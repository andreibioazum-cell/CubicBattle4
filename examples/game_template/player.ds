str PLAYER_PNG = "player.png"
bool player_png_loaded = 0
num player_x = 0
num player_y = 0
num player_speed = 5
num player_size = 40
num touch_x = 0
num touch_y = 0
num touch_action = 1

fn player_init() {
    player_png_loaded = png_load(PLAYER_PNG)
    player_x = screen_w / 2
    player_y = screen_h / 2
    joy.x = 150
    joy.y = screen_h - 150
    joy.r = 80
}

fn player_update() {
    player_x = player_x + joy.dx * player_speed
    player_y = player_y + joy.dy * player_speed
}

fn player_draw() {
    if (player_png_loaded) {
        tex(player_x - player_size / 2, player_y - player_size / 2, PLAYER_PNG, 0, 1)
    }
    if (!player_png_loaded) {
        rect(player_x - player_size / 2, player_y - player_size / 2, player_size, player_size, COLOR_PLAYER)
    }
    ring(joy.x, joy.y, joy.r, 4, COLOR_JOY)
    circle(joy.x + joy.ox, joy.y + joy.oy, 35, COLOR_JOY)
}

fn player_touch(x, y, action) {
    touch_x = x
    touch_y = y
    touch_action = action

    if (touch_action == 1 || touch_action == 3) {
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
        return
    }

    num dx = touch_x - joy.x
    num dy = touch_y - joy.y
    num distance = sqrt(dx * dx + dy * dy)
    if (distance < 15) {
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
        return
    }

    num knob_distance = distance
    if (knob_distance > joy.r) {
        knob_distance = joy.r
    }
    joy.dx = dx / distance
    joy.dy = dy / distance
    joy.ox = joy.dx * knob_distance
    joy.oy = joy.dy * knob_distance
}
