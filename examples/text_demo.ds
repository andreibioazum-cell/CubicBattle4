// Пример использования текстовых утилит DimScript.
//
// Текстовые утилиты встроены в runtime (runtime.h), поэтому функции
// доступны из скрипта без дополнительных include. Для вывода в лог
// используйте ds_log (print/printn/prints удалены).

fn init() {
    str greeting = "  Hello, DimScript!  "

    // Длина в байтах
    num bytes = ds_len(greeting)
    ds_log("bytes: " + bytes)                 // 22

    // Поиск подстроки
    num pos = ds_find(greeting, "Dim", 0)
    ds_log("pos: " + pos)                     // 4

    // Проверки
    num has = ds_contains(greeting, "Script")
    ds_log("has: " + has)                     // 1

    num starts = ds_starts_with(greeting, "  He")
    ds_log("starts: " + starts)               // 1

    num ends = ds_ends_with(greeting, "!  ")
    ds_log("ends: " + ends)                   // 1

    // Конкатенация
    str combined = ds_concat("foo", "bar")
    ds_log(combined)                          // "foobar"
}

fn update() {
}

fn draw() {
}
