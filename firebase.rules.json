{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        "players": {
          ".read": true,
          "$slot": {
            ".write": true,
            ".validate": "$slot.matches(/^[0-3]$/)"
          }
        },
        "chat": {
          ".read": true,
          ".write": true,
          ".indexOn": ".key"
        }
      }
    }
  }
}
