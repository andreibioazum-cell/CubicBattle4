{
  "rules": {
    ".read": false,
    ".write": false,
    "event": {
      ".read": true,
      ".write": true
    },
    "bans": {
      ".read": true,
      ".write": true
    },
    "users": {
      ".read": true,
      "$nick": {
        ".write": "!data.exists() || newData.child('pass').val() == data.child('pass').val()"
      }
    },
    "rooms": {
      "$room": {
        "players": {
          ".read": true,
          "$slot": {
            ".write": true,
            ".validate": "$slot.matches(/^[0-3]$/)"
          }
        },
        "chat": {
          ".read": true,
          ".write": true,
          ".indexOn": ".key"
        }
      }
    }
  }
}
