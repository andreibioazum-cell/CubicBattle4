// Точки входа движка.
function init
    png_load GRASS
    png_load TEX
    init_stars 90, 0xFFFFFF
end

function update
    update_transition
    if game_state == 5 && t_dir == 0
        match_time = match_time + dt
        // Комната не оставляет игрока в бесконечном «ждём соперника».
        // После короткого поиска запускается матч в выбранной комнате.
        if match_time >= 1.2
            start_transition 1
        end
    end
    if game_state == 1
        update_game
    end
end

function draw
    if game_state == 0
        draw_lobby
    else if game_state == 1
        draw_game
    else if game_state == 2
        draw_modes
    else if game_state == 3
        draw_rooms
    else if game_state == 4
        draw_settings
    else
        draw_matchmaking
    end
    // затемнение поверх во время перехода
    if t_fade > 0
        rect 0, 0, screen_w, screen_h, floor(t_fade * 255) * 0x1000000
    end
end

function touch num x, num y, num action, num id
    if t_dir != 0
        return
    end
    if game_state == 0
        touch_lobby x, y, action
    else if game_state == 1
        touch_game x, y, action, id
    else
        touch_menu x, y, action
    end
end
