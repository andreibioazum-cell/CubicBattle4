<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ZeroHabit">

    <!-- Android 10 (API 29) до Android 14 (API 34), arm64 и arm32 -->
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!-- Игра одиночная и офлайновая; интернет нужен только движку для сохранения прогресса. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="ZeroHabit"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true">

        <activity
            android:name="com.ZeroHabit.GameActivity"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <meta-data
                android:name="android.app.lib_name"
                android:value="ds_game" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
