// Управление касаниями.
function drop_joy
    joy_id = -1
    joy.dx = 0
    joy.dy = 0
    joy.ox = 0
    joy.oy = 0
end

function joy_touch num x, num y, num action, num id
    if action == 1
        if id == joy_id
            drop_joy
        end
        return
    end
    if action == 0
        if joy_id != -1
            return
        end
        num hx = x - joy.x
        num hy = y - joy.y
        if sqrt(hx * hx + hy * hy) > 150
            return
        end
        joy_id = id
    end
    if id != joy_id
        return
    end
    num dx = x - joy.x
    num dy = y - joy.y
    num dist = sqrt(dx * dx + dy * dy)
    if dist > joy.r
        joy.dx = dx / dist
        joy.dy = dy / dist
        joy.ox = joy.dx * joy.r
        joy.oy = joy.dy * joy.r
    else
        joy.dx = dx / joy.r
        joy.dy = dy / joy.r
        joy.ox = dx
        joy.oy = dy
    end
end

function touch_game num x, num y, num action, num id
    if finished != 0
        if action == 0
            start_transition 0
        end
        return
    end
    if action == 3
        // системная отмена жеста: сбрасываем пальцы, пуля не вылетает
        aiming = 0
        aim_id = -1
        drop_joy
        return
    end
    // Кнопка Back с увеличенной невидимой зоной срабатывает сразу на down.
    // Up оставлен запасным вариантом на случай прерванного начала жеста.
    if x >= (screen_w - 156) / 2 && x <= (screen_w + 156) / 2 && y >= 0 && y <= 72
        if action == 0 || action == 1
            start_transition 0
            return
        end
    end
    if action == 0
        num adx = x - atk_x
        num ady = y - atk_y
        // Выстрел происходит при нажатии, а не после отпускания: быстрый тап
        // больше не ощущается пропущенным. Зона нажатия чуть шире кнопки.
        if sqrt(adx * adx + ady * ady) <= 96
            aiming = 1
            aim_id = id
            fire_bullet
            return
        end
    end
    if action == 1 && id == aim_id
        aiming = 0
        aim_id = -1
        return
    end
    joy_touch x, y, action, id
end
