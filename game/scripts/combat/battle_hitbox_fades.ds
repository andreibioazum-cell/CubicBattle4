public function hb_live(number active)
    if finished!=0 then
        return 0
    end
    return active
end
public function hb_fade(number a, number live, number tin, number tout)
    if live==1 then
        return fade_up_a(a,tin)
    end
    return fade_down_a(a,tout)
end
public function tick_hitbox_fades()
    dash_box_a=hb_fade(dash_box_a,hb_live(dash_active),hitbox_fade_in,hitbox_fade_out)
    snow_ball_a=hb_fade(snow_ball_a,hb_live(gift.active),hitbox_fade_in,hitbox_fade_out)
    snow_boom_a=hb_fade(snow_boom_a,hb_live(boom_t>0),hitbox_fade_in,hitbox_fade_out)
    universe_box_a=hb_fade(universe_box_a,hb_live(universe_active),hitbox_fade_in,hitbox_fade_out)
    universe_fx_a=hb_fade(universe_fx_a,hb_live(universe_active),universe_fade_in,universe_fade_out)
    local number i=0
    while i<turret_max do
        arr_set(turret_box_a,i,hb_fade(arr_get(turret_box_a,i),hb_live(turret_alive(i)),hitbox_fade_in,hitbox_fade_out))
        i=i+1
    end
    if game_state==ST_SOLO then
        -- Only the strike (state 2) hits, so only the strike shows a zone: the
        -- wind-up used to draw a zone that could not deal damage yet.
        local number epunch=enemy.state==2
        enemy_punch_a=hb_fade(enemy_punch_a,hb_live(epunch),aim_fade_in,aim_fade_out)
        edash_box_a=hb_fade(edash_box_a,hb_live(enemy_dash_active),hitbox_fade_in,hitbox_fade_out)
        esnow_ball_a=hb_fade(esnow_ball_a,hb_live(enemy_gift.active),hitbox_fade_in,hitbox_fade_out)
        esnow_boom_a=hb_fade(esnow_boom_a,hb_live(enemy_boom_t>0),hitbox_fade_in,hitbox_fade_out)
        i=0
        while i<turret_max do
            arr_set(enemy_turret_box_a,i,hb_fade(arr_get(enemy_turret_box_a,i),hb_live(enemy_turret_alive(i)),hitbox_fade_in,hitbox_fade_out))
            i=i+1
        end
    else
        enemy_punch_a=fade_down_a(enemy_punch_a,hitbox_fade_out)
    end
    if game_state!=ST_ONLINE then
        return
    end
    local number s=0
    while s<max_players do
        if s!=net_slot() then
            arr_set(rpunch_a,s,hb_fade(arr_get(rpunch_a,s),hb_live(arr_get(remote_punches,s*punch_fields)==1),aim_fade_in,aim_fade_out))
            local number b=s*dash_fields
            arr_set(rdash_box_a,s,hb_fade(arr_get(rdash_box_a,s),hb_live(arr_get(remote_dash,b+1)),hitbox_fade_in,hitbox_fade_out))
            b=s*snow_fields
            arr_set(rsnow_ball_a,s,hb_fade(arr_get(rsnow_ball_a,s),hb_live(arr_get(remote_snow,b+1)),hitbox_fade_in,hitbox_fade_out))
            arr_set(rsnow_boom_a,s,hb_fade(arr_get(rsnow_boom_a,s),hb_live(arr_get(remote_snow,b+5)>0),hitbox_fade_in,hitbox_fade_out))
            b=s*universe_fields
            arr_set(runiverse_box_a,s,hb_fade(arr_get(runiverse_box_a,s),hb_live(arr_get(remote_universe,b+1)),hitbox_fade_in,hitbox_fade_out))
            arr_set(runiverse_fx_a,s,hb_fade(arr_get(runiverse_fx_a,s),hb_live(arr_get(remote_universe,b+1)),universe_fade_in,universe_fade_out))
            local number k=0
            while k<turret_max do
                local number stb=s*station_fields
                arr_set(rstation_box_a,s*turret_max+k,hb_fade(arr_get(rstation_box_a,s*turret_max+k),hb_live(arr_get(remote_station,stb+1+k*5)),hitbox_fade_in,hitbox_fade_out))
                k=k+1
            end
        end
        s=s+1
    end
end
