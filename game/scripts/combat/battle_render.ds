function update_remote_snow()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*snow_fields
        if s==net_slot()||net_player_online(s)!=1
            arr_set(remote_snow,b+1,0)
            arr_set(remote_snow,b+5,0)
        else
            number cnt=net_player_snow(s)
            number prev=arr_get(remote_snow,b)
            if cnt!=prev&&cnt>0
                arr_set(remote_snow,b,cnt)
                arr_set(remote_snow,b+1,1)
                arr_set(remote_snow,b+2,0)
                arr_set(remote_snow,b+3,net_player_snow_x(s)*screen_w)
                arr_set(remote_snow,b+4,net_player_snow_y(s)*screen_h)
            end
            if arr_get(remote_snow,b+1)==1
                number t=arr_get(remote_snow,b+2)+dt
                number x=arr_get(remote_snow,b+3)+net_player_snow_dx(s)*super_speed*dt
                number y=arr_get(remote_snow,b+4)+net_player_snow_dy(s)*super_speed*dt
                arr_set(remote_snow,b+2,t)
                arr_set(remote_snow,b+3,x)
                arr_set(remote_snow,b+4,y)
                number hit=0
                if dist(x,y,player.x,player.y)<player.size*0.65+24
                    hit=1
                end
                if t>super_range/super_speed
                    hit=1
                end
                if hit==1
                    arr_set(remote_snow,b+1,0)
                    arr_set(remote_snow,b+5,boom_time)
                    arr_set(remote_snow,b+6,x)
                    arr_set(remote_snow,b+7,y)
                    if dist(x,y,player.x,player.y)<=super_radius
                        number rcls=arr_get(remotes,s*remote_fields+10), rlevel=net_player_level(s), freeze_time=super_freeze
                        if rcls==CLASS_SANTA
                            freeze_time=santa_freeze_time_for(rlevel)
                        end
                        if player_freeze<freeze_time
                            player_freeze=freeze_time
                            player_freeze_slow=super_freeze_slow
                        end
                    end
                end
            end
            if arr_get(remote_snow,b+5)>0
                number bt=arr_get(remote_snow,b+5)-dt
                if bt<0
                    bt=0
                end
                arr_set(remote_snow,b+5,bt)
            end
        end
        s=s+1
    end
end

function draw_remote_snow()
    number s=0
    loop s<max_players
        number b=s*snow_fields
        if arr_get(remote_snow,b+1)==1
            number x=arr_get(remote_snow,b+3), y=arr_get(remote_snow,b+4), t=arr_get(remote_snow,b+2)
            number hw=16
            tex(x-hw,y-hw,SNOWFLAKE_TEX,t*3,0.5)
        end
        if arr_get(remote_snow,b+5)>0
            draw_boom_at(arr_get(remote_snow,b+6),arr_get(remote_snow,b+7),arr_get(remote_snow,b+5))
        end
        s=s+1
    end
end

function finish_game(number result)
    finished=result
    aim_id=-1
    super_id=-1
    aim_a=0
    punch.active=0
    punch.hit=0
    punch_left=0
    super_windup=0
    santa_follow=0
    drop_joy()
    gift.active=0
    boom_t=0
    station.active=0
    // Взрывы турелей не обрываем на экране результата: они доигрывают под
    // полупрозрачной плашкой и гаснут сами (очистка — в reset_battle).
    station_hit_t=0
    station_spawn_t=0
    station_heal_t=0
    arr_clear(ebuc_station_stack_x)
    arr_clear(ebuc_station_stack_y)
    arr_clear(ebuc_station_stack_hp)
    arr_clear(ebuc_station_stack_max)
    universe_active=0
    universe_t=0
    universe_a=0
    keyboard_hide()
    number i=0
    loop i<max_players*snow_fields
        arr_set(remote_snow,i,0)
        i=i+1
    end
    i=0
    loop i<max_players*station_fields
        arr_set(remote_station,i,0)
        i=i+1
    end
    i=0
    loop i<max_players*universe_fields
        arr_set(remote_universe,i,0)
        i=i+1
    end
    if result==1&&cups_awarded==0
        cups_awarded=1
        cups=cups+cup_win
        candies=candies+candy_win
        save_progress()
        // Первая победа открывает достижение: grant_achievement сам проверяет,
        // не выдана ли награда раньше, отмечает её в облаке и показывает тост.
        grant_achievement(ACH_FIRST_WIN)
        ds_log("win +%g cups +%g candies",cup_win,candy_win)
    end
end

function draw_punch_box(number x, number y, number dx, number dy, number reach, number width, number alpha)
    number aa=floor(clamp(alpha,0,1)*aim_max_alpha)
    if aa>0
        line(x,y,x+dx*reach,y+dy*reach,width,aa*0x1000000)
    end
end

// Тело и тень бойца — одни функции на всех: игрок, бот и сетевые соперники
// рисуются одинаково, поэтому спрайт, размер и цвет тени не могут разъехаться.
// skin — номер скина бойца (у игрока azum_skin, у соперника net_player_skin).
// Скин «Зомби» ходит своими текстурами (zombie_azum*.png); если они не
// загрузились, остаётся зелёный силуэт (zombie_tint).
function fighter_sprite(number cls, number punching, number skin)
    if skin_is_active(cls,skin)==1
        if punching==1
            return zombie_punch_tex()
        end
        return zombie_idle_tex()
    end
    if punching==1
        return class_punch_tex(cls)
    end
    return class_idle_tex(cls)
end

function draw_fighter_shadow(number x, number y, number ang, number cls, number punching, number skin)
    number hw=25*cube_scale*player_scale, ps=cube_scale*player_scale
    tex_tint(x-hw-shadow_off,y-hw+shadow_off,fighter_sprite(cls,punching,skin),sprite_a(ang),ps,(((unsigned)(int)shadow_alpha)<<24))
end

function draw_fighter_body(number x, number y, number ang, number cls, number punching, number skin)
    number hw=25*cube_scale*player_scale, ps=cube_scale*player_scale
    number sx=x-hw, sy=y-hw
    string t=fighter_sprite(cls,punching,skin)
    if skin_is_active(cls,skin)==1
        if zombie_tex_ok()==1
            // Текстура зомби уже зелёная — тон не нужен.
            tex(sx,sy,t,sprite_a(ang),ps)
            return
        end
        tex_tint(sx,sy,t,sprite_a(ang),ps,zombie_tint)
        return
    end
    tex(sx,sy,t,sprite_a(ang),ps)
end

function draw_player_shadow(number x, number y, number ang, number punching, number skin)
    draw_fighter_shadow(x,y,ang,player_class,punching,skin)
end

function draw_player_body(number x, number y, number ang, number punching)
    draw_fighter_body(x,y,ang,player_class,punching,azum_skin)
end

function draw_remote_shadow(number x, number y, number ang, number cls, number punching, number skin)
    draw_fighter_shadow(x,y,ang,cls,punching,skin)
end

function draw_remote_body(number x, number y, number ang, number cls, number punching, number skin)
    draw_fighter_body(x,y,ang,cls,punching,skin)
end

function draw_grass()
    number y=0
    loop y<screen_h
        number x=0
        loop x<screen_w
            tex(x,y,GRASS,0,1)
            x=x+256
        end
        y=y+256
    end
end

function draw_field()
    rect(0,0,screen_w,screen_h,0x33000000)
end

function draw_player_shadow_layer()
    if punch_left>0
        draw_player_shadow(player.x,player.y,player.angle,1,azum_skin)
    else
        draw_player_shadow(player.x,player.y,player.angle,0,azum_skin)
    end
end

function draw_player_hitbox_layer()
    if aim_a>0&&finished==0
        draw_punch_box(player.x,player.y,cos(player.angle),sin(player.angle),punch_reach,punch_width,aim_a)
    end
end

function draw_player_body_layer()
    if punch_left>0
        draw_player_body(player.x,player.y,player.angle,1)
    else
        draw_player_body(player.x,player.y,player.angle,0)
    end
end

function enemy_battle_tex()
    if enemy.state==1||enemy.state==2
        return PUNCH_TEX
    end
    return ORDINARY_TEX
end

function draw_enemy_shadow()
    number ehw=25*cube_scale*enemy_scale, es=cube_scale*enemy_scale
    tex_tint(enemy.x-ehw-shadow_off,enemy.y-ehw+shadow_off,enemy_battle_tex(),sprite_a(enemy.angle),es,(((unsigned)(int)shadow_alpha)<<24))
end

function draw_enemy_hitbox()
    if (enemy.state==1||enemy.state==2)&&finished==0
        draw_punch_box(enemy.x,enemy.y,cos(enemy.angle),sin(enemy.angle),enemy_punch_reach,enemy_punch_width,1)
    end
end

function draw_enemy_body()
    number ehw=25*cube_scale*enemy_scale, es=cube_scale*enemy_scale
    tex(enemy.x-ehw,enemy.y-ehw,enemy_battle_tex(),sprite_a(enemy.angle),es)
end

function draw_controls()
    ring(joy.x,joy.y,joy.r,4,0x000000)
    circle(joy.x+joy.ox,joy.y+joy.oy,34,0x000000)
    circle(atk_x,atk_y,70,0xE94560)
    ring(atk_x,atk_y,70,4,0x000000)
    text_in_box(tr_punch(),atk_x-70,atk_y-70,140,140,0xFFFFFF,0.55)
    if (player_class==CLASS_SANTA||player_class==CLASS_EBUC)&&(game_state==ST_SOLO||game_state==ST_ONLINE)
        circle(atk2_x,atk2_y,70,0x5F10A0)
        ring(atk2_x,atk2_y,70,4,0x000000)
        string sl=tr_super()
        if player_class==CLASS_EBUC
            sl=tr_super_ebuc()
        end
        number sls=0.55
        if super_cd>0
            sl=floor(super_cd+0.999)+""
            sls=0.95
        end
        text_in_box(sl,atk2_x-70,atk2_y-70,140,140,0xFFFFFF,sls)
    end
    draw_back()
end

function draw_result(string title)
    rect(0,0,screen_w,screen_h,0x99000000)
    number w=430, h=250
    number x=(screen_w-w)/2, y=screen_h/2-h/2
    roundrect(x,y,w,h,30,0x5F10A0)
    number reward=0
    if finished==1
        reward=cup_win
    end
    // Весь текст алерта — белый (в т.ч. «+N кубков» и приглашение выйти).
    ctext_scaled(title,y+36,0xFFFFFF,1.12)
    ctext_scaled(tr_cups_reward(reward),y+126,0xFFFFFF,0.9)
    ctext_scaled(tr_tap_to_return(),y+188,0xFFFFFF,0.62)
end

function draw_game()
    draw_grass()
    draw_field()
    draw_dust()
    draw_player_shadow_layer()
    draw_enemy_shadow()
    draw_candies()
    draw_player_hitbox_layer()
    draw_enemy_hitbox()
    draw_gift()
    draw_boom()
    draw_universe()
    draw_station()
    draw_player_body_layer()
    draw_enemy_body()
    draw_freeze()
    draw_poison()
    number w=screen_w/4
    hud_bar(20,20,w,28,player.hp,player.max_hp,0x7ED321,0)
    hud_bar(screen_w-w-20,20,w,28,enemy.hp,enemy.max_hp,0xE94560,1)
    draw_controls()
    if finished==1
        draw_result(tr_victory())
    else if finished==2
        draw_result(tr_defeat())
    end
end
