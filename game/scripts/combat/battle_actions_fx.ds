function start_punch_now()
    punch.x=player.x
    punch.y=player.y
    punch.dx=cos(player.angle)
    punch.dy=sin(player.angle)
    punch.active=1
    punch.shot=punch.shot+1
    punch.hit=0
    punch_left=punch_time
    punch_cd=punch_cooldown
    queued_punch=0
end

// Ульта и обычная атака используют разные визуальные слои. Пока на арене
// проигрывается любой эффект ульты, обычный удар не запускается: это не даёт
// спрайту удара, снежинке или вспышке вселенной накладываться друг на друга.
function station_boom_visual_busy()
    number i=0
    loop i<arr_len(station_boom_ts)
        if arr_get(station_boom_ts,i)>0
            return 1
        end
        i=i+1
    end
    return 0
end

function ultimate_visual_busy()
    if super_windup>0||gift.active==1||universe_active==1||boom_t>0||station_spawn_t>0
        return 1
    end
    if station_boom_visual_busy()==1
        return 1
    end
    return 0
end

function fire_punch()
    if punch_cd>0||ultimate_visual_busy()==1
        // Не запускаем два визуальных состояния одним кадром, но сохраняем
        // нажатие — удар начнётся сразу после ульты или её вспышки.
        queued_punch=1
        return
    end
    start_punch_now()
    if player_class==2
        santa_follow=santa_follow_delay
    end
end

function tick_santa_follow()
    if santa_follow<=0
        return
    end
    santa_follow=santa_follow-dt
    if santa_follow>0
        return
    end
    santa_follow=0
    if finished!=0||player_class!=2
        return
    end
    if super_windup>0||gift.active==1||universe_active==1||boom_t>0||station_spawn_t>0
        return
    end
    start_punch_now()
end

function fire_super()
    if player_class!=2&&player_class!=3
        return
    end
    if super_cd>0
        return
    end
    // Ульта ждёт окончания обычного удара и его кулдауна. Иначе старый
    // эффект удара и анимация замаха ульты появлялись в одном кадре.
    if punch_left>0||punch_cd>0||gift.active==1||universe_active==1||boom_t>0||station_spawn_t>0||station_boom_visual_busy()==1
        queued_super=1
        return
    end
    if super_windup>0
        queued_super=1
        return
    end
    // Отменяем отложенный второй удар Деда Мороза: иначе он мог стартовать
    // одновременно с уже летящей снежинкой после быстрого нажатия двух кнопок.
    santa_follow=0
    queued_super=0
    super_windup=punch_time
    punch_left=punch_time
    punch.active=0
    punch.hit=0
    if player_class==CLASS_EBUC
        super_cd=ebuc_super_cd_time
    else
        super_cd=super_cd_time
    end
end

function tick_super_windup()
    if super_windup<=0
        return
    end
    super_windup=super_windup-dt
    if super_windup>0
        return
    end
    super_windup=0
    if finished!=0
        return
    end
    if player_class==2
        gift.x=player.x
        gift.y=player.y
        gift.dx=cos(player.angle)
        gift.dy=sin(player.angle)
        gift.active=1
        gift.t=0
        gift.shot=gift.shot+1
        if game_state==ST_ONLINE
            net_publish_snow(gift.x/screen_w,gift.y/screen_h,gift.dx,gift.dy,gift.shot)
        end
        return
    end
    if player_class==CLASS_EBUC
        // Вторая ульта (вселенная) отключена — теперь всегда только станция.
        place_station()
        if game_state==ST_ONLINE
            net_publish_station(station.x/screen_w,station.y/screen_h,station.hp,station.shot)
        end
    end
end

function update_gift()
    if gift.active==0
        return
    end
    gift.t=gift.t+dt
    gift.x=gift.x+gift.dx*super_speed*dt
    gift.y=gift.y+gift.dy*super_speed*dt
    number touched=0
    if game_state==ST_ONLINE
        if gift.t>super_range/super_speed
            touched=1
        end
    else
        number hx=gift.x-enemy.x, hy=gift.y-enemy.y, hd=sqrt(hx*hx+hy*hy)
        if hd<enemy.size*0.65+24
            touched=1
        end
        if gift.t>super_range/super_speed
            touched=1
        end
    end
    if touched==0
        return
    end
    gift.active=0
    boom_x=gift.x
    boom_y=gift.y
    boom_t=boom_time
    if game_state!=ST_ONLINE&&dist(gift.x,gift.y,enemy.x,enemy.y)<=super_radius
        freeze_enemy(santa_freeze_time_for(player_level),super_freeze_slow)
        enemy.hp=enemy.hp-santa_super_damage
        if enemy.hp<=0
            enemy.hp=0
            finish_game(1)
            return
        end
    end
end

function draw_gift()
    if gift.active==0
        return
    end
    number hw=16, rot=gift.t*3
    tex(gift.x-hw,gift.y-hw,SNOWFLAKE_TEX,rot,0.5)
end

function draw_boom_at(number x, number y, number bt)
    if bt<=0
        return
    end
    number p=1-bt/boom_time, r=super_radius*p
    number fade_in=clamp(p/boom_fade_in,0,1), fade_out=clamp(bt/(boom_time*boom_fade_out),0,1)
    number a=floor(fade_in*fade_out*255)
    if a<=0
        return
    end
    number c0=(((unsigned)(int)a)<<24)|0x00B3E5FC, c1=(((unsigned)(int)a)<<24)|0x00E1F5FE
    ring(x,y,r,9,c0)
    ring(x,y,r*0.6,6,c1)
    circle(x,y,super_radius*0.3,c0)
end

function draw_boom()
    draw_boom_at(boom_x,boom_y,boom_t)
end

// ── Луч турели бука ────────────────────────────────────────────────────────
// Живая турель непрерывно излучает луч от себя до своего хозяина: плотное,
// почти непрозрачное яркое ядро внутри зелёного свечения. Без бегущих
// кружков и колец на концах — только чистый луч.
function draw_station_beam(number sx, number sy, number px, number py)
    number dx=px-sx, dy=py-sy
    number d=sqrt(dx*dx+dy*dy)
    if d<40
        return
    end
    number nx=dx/d, ny=dy/d
    // Луч выходит прямо из центра турели (x1,y1 = центр), а спрайт рисуется
    // поверх него, поэтому видно, что луч «растёт» из середины турели.
    number x1=sx, y1=sy
    // не заходить внутрь спрайта игрока
    number x2=px-nx*32, y2=py-ny*32
    // Пульсация луча убрана: ширина и яркость постоянные.
    number a=floor(250)
    // внешнее свечение — плотное, без пульсации
    line(x1,y1,x2,y2,15,(((unsigned)(int)200)<<24)|0x0000E676)
    // ядро луча — сплошное и яркое
    line(x1,y1,x2,y2,6,(((unsigned)(int)a)<<24)|0x00C8FAD6)
end

function draw_station_at(number x, number y, number hp, number max_hp)
    number scale=station_scale
    if station.active==1&&x==station.x&&y==station.y
        // Появление: спрайт немного увеличен и быстро сжимается до нормы.
        // Эффект урона (сжатие при попадании) убран.
        if station_spawn_t>0
            number sp=clamp(station_spawn_t/station_spawn_time,0,1)
            scale=station_scale*(1.0+0.25*sp)
        end
    end
    // Спрайт турели 50x50: центрируем по половине реального размера,
    // раньше смещение считалось от 44px и спрайт уезжал вниз-влево.
    number hw=25*scale
    tex(x-hw,y-hw,DESPENSER_TEX,0,scale)
    // Полоса здоровья турели — прямо над ней.
    number bw=46*scale, bh=7
    hud_bar(x-bw/2, y-hw-12, bw, bh, hp, max_hp, 0x7ED321, 0)
end

// Взрыв турели при полном разрушении: тот же характер, что у взрыва
// снежинки Деда Мороза, но в зелёных тонах бука.
function draw_turret_boom(number x, number y, number bt)
    if bt<=0
        return
    end
    number p=1-bt/station_boom_time
    if p<0
        p=0
    end
    if p>1
        p=1
    end
    number fade_in=clamp(p/boom_fade_in,0,1)
    number fade_out=clamp(bt/(station_boom_time*boom_fade_out),0,1)
    number a=floor(fade_in*fade_out*240)
    if a<=0
        return
    end
    number r=30+95*p
    // зелёные кольца (вместо голубых у снежинки)
    ring(x,y,r,9,(((unsigned)(int)a)<<24)|0x0000E676)
    ring(x,y,r*0.66,6,(((unsigned)(int)floor(a*0.85))<<24)|0x00B9F6CA)
    ring(x,y,r*0.36,5,(((unsigned)(int)floor(a*0.65))<<24)|0x0076FF03)
    // яркая вспышка в центре
    circle(x,y,r*0.22+6*(1-p),(((unsigned)(int)floor(a*0.7))<<24)|0x0000E676)
    // разлетающиеся зелёные осколки-частицы
    number i=0
    loop i<18
        number h1=hash01(i*37+11)
        number h2=hash01(i*61+7)
        number ang=h1*2*pi
        number rr=r*(0.5+0.5*h2)
        number px=x+cos(ang)*rr
        number py=y+sin(ang)*rr
        number sz=2+4*(1-p)
        number aa=floor(a*(0.7+0.3*h2))
        circle(px,py,sz,(((unsigned)(int)aa)<<24)|0x0000E676)
        i=i+1
    end
end

function draw_station()
    // Рисуем запасные турели из стека (старые)
    number si=0
    loop si<arr_len(ebuc_station_stack_x)
        number sx=arr_get(ebuc_station_stack_x,si)
        number sy=arr_get(ebuc_station_stack_y,si)
        number sh=arr_get(ebuc_station_stack_hp,si)
        number sm=arr_get(ebuc_station_stack_max,si)
        // чуть темнее/прозрачнее чтобы отличать
        draw_station_at(sx,sy,sh,sm)
        si=si+1
    end
    if station.active==1
        // Луч рисуем под спрайтом, чтобы он «выходил прямо из центра» турели.
        // Активная турель излучает луч до самого бука.
        draw_station_beam(station.x,station.y,player.x,player.y)
        draw_station_at(station.x,station.y,station.hp,station.max_hp)
    end
    // Все взрывы разрушенных турелей доигрывают на своих местах.
    number bi=0
    loop bi<arr_len(station_boom_ts)
        number bt=arr_get(station_boom_ts,bi)
        if bt>0
            draw_turret_boom(arr_get(station_boom_xs,bi),arr_get(station_boom_ys,bi),bt)
        end
        bi=bi+1
    end
end

function universe_particle_color(number i, number a)
    number m=(int)i%4
    if m==0
        return (((unsigned)(int)a)<<24)|0x0000E676
    end
    if m==1
        return (((unsigned)(int)a)<<24)|0x0000E5FF
    end
    if m==2
        return (((unsigned)(int)a)<<24)|0x00FFFFFF
    end
    return (((unsigned)(int)a)<<24)|0x0076FF03
end

function draw_universe_at(number cx, number cy, number seed, number t)
    if t<=0
        return
    end
    number p=clamp(t/ebuc_universe_collapse_time,0,1)
    if p>=1
        return
    end
    number i=0
    loop i<ebuc_universe_particles
        number h1=hash01(seed*13+i*91+7)
        number h2=hash01(seed*17+i*131+19)
        number h3=hash01(seed*23+i*173+31)
        number h4=hash01(seed*29+i*211+47)
        number sx=40+h1*(screen_w-80)
        number sy=40+h2*(screen_h-80)
        number k=p*p
        number px=lerp(sx,cx,k)
        number py=lerp(sy,cy,k)
        number size=2+6*h3*(1-p)
        number a=floor(120+120*p)
        circle(px,py,size,universe_particle_color(i,a))
        if h4>0.86
            number trail=floor(a*0.55)
            circle(px,py,size*2.1,universe_particle_color(i+1,trail))
        end
        i=i+1
    end
    if p>0.78
        number ep=(p-0.78)/0.22
        number r=(80+120*ep)*1.0
        number af=floor(240*ep)
        ring(cx,cy,r,10,(((unsigned)(int)af)<<24)|0x0000E676)
        if ep>0.45
            number a2=floor(160*(ep-0.45)/0.55)
            ring(cx,cy,r*0.62,8,(((unsigned)(int)a2)<<24)|0x0076FF03)
        end
    end
end

function draw_universe()
    if universe_active==0
        return
    end
    draw_universe_at(universe_x,universe_y,universe_id,universe_t)
end

function draw_remote_station()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*station_fields
        if s!=net_slot()
            number st=arr_get(remote_station,b)
            if st==1
                // Луч рисуем под спрайтом, чтобы он «выходил прямо из центра» турели.
                number rb=s*remote_fields
                if arr_get(remotes,rb+5)==1
                    draw_station_beam(arr_get(remote_station,b+1),arr_get(remote_station,b+2),arr_get(remotes,rb+1),arr_get(remotes,rb+2))
                end
                number rl=net_player_level(s)
                draw_station_at(arr_get(remote_station,b+1),arr_get(remote_station,b+2),net_player_station_hp(s),ebuc_station_hp_for(rl))
            else if st==2
                // Взрыв чужой турели виден и у нас — доигрывает до конца.
                draw_turret_boom(arr_get(remote_station,b+1),arr_get(remote_station,b+2),arr_get(remote_station,b+3))
            end
        end
        s=s+1
    end
end

function draw_remote_universe()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*universe_fields
        if s!=net_slot()&&arr_get(remote_universe,b+1)==1
            draw_universe_at(arr_get(remote_universe,b+2),arr_get(remote_universe,b+3),arr_get(remote_universe,b),arr_get(remote_universe,b+4))
        end
        s=s+1
    end
end
