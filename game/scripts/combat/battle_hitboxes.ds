include graphics

// ══════════════════════════════════════════════════════════════════════════
// battle_hitboxes.ds — хитбоксы всех способностей с уроном.
//
// Все хитбоксы (и удары, и способности) рисуются одним серым цветом, как
// полосы удара (draw_punch_box в battle_render.ds). Всё прячется одним
// переключателем show_hitboxes из настроек. Слой вызывается из
// draw_game/draw_online сразу после хитбоксов ударов.
//
// Хитбоксы способностей не мигают и не обрываются: альфа каждого эффекта
// плавно набирается при появлении (hitbox_fade_in) и плавно гаснет после
// конца (hitbox_fade_out) — как полоса удара. «Живые» альфы ведёт
// tick_hitbox_fades() из update_game/update_online; она же отвечает за полосы
// ударов врага-бота и сетевых соперников. В конце боя (finished!=0) хитбоксы
// не исчезают разом: tick_hitbox_fades считает их закончившимися, и все зоны
// плавно гаснут под плашкой результата.
//
// Рисуются реальные зоны урона: у снежинки — круг контакта (размером с
// проверку попадания), линия пути и круг взрыва; у рывка — уже проеханный
// отрезок, разложенный на квадратные большие хитбоксы (один слой: онлайн-рывок
// бьёт ровно по этому отрезку, см. dash_resolve_target); у турели — квадрат
// зоны попадания, как её спрайт и тень. Залитые участки сплошные, чтобы зона
// читалась целиком, а не только контуром.
// ══════════════════════════════════════════════════════════════════════════

// ── Альфа: плавное появление/пропадание ──────────────────────────────────
function fade_up_a(number a, number t)
    if t<=0
        return 1
    end
    a=a+dt/t
    if a>1
        a=1
    end
    return a
end

function fade_down_a(number a, number t)
    if t<=0
        return 0
    end
    a=a-dt/t
    if a<0
        a=0
    end
    return a
end

// Текущая альфа эффекта с учётом плавности (0..1).
function hb_env(number a)
    if a<0
        a=0
    end
    if a>1
        a=1
    end
    return a
end

// Итоговые альфы серого цвета: контур и заливка масштабируются плавностью.
function hb_line_alpha(number env)
    return floor(hitbox_line_alpha*hb_env(env))
end

function hb_fill_alpha(number env)
    return floor(hitbox_fill_alpha*hb_env(env))
end

function hb_solid_alpha(number env)
    return floor(hitbox_solid_alpha*hb_env(env))
end

// ── Примитивы ─────────────────────────────────────────────────────────────
// Контурный круг: заливка едва видна, контур читается чётко.
function draw_hit_circle(number x, number y, number r, number rgb, number env)
    if show_hitboxes==0
        return
    end
    if r<=0||env<=0
        return
    end
    circle(x,y,r,(((unsigned)(int)hb_fill_alpha(env))<<24)|((unsigned)(int)rgb))
    ring(x,y,r,3,(((unsigned)(int)hb_line_alpha(env))<<24)|((unsigned)(int)rgb))
end

// Залитый круг: вся зона урона залита серым (снежинка, взрыв, пятно рывка),
// контур остаётся поверх заливки.
function draw_hit_circle_solid(number x, number y, number r, number rgb, number env)
    if show_hitboxes==0
        return
    end
    if r<=0||env<=0
        return
    end
    circle(x,y,r,(((unsigned)(int)hb_solid_alpha(env))<<24)|((unsigned)(int)rgb))
    ring(x,y,r,3,(((unsigned)(int)hb_line_alpha(env))<<24)|((unsigned)(int)rgb))
end

function draw_hit_line(number x1, number y1, number x2, number y2, number w, number rgb, number env)
    if show_hitboxes==0
        return
    end
    if w<=0||env<=0
        return
    end
    line(x1,y1,x2,y2,w,(((unsigned)(int)hb_line_alpha(env))<<24)|((unsigned)(int)rgb))
end

// ── Снежинки: летящий снаряд + радиус взрыва ──────────────────────────────
// Круг снаряда — реальная зона контакта (как проверка попадания), линия —
// оставшийся путь, ширина линии равна диаметру круга. Всё залито целиком.
function draw_hit_snowball(number x, number y, number dx, number dy, number t, number r, number env)
    draw_hit_circle_solid(x,y,r,hitbox_snow_rgb,env)
    number left=super_range-t*super_speed
    if left>0
        draw_hit_line(x,y,x+dx*left,y+dy*left,r*2,hitbox_snow_rgb,env)
    end
end

// Радиус контакта снежинки: размер цели + запас 24 (как в проверках урона).
function snow_hit_radius(number target_size)
    return target_size*0.65+24
end

// Видимость каждой зоны определяет её альфа, а не флаг эффекта: так хитбокс
// доигрывает своё плавное пропадание даже после того, как эффект закончился
// (геометрия при этом не стирается — см. finish_game).
function draw_hit_snow()
    if snow_ball_a>0
        number r=snow_hit_radius(enemy.size)
        if game_state==ST_ONLINE
            r=snow_hit_radius(player.size)
        end
        draw_hit_snowball(gift.x,gift.y,gift.dx,gift.dy,gift.t,r,snow_ball_a)
    end
    if snow_boom_a>0
        draw_hit_circle_solid(boom_x,boom_y,super_radius,hitbox_snow_rgb,snow_boom_a)
    end
    if game_state==ST_SOLO
        if esnow_ball_a>0
            number er=snow_hit_radius(player.size)
            draw_hit_snowball(enemy_gift.x,enemy_gift.y,enemy_gift.dx,enemy_gift.dy,enemy_gift.t,er,esnow_ball_a)
        end
        if esnow_boom_a>0
            draw_hit_circle_solid(enemy_boom_x,enemy_boom_y,super_radius,hitbox_snow_rgb,esnow_boom_a)
        end
    end
    if game_state!=ST_ONLINE
        return
    end
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*snow_fields
        if arr_get(rsnow_ball_a,s)>0
            number rr=snow_hit_radius(player.size)
            draw_hit_snowball(arr_get(remote_snow,b+3),arr_get(remote_snow,b+4),net_player_snow_dx(s),net_player_snow_dy(s),arr_get(remote_snow,b+2),rr,arr_get(rsnow_ball_a,s))
        end
        if arr_get(rsnow_boom_a,s)>0
            draw_hit_circle_solid(arr_get(remote_snow,b+6),arr_get(remote_snow,b+7),super_radius,hitbox_snow_rgb,arr_get(rsnow_boom_a,s))
        end
        s=s+1
    end
end

// ── Рывки: зона урона — только квадратные большие хитбоксы ────────────────
// Рывок рисуется ровно там, где он действительно бьёт: по уже проеханному
// отрезку от точки старта до текущего положения бойца (по нему режется урон,
// см. dash_resolve_target и tick_dash_solo_hit).
//
// Слой один: проеханный отрезок раскладывается по клеткам мира размером со
// сторону квадрата, и каждая затронутая клетка рисуется одним БОЛЬШИМ
// квадратом (сторона — dash_hitbox_zone_scale радиусов зоны урона, альфа —
// как у хитбоксов ударов). Мелких кубиков, тянущихся вторым слоем следом за
// большими, больше нет: квадраты не перекрываются (каждая клетка рисуется
// один раз), поэтому зона не двоится и не оставляет мелкой крошки позади.
// Круга вокруг бойца тоже нет: зона рывка — отрезок, а не пятно под кубиком.

// Альфа как у хитбоксов ударов (aim_max_alpha), чтобы рывок читался так же.
function hb_aim_alpha(number env)
    return floor(aim_max_alpha*hb_env(env))
end

function draw_hit_dash_path(number sx, number sy, number dx, number dy, number cx, number cy, number pr, number env)
    // Сколько уже проехали вдоль направления рывка: от старта до текущего
    // положения (текущая точка всегда лежит на прямой рывка).
    number travel=(cx-sx)*dx+(cy-sy)*dy
    if travel<0
        travel=0
    end
    number len=azum_dash_speed*azum_dash_time
    if travel>len
        travel=len
    end
    if pr<=0||env<=0
        return
    end
    number side=pr*dash_hitbox_zone_scale
    if side<=0
        side=2
    end
    // Клетки мира, затронутые проеханным отрезком: список пар gx,gy без
    // повторов. Шаг обхода — половина стороны, поэтому ни одна клетка на
    // пути не пропускается, а текущая точка даёт последний квадрат зоны.
    array cells=arr_new()
    number off=0, step=side*0.5, px=0, py=0, gx=0, gy=0, seen=0, k=0
    loop off<=travel
        px=sx+dx*off
        py=sy+dy*off
        gx=floor(px/side)
        gy=floor(py/side)
        seen=0
        k=0
        loop k<arr_len(cells)
            if arr_get(cells,k)==gx&&arr_get(cells,k+1)==gy
                seen=1
                k=arr_len(cells)
            end
            k=k+2
        end
        if seen==0
            arr_push(cells,gx)
            arr_push(cells,gy)
        end
        off=off+step
    end
    number col=(((unsigned)(int)hb_aim_alpha(env))<<24)|((unsigned)(int)hitbox_dash_rgb)
    k=0
    loop k<arr_len(cells)
        gx=arr_get(cells,k)
        gy=arr_get(cells,k+1)
        rect(gx*side,gy*side,side,side,col)
        k=k+2
    end
end

function draw_hit_dash()
    if dash_box_a>0
        // Радиус зоны — тот же, которым считается урон: в соло рывок бьёт по
        // врагу, в онлайне чужой рывок бьёт по этому игроку.
        number dpr=dash_hit_radius_remote()
        if game_state==ST_SOLO
            dpr=dash_hit_radius_solo()
        end
        draw_hit_dash_path(dash_x0,dash_y0,dash_dx,dash_dy,player.x,player.y,dpr,dash_box_a)
    end
    if game_state==ST_SOLO&&edash_box_a>0
        number epr=dash_hit_radius_solo()
        draw_hit_dash_path(enemy_dash_x0,enemy_dash_y0,enemy_dash_dx,enemy_dash_dy,enemy.x,enemy.y,epr,edash_box_a)
    end
    if game_state!=ST_ONLINE
        return
    end
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*dash_fields
        if s!=net_slot()&&arr_get(rdash_box_a,s)>0
            number rx=arr_get(remote_dash,b+2), ry=arr_get(remote_dash,b+3)
            number rdx=arr_get(remote_dash,b+4), rdy=arr_get(remote_dash,b+5)
            number gone=azum_dash_speed*(azum_dash_time-arr_get(remote_dash,b+6))
            number pr=dash_hit_radius_remote()
            draw_hit_dash_path(rx,ry,rdx,rdy,rx+rdx*gone,ry+rdy*gone,pr,arr_get(rdash_box_a,s))
        end
        s=s+1
    end
end

// ── Турели: квадрат зоны попадания по каждой живой турели ─────────────────
// Зона турели — квадрат, как и её спрайт с тенью: половина стороны равна
// turret_hit_r (combat/battle_hitscan.ds, проверки идут по тому же квадрату).
// Круглой зоны у деспенсера больше нет.
function draw_hit_square(number x, number y, number half, number rgb, number env)
    if show_hitboxes==0
        return
    end
    if half<=0||env<=0
        return
    end
    rect(x-half,y-half,half*2,half*2,(((unsigned)(int)hb_fill_alpha(env))<<24)|((unsigned)(int)rgb))
    draw_hit_line(x-half,y-half,x+half,y-half,3,rgb,env)
    draw_hit_line(x+half,y-half,x+half,y+half,3,rgb,env)
    draw_hit_line(x+half,y+half,x-half,y+half,3,rgb,env)
    draw_hit_line(x-half,y+half,x-half,y-half,3,rgb,env)
end

function draw_hit_turrets()
    number i=0
    loop i<turret_max
        if arr_get(turret_box_a,i)>0
            draw_hit_square(arr_get(turret_x,i),arr_get(turret_y,i),turret_hit_r,hitbox_turret_rgb,arr_get(turret_box_a,i))
        end
        i=i+1
    end
    if game_state==ST_SOLO
        i=0
        loop i<turret_max
            if arr_get(enemy_turret_box_a,i)>0
                draw_hit_square(arr_get(enemy_turret_x,i),arr_get(enemy_turret_y,i),turret_hit_r,hitbox_turret_rgb,arr_get(enemy_turret_box_a,i))
            end
            i=i+1
        end
    end
    if game_state!=ST_ONLINE
        return
    end
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*station_fields
        if s!=net_slot()
            number o=b+1, k=0
            loop k<turret_max
                if arr_get(rstation_box_a,s*turret_max+k)>0
                    draw_hit_square(arr_get(remote_station,o+1),arr_get(remote_station,o+2),turret_hit_r,hitbox_turret_rgb,arr_get(rstation_box_a,s*turret_max+k))
                end
                o=o+5
                k=k+1
            end
        end
        s=s+1
    end
end

// ── Вселенная: бьёт по всей арене, поэтому рамка по краям экрана ──────────
function draw_hit_universe_frame(number env)
    number w=7
    draw_hit_line(0,0,screen_w,0,w,hitbox_universe_rgb,env)
    draw_hit_line(0,screen_h,screen_w,screen_h,w,hitbox_universe_rgb,env)
    draw_hit_line(0,0,0,screen_h,w,hitbox_universe_rgb,env)
    draw_hit_line(screen_w,0,screen_w,screen_h,w,hitbox_universe_rgb,env)
end

function draw_hit_universe()
    if universe_box_a>0
        draw_hit_universe_frame(universe_box_a)
        draw_hit_circle(universe_x,universe_y,60,hitbox_universe_rgb,universe_box_a)
    end
    if game_state!=ST_ONLINE
        return
    end
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*universe_fields
        if s!=net_slot()&&arr_get(runiverse_box_a,s)>0
            draw_hit_universe_frame(arr_get(runiverse_box_a,s))
            draw_hit_circle(arr_get(remote_universe,b+2),arr_get(remote_universe,b+3),60,hitbox_universe_rgb,arr_get(runiverse_box_a,s))
        end
        s=s+1
    end
end

// Общий слой хитбоксов способностей: вызывается из draw_game/draw_online
// сразу после хитбоксов ударов. При show_hitboxes==0 ничего не рисует.
function draw_ability_hitboxes()
    if show_hitboxes==0
        return
    end
    draw_hit_snow()
    draw_hit_dash()
    draw_hit_turrets()
    draw_hit_universe()
end
