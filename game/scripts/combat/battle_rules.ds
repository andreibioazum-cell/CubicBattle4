include graphics
// Упрощённый бой без праймов, с человечным врагом и админкой
// Пока azum.png не лежит в game/assets, Азум (игрок и враг) выглядит как
// обычный куб — играет текстурами ordinary*.png. Скин «Зомби» ходит своими
// zombie_azum*.png; если они не загрузились, скин откатывается на обычный
// вид Азума. Как только azum*.png появятся в ассетах, Азум включит свою
// текстуру сам (флаг azum_tex_ok выставляет engine.ds из png_load).
function azum_idle_tex()
    if azum_tex_ok==1
        return AZUM_TEX
    end
    return ORDINARY_TEX
end
function azum_punch_tex()
    if azum_tex_ok==1
        return AZUM_PUNCH_TEX
    end
    return PUNCH_TEX
end

// Есть ли у скина «Зомби» обе свои текстуры (idle и удар). Ходит по текстурам
// только тогда, когда и то, и другое загрузились: половинчатый скин, где
// удар — чужой силуэт, выглядит хуже, чем откат на обычный вид целиком.
function zombie_tex_ok()
    if azum_zombie_tex_ok==1&&azum_zombie_punch_tex_ok==1
        return 1
    end
    return 0
end

// Спрайт скина «Зомби»: zombie_azum*.png. Если они не загрузились,
// возвращается обычная текстура Азума (обычный куб).
function zombie_idle_tex()
    if azum_zombie_tex_ok==1
        return AZUM_ZOMBIE_TEX
    end
    return azum_idle_tex()
end

function zombie_punch_tex()
    if azum_zombie_punch_tex_ok==1
        return AZUM_ZOMBIE_PUNCH_TEX
    end
    return azum_punch_tex()
end

function class_idle_tex(number cls)
    if cls==CLASS_AZUM
        return azum_idle_tex()
    end
    if cls==CLASS_SANTA
        return SANTA_TEX
    end
    if cls==CLASS_EBUC
        return EBUC_TEX
    end
    return ORDINARY_TEX
end

function class_punch_tex(number cls)
    if cls==CLASS_AZUM
        return azum_punch_tex()
    end
    if cls==CLASS_SANTA
        return SANTA_PUNCH_TEX
    end
    if cls==CLASS_EBUC
        return EBUC_PUNCH_TEX
    end
    return PUNCH_TEX
end

function class_punch_damage_for(number cls, number lv)
    if cls==CLASS_SANTA
        return santa_damage
    end
    if cls==CLASS_EBUC
        return ebuc_damage
    end
    if cls==CLASS_ORDINARY&&lv>=1
        return punch_damage*(1+ordinary_damage_bonus)
    end
    return punch_damage
end

function player_max_hp_for(number cls)
    if cls==CLASS_EBUC
        return ebuc_hp
    end
    return 10
end

// Уровни бука: 1 — у турелей больше HP, 2 — установка турели лечит бука,
// 3 — луч турели лечит бука каждую секунду.
function ebuc_station_hp_for(number lv)
    number h=ebuc_station_hp
    if lv>=1
        h=h+ebuc_station_hp_bonus*2
    end
    return h
end

function ebuc_universe_damage_for(number lv)
    number d=ebuc_universe_damage
    if lv>=3
        d=d+ebuc_universe_damage_bonus
    end
    return d
end

function class_punch_damage(number cls)
    return class_punch_damage_for(cls,player_level)
end

function santa_poison_time_for(number lv)
    return santa_poison_time
end

function santa_poison_damage_for(number lv)
    number d=santa_poison_dps
    if lv>=1
        d=d+santa_poison_damage_bonus
    end
    if lv>=2
        d=d+santa_poison_damage_bonus
    end
    return d
end

function santa_freeze_time_for(number lv)
    number t=super_freeze
    if lv>=3
        t=t+santa_freeze_time_bonus
    end
    return t
end

// ── Турели бука ───────────────────────────────────────────────────────────
// Настоящие турели: до turret_max штук, каждая стоит на своём месте со своим
// HP. Слот считается занятым, пока hp>0. Анимация появления у каждой своя
// (turret_spawn_t), чтобы новая турель не «перезаписывала» чужую анимацию.
function turret_alive(number i)
    if arr_get(turret_hp,i)>0
        return 1
    end
    return 0
end

function turret_count_alive()
    number n=0, i=0
    loop i<turret_max
        if turret_alive(i)==1
            n=n+1
        end
        i=i+1
    end
    return n
end

// Каждая поломка турели ставит свой взрыв в очередь: взрыв живёт на своём
// месте и доигрывает до конца, его не перезаписывает ни постановка новой
// турели, ни поломка следующей.
function push_station_boom(number x, number y)
    arr_push(station_boom_xs,x)
    arr_push(station_boom_ys,y)
    arr_push(station_boom_ts,station_boom_time)
    // Не копим больше station_booms_max взрывов: самые старые убираем.
    if arr_len(station_boom_ts)>station_booms_max
        number keep=station_booms_max
        array nx=arr_new()
        array ny=arr_new()
        array nt=arr_new()
        number i=arr_len(station_boom_ts)-keep
        loop i<arr_len(station_boom_ts)
            arr_push(nx,arr_get(station_boom_xs,i))
            arr_push(ny,arr_get(station_boom_ys,i))
            arr_push(nt,arr_get(station_boom_ts,i))
            i=i+1
        end
        station_boom_xs=nx
        station_boom_ys=ny
        station_boom_ts=nt
    end
end

// Сломать турель слота i: взрыв остаётся в очереди, слот освобождается.
function destroy_turret(number i)
    if i<0||i>=turret_max
        return
    end
    if turret_alive(i)==0
        return
    end
    push_station_boom(arr_get(turret_x,i),arr_get(turret_y,i))
    arr_set(turret_hp,i,0)
    arr_set(turret_maxhp,i,0)
    arr_set(turret_spawn_t,i,0)
end

// Урон по турели: если HP кончилось — взрыв на её месте и слот свободен.
// Взрыв ставим прямо здесь, а не через destroy_turret: та ждёт живую турель,
// а урон уже обнулил HP — через неё взрыва бы не было вовсе.
function damage_turret(number i, number dmg)
    if i<0||i>=turret_max
        return
    end
    if turret_alive(i)==0
        return
    end
    number h=arr_get(turret_hp,i)-dmg
    if h<=0
        push_station_boom(arr_get(turret_x,i),arr_get(turret_y,i))
        arr_set(turret_hp,i,0)
        arr_set(turret_maxhp,i,0)
        arr_set(turret_spawn_t,i,0)
        return
    end
    arr_set(turret_hp,i,h)
end

// Новая турель: встаёт в свободный (сломанный) слот; если все заняты —
// самая старая взрывается, а её слот занимает новая.
function place_turret()
    number slot=-1, i=0
    loop i<turret_max
        if turret_alive(i)==0
            slot=i
            i=turret_max
        end
        i=i+1
    end
    if slot<0
        // все живы — самая старая (первый живой слот) уступает место
        i=0
        loop i<turret_max
            if turret_alive(i)==1
                slot=i
                i=turret_max
            end
            i=i+1
        end
        if slot<0
            return
        end
        destroy_turret(slot)
    end
    arr_set(turret_x,slot,player.x)
    arr_set(turret_y,slot,player.y)
    number mh=ebuc_station_hp_for(player_level)
    arr_set(turret_maxhp,slot,mh)
    arr_set(turret_hp,slot,mh)
    arr_set(turret_spawn_t,slot,station_spawn_time)
    // Уровень 2: установка турели лечит бука.
    if player_level>=2
        player.hp=clamp(player.hp+ebuc_place_heal,0,player.max_hp)
    end
end

// Тикер турелей: анимации появления гаснут, уровень 3 лечит лучом, взрывы
// доигрывают. Взрывы тикаем всегда (даже после конца боя), остальное — в бою.
function tick_station_boom()
    number i=0
    loop i<arr_len(station_boom_ts)
        number t=arr_get(station_boom_ts,i)
        if t>0
            t=t-dt
            if t<0
                t=0
            end
            arr_set(station_boom_ts,i,t)
        end
        i=i+1
    end
end

function tick_turrets()
    tick_station_boom()
    number i=0
    loop i<turret_max
        if arr_get(turret_spawn_t,i)>0
            number t=arr_get(turret_spawn_t,i)-dt
            if t<0
                t=0
            end
            arr_set(turret_spawn_t,i,t)
        end
        i=i+1
    end
    // Уровень 3: пока жива хоть одна турель, её луч лечит бука раз в секунду.
    if player_class==CLASS_EBUC&&player_level>=3&&turret_count_alive()>0&&finished==0&&player.hp>0
        turret_heal_t=turret_heal_t+dt
        if turret_heal_t>=1
            turret_heal_t=turret_heal_t-1
            player.hp=clamp(player.hp+ebuc_beam_heal,0,player.max_hp)
        end
    else
        turret_heal_t=0
    end
end

// ── Попадания по игроку и турелям ────────────────────────────────────────
// Удар из точки (px,py) вдоль (pdx,pdy): кого он задевает — игрока (0) или
// живую турель (номер слота 1..turret_max). expand_player — радиус игрока для
// проверки (0 — проверка точно по центру, как в старом онлайне).
// Турель принимает удар, если она стоит перед игроком или «на нём»
// (ближе по направлению удара, допуск 30px назад): турель — это щит бука.
// -1 — удар никого не задевает.
function punch_resolve_target(number px, number py, number pdx, number pdy, number expand_player)
    number best=-1, bfw=0, i=0
    number pr=expand_player
    if pr<0
        pr=0
    end
    number half=punch_width/2+pr
    number rx=player.x-px, ry=player.y-py
    number fw=rx*pdx+ry*pdy, side=ry*pdx-rx*pdy
    if fw>=0&&fw<=punch_reach+pr&&side*side<=half*half
        best=0
        bfw=fw
    end
    loop i<turret_max
        if turret_alive(i)==1
            number hx=arr_get(turret_x,i)-px, hy=arr_get(turret_y,i)-py
            number tf=hx*pdx+hy*pdy, ts=hy*pdx-hx*pdy, th=punch_width/2+turret_hit_r
            if tf>=0&&tf<=punch_reach+turret_hit_r&&ts*ts<=th*th
                if best==-1
                    best=i+1
                    bfw=tf
                else if best==0
                    // турель перед игроком или почти на нём — принимает удар
                    if tf<=bfw+30
                        best=i+1
                        bfw=tf
                    end
                else if tf<bfw-1
                    best=i+1
                    bfw=tf
                end
            end
        end
        i=i+1
    end
    return best
end

// Локальный бой иногда должен проверить турель отдельно от игрока-владельца.
function punch_turret_target(number px, number py, number pdx, number pdy)
    number best=-1, bfw=0, i=0
    loop i<turret_max
        if turret_alive(i)==1
            number hx=arr_get(turret_x,i)-px, hy=arr_get(turret_y,i)-py
            number tf=hx*pdx+hy*pdy, ts=hy*pdx-hx*pdy
            number th=punch_width/2+turret_hit_r
            if tf>=0&&tf<=punch_reach+turret_hit_r&&ts*ts<=th*th
                if best==-1||tf<bfw
                    best=i+1
                    bfw=tf
                end
            end
        end
        i=i+1
    end
    return best
end

// Дистанция от точки до отрезка [sx,sy]→[sx+dx*len,sy+dy*len] (dx,dy — единичные).
function seg_dist(number sx, number sy, number dx, number dy, number len, number tx, number ty)
    number ex=sx+dx*len, ey=sy+dy*len
    number wx=tx-sx, wy=ty-sy
    number c=wx*dx+wy*dy
    if c<=0
        return sqrt(wx*wx+wy*wy)
    end
    if c>=len
        return sqrt((tx-ex)*(tx-ex)+(ty-ey)*(ty-ey))
    end
    number px=sx+dx*c, py=sy+dy*c
    return sqrt((tx-px)*(tx-px)+(ty-py)*(ty-py))
end

// Кого задевает рывок по отрезку: 0 — игрока, 1..turret_max — турель, -1 —
// никого. Турель-щит имеет приоритет, пока стоит на пути или рядом с игроком.
function dash_resolve_target(number sx, number sy, number dx, number dy)
    number len=azum_dash_speed*azum_dash_time
    number best=-1, bd=0
    number pr=player.size*0.65+14
    number d=seg_dist(sx,sy,dx,dy,len,player.x,player.y)
    if d<=pr
        best=0
        bd=d
    end
    number i=0
    loop i<turret_max
        if turret_alive(i)==1
            number r=turret_hit_r+8
            number td=seg_dist(sx,sy,dx,dy,len,arr_get(turret_x,i),arr_get(turret_y,i))
            if td<=r
                if best==-1
                    best=i+1
                    bd=td
                else if best==0
                    // турель-щит на пути рывка или рядом с игроком
                    if td<=bd+20
                        best=i+1
                        bd=td
                    end
                else if td<bd-1
                    best=i+1
                    bd=td
                end
            end
        end
        i=i+1
    end
    return best
end

// Урон по самому игроку (после всех поглощений). Скидка Азума после
// возрождения работает как раньше.
function take_damage(number dmg)
    number reduction=0
    if player_class==CLASS_AZUM&&azum_revived==1&&player_level>=1
        reduction=azum_second_life_damage_reduction
    end
    if reduction<0
        reduction=0
    end
    if reduction>0.9
        reduction=0.9
    end
    number real=dmg*(1-reduction)
    player.hp=player.hp-real
    if player.hp<0
        player.hp=0
    end
end

function heal_after_attack()
    number amount=0
    if player_class==CLASS_AZUM&&player_level>=3
        amount=azum_attack_heal
    else if player_class==CLASS_ORDINARY&&player_level>=3
        amount=ordinary_attack_heal
    end
    if amount>0
        player.hp=clamp(player.hp+amount,0,player.max_hp)
    end
end

// ── Оглушение (рывок Азума) ──────────────────────────────────────────────
// Оглушённый враг не двигается и не атакует. В отличие от заморозки Деда
// Мороза (freeze), оглушение обрывает и текущий замах/удар, и замах ульты.
function stun_enemy(number t)
    if t>enemy.stun
        enemy.stun=t
    end
    if enemy.state>=1&&enemy.state<=3
        enemy.state=0
        enemy.state_time=0
        enemy.cooldown=0.25
        enemy.think=0.15
    end
    enemy_super_windup=0
    enemy_super_kind=0
end

function stun_player(number t)
    if t>player_stun
        player_stun=t
    end
end

function try_revive()
    if player.hp>0
        return 0
    end
    if player_class!=1
        return 0
    end
    if azum_revived==1
        return 0
    end
    azum_revived=1
    player.hp=player.max_hp
    revive_prot=1.2
    number k=0
    loop k<50
        number rx=70+rand()%(screen_w-140), ry=70+rand()%(screen_h-140)
        if dist(rx,ry,enemy.x,enemy.y)>200
            k=50
            player.x=rx
            player.y=ry
        else
            k=k+1
        end
    end
    // Каждое возрождение за Азума копит достижение «Легенды не умирают...».
    // Счётчик живёт в achievements.dat (второе число), поэтому переживает
    // перезаход и не зависит от прогресса-файла.
    azum_revive_count=azum_revive_count+1
    net_save_azum_revives(azum_revive_count)
    ds_log("azum revived (%g/%g)",azum_revive_count,ACH_LEGENDS_NEED)
    if azum_revive_count>=ACH_LEGENDS_NEED
        grant_achievement(ACH_LEGENDS)
        // Скин «Зомби» при этом не надеваем автоматически: достижение только
        // открывает его в меню скинов, а выбирает игрок сам. Раньше скин
        // включался прямо посреди боя в момент смерти, и казалось, что Азум
        // «умирает сразу же» — на деле его только что убило то же самое
        // попадание, а защита от возрождения в онлайне проскакивала.
    end
    return 1
end

function tick_revive()
    if revive_prot>0
        revive_prot=revive_prot-dt
        if revive_prot<0
            revive_prot=0
        end
    end
end

// Алерт победы/поражения нельзя закрыть в первые alert_hold секунд: таймер
// finish_t тикает, пока бой закончен, и разблокирует тап «на выход».
function tick_alert_hold()
    if finished!=0&&finish_t<alert_hold
        finish_t=finish_t+dt
        if finish_t>alert_hold
            finish_t=alert_hold
        end
    end
end
