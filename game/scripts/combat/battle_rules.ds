-- The swing sprite must load: tex() draws nothing for a missing texture, which
-- made a fighter disappear while punching. The fallback is the ordinary sprite
-- of the same class, which is always there.
public function punch_tex_or_idle(string punch_tex, number ok, number cls)
    if ok==1 then
        return punch_tex
    end
    return class_idle_tex(cls)
end
-- The Azum idle and swing load as a pair or not at all, like the zombie pair
-- below. They used to fall back one by one: when only azum.png missed its load
-- (a second start of the game on a budget phone), the idle became the black
-- ordinary cube while azum_punch.png had landed, so the fighter looked ordinary
-- and turned blue Azum on every punch. A broken pair shows the whole ordinary
-- pair until reload_textures (engine.ds) brings the missing half back.
public function azum_tex_pair_ok()
    if azum_tex_ok==1&&azum_punch_tex_ok==1 then
        return 1
    end
    return 0
end
public function azum_idle_tex()
    if azum_tex_pair_ok()==1 then
        return AZUM_TEX
    end
    return ORDINARY_TEX
end
public function azum_punch_tex()
    if azum_tex_pair_ok()==1 then
        return AZUM_PUNCH_TEX
    end
    return punch_tex_or_idle(PUNCH_TEX,ordinary_punch_tex_ok,CLASS_ORDINARY)
end
public function zombie_tex_ok()
    if azum_zombie_tex_ok==1&&azum_zombie_punch_tex_ok==1 then
        return 1
    end
    return 0
end
-- The zombie pair loads as a pair or not at all: one missing half must not mix
-- the brain sprites with the class cubes (the idle from one creature and the
-- swing from another, which looked like a zombie-azum popping up on a hit).
public function zombie_idle_tex()
    if zombie_tex_ok()==1 then
        return AZUM_ZOMBIE_TEX
    end
    return azum_idle_tex()
end
public function zombie_punch_tex()
    if zombie_tex_ok()==1 then
        return AZUM_ZOMBIE_PUNCH_TEX
    end
    return azum_punch_tex()
end
-- The elf skin of ebuC loads as a pair too, for the same reason as the zombie
-- pair: a half-loaded skin would mix the elf idle with the plain ebuC swing.
public function elf_tex_ok()
    if ebuc_elf_tex_ok==1&&ebuc_elf_punch_tex_ok==1 then
        return 1
    end
    return 0
end
public function elf_idle_tex()
    if elf_tex_ok()==1 then
        return EBUC_ELF_TEX
    end
    return EBUC_TEX
end
public function elf_punch_tex()
    if elf_tex_ok()==1 then
        return EBUC_ELF_PUNCH_TEX
    end
    return punch_tex_or_idle(EBUC_PUNCH_TEX,ebuc_punch_tex_ok,CLASS_EBUC)
end
-- The idle sprite a class shows with the given skin, used by the menu cards.
public function skin_idle_tex_for(number cls, number skin)
    if skin_is_active(cls,skin)==1 then
        if cls==CLASS_EBUC then
            return elf_idle_tex()
        end
        return zombie_idle_tex()
    end
    return class_idle_tex(cls)
end
public function class_idle_tex(number cls)
    if cls==CLASS_AZUM then
        return azum_idle_tex()
    end
    if cls==CLASS_SANTA then
        return SANTA_TEX
    end
    if cls==CLASS_EBUC then
        return EBUC_TEX
    end
    return ORDINARY_TEX
end
public function class_punch_tex(number cls)
    if cls==CLASS_AZUM then
        return azum_punch_tex()
    end
    if cls==CLASS_SANTA then
        return punch_tex_or_idle(SANTA_PUNCH_TEX,santa_punch_tex_ok,cls)
    end
    if cls==CLASS_EBUC then
        return punch_tex_or_idle(EBUC_PUNCH_TEX,ebuc_punch_tex_ok,cls)
    end
    return punch_tex_or_idle(PUNCH_TEX,ordinary_punch_tex_ok,cls)
end
public function class_punch_damage_for(number cls, number lv)
    if cls==CLASS_SANTA then
        return santa_damage
    end
    if cls==CLASS_EBUC then
        return ebuc_damage
    end
    if cls==CLASS_ORDINARY&&lv>=1 then
        return punch_damage*(1+ordinary_damage_bonus)
    end
    return punch_damage
end
public function player_max_hp_for(number cls)
    if cls==CLASS_EBUC then
        return ebuc_hp
    end
    if cls==CLASS_AZUM then
        return azum_hp
    end
    return 10
end
public function ebuc_station_hp_for(number lv)
    local number h=ebuc_station_hp
    if lv>=1 then
        h=h+ebuc_station_hp_bonus*2
    end
    return h
end
public function ebuc_universe_damage_for(number lv)
    local number d=ebuc_universe_damage
    if lv>=3 then
        d=d+ebuc_universe_damage_bonus
    end
    return d
end
public function class_punch_damage(number cls)
    return class_punch_damage_for(cls,player_level)
end
public function santa_poison_time_for(number lv)
    return santa_poison_time
end
public function santa_poison_damage_for(number lv)
    local number d=santa_poison_dps
    if lv>=1 then
        d=d+santa_poison_damage_bonus
    end
    if lv>=2 then
        d=d+santa_poison_damage_bonus
    end
    return d
end
public function santa_freeze_time_for(number lv)
    local number t=super_freeze
    if lv>=3 then
        t=t+santa_freeze_time_bonus
    end
    return t
end
