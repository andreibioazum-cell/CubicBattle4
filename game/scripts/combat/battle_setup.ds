function reset_battle()
    player.x=screen_w/2
    player.y=screen_h/2
    player.angle=0
    player.max_hp=player_max_hp_for(player_class)
    player.hp=player.max_hp
    player.size=25*player_scale
    enemy.size=25*enemy_scale
    // Здоровье врага всегда сбрасывается к стандартному перед каждым боем.
    enemy.max_hp=enemy_base_hp
    enemy.hp=enemy.max_hp
    enemy.state=0
    enemy.state_time=0
    enemy.spawn_t=0
    enemy.cooldown=enemy_first_delay
    enemy.hit=0
    enemy.dodge_cd=0
    enemy.think=0.2
    enemy.mvx=0
    enemy.mvy=0
    enemy.svx=0
    enemy.svy=0
    enemy.freeze=0
    enemy.freeze_slow=1
    enemy.poison=0
    enemy.poison_tick=0
    enemy.poison_damage=0
    enemy.wobble=0
    enemy.wobble_t=0
    enemy.react=0
    enemy.speed_var=1
    enemy.aim_err=0
    enemy.hesit=0
    enemy.feint=0
    finished=0
    finish_t=0
    punch.active=0
    punch.hit=0
    punch_left=0
    punch_cd=0
    aim_id=-1
    aim_a=0
    santa_follow=0
    azum_revived=0
    revive_prot=0
    cups_awarded=0
    match_seen_foe=0
    foes_seen_t=0
    gift.active=0
    gift.t=0
    gift.shot=0
    super_cd=0
    queued_punch=0
    queued_super=0
    super_id=-1
    boom_t=0
    boom_x=0
    boom_y=0
    freeze_a=0
    super_windup=0
    station.active=0
    station.hp=0
    station.max_hp=0
    arr_clear(station_boom_xs)
    arr_clear(station_boom_ys)
    arr_clear(station_boom_ts)
    station_hit_t=0
    station_spawn_t=0
    station_heal_t=0
    arr_clear(ebuc_station_stack_x)
    arr_clear(ebuc_station_stack_y)
    arr_clear(ebuc_station_stack_hp)
    arr_clear(ebuc_station_stack_max)
    universe_active=0
    universe_t=0
    universe_x=0
    universe_y=0
    universe_hit=0
    universe_id=0
    universe_a=0
    player_freeze=0
    player_freeze_slow=1
    pfreeze_a=0
    player_poison=0
    player_poison_tick=0
    player_poison_damage=0
    ppoison_a=0
    poison_a=0
    joy.x=130
    joy.y=screen_h-150
    joy.r=70
    atk_x=screen_w-140
    atk_y=screen_h-150
    atk2_x=screen_w-140
    atk2_y=screen_h-310
    drop_joy()
    arr_clear(remotes)
    arr_clear(remote_punches)
    arr_clear(candy_x)
    arr_clear(candy_y)
    arr_clear(remote_snow)
    arr_clear(remote_station)
    arr_clear(remote_universe)
    number i=0
    loop i<max_players*remote_fields
        arr_push(remotes,0)
        i=i+1
    end
    i=0
    loop i<max_players*punch_fields
        arr_push(remote_punches,0)
        i=i+1
    end
    i=0
    loop i<max_players*snow_fields
        arr_push(remote_snow,0)
        i=i+1
    end
    i=0
    loop i<max_players*station_fields
        arr_push(remote_station,0)
        i=i+1
    end
    i=0
    loop i<max_players*universe_fields
        arr_push(remote_universe,0)
        i=i+1
    end
    arr_clear(dust)
    dust_cd=0
    enemy_dust_cd=0
    i=0
    loop i<dust_max*dust_fields
        arr_push(dust,0)
        i=i+1
    end
    arr_clear(remote_dust_cd)
    i=0
    loop i<max_players
        arr_push(remote_dust_cd,0)
        i=i+1
    end
end

function init_game()
    reset_battle()
    enemy.hp=enemy.max_hp
    spawn_enemy()
    spawn_all_candies()
end

function init_online()
    reset_battle()
    chat_open=0
    keyboard_hide()
    online_ready=0
    // Баннер: не показываем баннер, который висел до нашего входа в комнату.
    banner_skip=1
    banner_t=0
    // Класс, уровень и скин своего бойца — их видят соперники.
    progress_push_to_net()
    net_connect(FIREBASE,ROOM)
end

function place_online()
    number s=net_slot(), row=floor(s/2), col=s-row*2
    player.x=screen_w*(0.3+0.4*col)
    player.y=screen_h*(0.35+0.3*row)
    online_ready=1
end

function spawn_enemy()
    number margin=70, i=0
    loop i<50
        enemy.x=margin+rand()%(screen_w-140)
        enemy.y=margin+rand()%(screen_h-140)
        if dist(enemy.x,enemy.y,player.x,player.y)>300
            i=50
        else
            i=i+1
        end
    end
    enemy.state=0
    enemy.spawn_t=0
    enemy.state_time=0
    enemy.cooldown=enemy_first_delay
    enemy.hit=0
    enemy.dodge_cd=0
    enemy.think=0.3
    enemy.mvx=0
    enemy.mvy=0
    enemy.svx=0
    enemy.svy=0
    enemy.wobble=(rand()%100)/100.0*2*pi
    enemy.wobble_t=0
    enemy.react=enemy_human_react_min + (rand()%100)/100.0*(enemy_human_react_max-enemy_human_react_min)
    enemy.speed_var=0.9 + (rand()%40)/100.0
    enemy.aim_err=0
    if rand()%2==0
        enemy.strafe=-1
    else
        enemy.strafe=1
    end
    ds_log("enemy spawned instantly")
end

function candy_rand_pos(number i)
    number m=candy_margin, k=0
    number cx=m+rand()%(int)(screen_w-2*m), cy=m+rand()%(int)(screen_h-2*m)
    loop k<24
        if dist(cx,cy,player.x,player.y)<80||dist(cx,cy,enemy.x,enemy.y)<80
            cx=m+rand()%(int)(screen_w-2*m)
            cy=m+rand()%(int)(screen_h-2*m)
            k=k+1
        else
            k=24
        end
    end
    arr_set(candy_x,i,cx)
    arr_set(candy_y,i,cy)
end

function spawn_all_candies()
    number i=0
    loop i<candy_count
        candy_rand_pos(i)
        i=i+1
    end
end

function sprite_a(number a)
    return a+pi/2
end
