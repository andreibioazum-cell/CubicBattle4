include graphics
number last_turret_slot=0
function turret_alive(number i)
    if arr_get(turret_hp,i)>0
        return 1
    end
    return 0
end
function turret_count_alive()
    number n=0, i=0
    loop i<turret_max
        if turret_alive(i)==1
            n=n+1
        end
        i=i+1
    end
    return n
end
function push_station_boom(number x, number y)
    arr_push(station_boom_xs,x)
    arr_push(station_boom_ys,y)
    arr_push(station_boom_ts,station_boom_time)
    if arr_len(station_boom_ts)>station_booms_max
        number keep=station_booms_max
        array nx=arr_new()
        array ny=arr_new()
        array nt=arr_new()
        number i=arr_len(station_boom_ts)-keep
        loop i<arr_len(station_boom_ts)
            arr_push(nx,arr_get(station_boom_xs,i))
            arr_push(ny,arr_get(station_boom_ys,i))
            arr_push(nt,arr_get(station_boom_ts,i))
            i=i+1
        end
        station_boom_xs=nx
        station_boom_ys=ny
        station_boom_ts=nt
    end
end
function destroy_turret(number i)
    if i<0||i>=turret_max
        return
    end
    if turret_alive(i)==0
        return
    end
    push_station_boom(arr_get(turret_x,i),arr_get(turret_y,i))
    arr_set(turret_hp,i,0)
    arr_set(turret_maxhp,i,0)
    arr_set(turret_spawn_t,i,0)
end
function damage_turret(number i, number dmg)
    if i<0||i>=turret_max
        return
    end
    if turret_alive(i)==0
        return
    end
    number h=arr_get(turret_hp,i)-dmg
    if h<=0
        push_station_boom(arr_get(turret_x,i),arr_get(turret_y,i))
        arr_set(turret_hp,i,0)
        arr_set(turret_maxhp,i,0)
        arr_set(turret_spawn_t,i,0)
        return
    end
    arr_set(turret_hp,i,h)
end
function place_turret()
    number slot=-1, i=0
    loop i<turret_max
        if turret_alive(i)==0
            slot=i
            i=turret_max
        end
        i=i+1
    end
    if slot<0
        i=0
        loop i<turret_max
            if turret_alive(i)==1
                slot=i
                i=turret_max
            end
            i=i+1
        end
        if slot<0
            return
        end
        destroy_turret(slot)
    end
    arr_set(turret_x,slot,player.x)
    arr_set(turret_y,slot,player.y)
    number mh=ebuc_station_hp_for(player_level)
    arr_set(turret_maxhp,slot,mh)
    arr_set(turret_hp,slot,mh)
    arr_set(turret_spawn_t,slot,station_spawn_time)
    last_turret_slot=slot
    if player_level>=2
        player.hp=clamp(player.hp+ebuc_place_heal,0,player.max_hp)
    end
end
function tick_station_boom()
    number i=0
    loop i<arr_len(station_boom_ts)
        number t=arr_get(station_boom_ts,i)
        if t>0
            t=t-dt
            if t<0
                t=0
            end
            arr_set(station_boom_ts,i,t)
        end
        i=i+1
    end
end
function tick_turrets()
    tick_station_boom()
    number i=0
    loop i<turret_max
        if arr_get(turret_spawn_t,i)>0
            number t=arr_get(turret_spawn_t,i)-dt
            if t<0
                t=0
            end
            arr_set(turret_spawn_t,i,t)
        end
        i=i+1
    end
    if player_class==CLASS_EBUC&&player_level>=3&&turret_count_alive()>0&&finished==0&&player.hp>0
        turret_heal_t=turret_heal_t+dt
        if turret_heal_t>=1
            turret_heal_t=turret_heal_t-1
            player.hp=clamp(player.hp+ebuc_beam_heal,0,player.max_hp)
        end
    else
        turret_heal_t=0
    end
end
