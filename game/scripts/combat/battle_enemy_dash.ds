include graphics

// ══════════════════════════════════════════════════════════════════════════
// battle_enemy_dash.ds — рывок врага-Азума и рывок игрока в соло
//
// Старт рывка бота, его полёт и проверка попадания по игроку и турелям;
// рядом — рывок самого игрока против бота (tick_dash_solo_hit). Радиусы
// зоны берутся из combat/battle_hitscan.ds, поэтому рисунок совпадает.
//
// ══════════════════════════════════════════════════════════════════════════

// ── Рывок врага (Азум) ────────────────────────────────────────────────────
function enemy_start_dash()
    number a=atan2(player.y-enemy.y,player.x-enemy.x)
    enemy_dash_dx=cos(a)
    enemy_dash_dy=sin(a)
    enemy_dash_x0=enemy.x
    enemy_dash_y0=enemy.y
    enemy_dash_active=1
    enemy_dash_t=azum_dash_time
    enemy_dash_hit=0
    enemy_dash_cd=enemy_dash_cd_time
    enemy.angle=a
    ds_log("enemy dash started")
end

function tick_enemy_dash()
    if enemy_dash_cd>0
        enemy_dash_cd=enemy_dash_cd-dt
        if enemy_dash_cd<0
            enemy_dash_cd=0
        end
    end
    if enemy_dash_active==0
        return
    end
    enemy_dash_t=enemy_dash_t-dt
    if enemy_dash_t<=0
        enemy_dash_t=0
        enemy_dash_active=0
        enemy_dash_hit=0
        return
    end
    if finished!=0
        enemy_dash_active=0
        return
    end
    // Оглушённый враг замирает: таймер идёт, движения нет (как у игрока).
    if enemy.stun>0
        return
    end
    enemy.x=enemy.x+enemy_dash_dx*azum_dash_speed*dt
    enemy.y=enemy.y+enemy_dash_dy*azum_dash_speed*dt
    if enemy.x<enemy.size
        enemy.x=enemy.size
        enemy_dash_active=0
        enemy_dash_t=0
        return
    end
    if enemy.x>screen_w-enemy.size
        enemy.x=screen_w-enemy.size
        enemy_dash_active=0
        enemy_dash_t=0
        return
    end
    if enemy.y<enemy.size
        enemy.y=enemy.size
        enemy_dash_active=0
        enemy_dash_t=0
        return
    end
    if enemy.y>screen_h-enemy.size
        enemy.y=screen_h-enemy.size
        enemy_dash_active=0
        enemy_dash_t=0
        return
    end
    tick_enemy_dust(enemy_dash_dx*azum_dash_speed,enemy_dash_dy*azum_dash_speed)
    if enemy_dash_hit==1
        return
    end
    // Рывок бьёт по текущей позиции (как рывок игрока в соло): сначала щит
    // из турелей, потом сам игрок. Бьёт в момент пролёта, а не на старте.
    number dti=0
    loop dti<turret_max
        if enemy_dash_hit==0&&turret_alive(dti)==1
            // Контакт с квадратом турели: по обеим осям сразу.
            number pad=enemy.size*0.65+turret_zone_half()+14
            if fabs(enemy.x-arr_get(turret_x,dti))<=pad&&fabs(enemy.y-arr_get(turret_y,dti))<=pad
                enemy_dash_hit=1
                damage_turret(dti,enemy_dash_damage)
                // Турель-щит мстит за рывок, как за удар.
                enemy_apply_damage(turret_counter_damage)
            end
        end
        dti=dti+1
    end
    if enemy_dash_hit==1||finished!=0
        return
    end
    if revive_prot>0
        return
    end
    number dpr=dash_hit_radius_solo()
    if dist(enemy.x,enemy.y,player.x,player.y)<=dpr
        enemy_dash_hit=1
        take_damage(enemy_dash_damage)
        stun_player(azum_dash_stun)
        ds_log("enemy dash hit player")
        if player.hp<=0
            player.hp=0
            if try_revive()==0
                finish_game(2)
            end
        end
    end
end

// Рывок игрока: бьёт врага и его турели-щиты (сначала щит, потом враг).
function tick_dash_solo_hit()
    if dash_active==0||dash_hit==1||finished!=0
        return
    end
    number ti=0
    loop ti<turret_max
        if dash_hit==0&&enemy_turret_alive(ti)==1
            // Контакт с квадратом турели-щита: по обеим осям сразу.
            number pad=player.size*0.65+turret_zone_half()+14
            if fabs(player.x-arr_get(enemy_turret_x,ti))<=pad&&fabs(player.y-arr_get(enemy_turret_y,ti))<=pad
                dash_hit=1
                enemy_damage_turret(ti,azum_dash_damage)
                if revive_prot<=0
                    take_damage(turret_counter_damage)
                    ds_log("dash hit enemy turret")
                    if player.hp<=0
                        player.hp=0
                        if try_revive()==0
                            finish_game(2)
                        end
                    end
                end
            end
        end
        ti=ti+1
    end
    if dash_hit==1||finished!=0
        return
    end
    if enemy_revive_prot>0
        return
    end
    number pr=dash_hit_radius_solo()
    if dist(player.x,player.y,enemy.x,enemy.y)<=pr
        dash_hit=1
        stun_enemy(azum_dash_stun)
        ds_log("dash hit enemy, hp %g",enemy.hp)
        enemy_apply_damage(azum_dash_damage)
    end
end

// ── Общий тик врага-класса: вызывается из update_game ─────────────────────
function tick_enemy_class()
    if game_state!=ST_SOLO
        return
    end
    if enemy_super_cd>0
        enemy_super_cd=enemy_super_cd-dt
        if enemy_super_cd<0
            enemy_super_cd=0
        end
    end
    if enemy_revive_prot>0
        enemy_revive_prot=enemy_revive_prot-dt
        if enemy_revive_prot<0
            enemy_revive_prot=0
        end
    end
    enemy_tick_turrets()
    tick_enemy_gift()
    tick_enemy_dash()
end

// ── Решения: когда враг жмёт ульту ────────────────────────────────────────
// Вызывается из update_enemy после оглушения. Возвращает 1, если враг занят
// (рывок летит или идёт замах): обычному ИИ в этом кадре делать нечего.
function enemy_tick_class_abilities()
    if game_state!=ST_SOLO
        return 0
    end
    if finished!=0
        return 0
    end
    if enemy_dash_active==1
        return 1
    end
    if enemy_super_windup>0
        enemy_face_player()
        enemy_super_windup=enemy_super_windup-dt
        if enemy_super_windup<=0
            enemy_super_windup=0
            if enemy_super_kind==1
                enemy_start_snow()
            else if enemy_super_kind==2
                enemy_place_turret()
            end
            enemy_super_kind=0
        end
        return 1
    end
    // Ульта только в спокойных состояниях: не в замахе/ударе и не в увороте.
    if enemy.state==1||enemy.state==2||enemy.state==4
        return 0
    end
    number d=dist(enemy.x,enemy.y,player.x,player.y)
    if enemy_class==CLASS_SANTA
        if enemy_super_cd<=0&&d<=enemy_santa_range
            enemy_super_kind=1
            enemy_super_windup=enemy_super_windup_time
            enemy_super_cd=enemy_santa_cd_time
            enemy.state=0
            enemy.state_time=0
            return 1
        end
    else if enemy_class==CLASS_EBUC
        if enemy_super_cd<=0&&enemy_turret_count_alive()<turret_max
            enemy_super_kind=2
            enemy_super_windup=enemy_super_windup_time
            enemy_super_cd=enemy_station_cd_time
            enemy.state=0
            enemy.state_time=0
            return 1
        end
    else if enemy_class==CLASS_AZUM
        if enemy_dash_cd<=0&&d>=enemy_dash_min_range&&d<=enemy_dash_max_range
            enemy.state=0
            enemy.state_time=0
            enemy_start_dash()
            return 1
        end
    end
    return 0
end
