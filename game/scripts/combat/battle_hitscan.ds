-- Target resolution of punches and dashes against our fighter and our turrets.
-- Every test is the exact overlap of the drawn zone with the body
-- (combat/hit_geometry.ds): the punch strip of draw_punch_box and the dash
-- strip of draw_hit_dash_path.
public function turret_zone_half()
    return turret_half()
end
-- A punch from (px, py) along (pdx, pdy) with the given reach and width:
-- 0 is our fighter, i+1 turret i, -1 nothing. When the strip touches both, the
-- turret standing in front (along the punch) takes it, as before.
public function punch_resolve_target(number px, number py, number pdx, number pdy, number reach, number width)
    local number best=-1, bfw=0, i=0
    if punch_hits_player(px,py,pdx,pdy,reach,width)==1 then
        best=0
        bfw=along(px,py,pdx,pdy,player.x,player.y)
    end
    while i<turret_max do
        if turret_alive(i)==1 then
            local number hx=arr_get(turret_x,i), hy=arr_get(turret_y,i)
            if punch_hits_turret(px,py,pdx,pdy,reach,width,hx,hy)==1 then
                local number tf=along(px,py,pdx,pdy,hx,hy)
                if best==-1 then
                    best=i+1
                    bfw=tf
                else if best==0 then
                    if tf<=bfw+30 then
                        best=i+1
                        bfw=tf
                    end
                else if tf<bfw-1 then
                    best=i+1
                    bfw=tf
                end
            end
        end
        i=i+1
    end
    return best
end
-- The dash zone is the strip the dasher's cube sweeps: as wide as his body.
public function dash_hit_radius_solo()
    return player_half()
end
public function dash_hit_radius_remote()
    return player_half()
end
-- A remote dash: the strip over the travelled leg (sx, sy) + (dx, dy) * [0, len].
public function dash_resolve_target(number sx, number sy, number dx, number dy, number len)
    local number best=-1, bd=0
    local number pr=dash_hit_radius_remote()
    if strip_hits_player(sx,sy,dx,dy,0,len,pr)==1 then
        best=0
        bd=along(sx,sy,dx,dy,player.x,player.y)
    end
    local number i=0
    while i<turret_max do
        if turret_alive(i)==1 then
            local number hx=arr_get(turret_x,i), hy=arr_get(turret_y,i)
            if strip_hits_turret(sx,sy,dx,dy,0,len,pr,hx,hy)==1 then
                local number td=along(sx,sy,dx,dy,hx,hy)
                if best==-1 then
                    best=i+1
                    bd=td
                else if best==0 then
                    if td<=bd+20 then
                        best=i+1
                        bd=td
                    end
                else if td<bd-1 then
                    best=i+1
                    bd=td
                end
            end
        end
        i=i+1
    end
    return best
end
