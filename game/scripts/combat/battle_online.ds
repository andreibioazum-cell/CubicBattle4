// Гасим только флаг и таймер удара: геометрию (x, y, dx, dy) оставляем, чтобы
// хитбокс удара соперника плавно догасал на своём месте (rpunch_a), а не
// уезжал в угол экрана на последнем кадре.
function clear_remote_punch(number s)
    number rb=s*punch_fields
    arr_set(remote_punches,rb,0)
    arr_set(remote_punches,rb+5,0)
end

function start_remote_punch(number s)
    number rb=s*punch_fields
    arr_set(remote_punches,rb,1)
    arr_set(remote_punches,rb+1,net_player_punch_x(s)*screen_w)
    arr_set(remote_punches,rb+2,net_player_punch_y(s)*screen_h)
    arr_set(remote_punches,rb+3,net_player_punch_dx(s))
    arr_set(remote_punches,rb+4,net_player_punch_dy(s))
    arr_set(remote_punches,rb+5,0)
end

function read_remotes()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*remote_fields
        if net_player_online(s)==1&&s!=net_slot()
            number x=net_player_x(s)*screen_w, y=net_player_y(s)*screen_h, a=net_player_angle(s)
            if arr_get(remotes,b)==0
                arr_set(remotes,b,1)
                arr_set(remotes,b+1,x)
                arr_set(remotes,b+2,y)
                arr_set(remotes,b+3,a)
                arr_set(remotes,b+7,x)
                arr_set(remotes,b+8,y)
                arr_set(remotes,b+9,a)
            else
                arr_set(remotes,b+7,x)
                arr_set(remotes,b+8,y)
                arr_set(remotes,b+9,a)
            end
            arr_set(remotes,b+4,net_player_hp(s))
            arr_set(remotes,b+5,net_player_alive(s))
            arr_set(remotes,b+10,net_player_class(s))
            number net_p=net_player_punch(s), prev_p=arr_get(remotes,b+6)
            if net_p!=prev_p
                arr_set(remotes,b+6,net_p)
                start_remote_punch(s)
            end
        else
            arr_set(remotes,b,0)
            arr_set(remotes,b+5,0)
            clear_remote_punch(s)
        end
        s=s+1
    end
end

function update_remote_punches()
    number s=0
    loop s<max_players
        number rb=s*punch_fields
        if arr_get(remote_punches,rb)==1
            number t=arr_get(remote_punches,rb+5)+dt
            arr_set(remote_punches,rb+5,t)
            if arr_get(remotes,s*remote_fields+5)==0
                clear_remote_punch(s)
            else
                // Удар соперника бьёт игрока (по центру, как раньше) или
                // живую турель бука — с проверкой на радиус турели. Если удар
                // приняла турель, её HP убывает и виден взрыв при разрушении.
                number target=punch_resolve_target(arr_get(remote_punches,rb+1),arr_get(remote_punches,rb+2),arr_get(remote_punches,rb+3),arr_get(remote_punches,rb+4),0)
                if target==0||(target>=1&&target<=turret_max)
                    number rcls=arr_get(remotes,s*remote_fields+10), rlevel=net_player_level(s)
                    if target==0
                        // Как и в соло: в защите после возрождения удар
                        // проскакивает насквозь — Азум не умирает снова в ту
                        // же секунду, особенно в момент достижения легенды.
                        if revive_prot<=0
                            take_damage(class_punch_damage_for(rcls,rlevel))
                            if rcls==CLASS_SANTA
                                if player_poison<=0
                                    player_poison_tick=santa_poison_tick_interval
                                end
                                player_poison=santa_poison_time_for(rlevel)
                                player_poison_damage=santa_poison_damage_for(rlevel)
                            end
                        end
                    else
                        damage_turret(target-1,class_punch_damage_for(rcls,rlevel))
                        // Турель-щит мстит: публикуем событие «турель
                        // получила удар» — бивший клиент сам у себя
                        // списывает небольшой урон (update_remote_thuds).
                        thud_seq=thud_seq+1
                        net_publish_thud(thud_seq)
                        ds_log("remote punch hit turret %g, hp %g",target-1,arr_get(turret_hp,target-1))
                    end
                    clear_remote_punch(s)
                    if player.hp<=0
                        player.hp=0
                        if try_revive()==0
                            finish_game(2)
                            return
                        end
                    end
                else if t>punch_time
                    clear_remote_punch(s)
                end
            end
        end
        s=s+1
    end
end

// Контрудары чужих турелей: соперник-бук публикует новый счётчик thud, когда
// по его турели попал наш удар, — и мы у себя списываем небольшой урон.
// Счётчик меняется один раз на событие (как punch/dash), поэтому урон не
// дублируется. В защите после возрождения контрудар не бьёт.
function update_remote_thuds()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        if s==net_slot()||net_player_online(s)!=1
            arr_set(remote_thuds,s,0)
        else
            number gen=net_player_thud(s)
            number prev=arr_get(remote_thuds,s)
            if gen!=prev
                arr_set(remote_thuds,s,gen)
                if gen>0&&revive_prot<=0&&finished==0
                    take_damage(turret_counter_damage)
                    ds_log("turret thud from %g, hp %g",s,player.hp)
                    if player.hp<=0
                        player.hp=0
                        if try_revive()==0
                            finish_game(2)
                        end
                    end
                end
            end
        end
        s=s+1
    end
end

// Чужие снежинки: летят по снимку, взрываются заморозкой без урона.
function update_remote_snow()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*snow_fields
        if s==net_slot()||net_player_online(s)!=1
            arr_set(remote_snow,b+1,0)
            arr_set(remote_snow,b+5,0)
        else
            number cnt=net_player_snow(s)
            number prev=arr_get(remote_snow,b)
            if cnt!=prev&&cnt>0
                arr_set(remote_snow,b,cnt)
                arr_set(remote_snow,b+1,1)
                arr_set(remote_snow,b+2,0)
                arr_set(remote_snow,b+3,net_player_snow_x(s)*screen_w)
                arr_set(remote_snow,b+4,net_player_snow_y(s)*screen_h)
            end
            if arr_get(remote_snow,b+1)==1
                number t=arr_get(remote_snow,b+2)+dt
                number x=arr_get(remote_snow,b+3)+net_player_snow_dx(s)*super_speed*dt
                number y=arr_get(remote_snow,b+4)+net_player_snow_dy(s)*super_speed*dt
                arr_set(remote_snow,b+2,t)
                arr_set(remote_snow,b+3,x)
                arr_set(remote_snow,b+4,y)
                number hit=0
                if dist(x,y,player.x,player.y)<player.size*0.65+24
                    hit=1
                end
                if t>super_range/super_speed
                    hit=1
                end
                if hit==1
                    arr_set(remote_snow,b+1,0)
                    arr_set(remote_snow,b+5,boom_time)
                    arr_set(remote_snow,b+6,x)
                    arr_set(remote_snow,b+7,y)
                    if dist(x,y,player.x,player.y)<=super_radius
                        number rcls=arr_get(remotes,s*remote_fields+10), rlevel=net_player_level(s), freeze_time=super_freeze
                        if rcls==CLASS_SANTA
                            freeze_time=santa_freeze_time_for(rlevel)
                        end
                        if player_freeze<freeze_time
                            player_freeze=freeze_time
                            player_freeze_slow=super_freeze_slow
                        end
                    end
                end
            end
            if arr_get(remote_snow,b+5)>0
                number bt=arr_get(remote_snow,b+5)-dt
                if bt<0
                    bt=0
                end
                arr_set(remote_snow,b+5,bt)
            end
        end
        s=s+1
    end
end

function smooth_remotes()
    number s=0
    loop s<max_players
        number b=s*remote_fields
        if arr_get(remotes,b+5)==1
            number rx=arr_get(remotes,b+1), ry=arr_get(remotes,b+2), ra=arr_get(remotes,b+3)
            number nx=arr_get(remotes,b+7), ny=arr_get(remotes,b+8), na=arr_get(remotes,b+9)
            if dist(rx,ry,nx,ny)>remote_snap
                rx=nx
                ry=ny
                ra=na
            else
                rx=lerp(rx,nx,clamp(dt*remote_smooth,0,1))
                ry=lerp(ry,ny,clamp(dt*remote_smooth,0,1))
                number da=na-ra
                if da>pi
                    da=da-2*pi
                end
                if da<0-pi
                    da=da+2*pi
                end
                ra=ra+da*clamp(dt*remote_smooth,0,1)
                // Соперник в онлайне тоже тянет за собой след пыли.
                tick_remote_dust(s,rx,ry,nx,ny)
            end
            arr_set(remotes,b+1,rx)
            arr_set(remotes,b+2,ry)
            arr_set(remotes,b+3,ra)
        end
        s=s+1
    end
end

function count_living_remotes()
    number count=0, s=0
    loop s<max_players
        if s!=net_slot()&&arr_get(remotes,s*remote_fields+5)==1
            count=count+1
        end
        s=s+1
    end
    return count
end

function check_online_finish()
    if online_ready==0||finished!=0
        return
    end
    number enemies_alive=count_living_remotes()
    if enemies_alive>0
        // Дебаунс: соперник должен реально побыть в комнате (секунду), прежде
        // чем его исчезновение станет победой. Один «фантомный» сетевой снимок
        // (например, гонка с удалением чужого слота) победу засчитать не может.
        foes_seen_t=foes_seen_t+dt
        if foes_seen_t>foes_seen_min
            match_seen_foe=1
        end
    end
    if match_seen_foe==1&&enemies_alive==0
        finish_game(1)
    end
end

function push_self()
    if net_slot()<0
        return
    end
    number alive=1
    if player.hp<=0
        alive=0
    end
    progress_push_to_net()
    net_publish(player.x/screen_w,player.y/screen_h,player.angle,player.hp,alive)
    net_publish_punch(punch.x/screen_w,punch.y/screen_h,punch.dx,punch.dy,punch.shot)
    if player_class==CLASS_EBUC
        // Все живые турели, каждая со своим HP: у соперников полоса здоровья
        // всегда свежая (публикуется при каждом изменении).
        number x1=0, y1=0, h1=0, x2=0, y2=0, h2=0, x3=0, y3=0, h3=0
        if turret_alive(0)==1
            x1=arr_get(turret_x,0)/screen_w
            y1=arr_get(turret_y,0)/screen_h
            h1=arr_get(turret_hp,0)
        end
        if turret_alive(1)==1
            x2=arr_get(turret_x,1)/screen_w
            y2=arr_get(turret_y,1)/screen_h
            h2=arr_get(turret_hp,1)
        end
        if turret_alive(2)==1
            x3=arr_get(turret_x,2)/screen_w
            y3=arr_get(turret_y,2)/screen_h
            h3=arr_get(turret_hp,2)
        end
        net_publish_turrets(x1,y1,h1,x2,y2,h2,x3,y3,h3,turret_count_alive())
        if universe_active==1
            net_publish_universe(universe_x/screen_w,universe_y/screen_h,universe_id)
        else
            net_publish_universe(0,0,0)
        end
    end
    // Рывок Азума: старт публикуем один раз (нужна точная стартовая позиция
    // и направление), когда рывок закончился — гасим счётчик.
    if player_class==CLASS_AZUM
        if dash_active==1&&dash_pub==0
            net_publish_dash(dash_x0/screen_w,dash_y0/screen_h,dash_dx,dash_dy,dash_seq)
            dash_pub=1
        else if dash_active==0&&dash_pub==1
            net_publish_dash(0,0,0,0,0)
            dash_pub=0
        end
    end
end

function update_online()
    // Бан мог прилететь уже во время боя: сразу выкидываем в меню с сообщением.
    if net_banned() == 1
        banned_msg = tr_banned()
        start_transition(0)
        return
    end
    tick_alert_hold()
    update_banner()
    tick_revive()
    tick_freeze()
    tick_player_stun()
    tick_player_poison()
    tick_turrets()
    tick_universe()
    tick_hitbox_fades()
    tick_status_fades()
    update_aim()
    if finished!=0
        return
    end
    if player.hp<=0
        if try_revive()==0
            finish_game(2)
            return
        end
    end
    move_player()
    tick_dash()
    if punch_left>0
        punch_left=punch_left-dt
        if punch_left<0
            punch_left=0
        end
    end
    follow_punch()
    if super_cd>0
        super_cd=super_cd-dt
        if super_cd<0
            super_cd=0
        end
    end
    if boom_t>0
        boom_t=boom_t-dt
        if boom_t<0
            boom_t=0
        end
    end
    tick_super_windup()
    tick_santa_follow()
    update_dust()
    update_gift()
    flush_queued_action()
    if finished!=0
        return
    end
    // Мир синхронизируем, пока у нас есть слот в комнате, а не только пока
    // net_status()==NET_PLAYING: статус NET_ERROR ставит поток-писатель при
    // временном сбое PUT (плохая сеть), но поток-читатель в это время продолжает
    // тянуть позиции и чат. Раньше весь обмен миром замирал при любой ошибке
    // записи: чат обновлялся, а персонажи стояли («чат прогрузился, никто не
    // двигается, висит переподключение»).
    if net_slot()>=0
        if online_ready==0
            place_online()
        end
        read_remotes()
        smooth_remotes()
        update_remote_punches()
        update_remote_thuds()
        update_remote_snow()
        update_remote_dashes()
        update_remote_station()
        update_remote_universe()
        check_online_finish()
        push_self()
    end
    update_event()
    // Пузыри чата над бойцами: таймеры и подхват новых сообщений живут здесь,
    // поэтому сообщение видно над кубиком автора даже с закрытым чатом.
    chat_bubbles_watch()
    chat_update()
end
