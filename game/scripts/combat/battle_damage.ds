-- Damages the player: the ebuC shield and the Azum damage reduction are applied
-- here, then the red flash (player_hurt_a), the HP loss and the death handling,
-- which is either Azum's revive or a defeat. Returns 1 when the battle ends.
public function take_damage(number dmg)
    local number real=dmg
    if player_class==CLASS_EBUC then
        real=player_shield_absorb(real)
    end
    if player_class==CLASS_AZUM&&azum_revived==1&&player_level>=1 then
        real=real*(1-clamp(azum_second_life_damage_reduction,0,0.9))
    end
    if real>0 then
        player_hurt_a=1
    end
    player.hp=clamp(player.hp-real,0,player.max_hp)
    if player.hp<=0 then
        player.hp=0
        if try_revive()==0 then
            finish_game(2)
            return 1
        end
    end
    return 0
end
public function heal_after_attack()
    local number amount=0
    if player_class==CLASS_AZUM&&player_level>=3 then
        amount=azum_attack_heal
    else if player_class==CLASS_ORDINARY&&player_level>=3 then
        amount=ordinary_attack_heal
    end
    if amount>0 then
        player.hp=clamp(player.hp+amount,0,player.max_hp)
    end
end
public function stun_enemy(number t)
    if t>enemy.stun then
        enemy.stun=t
    end
    if enemy.state>=1&&enemy.state<=3 then
        enemy.state=0
        enemy.state_time=0
        enemy.cooldown=0.25
        enemy.think=0.15
    end
    enemy_super_windup=0
    enemy_super_kind=0
end
public function stun_player(number t)
    if t>player_stun then
        player_stun=t
    end
end
public function try_revive()
    if player.hp>0 then
        return 0
    end
    if player_class!=1 then
        return 0
    end
    if azum_revived==1 then
        return 0
    end
    azum_revived=1
    player.hp=player.max_hp
    revive_prot=1.2
    local number k=0
    while k<50 do
        local number rx=70+rand()%(screen_w-140), ry=70+rand()%(screen_h-140)
        if dist(rx,ry,enemy.x,enemy.y)>200 then
            k=50
            player.x=rx
            player.y=ry
        else
            k=k+1
        end
    end
    azum_revive_count=azum_revive_count+1
    net_save_azum_revives(azum_revive_count)
    ds_log("azum revived (%g/%g)",azum_revive_count,ACH_LEGENDS_NEED)
    if azum_revive_count>=ACH_LEGENDS_NEED then
        grant_achievement(ACH_LEGENDS)
    end
    return 1
end
public function tick_revive()
    if revive_prot>0 then
        revive_prot=revive_prot-dt
        if revive_prot<0 then
            revive_prot=0
        end
    end
end
-- Red damage flash: a hit sets the alpha to 1 in take_damage or
-- enemy_apply_damage, and it fades to zero here every frame.
public function tick_hurt_fades()
    player_hurt_a=fade_down_a(player_hurt_a,hurt_fade)
    enemy_hurt_a=fade_down_a(enemy_hurt_a,hurt_fade)
end
public function tick_alert_hold()
    if finished!=0&&finish_t<alert_hold then
        finish_t=finish_t+dt
        if finish_t>alert_hold then
            finish_t=alert_hold
        end
    end
end
