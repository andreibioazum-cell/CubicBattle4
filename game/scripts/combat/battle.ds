include graphics

// Упрощённый бой без праймов, с человечным врагом и админкой

// Пока azum.png не лежит в game/assets, Азум играет силуэтом обычного класса:
// невидимый боец хуже «чужого» силуэта. Как только файл появится, флаг
// включится сам (engine.ds выставляет его из png_load) и менять ничего не надо.
function azum_idle_tex()
    if azum_tex_ok==1
        return AZUM_TEX
    end
    return ORDINARY_TEX
end

function azum_punch_tex()
    if azum_tex_ok==1
        return AZUM_PUNCH_TEX
    end
    return PUNCH_TEX
end

// Есть ли у скина «Зомби» обе свои текстуры (idle и удар). Ходит по текстурам
// только тогда, когда и то, и другое загрузились: половинчатый скин, где
// удар — чужой силуэт, выглядит хуже зелёного силуэта целиком.
function zombie_tex_ok()
    if azum_zombie_tex_ok==1&&azum_zombie_punch_tex_ok==1
        return 1
    end
    return 0
end

// Спрайт скина «Зомби»: legacy-файлы из старого клиента. Если они не
// загрузились, возвращается обычная текстура Азума — её назовут зелёным
// силуэтом (zombie_tint) в draw_fighter_body.
function zombie_idle_tex()
    if azum_zombie_tex_ok==1
        return AZUM_ZOMBIE_TEX
    end
    return azum_idle_tex()
end

function zombie_punch_tex()
    if azum_zombie_punch_tex_ok==1
        return AZUM_ZOMBIE_PUNCH_TEX
    end
    return azum_punch_tex()
end

function class_idle_tex(number cls)
    if cls==CLASS_AZUM
        return azum_idle_tex()
    end
    if cls==CLASS_SANTA
        return SANTA_TEX
    end
    if cls==CLASS_EBUC
        return EBUC_TEX
    end
    return ORDINARY_TEX
end

function class_punch_tex(number cls)
    if cls==CLASS_AZUM
        return azum_punch_tex()
    end
    if cls==CLASS_SANTA
        return SANTA_PUNCH_TEX
    end
    if cls==CLASS_EBUC
        return EBUC_PUNCH_TEX
    end
    return PUNCH_TEX
end

function class_punch_damage_for(number cls, number lv)
    if cls==CLASS_SANTA
        return santa_damage
    end
    if cls==CLASS_EBUC
        return ebuc_damage
    end
    if cls==CLASS_ORDINARY&&lv>=1
        return punch_damage*(1+ordinary_damage_bonus)
    end
    return punch_damage
end

function player_max_hp_for(number cls)
    if cls==CLASS_EBUC
        return ebuc_hp
    end
    return 10
end

// Уровни бука: 1 — у турели больше HP, 2 — спавн турели лечит бука,
// 3 — луч турели лечит бука каждую секунду.
function ebuc_station_hp_for(number lv)
    number h=ebuc_station_hp
    if lv>=1
        h=h+ebuc_station_hp_bonus*2
    end
    return h
end

function ebuc_universe_damage_for(number lv)
    number d=ebuc_universe_damage
    if lv>=3
        d=d+ebuc_universe_damage_bonus
    end
    return d
end

function class_punch_damage(number cls)
    return class_punch_damage_for(cls,player_level)
end

function santa_poison_time_for(number lv)
    return santa_poison_time
end

function santa_poison_damage_for(number lv)
    number d=santa_poison_dps
    if lv>=1
        d=d+santa_poison_damage_bonus
    end
    if lv>=2
        d=d+santa_poison_damage_bonus
    end
    return d
end

function santa_freeze_time_for(number lv)
    number t=super_freeze
    if lv>=3
        t=t+santa_freeze_time_bonus
    end
    return t
end

// Каждая поломка турели ставит свой взрыв в очередь: взрыв живёт на своём
// месте и доигрывает до конца, его не перезаписывает ни постановка новой
// турели, ни поломка следующей запасной.
function push_station_boom(number x, number y)
    arr_push(station_boom_xs,x)
    arr_push(station_boom_ys,y)
    arr_push(station_boom_ts,station_boom_time)
    // Не копим больше station_booms_max взрывов: самые старые убираем.
    if arr_len(station_boom_ts)>station_booms_max
        number keep=station_booms_max
        array nx=arr_new()
        array ny=arr_new()
        array nt=arr_new()
        number i=arr_len(station_boom_ts)-keep
        loop i<arr_len(station_boom_ts)
            arr_push(nx,arr_get(station_boom_xs,i))
            arr_push(ny,arr_get(station_boom_ys,i))
            arr_push(nt,arr_get(station_boom_ts,i))
            i=i+1
        end
        station_boom_xs=nx
        station_boom_ys=ny
        station_boom_ts=nt
    end
end

function destroy_station()
    if station.active==0
        return
    end
    // Запоминаем место поломки: зелёный взрыв рисуется именно там,
    // даже если из стека тут же поднимется запасная станция.
    push_station_boom(station.x,station.y)
    station.active=0
    station.hp=0
    station.max_hp=0
    station_hit_t=0
    // Если есть запасные станции в стеке, достаём последнюю (LIFO)
    number stack_len=arr_len(ebuc_station_stack_x)
    if stack_len>0
        number last=stack_len-1
        station.x=arr_get(ebuc_station_stack_x,last)
        station.y=arr_get(ebuc_station_stack_y,last)
        station.hp=arr_get(ebuc_station_stack_hp,last)
        station.max_hp=arr_get(ebuc_station_stack_max,last)
        station.active=1
        // убираем из стека
        number new_len=last
        // truncate arrays by rebuilding? arr_clear and push back up to new_len
        // simpler: pop via reducing len – we don't have pop, so recreate
        array nx=arr_new()
        array ny=arr_new()
        array nh=arr_new()
        array nm=arr_new()
        number i=0
        loop i<new_len
            arr_push(nx,arr_get(ebuc_station_stack_x,i))
            arr_push(ny,arr_get(ebuc_station_stack_y,i))
            arr_push(nh,arr_get(ebuc_station_stack_hp,i))
            arr_push(nm,arr_get(ebuc_station_stack_max,i))
            i=i+1
        end
        ebuc_station_stack_x=nx
        ebuc_station_stack_y=ny
        ebuc_station_stack_hp=nh
        ebuc_station_stack_max=nm
        // Взрыв от сломанной турели всё равно показываем на её месте,
        // а не на месте только что поднятой запасной.
        ds_log("station restored from stack %g left",new_len)
    end
end

function place_station()
    // Стек станций: новая ставится последней и впитывает первой.
    if station.active==1
        arr_push(ebuc_station_stack_x,station.x)
        arr_push(ebuc_station_stack_y,station.y)
        arr_push(ebuc_station_stack_hp,station.hp)
        arr_push(ebuc_station_stack_max,station.max_hp)
    end
    station.x=player.x
    station.y=player.y
    station.max_hp=ebuc_station_hp_for(player_level)
    station.hp=station.max_hp
    station.active=1
    station.shot=station.shot+1
    station_hit_t=0
    // Анимация появления: спрайт чуть крупнее и быстро сжимается.
    station_spawn_t=station_spawn_time
    // Уровень 2: спавн турели лечит бука.
    if player_class==CLASS_EBUC&&player_level>=2
        player.hp=clamp(player.hp+ebuc_place_heal,0,player.max_hp)
    end
end

function tick_station_boom()
    number i=0
    loop i<arr_len(station_boom_ts)
        number t=arr_get(station_boom_ts,i)
        if t>0
            t=t-dt
            if t<0
                t=0
            end
            arr_set(station_boom_ts,i,t)
        end
        i=i+1
    end
end

function tick_station_hit()
    if station_hit_t>0
        station_hit_t=station_hit_t-dt
        if station_hit_t<0
            station_hit_t=0
        end
    end
end

function take_damage(number dmg)
    number reduction=0
    if player_class==CLASS_AZUM&&azum_revived==1&&player_level>=1
        reduction=azum_second_life_damage_reduction
    end
    if reduction<0
        reduction=0
    end
    if reduction>0.9
        reduction=0.9
    end
    number real=dmg*(1-reduction)
    // Станция бука впитывает урон, пока жива; лишний урон идёт в самого бука.
    if player_class==CLASS_EBUC&&station.active==1&&real>0
        number absorbed=real
        if absorbed>station.hp
            absorbed=station.hp
        end
        station.hp=station.hp-absorbed
        real=real-absorbed
        // эффект урона: станция сжимается
        station_hit_t=station_hit_time
        if station.hp<=0
            destroy_station()
        end
    end
    player.hp=player.hp-real
    if player.hp<0
        player.hp=0
    end
end

function heal_after_attack()
    number amount=0
    if player_class==CLASS_AZUM&&player_level>=3
        amount=azum_attack_heal
    else if player_class==CLASS_ORDINARY&&player_level>=3
        amount=ordinary_attack_heal
    end
    if amount>0
        player.hp=clamp(player.hp+amount,0,player.max_hp)
    end
end

function try_revive()
    if player.hp>0
        return 0
    end
    if player_class!=1
        return 0
    end
    if azum_revived==1
        return 0
    end
    azum_revived=1
    player.hp=player.max_hp
    revive_prot=1.2
    number k=0
    loop k<50
        number rx=70+rand()%(screen_w-140), ry=70+rand()%(screen_h-140)
        if dist(rx,ry,enemy.x,enemy.y)>200
            k=50
            player.x=rx
            player.y=ry
        else
            k=k+1
        end
    end
    ds_log("azum revived")
    return 1
end

function tick_revive()
    if revive_prot>0
        revive_prot=revive_prot-dt
        if revive_prot<0
            revive_prot=0
        end
    end
end

// Алерт победы/поражения нельзя закрыть в первые alert_hold секунд: таймер
// finish_t тикает, пока бой закончен, и разблокирует тап «на выход».
function tick_alert_hold()
    if finished!=0&&finish_t<alert_hold
        finish_t=finish_t+dt
        if finish_t>alert_hold
            finish_t=alert_hold
        end
    end
end

function reset_battle()
    player.x=screen_w/2
    player.y=screen_h/2
    player.angle=0
    player.max_hp=player_max_hp_for(player_class)
    player.hp=player.max_hp
    player.size=25*player_scale
    enemy.size=25*enemy_scale
    // Здоровье врага всегда сбрасывается к стандартному перед каждым боем.
    enemy.max_hp=enemy_base_hp
    enemy.hp=enemy.max_hp
    enemy.state=0
    enemy.state_time=0
    enemy.spawn_t=0
    enemy.cooldown=enemy_first_delay
    enemy.hit=0
    enemy.dodge_cd=0
    enemy.think=0.2
    enemy.mvx=0
    enemy.mvy=0
    enemy.svx=0
    enemy.svy=0
    enemy.freeze=0
    enemy.freeze_slow=1
    enemy.poison=0
    enemy.poison_tick=0
    enemy.poison_damage=0
    enemy.wobble=0
    enemy.wobble_t=0
    enemy.react=0
    enemy.speed_var=1
    enemy.aim_err=0
    enemy.hesit=0
    enemy.feint=0
    finished=0
    finish_t=0
    punch.active=0
    punch.hit=0
    punch_left=0
    punch_cd=0
    aim_id=-1
    aim_a=0
    santa_follow=0
    azum_revived=0
    revive_prot=0
    cups_awarded=0
    match_seen_foe=0
    foes_seen_t=0
    gift.active=0
    gift.t=0
    gift.shot=0
    super_cd=0
    queued_punch=0
    queued_super=0
    super_id=-1
    boom_t=0
    boom_x=0
    boom_y=0
    freeze_a=0
    super_windup=0
    station.active=0
    station.hp=0
    station.max_hp=0
    arr_clear(station_boom_xs)
    arr_clear(station_boom_ys)
    arr_clear(station_boom_ts)
    station_hit_t=0
    station_spawn_t=0
    station_heal_t=0
    arr_clear(ebuc_station_stack_x)
    arr_clear(ebuc_station_stack_y)
    arr_clear(ebuc_station_stack_hp)
    arr_clear(ebuc_station_stack_max)
    universe_active=0
    universe_t=0
    universe_x=0
    universe_y=0
    universe_hit=0
    universe_id=0
    universe_a=0
    player_freeze=0
    player_freeze_slow=1
    pfreeze_a=0
    player_poison=0
    player_poison_tick=0
    player_poison_damage=0
    ppoison_a=0
    poison_a=0
    joy.x=130
    joy.y=screen_h-150
    joy.r=70
    atk_x=screen_w-140
    atk_y=screen_h-150
    atk2_x=screen_w-140
    atk2_y=screen_h-310
    drop_joy()
    arr_clear(remotes)
    arr_clear(remote_punches)
    arr_clear(candy_x)
    arr_clear(candy_y)
    arr_clear(remote_snow)
    arr_clear(remote_station)
    arr_clear(remote_universe)
    number i=0
    loop i<max_players*remote_fields
        arr_push(remotes,0)
        i=i+1
    end
    i=0
    loop i<max_players*punch_fields
        arr_push(remote_punches,0)
        i=i+1
    end
    i=0
    loop i<max_players*snow_fields
        arr_push(remote_snow,0)
        i=i+1
    end
    i=0
    loop i<max_players*station_fields
        arr_push(remote_station,0)
        i=i+1
    end
    i=0
    loop i<max_players*universe_fields
        arr_push(remote_universe,0)
        i=i+1
    end
    arr_clear(dust)
    dust_cd=0
    enemy_dust_cd=0
    i=0
    loop i<dust_max*dust_fields
        arr_push(dust,0)
        i=i+1
    end
    arr_clear(remote_dust_cd)
    i=0
    loop i<max_players
        arr_push(remote_dust_cd,0)
        i=i+1
    end
end

function init_game()
    reset_battle()
    enemy.hp=enemy.max_hp
    spawn_enemy()
    spawn_all_candies()
end

function init_online()
    reset_battle()
    chat_open=0
    keyboard_hide()
    online_ready=0
    // Баннер: не показываем баннер, который висел до нашего входа в комнату.
    banner_skip=1
    banner_t=0
    // Класс, уровень и скин своего бойца — их видят соперники.
    progress_push_to_net()
    net_connect(FIREBASE,ROOM)
end

function place_online()
    number s=net_slot(), row=floor(s/2), col=s-row*2
    player.x=screen_w*(0.3+0.4*col)
    player.y=screen_h*(0.35+0.3*row)
    online_ready=1
end

function spawn_enemy()
    number margin=70, i=0
    loop i<50
        enemy.x=margin+rand()%(screen_w-140)
        enemy.y=margin+rand()%(screen_h-140)
        if dist(enemy.x,enemy.y,player.x,player.y)>300
            i=50
        else
            i=i+1
        end
    end
    enemy.state=0
    enemy.spawn_t=0
    enemy.state_time=0
    enemy.cooldown=enemy_first_delay
    enemy.hit=0
    enemy.dodge_cd=0
    enemy.think=0.3
    enemy.mvx=0
    enemy.mvy=0
    enemy.svx=0
    enemy.svy=0
    enemy.wobble=(rand()%100)/100.0*2*pi
    enemy.wobble_t=0
    enemy.react=enemy_human_react_min + (rand()%100)/100.0*(enemy_human_react_max-enemy_human_react_min)
    enemy.speed_var=0.9 + (rand()%40)/100.0
    enemy.aim_err=0
    if rand()%2==0
        enemy.strafe=-1
    else
        enemy.strafe=1
    end
    ds_log("enemy spawned instantly")
end

function candy_rand_pos(number i)
    number m=candy_margin, k=0
    number cx=m+rand()%(int)(screen_w-2*m), cy=m+rand()%(int)(screen_h-2*m)
    loop k<24
        if dist(cx,cy,player.x,player.y)<80||dist(cx,cy,enemy.x,enemy.y)<80
            cx=m+rand()%(int)(screen_w-2*m)
            cy=m+rand()%(int)(screen_h-2*m)
            k=k+1
        else
            k=24
        end
    end
    arr_set(candy_x,i,cx)
    arr_set(candy_y,i,cy)
end

function spawn_all_candies()
    number i=0
    loop i<candy_count
        candy_rand_pos(i)
        i=i+1
    end
end

function sprite_a(number a)
    return a+pi/2
end

function move_player()
    number spd=joy_speed
    if player_class==CLASS_AZUM&&player_level>=2
        spd=spd*(1+azum_speed_bonus)
    else if player_class==CLASS_ORDINARY&&player_level>=2
        spd=spd*(1+ordinary_speed_bonus)
    end
    if player_freeze>0
        spd=spd*player_freeze_slow
    end
    player.x=player.x+joy.dx*spd*dt
    player.y=player.y+joy.dy*spd*dt
    number jm=sqrt(joy.dx*joy.dx+joy.dy*joy.dy)
    if jm>0.15
        player.angle=atan2(joy.dy,joy.dx)
    end
    if player.x<player.size
        player.x=player.size
    end
    if player.x>screen_w-player.size
        player.x=screen_w-player.size
    end
    if player.y<player.size
        player.y=player.size
    end
    if player.y>screen_h-player.size
        player.y=screen_h-player.size
    end
    tick_dust(joy.dx,joy.dy,jm)
end

function in_punch_box(number px, number py, number pdx, number pdy, number tx, number ty)
    number rx=tx-px, ry=ty-py, fw=rx*pdx+ry*pdy, side=ry*pdx-rx*pdy
    if fw>=0&&fw<=punch_reach&&side*side<=punch_width*punch_width/4
        return 1
    end
    return 0
end

function enemy_in_punch()
    number ex=enemy.x, ey=enemy.y, hs=enemy.size*0.65
    number fx=cos(enemy.angle)*hs, fy=sin(enemy.angle)*hs, sx=-sin(enemy.angle)*hs, sy=cos(enemy.angle)*hs
    if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex,ey)==1
        return 1
    end
    if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex-fx-sx,ey-fy-sy)==1
        return 1
    end
    if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex+fx-sx,ey+fy-sy)==1
        return 1
    end
    if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex+fx+sx,ey+fy+sy)==1
        return 1
    end
    if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex-fx+sx,ey-fy+sy)==1
        return 1
    end
    return 0
end

function update_aim()
    if punch_left>0&&super_windup<=0&&finished==0
        aim_a=1
    else
        aim_a=aim_a-dt/aim_fade_out
        if aim_a<0
            aim_a=0
        end
    end
    if punch_cd>0
        punch_cd=punch_cd-dt
        if punch_cd<0
            punch_cd=0
        end
    end
end

function follow_punch()
    if punch_left<=0
        return
    end
    punch.x=player.x
    punch.y=player.y
    punch.dx=cos(player.angle)
    punch.dy=sin(player.angle)
end

function enemy_freeze_factor()
    if enemy.freeze>0
        return enemy.freeze_slow
    end
    return 1
end

function freeze_enemy(number t, number slow)
    if t>enemy.freeze
        enemy.freeze=t
        enemy.freeze_slow=slow
    end
end

function enemy_move(number vx, number vy)
    number f=enemy_freeze_factor()*enemy.speed_var
    enemy.mvx=vx*f
    enemy.mvy=vy*f
    enemy.svx=vx
    enemy.svy=vy
    enemy.x=enemy.x+vx*f*dt
    enemy.y=enemy.y+vy*f*dt
    if enemy.x<enemy.size
        enemy.x=enemy.size
    end
    if enemy.x>screen_w-enemy.size
        enemy.x=screen_w-enemy.size
    end
    if enemy.y<enemy.size
        enemy.y=enemy.size
    end
    if enemy.y>screen_h-enemy.size
        enemy.y=screen_h-enemy.size
    end
    // Враг тоже оставляет шлейф пыли за спиной — как и игрок.
    tick_enemy_dust(enemy.mvx,enemy.mvy)
end

function enemy_face_motion()
    number sp=sqrt(enemy.mvx*enemy.mvx+enemy.mvy*enemy.mvy)
    if sp<10
        return
    end
    number ta=atan2(enemy.mvy,enemy.mvx), da=ta-enemy.angle
    if da>pi
        da=da-2*pi
    end
    if da<0-pi
        da=da+2*pi
    end
    // человечная неровность поворота
    number wob = sin(enemy.wobble_t*2.3)*0.15
    da = da + wob
    number turn=da*clamp(dt*enemy_face_speed,0,1), maxturn=enemy_face_max_speed*dt
    enemy.angle=enemy.angle+clamp(turn,0-maxturn,maxturn)
end

function enemy_track_player()
    if enemy.seen==0
        enemy.px=player.x
        enemy.py=player.y
        enemy.pvx=0
        enemy.pvy=0
        enemy.seen=1
        return
    end
    number vx=0, vy=0
    if dt>0
        vx=(player.x-enemy.px)/dt
        vy=(player.y-enemy.py)/dt
    end
    number sp=sqrt(vx*vx+vy*vy)
    if sp>joy_speed
        vx=vx/sp*joy_speed
        vy=vy/sp*joy_speed
    end
    // добавляем шум в оценку скорости — человек не идеально предсказывает
    vx = vx + (rand()%100-50)/100.0*12
    vy = vy + (rand()%100-50)/100.0*12
    enemy.pvx=lerp(enemy.pvx,vx,0.25)
    enemy.pvy=lerp(enemy.pvy,vy,0.25)
    enemy.px=player.x
    enemy.py=player.y
end

function enemy_predict(number lead)
    // упреждение с ошибкой
    number errx = (rand()%100-50)/100.0*18
    number erry = (rand()%100-50)/100.0*18
    aim_tx=clamp(player.x+enemy.pvx*lead+errx,player.size,screen_w-player.size)
    aim_ty=clamp(player.y+enemy.pvy*lead+erry,player.size,screen_h-player.size)
end

function enemy_turn_prediction()
    enemy_predict(enemy_lead)
    number ta=atan2(aim_ty-enemy.y,aim_tx-enemy.x)+enemy.aim_err, da=ta-enemy.angle
    if da>pi
        da=da-2*pi
    end
    if da<0-pi
        da=da+2*pi
    end
    number step=enemy_attack_turn_speed*dt
    enemy.angle=enemy.angle+clamp(da,0-step,step)
end

function player_in_enemy_punch()
    number pdx=cos(enemy.angle), pdy=sin(enemy.angle), rx=player.x-enemy.x, ry=player.y-enemy.y
    number fw=rx*pdx+ry*pdy, side=ry*pdx-rx*pdy, pr=player.size*0.65, half=enemy_punch_width/2+pr
    if fw>=0&&fw<=enemy_punch_reach+pr&&side*side<=half*half
        return 1
    end
    return 0
end

function enemy_would_hit()
    enemy_predict(enemy_lead)
    number rx=aim_tx-enemy.x, ry=aim_ty-enemy.y, fd=sqrt(rx*rx+ry*ry)
    number pr=player.size*0.65
    number margin=enemy_hit_margin
    if sqrt(enemy.pvx*enemy.pvx+enemy.pvy*enemy.pvy)<enemy_still_speed
        margin=0
    end
    if fd<=enemy_punch_reach+pr-margin
        return 1
    end
    return 0
end

function enemy_in_danger()
    number pdx=cos(player.angle), pdy=sin(player.angle), rx=enemy.x-player.x, ry=enemy.y-player.y
    number fw=rx*pdx+ry*pdy, side=ry*pdx-rx*pdy, er=enemy.size*0.65, half=punch_width/2+er
    if fw>=-er&&fw<=punch_reach+er&&side*side<=half*half
        return 1
    end
    return 0
end

function enemy_free_window()
    if punch_left<=0&&punch_cd>enemy_punish_react
        return 1
    end
    return 0
end

function enemy_pick_flank()
    number side=(enemy.y-player.y)*cos(player.angle)-(enemy.x-player.x)*sin(player.angle)
    if side>=0
        enemy.strafe=1
    else
        enemy.strafe=-1
    end
    // иногда человек меняет решение
    if rand()%100 < 22
        enemy.strafe = 0 - enemy.strafe
    end
end

function enemy_roll_cooldown()
    number r=enemy_cooldown_min+(rand()%1000)/1000.0*(enemy_cooldown_max-enemy_cooldown_min)
    // вариация скорости
    enemy.speed_var=0.85 + (rand()%100)/100.0*enemy_human_speed_var
    if r<enemy_cooldown_min
        r=enemy_cooldown_min
    end
    return r
end

function start_enemy_attack()
    number ta=atan2(player.y-enemy.y,player.x-enemy.x), da=ta-enemy.angle
    if da>pi
        da=da-2*pi
    end
    if da<0-pi
        da=da+2*pi
    end
    // человечный промах по углу
    number err = (rand()%100-50)/100.0 * enemy_human_wobble * pi/180
    if rand()%100 < enemy_human_miss*100
        err = err + (rand()%100-50)/100.0 * 0.35
    end
    enemy.aim_err = err
    // Раньше здесь угол мгновенно выставлялся на игрока — враг дёргался.
    // Теперь он доворачивается плавно во время замаха (enemy_turn_prediction),
    // поэтому атаку начинаем только если успеем довернуться за замах.
    number turn_budget = enemy_attack_turn_speed * (enemy_windup - enemy_lock_time)
    if fabs(da) > turn_budget
        return 0
    end
    enemy.state=1
    enemy.state_time=enemy_windup
    enemy.hit=0
    enemy.react=enemy_human_react_min + (rand()%100)/100.0*(enemy_human_react_max-enemy_human_react_min)
    return 1
end

// Плавный доворот на игрока: тот же лимит скорости, что и у доворота в замахе.
function enemy_face_player()
    enemy_predict(enemy_lead)
    number ta=atan2(aim_ty-enemy.y,aim_tx-enemy.x), da=ta-enemy.angle
    if da>pi
        da=da-2*pi
    end
    if da<0-pi
        da=da+2*pi
    end
    number step=enemy_attack_turn_speed*dt
    enemy.angle=enemy.angle+clamp(da,0-step,step)
end

function enemy_engage(number desired)
    number dx=aim_tx-enemy.x, dy=aim_ty-enemy.y, d=sqrt(dx*dx+dy*dy)
    if d<1
        d=1
    end
    // добавляем кривизну ходьбы
    enemy.wobble_t = enemy.wobble_t + dt* (1.2 + (rand()%100)/100.0)
    number wobble_off = sin(enemy.wobble_t*2.7)*14 + cos(enemy.wobble_t*1.3)*9
    // желаемая дистанция с рандомом
    desired = desired + (rand()%100-50)/100.0*18
    number radial=clamp((d-desired)*enemy_close_gain,-bot_speed,bot_speed)
    number orbit=bot_strafe_speed*enemy.strafe*0.5
    if d>desired+110
        orbit=orbit*0.4
    end
    // иногда идёт не идеально ровно — добавляем боковой шум
    number perp_x = 0 - dy/d * wobble_off
    number perp_y = dx/d * wobble_off
    number vx=dx/d*radial - dy/d*orbit + perp_x*0.3
    number vy=dy/d*radial + dx/d*orbit + perp_y*0.3
    // скорость как у игрока, но с вариацией
    number cap=bot_speed*enemy.speed_var
    number sp=sqrt(vx*vx+vy*vy)
    if sp>cap&&sp>0.001
        vx=vx/sp*cap
        vy=vy/sp*cap
    end
    // иногда человек спотыкается — резко меняет скорость
    if rand()%1000 < 8
        vx = vx*0.4
        vy = vy*0.4
        enemy.hesit = 0.08 + (rand()%100)/1000.0
    end
    if enemy.hesit>0
        enemy.hesit = enemy.hesit - dt
        vx = vx*0.55
        vy = vy*0.55
        if enemy.hesit<0
            enemy.hesit=0
        end
    end
    number ms=clamp(dt*enemy_move_smooth,0,1)
    enemy.svx=lerp(enemy.svx,vx,ms)
    enemy.svy=lerp(enemy.svy,vy,ms)
    enemy_move(enemy.svx,enemy.svy)
end

function update_enemy()
    enemy_track_player()
    enemy.mvx=0
    enemy.mvy=0
    enemy.wobble_t = enemy.wobble_t + dt

    if enemy.freeze>0
        enemy.freeze=enemy.freeze-dt
        if enemy.freeze<0
            enemy.freeze=0
        end
    end
    if enemy.freeze>0
        freeze_a=freeze_a+dt/freeze_fade_in
    else
        freeze_a=freeze_a-dt/freeze_fade_out
    end
    if freeze_a<0
        freeze_a=0
    end
    if freeze_a>1
        freeze_a=1
    end
    if enemy.cooldown>0
        enemy.cooldown=enemy.cooldown-dt*enemy_freeze_factor()
        if enemy.cooldown<0
            enemy.cooldown=0
        end
    end
    if enemy.dodge_cd>0
        enemy.dodge_cd=enemy.dodge_cd-dt
        if enemy.dodge_cd<0
            enemy.dodge_cd=0
        end
    end
    if enemy.flank>0
        enemy.flank=enemy.flank-dt
    end
    if enemy.react>0
        enemy.react=enemy.react-dt
        if enemy.react<0
            enemy.react=0
        end
    end
    if enemy.poison>0
        if enemy.poison_tick<=0
            enemy.poison_tick=santa_poison_tick_interval
        end
        enemy.poison=enemy.poison-dt
        enemy.poison_tick=enemy.poison_tick-dt
        if enemy.poison_tick<=0
            number tick_dmg=santa_poison_damage_for(player_level)
            if player_level>=3&&enemy.poison_damage>0
                tick_dmg=enemy.poison_damage
            end
            enemy.hp=enemy.hp-tick_dmg
            enemy.poison=0
            enemy.poison_tick=0
            enemy.poison_damage=0
            if enemy.hp<=0
                enemy.hp=0
                finish_game(1)
                return
            end
        end
        if enemy.poison<=0
            enemy.poison=0
            enemy.poison_tick=0
            enemy.poison_damage=0
        end
    end
    if enemy.poison>0
        poison_a=poison_a+dt/freeze_fade_in
    else
        poison_a=poison_a-dt/freeze_fade_out
    end
    if poison_a<0
        poison_a=0
    end
    if poison_a>1
        poison_a=1
    end

    number dx=player.x-enemy.x, dy=player.y-enemy.y, d=sqrt(dx*dx+dy*dy)
    if d<1
        d=1
    end
    number pr=player.size*0.65, reach=enemy_punch_reach+pr

    // замах
    if enemy.state==1
        enemy.state_time=enemy.state_time-dt
        if enemy.state_time>enemy_lock_time
            enemy_turn_prediction()
        end
        enemy_predict(enemy_lead)
        number adx=aim_tx-enemy.x, ady=aim_ty-enemy.y, ad=sqrt(adx*adx+ady*ady)
        if ad<1
            ad=1
        end
        if ad>reach-enemy_hit_margin
            enemy_move(adx/ad*bot_speed*0.85,ady/ad*bot_speed*0.85)
        end
        if enemy.state_time<=0
            enemy.state=2
            enemy.state_time=enemy_punch_time
            enemy.hit=0
        end
        return
    end

    if enemy.state==2
        enemy.state_time=enemy.state_time-dt
        if enemy.hit==0&&player_in_enemy_punch()==1
            // иногда человек промахивается даже в упор
            if rand()%100 >= enemy_human_miss*100 || rand()%100 < 30
                enemy.hit=1
                if revive_prot<=0
                    take_damage(enemy_damage)
                    ds_log("enemy punch! hp %g",player.hp)
                    if player.hp<=0
                        player.hp=0
                        if try_revive()==0
                            finish_game(2)
                            return
                        end
                    end
                end
            else
                ds_log("enemy miss (human)")
            end
        end
        if enemy.state_time<=0
            enemy.state=3
            enemy.state_time=enemy_recovery
            enemy.cooldown=enemy_roll_cooldown()
            if enemy.hit==1&&enemy_free_window()==1
                enemy.cooldown=enemy_cooldown_min*0.7
                enemy.think=0
            else
                enemy.think=enemy_think_min+(rand()%100)/100.0*(enemy_think_max-enemy_think_min)
            end
        end
        return
    end

    if enemy.state==3
        enemy.state_time=enemy.state_time-dt
        if enemy_free_window()==0&&d<reach*0.85
            enemy_predict(0)
            enemy_engage(reach*0.95)
        end
        // После удара не отворачиваемся в сторону движения: враг остаётся
        // лицом к игроку и сразу готов бить снова.
        enemy_face_player()
        if enemy.state_time<=0
            enemy.state=0
            if enemy.flank<=0
                enemy_pick_flank()
                enemy.flank=enemy_flank_time + (rand()%100)/100.0*0.4
            end
        end
        return
    end

    if enemy.state==4
        enemy.state_time=enemy.state_time-dt
        number dpx=cos(player.angle), dpy=sin(player.angle)
        // кривой уворот
        number dodge_err = (rand()%100-50)/100.0*0.6
        number dvx=-dpy*enemy.strafe*bot_dodge_speed*(0.7+dodge_err)-dpx*bot_speed*0.25
        number dvy=dpx*enemy.strafe*bot_dodge_speed*(0.7+dodge_err)-dpy*bot_speed*0.25
        enemy_move(dvx,dvy)
        enemy_face_motion()
        if enemy.state_time<=0
            enemy.state=0
            enemy.dodge_cd=enemy_dodge_cooldown + (rand()%100)/100.0*0.3
            enemy.cooldown=0
            enemy.think=0.08
        end
        return
    end

    // реакция на удар игрока — не всегда уклоняется, иногда криво
    if punch_left>0&&punch_left<=punch_time-enemy.react&&enemy.dodge_cd<=0&&enemy_in_danger()==1
        if enemy.react<=0
            // шанс не увернуться
            if rand()%100 < enemy_human_dodge_fail*100
                ds_log("enemy dodge fail (human)")
            else
                number side=(enemy.y-player.y)*cos(player.angle)-(enemy.x-player.x)*sin(player.angle)
                if side>=0
                    enemy.strafe=1
                else
                    enemy.strafe=-1
                end
                // иногда выбирает не ту сторону
                if rand()%100 < 18
                    enemy.strafe = 0 - enemy.strafe
                end
                enemy.state=4
                enemy.state_time=enemy_dodge_time + (rand()%100-50)/100.0*0.08
                enemy.react=enemy_human_react_min + (rand()%100)/100.0*(enemy_human_react_max-enemy_human_react_min)
                return
            end
        end
    end

    if enemy_free_window()==1
        enemy.think=0
        if enemy.cooldown<=0&&(d<=reach||enemy_would_hit()==1)
            // иногда фейнт вместо атаки
            if rand()%100 < 12
                enemy_pick_flank()
                enemy.flank=enemy_flank_time
                enemy.think=0.12
                enemy_engage(reach*1.2)
                enemy_face_motion()
                return
            end
            if start_enemy_attack()==1
                return
            end
            // Ещё не довернулся: плавно разворачиваемся, не замирая на месте.
            enemy_predict(enemy_lead)
            enemy_engage(reach*0.55)
            enemy_face_player()
            return
        end
        enemy_predict(enemy_lead)
        enemy_engage(reach*0.55)
        // Вплотную смотрим на игрока (иначе он крутится спиной перед ударом),
        // издалека — в сторону движения.
        if d<=reach
            enemy_face_player()
        else
            enemy_face_motion()
        end
        return
    end

    if enemy.cooldown<=0&&enemy.think<=0&&(d<=reach*0.95||enemy_would_hit()==1)
        // человечная задержка — не мгновенно
        if enemy.react<=0
            if start_enemy_attack()==1
                return
            end
        end
    end

    if enemy.think>0
        enemy.think=enemy.think-dt
    end
    if enemy.flank<=0
        enemy_pick_flank()
        enemy.flank=enemy_flank_time
    end

    number desired=reach*0.62
    if d<enemy_min_distance*0.75
        desired=enemy_min_distance*0.75
    end
    enemy_predict(enemy_lead)
    enemy_engage(desired)
    if d<=reach
        enemy_face_player()
    else
        enemy_face_motion()
    end
end

function tick_freeze()
    if player_freeze>0
        player_freeze=player_freeze-dt
        if player_freeze<0
            player_freeze=0
        end
    end
    if player_freeze>0
        pfreeze_a=pfreeze_a+dt/freeze_fade_in
    else
        pfreeze_a=pfreeze_a-dt/freeze_fade_out
    end
    if pfreeze_a<0
        pfreeze_a=0
    end
    if pfreeze_a>1
        pfreeze_a=1
    end
end

function tick_player_poison()
    if player_poison>0
        if player_poison_tick<=0
            player_poison_tick=santa_poison_tick_interval
        end
        player_poison=player_poison-dt
        player_poison_tick=player_poison_tick-dt
        if player_poison_tick<=0
            take_damage(player_poison_damage)
            player_poison=0
            player_poison_tick=0
            player_poison_damage=0
        end
        if player_poison<=0
            player_poison=0
            player_poison_tick=0
            player_poison_damage=0
        end
    end
    if player_poison>0
        ppoison_a=ppoison_a+dt/freeze_fade_in
    else
        ppoison_a=ppoison_a-dt/freeze_fade_out
    end
    if ppoison_a<0
        ppoison_a=0
    end
    if ppoison_a>1
        ppoison_a=1
    end
end

// ── Ульта бука: вселенная ──────────────────────────────────────────────────
// Прямой урон от вселенной: он бьёт самого бука, врага и станцию отдельно,
// поэтому станция не «спасает» бука от собственной вселенной.
// Вторая ульта отключена, но функция оставлена для совместимости со старыми клиентами.
function universe_collapse(number dmg)
    if finished!=0
        return
    end
    if game_state!=ST_ONLINE
        enemy.hp=enemy.hp-dmg
        if enemy.hp<0
            enemy.hp=0
        end
    end
    // Станция бука тоже ломается вселенной.
    if player_class==CLASS_EBUC&&station.active==1
        station.hp=station.hp-dmg
        station_hit_t=station_hit_time
        if station.hp<=0
            destroy_station()
        end
    end
    // Сам бук тоже может погибнуть от своей ульты.
    player.hp=player.hp-dmg
    if player.hp<0
        player.hp=0
    end
    if player.hp<=0
        if try_revive()==0
            finish_game(2)
            return
        end
    end
    if finished==0&&game_state!=ST_ONLINE&&enemy.hp<=0
        finish_game(1)
    end
end

// Чужая вселенная в онлайне: ломает только самого получателя и его станцию.
function universe_collapse_remote(number dmg)
    if finished!=0
        return
    end
    if player_class==CLASS_EBUC&&station.active==1
        station.hp=station.hp-dmg
        station_hit_t=station_hit_time
        if station.hp<=0
            destroy_station()
        end
    end
    player.hp=player.hp-dmg
    if player.hp<0
        player.hp=0
    end
    if player.hp<=0
        if try_revive()==0
            finish_game(2)
        end
    end
end

function tick_universe()
    if universe_active==0
        return
    end
    universe_t=universe_t+dt
    universe_a=clamp(universe_t/ebuc_universe_collapse_time,0,1)
    if universe_t>=ebuc_universe_collapse_time
        universe_active=0
        universe_hit=1
        universe_collapse(ebuc_universe_damage_for(player_level))
    end
end

function tick_station()
    // Станция стоит на месте и не развеивается сама, пока её не сломают.
    tick_station_boom()
    tick_station_hit()
    // Анимация появления турели затухает.
    if station_spawn_t>0
        station_spawn_t=station_spawn_t-dt
        if station_spawn_t<0
            station_spawn_t=0
        end
    end
    // Уровень 3: каждую секунду луч живой турели лечит бука.
    if player_class==CLASS_EBUC&&player_level>=3&&station.active==1&&finished==0&&player.hp>0
        station_heal_t=station_heal_t+dt
        if station_heal_t>=1
            station_heal_t=station_heal_t-1
            player.hp=clamp(player.hp+ebuc_beam_heal,0,player.max_hp)
        end
    else
        station_heal_t=0
    end
end

function update_remote_station()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*station_fields
        if s==net_slot()||net_player_online(s)!=1
            arr_set(remote_station,b,0)
            arr_set(remote_station,b+1,0)
            arr_set(remote_station,b+2,0)
            arr_set(remote_station,b+3,0)
        else
            number cnt=net_player_station(s)
            if cnt>0
                arr_set(remote_station,b,1)
                arr_set(remote_station,b+1,net_player_station_x(s)*screen_w)
                arr_set(remote_station,b+2,net_player_station_y(s)*screen_h)
                arr_set(remote_station,b+3,0)
            else
                // Состояние: 0 — нет, 1 — турель стоит, 2 — идёт взрыв.
                // b+1/b+2 хранят последнюю позицию турели, b+3 — таймер взрыва.
                number st=arr_get(remote_station,b)
                number bt=arr_get(remote_station,b+3)
                if st==1&&bt<=0
                    // Турель только что сломалась: взрыв виден и доигрывает.
                    arr_set(remote_station,b,2)
                    arr_set(remote_station,b+3,station_boom_time)
                else if bt>0
                    bt=bt-dt
                    if bt<0
                        bt=0
                    end
                    arr_set(remote_station,b+3,bt)
                    if bt<=0
                        arr_set(remote_station,b,0)
                    end
                else
                    arr_set(remote_station,b,0)
                end
            end
        end
        s=s+1
    end
end

function update_remote_universe()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*universe_fields
        if s==net_slot()||net_player_online(s)!=1
            arr_set(remote_universe,b,0)
            arr_set(remote_universe,b+1,0)
        else
            number ucnt=net_player_universe(s)
            number prev=arr_get(remote_universe,b)
            if ucnt!=prev&&ucnt>0
                arr_set(remote_universe,b,ucnt)
                arr_set(remote_universe,b+1,1)
                arr_set(remote_universe,b+2,net_player_universe_x(s)*screen_w)
                arr_set(remote_universe,b+3,net_player_universe_y(s)*screen_h)
                arr_set(remote_universe,b+4,0)
            end
            if arr_get(remote_universe,b+1)==1
                number t=arr_get(remote_universe,b+4)+dt
                arr_set(remote_universe,b+4,t)
                if t>=ebuc_universe_collapse_time
                    arr_set(remote_universe,b+1,0)
                    arr_set(remote_universe,b,0)
                    // Чужая вселенная тоже бьёт локального игрока и его станцию.
                    number rlevel=net_player_level(s)
                    universe_collapse_remote(ebuc_universe_damage_for(rlevel))
                    if finished!=0
                        return
                    end
                end
            end
        end
        s=s+1
    end
end

function flush_queued_action()
    if queued_punch==0&&queued_super==0
        return
    end
    if punch_left>0||punch_cd>0||ultimate_visual_busy()==1
        return
    end
    if queued_super==1&&super_cd<=0
        queued_super=0
        fire_super()
        return
    end
    if queued_punch==1
        queued_punch=0
        fire_punch()
    end
end

function update_game()
    tick_alert_hold()
    tick_revive()
    tick_freeze()
    tick_player_poison()
    tick_station()
    tick_universe()
    update_aim()
    if finished!=0
        return
    end
    if player.hp<=0
        if try_revive()==0
            finish_game(2)
            return
        end
    end
    move_player()
    number ci=0
    loop ci<candy_count
        if dist(arr_get(candy_x,ci),arr_get(candy_y,ci),player.x,player.y)<player.size*0.65+18
            candies=candies+candy_give
            save_progress()
            ds_log("candy picked -> %g",candies)
            candy_rand_pos(ci)
        end
        ci=ci+1
    end
    if punch_left>0
        punch_left=punch_left-dt
        if punch_left<0
            punch_left=0
        end
    end
    follow_punch()
    if super_cd>0
        super_cd=super_cd-dt
        if super_cd<0
            super_cd=0
        end
    end
    if boom_t>0
        boom_t=boom_t-dt
        if boom_t<0
            boom_t=0
        end
    end
    tick_super_windup()
    tick_santa_follow()
    if punch_left>0&&punch.active==1&&punch.hit==0
        if enemy_in_punch()==1
            punch.hit=1
            if player_class==2&&santa_follow>0
                if player_level>=3
                    if enemy.poison<=0
                        enemy.poison_tick=santa_poison_tick_interval
                        enemy.poison_damage=santa_poison_damage_for(player_level)
                    else
                        enemy.poison_damage=enemy.poison_damage+santa_poison_damage_for(player_level)
                    end
                    enemy.poison=santa_poison_time_for(player_level)
                else
                    if enemy.poison<=0
                        enemy.poison_tick=santa_poison_tick_interval
                    end
                    enemy.poison=santa_poison_time_for(player_level)
                end
            end
            enemy.hp=enemy.hp-class_punch_damage(player_class)
            heal_after_attack()
            if enemy.hp<=0
                finish_game(1)
                return
            end
        end
    end
    update_dust()
    update_gift()
    flush_queued_action()
    if finished!=0
        return
    end
    update_enemy()
end

function clear_remote_punch(number s)
    number rb=s*punch_fields, k=0
    loop k<punch_fields
        arr_set(remote_punches,rb+k,0)
        k=k+1
    end
end

function start_remote_punch(number s)
    number rb=s*punch_fields
    arr_set(remote_punches,rb,1)
    arr_set(remote_punches,rb+1,net_player_punch_x(s)*screen_w)
    arr_set(remote_punches,rb+2,net_player_punch_y(s)*screen_h)
    arr_set(remote_punches,rb+3,net_player_punch_dx(s))
    arr_set(remote_punches,rb+4,net_player_punch_dy(s))
    arr_set(remote_punches,rb+5,0)
end

function read_remotes()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*remote_fields
        if net_player_online(s)==1&&s!=net_slot()
            number x=net_player_x(s)*screen_w, y=net_player_y(s)*screen_h, a=net_player_angle(s)
            if arr_get(remotes,b)==0
                arr_set(remotes,b,1)
                arr_set(remotes,b+1,x)
                arr_set(remotes,b+2,y)
                arr_set(remotes,b+3,a)
                arr_set(remotes,b+7,x)
                arr_set(remotes,b+8,y)
                arr_set(remotes,b+9,a)
            else
                arr_set(remotes,b+7,x)
                arr_set(remotes,b+8,y)
                arr_set(remotes,b+9,a)
            end
            arr_set(remotes,b+4,net_player_hp(s))
            arr_set(remotes,b+5,net_player_alive(s))
            arr_set(remotes,b+10,net_player_class(s))
            number net_p=net_player_punch(s), prev_p=arr_get(remotes,b+6)
            if net_p!=prev_p
                arr_set(remotes,b+6,net_p)
                start_remote_punch(s)
            end
        else
            arr_set(remotes,b,0)
            arr_set(remotes,b+5,0)
            clear_remote_punch(s)
        end
        s=s+1
    end
end

function update_remote_punches()
    number s=0
    loop s<max_players
        number rb=s*punch_fields
        if arr_get(remote_punches,rb)==1
            number t=arr_get(remote_punches,rb+5)+dt
            arr_set(remote_punches,rb+5,t)
            if arr_get(remotes,s*remote_fields+5)==0
                clear_remote_punch(s)
            else if in_punch_box(arr_get(remote_punches,rb+1),arr_get(remote_punches,rb+2),arr_get(remote_punches,rb+3),arr_get(remote_punches,rb+4),player.x,player.y)==1
                number rcls=arr_get(remotes,s*remote_fields+10), rlevel=net_player_level(s)
                take_damage(class_punch_damage_for(rcls,rlevel))
                if rcls==CLASS_SANTA
                    if player_poison<=0
                        player_poison_tick=santa_poison_tick_interval
                    end
                    player_poison=santa_poison_time_for(rlevel)
                    player_poison_damage=santa_poison_damage_for(rlevel)
                end
                clear_remote_punch(s)
                if player.hp<=0
                    player.hp=0
                    if try_revive()==0
                        finish_game(2)
                        return
                    end
                end
            else if t>punch_time
                clear_remote_punch(s)
            end
        end
        s=s+1
    end
end

function smooth_remotes()
    number s=0
    loop s<max_players
        number b=s*remote_fields
        if arr_get(remotes,b+5)==1
            number rx=arr_get(remotes,b+1), ry=arr_get(remotes,b+2), ra=arr_get(remotes,b+3)
            number nx=arr_get(remotes,b+7), ny=arr_get(remotes,b+8), na=arr_get(remotes,b+9)
            if dist(rx,ry,nx,ny)>remote_snap
                rx=nx
                ry=ny
                ra=na
            else
                rx=lerp(rx,nx,clamp(dt*remote_smooth,0,1))
                ry=lerp(ry,ny,clamp(dt*remote_smooth,0,1))
                number da=na-ra
                if da>pi
                    da=da-2*pi
                end
                if da<0-pi
                    da=da+2*pi
                end
                ra=ra+da*clamp(dt*remote_smooth,0,1)
                // Соперник в онлайне тоже тянет за собой след пыли.
                tick_remote_dust(s,rx,ry,nx,ny)
            end
            arr_set(remotes,b+1,rx)
            arr_set(remotes,b+2,ry)
            arr_set(remotes,b+3,ra)
        end
        s=s+1
    end
end

function count_living_remotes()
    number count=0, s=0
    loop s<max_players
        if s!=net_slot()&&arr_get(remotes,s*remote_fields+5)==1
            count=count+1
        end
        s=s+1
    end
    return count
end

function check_online_finish()
    if online_ready==0||finished!=0
        return
    end
    number enemies_alive=count_living_remotes()
    if enemies_alive>0
        // Дебаунс: соперник должен реально побыть в комнате (секунду), прежде
        // чем его исчезновение станет победой. Один «фантомный» сетевой снимок
        // (например, гонка с удалением чужого слота) победу засчитать не может.
        foes_seen_t=foes_seen_t+dt
        if foes_seen_t>foes_seen_min
            match_seen_foe=1
        end
    end
    if match_seen_foe==1&&enemies_alive==0
        finish_game(1)
    end
end

function push_self()
    if net_slot()<0
        return
    end
    number alive=1
    if player.hp<=0
        alive=0
    end
    progress_push_to_net()
    net_publish(player.x/screen_w,player.y/screen_h,player.angle,player.hp,alive)
    net_publish_punch(punch.x/screen_w,punch.y/screen_h,punch.dx,punch.dy,punch.shot)
    if player_class==CLASS_EBUC
        if station.active==1
            net_publish_station(station.x/screen_w,station.y/screen_h,station.hp,station.shot+1)
        else
            net_publish_station(0,0,0,0)
        end
        if universe_active==1
            net_publish_universe(universe_x/screen_w,universe_y/screen_h,universe_id)
        else
            net_publish_universe(0,0,0)
        end
    end
end

function update_online()
    // Бан мог прилететь уже во время боя: сразу выкидываем в меню с сообщением.
    if net_banned() == 1
        banned_msg = tr_banned()
        start_transition(0)
        return
    end
    tick_alert_hold()
    update_banner()
    tick_revive()
    tick_freeze()
    tick_player_poison()
    tick_station()
    tick_universe()
    update_aim()
    if finished!=0
        return
    end
    if player.hp<=0
        if try_revive()==0
            finish_game(2)
            return
        end
    end
    move_player()
    if punch_left>0
        punch_left=punch_left-dt
        if punch_left<0
            punch_left=0
        end
    end
    follow_punch()
    if super_cd>0
        super_cd=super_cd-dt
        if super_cd<0
            super_cd=0
        end
    end
    if boom_t>0
        boom_t=boom_t-dt
        if boom_t<0
            boom_t=0
        end
    end
    tick_super_windup()
    tick_santa_follow()
    update_dust()
    update_gift()
    flush_queued_action()
    if finished!=0
        return
    end
    // Мир синхронизируем, пока у нас есть слот в комнате, а не только пока
    // net_status()==NET_PLAYING: статус NET_ERROR ставит поток-писатель при
    // временном сбое PUT (плохая сеть), но поток-читатель в это время продолжает
    // тянуть позиции и чат. Раньше весь обмен миром замирал при любой ошибке
    // записи: чат обновлялся, а персонажи стояли («чат прогрузился, никто не
    // двигается, висит переподключение»).
    if net_slot()>=0
        if online_ready==0
            place_online()
        end
        read_remotes()
        smooth_remotes()
        update_remote_punches()
        update_remote_snow()
        update_remote_station()
        update_remote_universe()
        check_online_finish()
        push_self()
    end
    update_event()
    chat_update()
end

function start_punch_now()
    punch.x=player.x
    punch.y=player.y
    punch.dx=cos(player.angle)
    punch.dy=sin(player.angle)
    punch.active=1
    punch.shot=punch.shot+1
    punch.hit=0
    punch_left=punch_time
    punch_cd=punch_cooldown
    queued_punch=0
end

// Ульта и обычная атака используют разные визуальные слои. Пока на арене
// проигрывается любой эффект ульты, обычный удар не запускается: это не даёт
// спрайту удара, снежинке или вспышке вселенной накладываться друг на друга.
function station_boom_visual_busy()
    number i=0
    loop i<arr_len(station_boom_ts)
        if arr_get(station_boom_ts,i)>0
            return 1
        end
        i=i+1
    end
    return 0
end

function ultimate_visual_busy()
    if super_windup>0||gift.active==1||universe_active==1||boom_t>0||station_spawn_t>0
        return 1
    end
    if station_boom_visual_busy()==1
        return 1
    end
    return 0
end

function fire_punch()
    if punch_cd>0||ultimate_visual_busy()==1
        // Не запускаем два визуальных состояния одним кадром, но сохраняем
        // нажатие — удар начнётся сразу после ульты или её вспышки.
        queued_punch=1
        return
    end
    start_punch_now()
    if player_class==2
        santa_follow=santa_follow_delay
    end
end

function tick_santa_follow()
    if santa_follow<=0
        return
    end
    santa_follow=santa_follow-dt
    if santa_follow>0
        return
    end
    santa_follow=0
    if finished!=0||player_class!=2
        return
    end
    if super_windup>0||gift.active==1||universe_active==1||boom_t>0||station_spawn_t>0
        return
    end
    start_punch_now()
end

function fire_super()
    if player_class!=2&&player_class!=3
        return
    end
    if super_cd>0
        return
    end
    // Ульта ждёт окончания обычного удара и его кулдауна. Иначе старый
    // эффект удара и анимация замаха ульты появлялись в одном кадре.
    if punch_left>0||punch_cd>0||gift.active==1||universe_active==1||boom_t>0||station_spawn_t>0||station_boom_visual_busy()==1
        queued_super=1
        return
    end
    if super_windup>0
        queued_super=1
        return
    end
    // Отменяем отложенный второй удар Деда Мороза: иначе он мог стартовать
    // одновременно с уже летящей снежинкой после быстрого нажатия двух кнопок.
    santa_follow=0
    queued_super=0
    super_windup=punch_time
    punch_left=punch_time
    punch.active=0
    punch.hit=0
    if player_class==CLASS_EBUC
        super_cd=ebuc_super_cd_time
    else
        super_cd=super_cd_time
    end
end

function tick_super_windup()
    if super_windup<=0
        return
    end
    super_windup=super_windup-dt
    if super_windup>0
        return
    end
    super_windup=0
    if finished!=0
        return
    end
    if player_class==2
        gift.x=player.x
        gift.y=player.y
        gift.dx=cos(player.angle)
        gift.dy=sin(player.angle)
        gift.active=1
        gift.t=0
        gift.shot=gift.shot+1
        if game_state==ST_ONLINE
            net_publish_snow(gift.x/screen_w,gift.y/screen_h,gift.dx,gift.dy,gift.shot)
        end
        return
    end
    if player_class==CLASS_EBUC
        // Вторая ульта (вселенная) отключена — теперь всегда только станция.
        place_station()
        if game_state==ST_ONLINE
            net_publish_station(station.x/screen_w,station.y/screen_h,station.hp,station.shot)
        end
    end
end

function update_gift()
    if gift.active==0
        return
    end
    gift.t=gift.t+dt
    gift.x=gift.x+gift.dx*super_speed*dt
    gift.y=gift.y+gift.dy*super_speed*dt
    number touched=0
    if game_state==ST_ONLINE
        if gift.t>super_range/super_speed
            touched=1
        end
    else
        number hx=gift.x-enemy.x, hy=gift.y-enemy.y, hd=sqrt(hx*hx+hy*hy)
        if hd<enemy.size*0.65+24
            touched=1
        end
        if gift.t>super_range/super_speed
            touched=1
        end
    end
    if touched==0
        return
    end
    gift.active=0
    boom_x=gift.x
    boom_y=gift.y
    boom_t=boom_time
    if game_state!=ST_ONLINE&&dist(gift.x,gift.y,enemy.x,enemy.y)<=super_radius
        freeze_enemy(santa_freeze_time_for(player_level),super_freeze_slow)
        enemy.hp=enemy.hp-santa_super_damage
        if enemy.hp<=0
            enemy.hp=0
            finish_game(1)
            return
        end
    end
end

function draw_gift()
    if gift.active==0
        return
    end
    number hw=16, rot=gift.t*3
    tex(gift.x-hw,gift.y-hw,SNOWFLAKE_TEX,rot,0.5)
end

function draw_boom_at(number x, number y, number bt)
    if bt<=0
        return
    end
    number p=1-bt/boom_time, r=super_radius*p
    number fade_in=clamp(p/boom_fade_in,0,1), fade_out=clamp(bt/(boom_time*boom_fade_out),0,1)
    number a=floor(fade_in*fade_out*255)
    if a<=0
        return
    end
    number c0=(((unsigned)(int)a)<<24)|0x00B3E5FC, c1=(((unsigned)(int)a)<<24)|0x00E1F5FE
    ring(x,y,r,9,c0)
    ring(x,y,r*0.6,6,c1)
    circle(x,y,super_radius*0.3,c0)
end

function draw_boom()
    draw_boom_at(boom_x,boom_y,boom_t)
end

// ── Луч турели бука ────────────────────────────────────────────────────────
// Живая турель непрерывно излучает луч от себя до своего хозяина: плотное,
// почти непрозрачное яркое ядро внутри зелёного свечения. Без бегущих
// кружков и колец на концах — только чистый луч.
function draw_station_beam(number sx, number sy, number px, number py)
    number dx=px-sx, dy=py-sy
    number d=sqrt(dx*dx+dy*dy)
    if d<40
        return
    end
    number nx=dx/d, ny=dy/d
    // Луч выходит прямо из центра турели (x1,y1 = центр), а спрайт рисуется
    // поверх него, поэтому видно, что луч «растёт» из середины турели.
    number x1=sx, y1=sy
    // не заходить внутрь спрайта игрока
    number x2=px-nx*32, y2=py-ny*32
    // Пульсация луча убрана: ширина и яркость постоянные.
    number a=floor(250)
    // внешнее свечение — плотное, без пульсации
    line(x1,y1,x2,y2,15,(((unsigned)(int)200)<<24)|0x0000E676)
    // ядро луча — сплошное и яркое
    line(x1,y1,x2,y2,6,(((unsigned)(int)a)<<24)|0x00C8FAD6)
end

function draw_station_at(number x, number y, number hp, number max_hp)
    number scale=station_scale
    if station.active==1&&x==station.x&&y==station.y
        // Появление: спрайт немного увеличен и быстро сжимается до нормы.
        // Эффект урона (сжатие при попадании) убран.
        if station_spawn_t>0
            number sp=clamp(station_spawn_t/station_spawn_time,0,1)
            scale=station_scale*(1.0+0.25*sp)
        end
    end
    // Спрайт турели 50x50: центрируем по половине реального размера,
    // раньше смещение считалось от 44px и спрайт уезжал вниз-влево.
    number hw=25*scale
    tex(x-hw,y-hw,DESPENSER_TEX,0,scale)
    // Полоса здоровья турели — прямо над ней.
    number bw=46*scale, bh=7
    hud_bar(x-bw/2, y-hw-12, bw, bh, hp, max_hp, 0x7ED321, 0)
end

// Взрыв турели при полном разрушении: тот же характер, что у взрыва
// снежинки Деда Мороза, но в зелёных тонах бука.
function draw_turret_boom(number x, number y, number bt)
    if bt<=0
        return
    end
    number p=1-bt/station_boom_time
    if p<0
        p=0
    end
    if p>1
        p=1
    end
    number fade_in=clamp(p/boom_fade_in,0,1)
    number fade_out=clamp(bt/(station_boom_time*boom_fade_out),0,1)
    number a=floor(fade_in*fade_out*240)
    if a<=0
        return
    end
    number r=30+95*p
    // зелёные кольца (вместо голубых у снежинки)
    ring(x,y,r,9,(((unsigned)(int)a)<<24)|0x0000E676)
    ring(x,y,r*0.66,6,(((unsigned)(int)floor(a*0.85))<<24)|0x00B9F6CA)
    ring(x,y,r*0.36,5,(((unsigned)(int)floor(a*0.65))<<24)|0x0076FF03)
    // яркая вспышка в центре
    circle(x,y,r*0.22+6*(1-p),(((unsigned)(int)floor(a*0.7))<<24)|0x0000E676)
    // разлетающиеся зелёные осколки-частицы
    number i=0
    loop i<18
        number h1=hash01(i*37+11)
        number h2=hash01(i*61+7)
        number ang=h1*2*pi
        number rr=r*(0.5+0.5*h2)
        number px=x+cos(ang)*rr
        number py=y+sin(ang)*rr
        number sz=2+4*(1-p)
        number aa=floor(a*(0.7+0.3*h2))
        circle(px,py,sz,(((unsigned)(int)aa)<<24)|0x0000E676)
        i=i+1
    end
end

function draw_station()
    // Рисуем запасные турели из стека (старые)
    number si=0
    loop si<arr_len(ebuc_station_stack_x)
        number sx=arr_get(ebuc_station_stack_x,si)
        number sy=arr_get(ebuc_station_stack_y,si)
        number sh=arr_get(ebuc_station_stack_hp,si)
        number sm=arr_get(ebuc_station_stack_max,si)
        // чуть темнее/прозрачнее чтобы отличать
        draw_station_at(sx,sy,sh,sm)
        si=si+1
    end
    if station.active==1
        // Луч рисуем под спрайтом, чтобы он «выходил прямо из центра» турели.
        // Активная турель излучает луч до самого бука.
        draw_station_beam(station.x,station.y,player.x,player.y)
        draw_station_at(station.x,station.y,station.hp,station.max_hp)
    end
    // Все взрывы разрушенных турелей доигрывают на своих местах.
    number bi=0
    loop bi<arr_len(station_boom_ts)
        number bt=arr_get(station_boom_ts,bi)
        if bt>0
            draw_turret_boom(arr_get(station_boom_xs,bi),arr_get(station_boom_ys,bi),bt)
        end
        bi=bi+1
    end
end

function universe_particle_color(number i, number a)
    number m=(int)i%4
    if m==0
        return (((unsigned)(int)a)<<24)|0x0000E676
    end
    if m==1
        return (((unsigned)(int)a)<<24)|0x0000E5FF
    end
    if m==2
        return (((unsigned)(int)a)<<24)|0x00FFFFFF
    end
    return (((unsigned)(int)a)<<24)|0x0076FF03
end

function draw_universe_at(number cx, number cy, number seed, number t)
    if t<=0
        return
    end
    number p=clamp(t/ebuc_universe_collapse_time,0,1)
    if p>=1
        return
    end
    number i=0
    loop i<ebuc_universe_particles
        number h1=hash01(seed*13+i*91+7)
        number h2=hash01(seed*17+i*131+19)
        number h3=hash01(seed*23+i*173+31)
        number h4=hash01(seed*29+i*211+47)
        number sx=40+h1*(screen_w-80)
        number sy=40+h2*(screen_h-80)
        number k=p*p
        number px=lerp(sx,cx,k)
        number py=lerp(sy,cy,k)
        number size=2+6*h3*(1-p)
        number a=floor(120+120*p)
        circle(px,py,size,universe_particle_color(i,a))
        if h4>0.86
            number trail=floor(a*0.55)
            circle(px,py,size*2.1,universe_particle_color(i+1,trail))
        end
        i=i+1
    end
    if p>0.78
        number ep=(p-0.78)/0.22
        number r=(80+120*ep)*1.0
        number af=floor(240*ep)
        ring(cx,cy,r,10,(((unsigned)(int)af)<<24)|0x0000E676)
        if ep>0.45
            number a2=floor(160*(ep-0.45)/0.55)
            ring(cx,cy,r*0.62,8,(((unsigned)(int)a2)<<24)|0x0076FF03)
        end
    end
end

function draw_universe()
    if universe_active==0
        return
    end
    draw_universe_at(universe_x,universe_y,universe_id,universe_t)
end

function draw_remote_station()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*station_fields
        if s!=net_slot()
            number st=arr_get(remote_station,b)
            if st==1
                // Луч рисуем под спрайтом, чтобы он «выходил прямо из центра» турели.
                number rb=s*remote_fields
                if arr_get(remotes,rb+5)==1
                    draw_station_beam(arr_get(remote_station,b+1),arr_get(remote_station,b+2),arr_get(remotes,rb+1),arr_get(remotes,rb+2))
                end
                number rl=net_player_level(s)
                draw_station_at(arr_get(remote_station,b+1),arr_get(remote_station,b+2),net_player_station_hp(s),ebuc_station_hp_for(rl))
            else if st==2
                // Взрыв чужой турели виден и у нас — доигрывает до конца.
                draw_turret_boom(arr_get(remote_station,b+1),arr_get(remote_station,b+2),arr_get(remote_station,b+3))
            end
        end
        s=s+1
    end
end

function draw_remote_universe()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*universe_fields
        if s!=net_slot()&&arr_get(remote_universe,b+1)==1
            draw_universe_at(arr_get(remote_universe,b+2),arr_get(remote_universe,b+3),arr_get(remote_universe,b),arr_get(remote_universe,b+4))
        end
        s=s+1
    end
end

function draw_candies()
    number hw=25*candy_scale, i=0
    loop i<candy_count
        tex(arr_get(candy_x,i)-hw,arr_get(candy_y,i)-hw,CANDY_TEX,0,candy_scale)
        i=i+1
    end
end

function draw_freeze()
    if freeze_a<=0
        return
    end
    number fa=freeze_a*255
    number af=floor(fa*0.3)
    if af<=0
        return
    end
    number half=enemy.size+6
    number fill=(((unsigned)(int)af)<<24)|0x001E88E5
    number ar=floor(fa*0.7)
    number rim=(((unsigned)(int)ar)<<24)|0x004FC3F7
    circle(enemy.x,enemy.y,half,fill)
    ring(enemy.x,enemy.y,half,5,rim)
end

function draw_poison()
    if poison_a<=0
        return
    end
    number fa=poison_a*255
    number af=floor(fa*0.3)
    if af<=0
        return
    end
    number half=enemy.size+6
    number fill=(((unsigned)(int)af)<<24)|0x001E88E5
    number ar=floor(fa*0.7)
    number rim=(((unsigned)(int)ar)<<24)|0x004FC3F7
    circle(enemy.x,enemy.y,half,fill)
    ring(enemy.x,enemy.y,half,5,rim)
end

function draw_player_freeze()
    if pfreeze_a<=0
        return
    end
    number af=floor(pfreeze_a*255*0.3)
    if af<=0
        return
    end
    number half=player.size+6
    number fill=(((unsigned)(int)af)<<24)|0x001E88E5
    number ar=floor(pfreeze_a*255*0.7)
    number rim=(((unsigned)(int)ar)<<24)|0x004FC3F7
    circle(player.x,player.y,half,fill)
    ring(player.x,player.y,half,5,rim)
end

function draw_player_poison()
    if ppoison_a<=0
        return
    end
    number af=floor(ppoison_a*255*0.3)
    if af<=0
        return
    end
    number half=player.size+6
    number fill=(((unsigned)(int)af)<<24)|0x001E88E5
    number ar=floor(ppoison_a*255*0.7)
    number rim=(((unsigned)(int)ar)<<24)|0x004FC3F7
    circle(player.x,player.y,half,fill)
    ring(player.x,player.y,half,5,rim)
