include graphics

// Общий фон арены для соло и онлайна. snow.png — такая же бесшовная плитка
// 256×256, как grass.png. Пока снежный фон не добавлен, оставляем траву.
function draw_arena_background()
    string ground=GRASS
    if candy_enabled==1&&snow_tex_ok==1
        ground=SNOW_TEX
    end
    number y=0
    loop y<screen_h
        number x=0
        loop x<screen_w
            tex(x,y,ground,0,1)
            x=x+arena_tile_size
        end
        y=y+arena_tile_size
    end
end

// Сезонный снег в соло не зависит от Firebase и не включает сетевые ивенты.
// В онлайне снег по-прежнему запускается только событием 2, даже без конфет.
function snow_active()
    if game_state==ST_SOLO
        return candy_enabled==1
    end
    if game_state==ST_ONLINE
        return event_mode==2
    end
    return 0
end

// Отдельные часы погоды: обновляются из главного цикла, даже когда бой уже
// закончился и update_game() больше не двигает бойцов. Снег не замирает.
function update_weather()
    if snow_active()==0
        return
    end
    snow_t=snow_t+dt
    if snow_t>100000
        snow_t=0
    end
end

function hash01(number i)
    number v=sin(i*127.1+11.7)*43758.5453
    return v-floor(v)
end

function frac01(number v)
    return v-floor(v)
end

// Один и тот же эффект для снежного онлайн-ивента и зимнего соло-боя.
function draw_snow()
    if snow_active()==0
        return
    end
    number i=0
    loop i<event_flakes
        // Каждая снежинка живёт свой цикл: появляется в случайной точке,
        // со случайным размером (не больше самой png-снежинки, 64px = scale 1)
        // и, не двигаясь, постепенно уменьшается до нуля. Потом рождается
        // заново в новом месте с новым размером.
        number h1=hash01(i), h2=hash01(i+91)
        number life=2.2+2.6*h1
        number ph=frac01(snow_t/life+h2)
        number cyc=floor(snow_t/life+h2)
        number hx=hash01(i*7+cyc*131+1)
        number hy=hash01(i*13+cyc*197+2)
        number hs=hash01(i*29+cyc*57+3)
        number hr=hash01(i*17+cyc*83+4)
        number s0=0.3+0.7*hs
        number s=s0*(1-ph)
        if s>0.02
            number xx=36+hx*(screen_w-72)
            number yy=36+hy*(screen_h-72)
            number hw=32*s
            tex(xx-hw,yy-hw,SNOWFLAKE_TEX,hr*2*pi,s)
        end
        i=i+1
    end
end
