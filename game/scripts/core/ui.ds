include graphics

// ui — кнопки и HP бары
function hud_bar(number bx, number by, number w, number h, number cur, number max, color color, number from_right)
    roundrect(bx, by, w, h, h / 2, 0xDD171923)
    number shown = cur
    if shown < 0
        shown = 0
    end
    // У тонких баров (полоса HP турели, 7 px) отступ 4 px со всех сторон не
    // помещается: заливка получала высоту h-8 < 0, roundrect её не рисовал,
    // и бар оставался тёмным. Для низких баров отступ уменьшаем.
    number pad = 4
    if h <= 12
        pad = 1
    end
    number fh = h - 2 * pad
    if fh < 1
        fh = 1
    end
    if max > 0
        number fill_w = (w - 2 * pad) * shown / max
        if fill_w > 0
            if from_right == 1
                roundrect(bx + w - pad - fill_w, by + pad, fill_w, fh, fh / 2, color)
            else
                roundrect(bx + pad, by + pad, fill_w, fh, fh / 2, color)
            end
        end
    end
end

function draw_back()
    button(tr_back(), (screen_w - btn_w) / 2, back_y, btn_w, btn_h)
end

function back_hit(number x, number y)
    number bx = (screen_w - btn_w) / 2
    if x >= bx - 12 && x <= bx + btn_w + 12 && y >= back_y - 8 && y <= back_y + btn_h + 8
        return 1
    end
    return 0
end

function ctext(string s, number y, color color)
    text(s, (screen_w - text_ink_width(s)) / 2, y, color)
end

function ctext_scaled(string s, number y, color color, number scale)
    text_scaled(s, (screen_w - text_ink_width(s) * scale) / 2, y, color, scale)
end

// Плавное исчезновение подписей («Не хватает кубков» и т.п.): пока у таймера
// остаётся меньше msg_fade секунд, альфа цвета пропорционально падает, поэтому
// надпись тает, а не пропадает в один кадр.
function fade_color(number rgb, number t, number fade)
    number a = clamp(t / fade, 0, 1)
    return (1 + floor(a * 254)) * 0x1000000 + rgb
end

function ctext_fade(string s, number y, color rgb, number t, number fade)
    ctext(s, y, fade_color(rgb, t, fade))
end

// Ник админа своим цветом, остальной текст — обычный. Нужно и в лобби
// («Hi, "nick"»), и в чате, чтобы краснела/голубела только подпись, а не
// вся строка.
function draw_nick_msg(string nick, string rest, number x, number y, color base, number scale)
    number nw = text_ink_width(nick) * scale
    text_scaled(nick, x, y, admin_color_of(nick, base), scale)
    text_scaled(rest, x + nw, y, base, scale)
end

function text_in_box(string label, number x, number y, number w, number h, color color, number scale)
    // Центруем реальные видимые границы глифов, а не условную базовую линию шрифта.
    // Небольшая оптическая поправка вниз не даёт Play/Играть и подсказкам «уезжать» вверх.
    number tw = text_ink_width(label) * scale
    number th = text_ink_height(label) * scale
    number tt = text_ink_top(label) * scale
    text_scaled(label, x + (w - tw) / 2, y + (h - th) / 2 - tt + 1.5, color, scale)
end

function text_in_field(string label, number x, number y, number h, color color, number scale)
    number th = text_ink_height(label) * scale
    number tt = text_ink_top(label) * scale
    text_scaled(label, x, y + (h - th) / 2 - tt + 1.5, color, scale)
end

function button(string label, number x, number y, number w, number h)
    // Фиолетовый цвет плашки — общий ui_purple из core/config.ds: тот же цвет
    // у тоста о достижении и у карточек полученных наград.
    roundrect(x, y, w, h, 20, ui_purple)
    text_in_box(label, x, y, w, h, 0xFFFFFF, 1)
end

function button_scaled(string label, number x, number y, number w, number h, number scale)
    // Та же кнопка, но текст меньше — для длинных подписей, чтобы не вылезали за рамки.
    roundrect(x, y, w, h, 20, ui_purple)
    text_in_box(label, x, y, w, h, 0xFFFFFF, scale)
end
