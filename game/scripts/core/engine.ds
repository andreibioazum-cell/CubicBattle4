include graphics

function start_transition(number t)
    if t_dir != 0
        return
    end
    t_target = t
    t_dir = 1
end

function update_transition()
    if t_dir == 1
        t_fade = t_fade + dt / transition_duration
        if t_fade >= 1
            t_fade = 1
            t_dir = 2
        end
    else if t_dir == 2
        if game_state == 7 && t_target != 7
            keyboard_hide()
        end
        if game_state == 5 && t_target != 5
            chat_open = 0
            keyboard_hide()
            net_disconnect()
            event_mode = 0
            event_t = 0
        end
        game_state = t_target
        if t_target == 1
            init_game()
        else if t_target == 5
            // проверка бана перед онлайном
            if net_is_banned(net_login_nick()) == 1
                banned_msg = tr_banned()
                game_state = 0
                t_dir = -1
                t_fade = 1
                return
            end
            init_online()
        else if t_target == 6
            console_scroll = 0
        else if t_target == 7
            login_open()
        end
        t_dir = -1
    else if t_dir == -1
        t_fade = t_fade - dt / transition_duration
        if t_fade <= 0
            t_fade = 0
            t_dir = 0
        end
    end
end

function init()
    ds_log("init: loading textures")
    png_load(GRASS)
    png_load(ORDINARY_TEX)
    png_load(PUNCH_TEX)
    png_load(AZUM_TEX)
    png_load(AZUM_PUNCH_TEX)
    png_load(SANTA_TEX)
    png_load(SANTA_PUNCH_TEX)
    png_load(EBUC_TEX)
    png_load(EBUC_PUNCH_TEX)
    png_load(DESPENSER_TEX)
    png_load(CANDY_TEX)
    png_load(SNOWFLAKE_TEX)
    net_set_firebase_key(FB_KEY)
    net_autologin(FIREBASE)
    music_ok = snd_load(LOBBY_MUSIC)
    if music_ok == 1
        music_level = 1
        snd_volume(LOBBY_MUSIC, 0.7)
        snd_loop(LOBBY_MUSIC)
        ds_log("init: lobby music on")
    else
        ds_log("init: no lobby music")
    end
    cups = net_load_cups()
    candies = net_load_candies()
    number ach = net_load_achievement_flags()
    // В скрипте нет битовых операторов — извлекаем каждый бит через сдвиг и парность.
    achievement_welcome = ach - floor(ach*0.5)*2
    achievement_first_win = floor(ach/2) - floor(floor(ach/2)*0.5)*2
    achievement_first_buy = floor(ach/4) - floor(floor(ach/4)*0.5)*2
    achievement_all_characters = floor(ach/8) - floor(floor(ach/8)*0.5)*2
    // Первый запуск игры открывает достижение «Привет!».
    check_achievements()
    player_class = net_load_class()
    azum_owned = net_load_azum()
    santa_owned = net_load_santa()
    ebuc_owned = net_load_ebuc()
    player_level = net_load_level()
    levels_unlocked = net_load_levels_unlocked()
    ordinary_level = net_load_ordinary_level()
    ordinary_levels_unlocked = net_load_ordinary_levels_unlocked()
    azum_level = net_load_azum_level()
    azum_levels_unlocked = net_load_azum_levels_unlocked()
    santa_level = net_load_santa_level()
    santa_levels_unlocked = net_load_santa_levels_unlocked()
    ebuc_level = net_load_ebuc_level()
    ebuc_levels_unlocked = net_load_ebuc_levels_unlocked()
    if levels_unlocked < 0
        levels_unlocked = 0
    end
    if levels_unlocked > max_level
        levels_unlocked = max_level
    end
    if player_level < 0 || player_level > levels_unlocked
        player_level = 0
    end
    if azum_owned == 0 && player_class == 1
        player_class = 0
    end
    if santa_owned == 0 && player_class == 2
        player_class = 0
    end
    if ebuc_owned == 0 && player_class == 3
        player_class = 0
    end
    load_selected_level()
    net_set_class(player_class)
    net_set_level(player_level)
    ds_log("init: ready")
end

function update_music()
    if music_ok == 0
        return
    end
    if game_state == 1 || game_state == 5
        music_level = music_level - dt / music_fade_out_time
        if music_level < 0
            music_level = 0
        end
        snd_volume(LOBBY_MUSIC, 0.7 * music_level)
        if music_level <= 0 && snd_playing(LOBBY_MUSIC) == 1
            snd_stop(LOBBY_MUSIC)
        end
    else
        if snd_playing(LOBBY_MUSIC) == 0
            music_level = 0
            snd_loop(LOBBY_MUSIC)
        end
        music_level = music_level + dt / music_fade_in_time
        if music_level > 1
            music_level = 1
        end
        snd_volume(LOBBY_MUSIC, 0.7 * music_level)
    end
end

function update_warning()
    if warn_open != 1
        return
    end
    warn_t = warn_t + dt
    if warn_t <= warn_hold
        warn_a = 1
        return
    end
    warn_a = 1 - (warn_t - warn_hold) / warn_fade
    if warn_a <= 0
        warn_a = 0
        warn_open = 0
    end
end

// ── Всплывающее уведомление о новом достижении ──────────────────────────
// Тост висит всегда в конце draw(): поверх любого экрана, но ПОД
// предупреждением об эпилепсии. Выглядит как обычная кнопка — та же
// фиолетовая плашка ui_purple и белый текст, без рамки, без кружка-медали
// и без полупрозрачности.
//
// Движение строго вертикальное, тремя фазами:
//   1. ACH_TOAST_FADE_IN — быстрый выезд сверху: плашка стартует целиком за
//      верхним краем и с торможением встаёт на место (home_y);
//   2. ACH_TOAST_HOLD — висит на месте ~1.5 секунды;
//   3. ACH_TOAST_EXIT — уезжает с разгоном прямо вверх и исчезает только
//      тогда, когда полностью ушла за верхний край экрана.
// Альфа не анимируется вовсе: раньше тост «испарялся» почти у самого верха,
// теперь он просто уходит вверх и пропадает там, где его уже не видно.
function tick_achievement_toast()
    if ach_toast_t > 0
        ach_toast_t = ach_toast_t - dt
        if ach_toast_t < 0
            ach_toast_t = 0
        end
    end
end

// Название награды для тоста по её биту.
function achievement_toast_text()
    if ach_toast_bit == ACH_FIRST_WIN
        return tr_achievement_first_win()
    end
    if ach_toast_bit == ACH_FIRST_BUY
        return tr_achievement_first_buy()
    end
    if ach_toast_bit == ACH_ALL_CHARACTERS
        return tr_achievement_grass()
    end
    return tr_achievement_welcome()
end

function draw_achievement_toast()
    if ach_toast_bit <= 0 || ach_toast_t <= 0
        return
    end
    number elapsed = ACH_TOAST_DURATION - ach_toast_t
    // Ширина подстраивается под экран, чтобы на узких ландшафтных
    // устройствах плашка не вылезала за края.
    number w = 460
    if w > screen_w - 32
        w = screen_w - 32
    end
    number h = 70
    number x = (screen_w - w) / 2
    number home_y = 64
    // Сколько пикселей нужно пройти вверх, чтобы плашка целиком ушла за край.
    number off = home_y + h + 8
    number y = home_y
    if elapsed < ACH_TOAST_FADE_IN
        // Фаза 1: выезд сверху с торможением (ease-out).
        number k = elapsed / ACH_TOAST_FADE_IN
        number ease = 1 - (1 - k) * (1 - k)
        y = home_y - off * (1 - ease)
    else if elapsed > ACH_TOAST_FADE_IN + ACH_TOAST_HOLD
        // Фаза 3: уход строго вверх с разгоном (ease-in), без затухания цвета.
        number k2 = (elapsed - ACH_TOAST_FADE_IN - ACH_TOAST_HOLD) / ACH_TOAST_EXIT
        if k2 > 1
            k2 = 1
        end
        y = home_y - off * k2 * k2
    end
    // Плашку не рисуем, пока она полностью за верхним краем — ни на входе,
    // ни на выходе: исчезновение выглядит как уход вверх, а не как испарение.
    if y + h <= 0
        return
    end
    roundrect(x, y, w, h, 20, ui_purple)
    // Две строки белого текста: заголовок «ДОСТИЖЕНИЕ» и название награды.
    // Центрируем их одним блоком по реальным границам глифов (как text_in_box
    // в core/ui.ds), а не по базовой линии — иначе в английском и русском
    // плашка выглядит по-разному.
    string head = tr_achievement_toast_title()
    string body = achievement_toast_text()
    number hs = 0.42, bs = 0.62, gap = 6
    number hh = text_ink_height(head) * hs, ht = text_ink_top(head) * hs
    number bh = text_ink_height(body) * bs, bt = text_ink_top(body) * bs
    number top = y + (h - hh - gap - bh) / 2
    ctext_scaled(head, top - ht, 0xFFFFFF, hs)
    ctext_scaled(body, top + hh + gap - bt, 0xFFFFFF, bs)
end

function update()
    update_warning()
    update_transition()
    update_music()
    tick_achievement_toast()
    if game_state == 1
        update_game()
    else if game_state == 5
        update_online()
    else if game_state == 7
        update_login()
    end
end

function draw()
    if game_state == 0
        draw_lobby()
    else if game_state == 1
        draw_game()
    else if game_state == 2
        draw_modes()
    else if game_state == 4
        draw_settings()
    else if game_state == 7
        draw_login()
    else if game_state == 8
        draw_classes()
    else if game_state == 9
        draw_levels()
    else if game_state == 10
        draw_leaderboard()
    else if game_state == 11
        draw_achievements()
    else
        draw_online()
    end
    if t_fade > 0
        rect(0, 0, screen_w, screen_h, (1 + floor(t_fade * 254)) * 0x1000000)
    end
    // Полноэкранное предупреждение поверх всего, включая фейд перехода.
    if warn_open == 1
        draw_warning()
    end
    // Уведомление о достижении — над всем, но под предупреждением.
    draw_achievement_toast()
end

function touch(number x, number y, number action, number id)
    if t_dir != 0
        return
    end
    // Пока висит предупреждение, нажатия в меню не проходят и не закрывают его:
    // экран сам тает через 2.5 с, кнопки OK нет.
    if warn_open == 1
        return
    end
    if game_state == 0
        touch_lobby(x, y, action)
    else if game_state == 1 || game_state == 5
        touch_game(x, y, action, id)
    else
        touch_menu(x, y, action)
    end
end
