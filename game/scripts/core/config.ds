public number show_hitboxes=1
-- Hitboxes share one colour and one alpha across all zones (punch, snowball,
-- dash, universe): hitbox_rgb plus hitbox_zone_alpha. Per-zone alphas and
-- colours made the zones look like different things. Nothing is rounded here:
-- hitbox_corner is gone, rectangular zones use rect or rect_rot, and roundrect
-- is not used at all because its pipeline does not blend, so it would draw
-- opaque.
public number hitbox_rgb=0x00000000
public number hitbox_zone_alpha=96
public number hitbox_fade_in=0.16, hitbox_fade_out=0.26
