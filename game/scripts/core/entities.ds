include graphics

object Player
    number x=0, y=0, size=30, angle=0, hp=10, max_hp=10
end

object Enemy
    // state: 0=сближение, 1=замах, 2=удар, 3=отход, 4=уклонение, 5=спавн
    number x=0, y=0, size=25, hp=10, max_hp=10, angle=0, state=0, state_time=0, cooldown=0, hit=0
    number strafe=1, dodge_cd=0, think=0, px=0, py=0, pvx=0, pvy=0, seen=0, flank=0
    number mvx=0, mvy=0, svx=0, svy=0, freeze=0, freeze_slow=1, poison=0, poison_tick=0, poison_damage=0
    // человечные дополнения
    number spawn_t=0, wobble=0, wobble_t=0, react=0, speed_var=1, miss_t=0, dodge_fail=0
    number aim_err=0, hesit=0, feint=0
end

object Punch
    number x=0, y=0, dx=0, dy=0, active=0, shot=0, hit=0
end

object Gift
    number x=0, y=0, dx=0, dy=0, active=0, t=0, shot=0
end

object Station
    number x=0, y=0, hp=0, max_hp=0, active=0, shot=0
end

Player player=new Player()
