public function has_achievement(number bit)
    local number shifted = floor(achievement_mask / bit)
    return shifted - floor(shifted * 0.5) * 2
end
public function show_achievement_toast(number bit)
    ach_toast_bit = bit
    ach_toast_t = ACH_TOAST_DURATION
end
public function grant_achievement(number bit)
    if has_achievement(bit) == 1 then
        return 0
    end
    achievement_mask = achievement_mask + bit
    net_mark_achievement_flag(bit)
    show_achievement_toast(bit)
    return 1
end
public function check_achievements()
    if class_owned_of(CLASS_AZUM) == 1 && class_owned_of(CLASS_SANTA) == 1 && class_owned_of(CLASS_EBUC) == 1 then
        grant_achievement(ACH_ALL_CHARACTERS)
    end
end
public function save_progress()
    -- The battle pass is gone, but its progress field is kept so old saves still
    -- read without shifting the other fields.
    local number bp_lv = net_load_bp_level()
    net_save_progress_all(cups, candies, player_class,
        class_owned_of(CLASS_AZUM), class_owned_of(CLASS_SANTA), class_owned_of(CLASS_EBUC),
        player_level, levels_unlocked,
        class_level_of(CLASS_ORDINARY), class_unlocked_of(CLASS_ORDINARY),
        class_level_of(CLASS_AZUM), class_unlocked_of(CLASS_AZUM),
        class_level_of(CLASS_SANTA), class_unlocked_of(CLASS_SANTA),
        class_level_of(CLASS_EBUC), class_unlocked_of(CLASS_EBUC),
        bp_lv, skin_flags())
    progress_push_to_net()
end
-- The two skins share one saved field: bit 0 is the Azum zombie, bit 1 is the
-- ebuC elf. Old saves hold a plain 0 or 1 and still read as the zombie flag.
public function skin_flags()
    local number f = 0
    if azum_skin == SKIN_SPECIAL then
        f = f + 1
    end
    if ebuc_skin == SKIN_SPECIAL then
        f = f + 2
    end
    return f
end
public function progress_push_to_net()
    net_set_class(player_class)
    net_set_level(player_level)
    -- Only the skin of the class being played goes online.
    net_set_skin(current_skin())
end
public function progress_normalize()
    if azum_skin < SKIN_NORMAL || azum_skin >= SKIN_COUNT then
        azum_skin = SKIN_NORMAL
    end
    if ebuc_skin < SKIN_NORMAL || ebuc_skin >= SKIN_COUNT then
        ebuc_skin = SKIN_NORMAL
    end
    if azum_skin == SKIN_ZOMBIE && has_achievement(ACH_LEGENDS) == 0 then
        azum_skin = SKIN_NORMAL
    end
    local number cls = CLASS_ORDINARY
    while cls < class_count do
        local number un = clamp(class_unlocked_of(cls), 0, max_level)
        local number lv = class_level_of(cls)
        if lv < 0 || lv > un then
            lv = 0
        end
        set_class_progress(cls, lv, un)
        cls = cls + 1
    end
    if player_class < 0 || player_class >= class_count || class_owned_of(player_class) == 0 then
        player_class = CLASS_ORDINARY
    end
    levels_unlocked = clamp(levels_unlocked, 0, max_level)
    if player_level < 0 || player_level > levels_unlocked then
        player_level = 0
    end
end
public function progress_from_storage()
    cups = net_load_cups()
    candies = net_load_candies()
    achievement_mask = net_load_achievement_flags()
    azum_revive_count = net_load_azum_revives()
    player_class = net_load_class()
    set_class_owned(CLASS_AZUM, net_load_azum())
    set_class_owned(CLASS_SANTA, net_load_santa())
    set_class_owned(CLASS_EBUC, net_load_ebuc())
    player_level = net_load_level()
    levels_unlocked = net_load_levels_unlocked()
    set_class_progress(CLASS_ORDINARY, net_load_ordinary_level(), net_load_ordinary_levels_unlocked())
    set_class_progress(CLASS_AZUM, net_load_azum_level(), net_load_azum_levels_unlocked())
    set_class_progress(CLASS_SANTA, net_load_santa_level(), net_load_santa_levels_unlocked())
    set_class_progress(CLASS_EBUC, net_load_ebuc_level(), net_load_ebuc_levels_unlocked())
    local number skins = net_load_azum_skin()
    ebuc_skin = SKIN_NORMAL
    if skins >= 2 then
        ebuc_skin = SKIN_SPECIAL
        skins = skins - 2
    end
    azum_skin = skins
    if azum_skin == SKIN_ZOMBIE && has_achievement(ACH_LEGENDS) == 0 then
        grant_achievement(ACH_LEGENDS)
    end
    progress_normalize()
    sync_selected_class()
    progress_push_to_net()
    check_achievements()
    quest_load()
end
-- There is no fps cap or upscale anymore, so there is nothing to read or write:
-- the old "fps" and "scale" lines in settings.dat are ignored.
public function settings_from_storage()
    language = net_load_language()
    show_hitboxes = net_load_hitboxes()
    music_volume = net_load_music_volume()
    winter_theme = net_load_winter_theme()
    show_fps = net_load_fps_meter()
end
public function save_settings()
    net_save_settings(language, show_hitboxes)
    net_save_winter_theme(winter_theme)
    net_save_fps_meter(show_fps)
end
-- The music button cycles the volume: off (0), on (100), 50 per cent of the
-- sound volume, then off again. The value is saved at once and applied to the
-- music that is playing.
public function music_volume_cycle()
    if music_volume <= 0 then
        music_volume = 100
    else if music_volume >= 100 then
        music_volume = 50
    else
        music_volume = 0
    end
    net_save_music_volume(music_volume)
    if music_ok == 1 then
        snd_volume(LOBBY_MUSIC, music_volume / 100 * music_level)
    end
end
