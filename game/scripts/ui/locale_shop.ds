-- Shop and class strings: HP, strength, the shop, candies and the class names
-- with their mottos, RU/EN like every locale module.

public function tr_hp()
    if language == 1 then
        return "Здоровье"
    end
    return "HP"
end
public function tr_strength()
    if language == 1 then
        return "Сила"
    end
    return "Power"
end
