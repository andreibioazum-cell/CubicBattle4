include graphics

// ══════════════════════════════════════════════════════════════════════════
// menu.ds — экраны меню: лобби, режимы, настройки, классы, уровни, скины,
// достижения, батл пасс, таблица лидеров и вход по нику.
//
// Модуль тонкий намеренно. Каждый экран делает ровно две вещи:
//   draw_*(...)  — «что нарисовать»;
//   touch_*(...) — «куда нажали и что вызвать».
// Всё остальное вынесено:
//   координаты       → ui/layout.ds   (одни и те же функции в draw_* и touch_*)
//   покупки/прогресс → ui/progress.ds (деньги, уровни, скины, достижения)
//   примитивы        → core/ui.ds     (кнопки, карточки, плашки, текст)
//   числа            → core/config.ds (размеры, цвета, цены)
//   переводы         → ui/locale.ds   (весь текст обоих языков)
// ══════════════════════════════════════════════════════════════════════════

// ── Колонка кнопок: лобби, режимы, настройки ──────────────────────────────
function draw_menu_button(number row, string label)
    button(label, menu_x(), menu_row(row), btn_w, btn_h)
end

function draw_lobby_nick()
    if net_login_status() != 2
        return
    end
    string nick = net_login_nick()
    if str_len(nick) == 0
        return
    end
    // Цвет только у ника: «Привет, "» и закрывающая кавычка остаются белыми.
    string pre = tr_hello_pre()
    string post = tr_hello_post()
    number scale = 0.5
    number pw = text_ink_width(pre) * scale
    number nw = text_ink_width(nick) * scale
    number qw = text_ink_width(post) * scale
    number x = (screen_w - pw - nw - qw) / 2
    number y = lobby_hello_y()
    text_scaled(pre, x, y, text_color, scale)
    text_scaled(nick, x + pw, y, admin_color_of(nick, text_color), scale)
    text_scaled(post, x + pw + nw, y, text_color, scale)
end

// Кошелёк лобби: «Кубки: 120  Леденцы: 7» одной строкой под меню. Формируется
// из переводов (tr_cups/tr_candies), размер и место — в config.ds и layout.ds.
function draw_lobby_money()
    string cup_s = tr_cups() + ": " + cups
    string cd_s = tr_candies() + ": " + candies
    money_pair(cup_s, cd_s, lobby_money_y(), money_scale, money_gap)
end

function draw_lobby()
    check_achievements()
    screen_fill()
    ctext("Cubic Battle 4", lobby_title_y(), text_color)
    draw_menu_button(0, tr_play())
    draw_menu_button(1, tr_settings())
    draw_menu_button(2, tr_shop())
    draw_menu_button(3, tr_account())
    draw_menu_button(4, tr_achievements())
    draw_lobby_nick()
    draw_lobby_money()
    if str_len(banned_msg) > 0
        ctext(banned_msg, lobby_msg_y(), text_color)
    end
    // Кнопка «???» в левом нижнем углу — вход в хэллоуинский батл пасс.
    button_scaled("???", lobby_bp_x(), lobby_bp_y(), btn_w, btn_h, 0.9)
end

function draw_modes()
    screen_fill()
    draw_menu_button(0, tr_back())
    draw_menu_button(1, tr_solo())
    draw_menu_button(2, tr_online())
    draw_menu_button(3, tr_leaderboard())
end

function draw_settings()
    screen_fill()
    draw_menu_button(0, tr_back())
    draw_menu_button(1, "English")
    draw_menu_button(2, "Русский")
end

// ── Экран классов ─────────────────────────────────────────────────────────
// Карточка класса: спрайт, название, девиз, уровень и кнопка действия.
// Азум в скине «Зомби» ходит своей текстурой (legacy_zombie_azum.png); если
// файлы не загрузились — прежний зелёный силуэт.
function draw_class_card(number cls)
    number x = classes_card_x(cls)
    number w = classes_card_w()
    number selected = 0
    if player_class == cls && class_owned_of(cls) == 1
        selected = 1
    end
    card(x, classes_top(), w, class_card_h, selected)
    number scale = class_sprite_scale()
    number sprite = 50 * scale
    number sx = x + (w - sprite) / 2
    if class_skin_active(cls) == 1
        if zombie_tex_ok() == 1
            tex(sx, class_sprite_y(), AZUM_ZOMBIE_TEX, 0, scale)
        else
            tex_tint(sx, class_sprite_y(), class_idle_tex(cls), 0, scale, zombie_tint)
        end
    else
        tex(sx, class_sprite_y(), class_idle_tex(cls), 0, scale)
    end
    centered_text(class_name_of(cls), x, w, class_title_y(), text_color, 1)
    centered_text(class_desc_of(cls), x, w, class_desc_y(), text_color, 0.5)
    centered_text(tr_level() + " " + class_level_of(cls), x, w, class_level_y(), text_color, 0.45)
    button_scaled(class_pick_label(cls), x + class_pick_inset(), class_pick_y(), class_pick_w(), class_pick_h, 0.55)
end

// Два бара выбранного класса: здоровье красное, сила голубая. Здоровье —
// живучесть в бою (у Азума с возрождением жизней вдвое больше), сила —
// реальный урон удара.
function draw_stat_row(string label, number x, number y, number w, number h, number cur, number maxv, color c)
    text_scaled(label, x, y - 26, text_color, 0.5)
    hud_bar(x, y, w, h, cur, maxv, c, 0)
end

function draw_class_stats()
    number w = stat_bar_w()
    number x = center_x(w)
    number hp = class_hp_of(player_class)
    number power = class_power_of(player_class)
    ctext_scaled(class_desc_of(player_class), stat_motto_y(), text_color, 0.8)
    draw_stat_row(tr_hp() + ": " + hp, x, stat_hp_y(), w, stat_bar_h(), hp, 20, stat_hp_color)
    draw_stat_row(tr_strength() + ": " + power, x, stat_power_y(), w, stat_bar_h(), power, 2, stat_power_color)
end

function draw_classes()
    screen_fill()
    number cls = 0
    loop cls < class_count
        draw_class_card(cls)
        cls = cls + 1
    end
    // Под карточками пара кнопок: слева «Уровни», справа «Скины», середина
    // пустая. Скины есть только у Азума — у остальных классов правой кнопки
    // нет вообще, а «Уровни» не переезжают, чтобы не прыгать при смене класса.
    button_scaled(tr_levels(), levels_btn_x(), class_actions_y(), class_action_w(), btn_h, 0.9)
    if skins_btn_visible() == 1
        button_scaled(tr_skins(), skins_btn_x(), class_actions_y(), class_action_w(), btn_h, 0.9)
    end
    class_msg_t = tick_down(class_msg_t)
    draw_msg(class_msg_text(), class_msg_y(), class_msg_t)
    draw_class_stats()
    draw_back()
end

// ── Экран уровней выбранного класса ───────────────────────────────────────
function draw_level_row(number n)
    number x = levels_x()
    number w = levels_w()
    number y = levels_row_y(n)
    number selected = 0
    if player_level == n && n <= levels_unlocked
        selected = 1
    end
    card(x, y, w, level_row_h, selected)
    centered_text(tr_level() + " " + n, x, w, y + 10, text_color, 0.62)
    centered_text(tr_class_level_effect(player_class, n), x, w, y + 34, text_color, 0.46)
    centered_text(level_status_of(player_class, n), x, w, y + 52, text_color, 0.42)
end

function draw_levels()
    screen_fill()
    screen_title(tr_levels_for_class() + " · " + class_name())
    number n = 1
    loop n <= max_level
        draw_level_row(n)
        n = n + 1
    end
    level_msg_t = tick_down(level_msg_t)
    draw_msg(level_msg_text(), levels_msg_y(), level_msg_t)
    draw_back()
end

// ── Экран скинов (пока только Азум) ───────────────────────────────────────
// Карточка скина: превью, название и статус. Закрытый скин темнее на 25% —
// и плашка, и текст, и само превью (locked_shade): превью закрытого зомби —
// тёмно-зелёный силуэт его формы, открытый — настоящая текстура.
function draw_skin_card(number skin)
    number x = skins_card_x(skin)
    number w = skin_card_w
    number locked = 1 - skin_unlocked(skin)
    number selected = 0
    if azum_skin == skin
        selected = 1
    end
    card_state(x, skins_top(), w, skin_card_h, selected, locked)
    number scale = skin_preview_scale()
    number sprite = 50 * scale
    number sx = x + (w - sprite) / 2
    if skin == SKIN_ZOMBIE
        if locked == 1
            tex_tint(sx, skin_preview_y(), zombie_idle_tex(), 0, scale, shade(zombie_tint, locked_shade))
        else if zombie_tex_ok() == 1
            tex(sx, skin_preview_y(), AZUM_ZOMBIE_TEX, 0, scale)
        else
            tex_tint(sx, skin_preview_y(), azum_idle_tex(), 0, scale, zombie_tint)
        end
    else
        tex(sx, skin_preview_y(), azum_idle_tex(), 0, scale)
    end
    color c = panel_text(locked)
    string status = tr_skin_bp_hint()
    if locked == 0
        status = tr_class_pick()
        if selected == 1
            status = tr_class_selected()
        end
    end
    centered_text(skin_name_of(skin), x, w, skin_name_y(), c, 0.8)
    centered_text(status, x, w, skin_status_y(), c, 0.45)
end

function draw_skins()
    screen_fill()
    screen_title(tr_skins_title())
    number skin = 0
    loop skin < SKIN_COUNT
        draw_skin_card(skin)
        skin = skin + 1
    end
    skin_msg_t = tick_down(skin_msg_t)
    draw_msg(tr_skin_zombie_locked(), skins_msg_y(), skin_msg_t)
    draw_back()
end

// ── Экран достижений ──────────────────────────────────────────────────────
// Список наград экрана: индекс → бит, название, описание. Одна таблица на
// отрисовку и на статус: чтобы добавить награду, нужна одна строка здесь.
function achievement_count()
    return 4
end

function achievement_bit(number i)
    if i == 1
        return ACH_FIRST_WIN
    end
    if i == 2
        return ACH_FIRST_BUY
    end
    if i == 3
        return ACH_ALL_CHARACTERS
    end
    return ACH_WELCOME
end

function achievement_title(number i)
    if i == 1
        return tr_achievement_first_win()
    end
    if i == 2
        return tr_achievement_first_buy()
    end
    if i == 3
        return tr_achievement_grass()
    end
    return tr_achievement_welcome()
end

function achievement_desc(number i)
    if i == 1
        return tr_achievement_first_win_desc()
    end
    if i == 2
        return tr_achievement_first_buy_desc()
    end
    if i == 3
        return tr_achievement_grass_desc()
    end
    return tr_achievement_welcome_desc()
end

// Карточка награды: полученная — яркий фиолетовый, закрытая — тот же цвет на
// 25% темнее и текст темнее (panel/panel_text из core/ui.ds). Никаких кружков
// и счётчиков «N из M»: статус виден по яркости и подписи.
function draw_achievement_card(number i)
    number locked = 1 - has_achievement(achievement_bit(i))
    number x = ach_x()
    number y = ach_card_y(i)
    panel(x, y, ach_w(), ach_card_h, locked)
    color c = panel_text(locked)
    string status = tr_achievement_open()
    if locked == 1
        status = tr_achievement_locked()
    end
    text_scaled(achievement_title(i), x + card_text_pad, y + 14, c, 0.62)
    text_scaled(achievement_desc(i), x + card_text_pad, y + 46, c, 0.46)
    text_scaled(status, x + card_text_pad, y + 70, c, 0.42)
end

function draw_achievements()
    check_achievements()
    screen_fill()
    screen_title(tr_achievements_title())
    number i = 0
    loop i < achievement_count()
        draw_achievement_card(i)
        i = i + 1
    end
    draw_back()
end

// ── Хэллоуинский батл пасс ────────────────────────────────────────────────
// Пять уровней по bp_cost кубков, покупаются по порядку. Купленный и
// доступный для покупки уровни — яркий фиолетовый, закрытые — на 25% темнее
// (и плашка, и текст).
function draw_bp_row(number n)
    number state = bp_row_state(n)
    number locked = 0
    if state == 0
        locked = 1
    end
    number x = bp_x()
    number y = bp_row_y(n)
    number w = bp_w()
    panel(x, y, w, bp_row_h, locked)
    color c = panel_text(locked)
    string status = tr_bp_locked()
    if state == 2
        status = tr_bp_bought()
    else if state == 1
        status = tr_bp_buy() + " (" + bp_cost + " " + tr_cups_unit() + ")"
    end
    text_scaled(tr_bp_level() + " " + n, x + card_text_pad, y + 12, c, 0.62)
    text_scaled(bp_reward_text(n), x + card_text_pad, y + 38, c, 0.46)
    rtext_in_box(status, x, y + 14, w, card_text_pad, c, 0.46)
end

function draw_battlepass()
    screen_fill()
    // Заголовка сверху нет — список уровней начинается сразу под «Назад».
    number n = 1
    loop n <= bp_max
        draw_bp_row(n)
        n = n + 1
    end
    bp_msg_t = tick_down(bp_msg_t)
    draw_msg(bp_msg_text(), bp_msg_y(), bp_msg_t)
    draw_back()
end

// ── Таблица лидеров ───────────────────────────────────────────────────────
// Подиум: 1 — золото, 2 — монохромное серебро, 3 — бронза. Цветной осталась
// только подложка строки: текст белый, и лишь ник админа — красный/голубой.
function lb_place_bg(number i)
    if i == 0
        return 0xFF3D3215
    end
    if i == 1
        return 0xFF2E2E30
    end
    if i == 2
        return 0xFF3A2414
    end
    return card_bg
end

function draw_lb_row(number i)
    number x = lb_x()
    number y = lb_row_y(i)
    number w = lb_w()
    roundrect(x, y, w, lb_row_h, 12, lb_place_bg(i))
    string place = "#" + (i + 1)
    string nick = net_leaderboard_nick(i)
    string cup_s = "" + floor(net_leaderboard_cups(i) + 0.5)
    number scale = 0.6
    number th = text_ink_height(place) * scale
    number tt = text_ink_top(place) * scale
    number ty = y + (lb_row_h - th) / 2 - tt + 1
    text_scaled(place, x + card_text_pad, ty, text_color, scale)
    // Ник админа и в таблице лидеров своим цветом: красный у главного,
    // голубой у второго, у остальных — обычный белый.
    text_scaled(nick, x + 70, ty, admin_color_of(nick, text_color), scale)
    number cw = text_ink_width(cup_s) * scale
    text_scaled(cup_s, x + w - card_text_pad - cw, ty, text_color, scale)
end

function draw_leaderboard()
    screen_fill()
    screen_title(tr_leaderboard_title())
    number st = net_leaderboard_status()
    if st == 1
        lb_wait = lb_wait + dt
        if lb_wait > lb_wait_max
            ctext(tr_no_connection(), screen_h / 2, text_color)
        else
            ctext(tr_loading(), screen_h / 2, text_color)
        end
        draw_back()
        return
    end
    if st == 4
        ctext(tr_no_connection(), screen_h / 2, text_color)
        draw_back()
        return
    end
    number count = net_leaderboard_count()
    if count == 0
        ctext(tr_no_data(), screen_h / 2, text_color)
    else
        number i = 0
        loop i < count
            draw_lb_row(i)
            i = i + 1
        end
    end
    draw_back()
end

// ── Экран входа ───────────────────────────────────────────────────────────
function login_error_text()
    if login_status == 4
        return tr_no_connection()
    end
    if login_status == 5
        return tr_bad_nick()
    end
    if login_status == 6
        return tr_wrong_pass()
    end
    if login_status == 7
        return tr_bad_pass()
    end
    return ""
end

// Одно поле формы: подпись сверху, плашка, текст и курсор, если поле активно
// и клавиатура открыта. Оба поля (ник и пароль) рисуются одной функцией.
function draw_login_field(string label, string value, string placeholder, number y, number focused)
    text(label, login_x() + login_lab_ox, y - login_lab, text_color)
    roundrect(login_x(), y, login_w, login_fh, field_radius, card_bg)
    number caret = 0
    if focused == 1 && keyboard_visible() == 1
        caret = 1
    end
    string shown = value
    if str_len(value) == 0 && caret == 0
        shown = placeholder
    end
    if caret == 1
        shown = value + "|"
    end
    text_in_field(shown, login_x() + field_text_pad, y, login_fh, text_color, 0.6)
end

function draw_login()
    screen_fill()
    // Заголовка сверху нет: экран и так подписан кнопкой «Аккаунт», а форма
    // из двух полей читается без него.
    draw_login_field(tr_nick(), login_nick, tr_nick_ph(), login_nick_y(), login_field == 1)
    draw_login_field(tr_pass(), login_pass, tr_pass_ph(), login_pass_y(), login_field == 2)
    button_scaled(tr_login_btn(), login_btn_x(), login_btn_y(), login_btn_w, btn_h, 0.65)
    string err = login_error_text()
    if str_len(err) > 0
        ctext(err, login_msg_y(), text_color)
    end
    draw_back()
end

function login_sync_field()
    if keyboard_visible() == 0
        return
    end
    if login_field == 1
        login_nick = keyboard_get_text()
    else
        login_pass = keyboard_get_text()
    end
end

// Перевести фокус в поле: забрать текущий текст из клавиатуры, подставить
// своё значение и показать клавиатуру заново.
function login_focus(number field, string value)
    login_sync_field()
    login_field = field
    keyboard_clear()
    if str_len(value) > 0
        keyboard_type(value)
    end
    keyboard_show()
end

function login_focus_nick()
    login_focus(1, login_nick)
end

function login_focus_pass()
    login_focus(2, login_pass)
end

function login_open()
    login_field = 1
    login_status = 0
    login_nick = ""
    login_pass = ""
    keyboard_clear()
    keyboard_hide()
end

function login_do()
    login_sync_field()
    if str_len(login_nick) == 0
        login_status = 5
        keyboard_hide()
        return
    end
    if str_len(login_pass) == 0
        login_status = 7
        keyboard_hide()
        return
    end
    number res = net_auth(FIREBASE, login_nick, login_pass)
    if res != 2
        login_status = res
        return
    end
    login_status = 0
    keyboard_hide()
    keyboard_clear()
    // Прогресс этого ника читаем одним вызовом: та же функция, что и при
    // старте игры (engine.init), поэтому расхождений между «зашёл» и
    // «перезапустил» больше не бывает.
    progress_from_storage()
    start_transition(login_after)
end

function update_login()
    if keyboard_visible() == 1
        login_sync_field()
    end
    if keyboard_enter_pressed() == 1
        if login_field == 1
            login_focus_pass()
        else
            login_do()
        end
    end
end

// ── Предупреждение об эпилепсии ───────────────────────────────────────────
// Полноэкранное: чёрный фон, оба языка сразу, белый WARNING/ВНИМАНИЕ, без
// кнопки. Альфа из warn_a — после warn_hold секунд надпись и фон плавно тают.
function warn_rgb(number rgb)
    return (1 + floor(warn_a * 254)) * 0x1000000 + rgb
end

function draw_warning()
    rect(0, 0, screen_w, screen_h, warn_rgb(0))
    // Один цвет на заголовки и строки — отличаются только размером.
    color body = warn_rgb(text_color)
    number y = screen_h / 2 - 196
    ctext_scaled(tr_warn_title_en(), y, body, 1.15)
    ctext_scaled(tr_warn_en1(), y + 48, body, 0.52)
    ctext_scaled(tr_warn_en2(), y + 76, body, 0.52)
    ctext_scaled(tr_warn_en3(), y + 104, body, 0.52)
    ctext_scaled(tr_warn_en4(), y + 132, body, 0.52)
    ctext_scaled(tr_warn_title_ru(), y + 186, body, 1.15)
    ctext_scaled(tr_warn_ru1(), y + 234, body, 0.52)
    ctext_scaled(tr_warn_ru2(), y + 262, body, 0.52)
    ctext_scaled(tr_warn_ru3(), y + 290, body, 0.52)
    ctext_scaled(tr_warn_ru4(), y + 318, body, 0.52)
end

// ══════════════════════════════════════════════════════════════════════════
// Нажатия
// ══════════════════════════════════════════════════════════════════════════

// Зайти в онлайн: если сессии нет — сначала форма входа, если ник в бане —
// обратно в лобби с сообщением.
function open_online()
    if net_login_status() != 2
        login_after = ST_ONLINE
        start_transition(ST_LOGIN)
        return
    end
    if net_is_banned(net_login_nick()) == 1
        banned_msg = tr_banned()
        start_transition(ST_LOBBY)
        return
    end
    start_transition(ST_ONLINE)
end

function open_leaderboard()
    lb_wait = 0
    net_leaderboard_fetch(FIREBASE)
    start_transition(ST_LEADERBOARD)
end

function touch_lobby(number x, number y, number action)
    if action != 0
        return
    end
    // «???» слева снизу — вход в батл пасс.
    if hit_lobby_bp(x, y) == 1
        start_transition(ST_BATTLEPASS)
        return
    end
    if hit_menu_row(x, y, 0) == 1
        start_transition(ST_MODES)
        return
    end
    if hit_menu_row(x, y, 1) == 1
        start_transition(ST_SETTINGS)
        return
    end
    if hit_menu_row(x, y, 2) == 1
        start_transition(ST_CLASSES)
        return
    end
    if hit_menu_row(x, y, 3) == 1
        login_after = ST_LOBBY
        start_transition(ST_LOGIN)
        return
    end
    if hit_menu_row(x, y, 4) == 1
        start_transition(ST_ACHIEVEMENTS)
    end
end

// Экраны-колонки (режимы и настройки): одинаковая сетка, разные пункты.
function touch_modes(number x, number y)
    if hit_menu_row(x, y, 0) == 1
        start_transition(ST_LOBBY)
        return
    end
    if hit_menu_row(x, y, 1) == 1
        start_transition(ST_SOLO)
        return
    end
    if hit_menu_row(x, y, 2) == 1
        open_online()
        return
    end
    if hit_menu_row(x, y, 3) == 1
        open_leaderboard()
    end
end

function touch_settings(number x, number y)
    if hit_menu_row(x, y, 0) == 1
        start_transition(ST_LOBBY)
        return
    end
    if hit_menu_row(x, y, 1) == 1
        language = 0
        return
    end
    if hit_menu_row(x, y, 2) == 1
        language = 1
    end
end

function touch_classes(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_LOBBY)
        return
    end
    if hit_levels_btn(x, y) == 1
        start_transition(ST_LEVELS)
        return
    end
    if hit_skins_btn(x, y) == 1
        start_transition(ST_SKINS)
        return
    end
    number cls = 0
    loop cls < class_count
        if hit_class_card(x, y, cls) == 1
            pick_class(cls)
            return
        end
        cls = cls + 1
    end
end

function touch_levels(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_CLASSES)
        return
    end
    number n = 1
    loop n <= max_level
        if hit_level_row(x, y, n) == 1
            level_action(player_class, n)
            return
        end
        n = n + 1
    end
end

function touch_skins(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_CLASSES)
        return
    end
    number skin = 0
    loop skin < SKIN_COUNT
        if hit_skin_card(x, y, skin) == 1
            pick_skin(skin)
            return
        end
        skin = skin + 1
    end
end

function touch_achievements(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_LOBBY)
    end
end

function touch_battlepass(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_LOBBY)
        return
    end
    number n = 1
    loop n <= bp_max
        if hit_bp_row(x, y, n) == 1
            buy_bp_level(n)
            return
        end
        n = n + 1
    end
end

function touch_leaderboard(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_MODES)
    end
end

function touch_login(number x, number y, number action)
    if action != 0
        return
    end
    if hit_login_field(x, y, login_nick_y()) == 1
        login_focus_nick()
        return
    end
    if hit_login_field(x, y, login_pass_y()) == 1
        login_focus_pass()
        return
    end
    if hit_login_btn(x, y) == 1
        login_do()
        keyboard_hide()
        return
    end
    login_sync_field()
    keyboard_hide()
    if back_hit(x, y) == 1
        keyboard_clear()
        if login_after == ST_ONLINE
            start_transition(ST_MODES)
        else
            start_transition(ST_LOBBY)
        end
    end
end

// Роутер нажатий для всех экранов, кроме лобби и боя: один экран — одна
// ветка, никаких общих «if y >= sy + 152» на несколько экранов сразу.
function touch_menu(number x, number y, number action)
    if action != 0
        return
    end
    if game_state == ST_MODES
        touch_modes(x, y)
        return
    end
    if game_state == ST_SETTINGS
        touch_settings(x, y)
        return
    end
    if game_state == ST_LOGIN
        touch_login(x, y, action)
        return
    end
    if game_state == ST_CLASSES
        touch_classes(x, y, action)
        return
    end
    if game_state == ST_LEVELS
        touch_levels(x, y, action)
        return
    end
    if game_state == ST_SKINS
        touch_skins(x, y, action)
        return
    end
    if game_state == ST_ACHIEVEMENTS
        touch_achievements(x, y, action)
        return
    end
    if game_state == ST_BATTLEPASS
        touch_battlepass(x, y, action)
        return
    end
    if game_state == ST_LEADERBOARD
        touch_leaderboard(x, y, action)
    end
end
