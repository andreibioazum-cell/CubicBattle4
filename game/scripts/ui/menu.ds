include graphics

function class_name()
if player_class==1; return tr_class_azum(); end
if player_class==2; return tr_class_santa(); end
return tr_class_ordinary()
end
function class_level_for(number cls)
if cls==1; return azum_level; end
if cls==2; return santa_level; end
return ordinary_level
end
function class_levels_unlocked_for(number cls)
if cls==1; return azum_levels_unlocked; end
if cls==2; return santa_levels_unlocked; end
return ordinary_levels_unlocked
end
function class_owned(number cls)
if cls==0; return 1; end
if cls==1; return azum_owned; end
if cls==2; return santa_owned; end
return 0
end
function load_selected_level()
if player_class==1; player_level=azum_level; levels_unlocked=azum_levels_unlocked
else if player_class==2; player_level=santa_level; levels_unlocked=santa_levels_unlocked
else; player_level=ordinary_level; levels_unlocked=ordinary_levels_unlocked; end
end
function save_progress()
// Сохраняем алиас выбранного класса и все три независимые ветки.
if player_class==1; azum_level=player_level; azum_levels_unlocked=levels_unlocked
else if player_class==2; santa_level=player_level; santa_levels_unlocked=levels_unlocked
else; ordinary_level=player_level; ordinary_levels_unlocked=levels_unlocked; end
net_save_progress_all(cups,candies,primes,player_class,azum_owned,santa_owned,player_level,levels_unlocked,ordinary_level,ordinary_levels_unlocked,azum_level,azum_levels_unlocked,santa_level,santa_levels_unlocked,ordinary_prime_level,azum_prime_level,santa_prime_level)
net_set_class(player_class)
net_set_level(player_level)
net_set_prime_level(selected_prime_level())
end
function level_cost(number n)
return level_base_cost+(n-1)*level_cost_step
end
function set_class_level(number cls, number lv, number un)
if cls==1; azum_level=lv; azum_levels_unlocked=un
else if cls==2; santa_level=lv; santa_levels_unlocked=un
else; ordinary_level=lv; ordinary_levels_unlocked=un; end
end
function unlock_next_level(number n)
if n<1||n>max_level; return; end
if n!=levels_unlocked+1; return; end
number cost=level_cost(n)
if cups<cost; level_msg_t=2.5; return; end
cups=cups-cost; levels_unlocked=n; player_level=n; level_msg_t=0; save_progress()
end

function pick_class_level(number cls, number n)
if n<1||n>max_level; return; end
if class_owned(cls)==0; class_msg_t=2.5; return; end
number lv=class_level_for(cls), un=class_levels_unlocked_for(cls)
if n<=un
set_class_level(cls,n,un)
if cls==player_class; player_level=n; levels_unlocked=un; end
save_progress()
return
end
if n==un+1
number cost=level_cost(n)
if cups<cost; level_msg_t=2.5; return; end
cups=cups-cost; un=n; lv=n; set_class_level(cls,lv,un)
if cls==player_class; player_level=lv; levels_unlocked=un; end
level_msg_t=0; save_progress()
return
end
class_msg_t=2.5
end
function menu_top()
return screen_h/2-120
end
function draw_money()
string cup_s=tr_cups()+": "+cups
number cw=text_ink_width(cup_s)*0.5
text_scaled(cup_s,screen_w-cw-20,18,0xFFFFFF,0.5)
string cd_s=tr_candies()+": "+candies
number dw=text_ink_width(cd_s)*0.5
text_scaled(cd_s,screen_w-dw-20,44,0xFFFFFF,0.5)
string pr_s=tr_primes()+": "+primes
number pw=text_ink_width(pr_s)*0.5
text_scaled(pr_s,screen_w-pw-20,70,0xB39DDB,0.5)
end
function draw_lobby_money(number y)
string cup_s=tr_cups()+": "+cups, cd_s=tr_candies()+": "+candies, pr_s=tr_primes()+": "+primes
number cw=text_ink_width(cup_s)*0.5, dw=text_ink_width(cd_s)*0.5, pw=text_ink_width(pr_s)*0.5, gap=24
number x=(screen_w-cw-dw-pw-gap*2)/2
text_scaled(cup_s,x,y,0xFFFFFF,0.5)
text_scaled(cd_s,x+cw+gap,y,0xFFFFFF,0.5)
text_scaled(pr_s,x+cw+dw+gap*2,y,0xB39DDB,0.5)
end
function draw_lobby()
number mx=(screen_w-btn_w)/2, my=menu_top()
rect(0,0,screen_w,screen_h,0x1a1a2e); ctext("Cubic Battle 4",my-70,0xFFFFFF)
button(tr_play(),mx,my,btn_w,btn_h); button(tr_settings(),mx,my+80,btn_w,btn_h); button(tr_shop(),mx,my+160,btn_w,btn_h); button(tr_account(),mx,my+240,btn_w,btn_h)
if net_login_status()==2; string ln=net_login_nick(); if str_len(ln)>0; string greet="Привет, \""+ln+"\""; number lw=text_ink_width(greet)*0.5; text_scaled(greet,(screen_w-lw)/2,18,0xFFFFFF,0.5); end; end
draw_lobby_money(my+240+btn_h+14)
end
function draw_class_level_rows(number x, number y, number w, number cls)
number lv=class_level_for(cls), un=class_levels_unlocked_for(cls), n=1
string head=tr_levels_for_class()+": "+lv+"/"+max_level
text_scaled(head,x+10,y+146,0xA8B7D8,0.30)
loop n<=max_level
string line=""+n+"."+tr_class_level_effect(cls,n)
color level_c=0x8888AA
if n<=un; level_c=0xFFFFFF
else if n==un+1; line=line+" · "+level_cost(n)+" "+tr_cups_unit(); level_c=0xFFFFFF; end
text_scaled(line,x+8,y+166+(n-1)*20,level_c,0.27)
n=n+1
end
end
function draw_class_card(number x, number y, number w, number h, number cls, number owned, number cost, string title, string desc, string texname)
number sel=0, locked=0
if player_class==cls; sel=1; end
if cls!=0&&owned==0; locked=1; sel=0; end
if sel==1; roundrect(x-5,y-5,w+10,h+10,26,0xFF5A5A78); end
roundrect(x,y,w,h,22,0xFF2A2A40)
number ts=1.55, spr=50*ts
tex(x+(w-spr)/2,y+12,texname,0,ts)
number tw=text_ink_width(title)
text(title,x+(w-tw)/2,y+92,0xFFFFFF)
number dw=text_ink_width(desc)*0.5
text_scaled(desc,x+(w-dw)/2,y+128,0xC8C8E0,0.5)
// Показываем текущий уровень под описанием
number lv=class_level_for(cls)
string lv_text=tr_level()+" "+lv
number lw=text_ink_width(lv_text)*0.5
text_scaled(lv_text,x+(w-lw)/2,y+156,0xDDE5FF,0.45)
string cur=tr_cups()
if cls==2; cur=tr_candies(); end
if sel==1; button_scaled(tr_class_selected(),x+24,y+h-72,w-48,48,0.55)
else if locked==1; button_scaled(tr_buy_for(cost,cur),x+24,y+h-72,w-48,48,0.55)
else; button_scaled(tr_class_pick(),x+24,y+h-72,w-48,48,0.55); end
end
function draw_classes()
rect(0,0,screen_w,screen_h,0x1a1a2e)
number cw=260, ch=300, gap=26
number total=cw*3+gap*2, x0=(screen_w-total)/2
number x1=x0, x2=x0+cw+gap, x3=x0+2*(cw+gap), y=back_y+btn_h+16
draw_class_card(x1,y,cw,ch,0,1,0,tr_class_ordinary(),tr_class_ordinary_desc(),ORDINARY_TEX)
draw_class_card(x2,y,cw,ch,1,azum_owned,azum_cost,tr_class_azum(),tr_class_azum_desc(),AZUM_TEX)
draw_class_card(x3,y,cw,ch,2,santa_owned,santa_candy_cost,tr_class_santa(),tr_class_santa_desc(),SANTA_TEX)
number by=y+ch+gap
button_scaled(tr_levels(),(screen_w-btn_w)/2,by,btn_w,btn_h,0.9)
// Прокачка прайма за кубки: у каждого класса свой прайм-уровень (1..3),
// за уровень в бою от персонажа веет аурой (цвет зависит от класса, см.
// fx/aura.ds). На максимуме кнопка показывает «Прайм: максимум».
number ey=by+btn_h+12
number pcost=0
if selected_prime_level()<prime_max_level; pcost=prime_cost_base+selected_prime_level()*prime_cost_step; end
button_scaled(tr_prime_upgrade(pcost),(screen_w-btn_w)/2,ey,btn_w,btn_h,0.5)
number sy=ey+btn_h+12
draw_money()
if class_msg_t>0; class_msg_t=class_msg_t-dt; ctext(tr_class_need_cups(),sy,0xFF8A80)
else if prime_msg_t>0; prime_msg_t=prime_msg_t-dt; ctext(tr_prime_need_cups(),sy,0xFF8A80)
else if prime_ok_t>0; prime_ok_t=prime_ok_t-dt; ctext(tr_prime_upgraded(selected_prime_level()),sy,0x7ED321)
else
number sw=text_ink_width(tr_prime_status(selected_prime_level()))*0.5
text_scaled(tr_prime_status(selected_prime_level()),(screen_w-sw)/2,sy,0xB39DDB,0.5)
end
draw_back()
end
function pick_class(number cls)
if cls==0; player_class=0; load_selected_level(); save_progress(); return; end
number owned=0
if cls==1; owned=azum_owned; end
if cls==2; owned=santa_owned; end
if owned==1; player_class=cls; load_selected_level(); save_progress(); return; end
number bought=0
if cls==1
if cups>=azum_cost; cups=cups-azum_cost; azum_owned=1; bought=1; end
else
if candies>=santa_candy_cost; candies=candies-santa_candy_cost; santa_owned=1; bought=1; end
end
if bought==1; player_class=cls; load_selected_level(); save_progress(); ds_log("bought class %g",cls)
else; class_msg_t=2.5; end
end
function upgrade_prime()
// Прокачка прайма выбранного класса за кубки: +1 к прайм-уровню,
// максимум — prime_max_level (дальше цвет ауры не меняется).
number lv=selected_prime_level()
if lv>=prime_max_level; return; end
number cost=prime_cost_base+lv*prime_cost_step
if cups<cost; prime_msg_t=2.5; prime_ok_t=0; return; end
cups=cups-cost
if player_class==1; azum_prime_level=lv+1
else if player_class==2; santa_prime_level=lv+1
else; ordinary_prime_level=lv+1; end
prime_ok_t=2.5; prime_msg_t=0; save_progress()
ds_log("prime upgraded to level %g (class %g)",lv+1,player_class)
end
function touch_classes(number x, number y, number action)
if action!=0; return; end
if back_hit(x,y)==1; start_transition(0); return; end
number cw=260, ch=300, gap=26
number total=cw*3+gap*2, x0=(screen_w-total)/2
number x1=x0, x2=x0+cw+gap, x3=x0+2*(cw+gap), cy=back_y+btn_h+16
if y>=cy&&y<=cy+ch
// Строки уровней под карточкой: тот же список, что рисует
// draw_class_level_rows (y+166 + 20 на уровень). Тап по строке выбирает
// открытый уровень или покупает следующий за кубки — ветка именно этого класса.
number ry=cy+166
if y>=ry&&y<=ry+max_level*20
number n=floor((y-ry)/20)+1
if n<1; n=1; end
if n>max_level; n=max_level; end
if x>=x1&&x<=x1+cw; pick_class_level(0,n); return; end
if x>=x2&&x<=x2+cw; pick_class_level(1,n); return; end
if x>=x3&&x<=x3+cw; pick_class_level(2,n); return; end
end
if x>=x1&&x<=x1+cw; pick_class(0); return; end
if x>=x2&&x<=x2+cw; pick_class(1); return; end
if x>=x3&&x<=x3+cw; pick_class(2); return; end
end
number by=cy+ch+gap
if y>=by-8&&y<=by+btn_h+8
if x>=(screen_w-btn_w)/2-12&&x<=(screen_w+btn_w)/2+12; start_transition(9); return; end
end
number ey=by+btn_h+12
if y>=ey-8&&y<=ey+btn_h+8
if x>=(screen_w-btn_w)/2-12&&x<=(screen_w+btn_w)/2+12; upgrade_prime(); return; end
end
end
function draw_levels()
rect(0,0,screen_w,screen_h,0x1a1a2e)
string title=tr_levels_for_class()+" · "+class_name()
ctext(title,back_y+btn_h+8,0xFFFFFF)
number n=1, row_h=78, y=back_y+btn_h+52, w=520, x=(screen_w-w)/2
loop n<=max_level
number unlocked=0, next=0
if n<=levels_unlocked; unlocked=1; end
if n==levels_unlocked+1; next=1; end
number sel=0; if player_level==n&&unlocked==1; sel=1; end
if sel==1; roundrect(x-4,y-4,w+8,row_h+8,24,0xFF5A5A78); end
roundrect(x,y,w,row_h,20,0xFF2A2A40)
string desc=tr_class_level_effect(player_class,n)
string level_title=tr_level()+" "+n
number tw=text_ink_width(level_title)*0.7
text_scaled(level_title,x+(w-tw)/2,y+12,0xFFFFFF,0.7)
number dw=text_ink_width(desc)*0.5
color desc_c=0xC8C8E0
if unlocked==1; desc_c=0xFFFFFF; end
text_scaled(desc,x+(w-dw)/2,y+42,desc_c,0.5)
// Показываем статус уровня
string status=""
if unlocked==1; status="✓ Открыт"; else if next==1; status="Открыть: "+level_cost(n)+" "+tr_cups_unit(); else; status="Закрыт"; end
number sw=text_ink_width(status)*0.5
text_scaled(status,x+(w-sw)/2,y+58,0xFFFFFF,0.45)
n=n+1; y=y+row_h+10
end
if level_msg_t>0; level_msg_t=level_msg_t-dt; ctext(tr_level_need_cups(),back_y+btn_h+52+max_level*(row_h+10)+8,0xFF8A80); end
draw_money()
draw_back()
end
function touch_levels(number x, number y, number action)
if action!=0; return; end
if back_hit(x,y)==1; start_transition(8); return; end
number n=1, row_h=78, ry=back_y+btn_h+52, w=520, rx=(screen_w-w)/2
loop n<=max_level
if x>=rx&&x<=rx+w&&y>=ry&&y<=ry+row_h
// Уже открытый уровень — выбираем его как активный; следующий — покупаем.
if n<=levels_unlocked
player_level=n; save_progress()
else if n==levels_unlocked+1; unlock_next_level(n); end
return
end
n=n+1; ry=ry+row_h+10
end
end
function draw_modes()
rect(0,0,screen_w,screen_h,0x1a1a2e)
number x=(screen_w-btn_w)/2, y=menu_top()
button(tr_back(),x,y,btn_w,btn_h)
button(tr_solo(),x,y+80,btn_w,btn_h)
button(tr_online(),x,y+160,btn_w,btn_h)
button(tr_leaderboard(),x,y+240,btn_w,btn_h)
end
function draw_login()
rect(0,0,screen_w,screen_h,0x1a1a2e)
text(tr_login_title(),24+login_ox,26,0xFFFFFF)
number bw=460, bx=(screen_w-bw)/2+login_ox, fy=screen_h/2-100+login_oy
text(tr_nick(),bx+login_lab_ox,fy-login_lab,0xFFFFFF)
roundrect(bx,fy,bw,login_fh,14,0xFF2A2A40)
if str_len(login_nick)==0; if keyboard_visible()==1&&login_field==1; text_in_field("|",bx+16,fy,login_fh,0xFFFFFF,0.6); else; text_in_field(tr_nick_ph(),bx+16,fy,login_fh,0x666688,0.6); end; else; if keyboard_visible()==1&&login_field==1; text_in_field(login_nick+"|",bx+16,fy,login_fh,0xFFFFFF,0.6); else; text_in_field(login_nick,bx+16,fy,login_fh,0xFFFFFF,0.6); end; end
number py=fy+login_fh+36
text(tr_pass(),bx+login_lab_ox,py-login_lab,0xFFFFFF)
roundrect(bx,py,bw,login_fh,14,0xFF2A2A40)
if str_len(login_pass)==0; if keyboard_visible()==1&&login_field==2; text_in_field("|",bx+16,py,login_fh,0xFFFFFF,0.6); else; text_in_field(tr_pass_ph(),bx+16,py,login_fh,0x666688,0.6); end; else; if keyboard_visible()==1&&login_field==2; text_in_field(login_pass+"|",bx+16,py,login_fh,0xFFFFFF,0.6); else; text_in_field(login_pass,bx+16,py,login_fh,0xFFFFFF,0.6); end; end
number yb=py+login_fh+34
button_scaled(tr_login_btn(),(screen_w-380)/2,yb,380,btn_h,0.65)
number sy=yb+btn_h+20
if login_status==5; ctext(tr_bad_nick(),sy,0xFF8A80); end
if login_status==6; ctext(tr_wrong_pass(),sy,0xFF8A80); end
if login_status==7; ctext(tr_bad_pass(),sy,0xFF8A80); end
if login_status==4; ctext(tr_no_connection(),sy,0xFF8A80); end
draw_back()
end
function draw_settings()
rect(0,0,screen_w,screen_h,0x1a1a2e)
number x=(screen_w-btn_w)/2, y=menu_top()
button(tr_back(),x,y,btn_w,btn_h)
button("English",x,y+80,btn_w,btn_h)
button("Русский",x,y+160,btn_w,btn_h)
string lbl=tr_disco_epilepsy()+" ("+tr_mode_off()+")"
if disco_safe==1; lbl=tr_disco_epilepsy()+" ("+tr_mode_on()+")"; end
button_scaled(lbl,x,y+240,btn_w,btn_h,0.7)
end
function draw_leaderboard()
rect(0,0,screen_w,screen_h,0x1a1a2e)
ctext(tr_leaderboard_title(),back_y+btn_h+12,0xFFFFFF)
number st=net_leaderboard_status()
if st==1
ctext(tr_loading(),screen_h/2,0xFFD54A)
else if st==4
ctext(tr_no_connection(),screen_h/2,0xFF8A80)
else
number count=net_leaderboard_count()
if count==0
ctext(tr_no_data(),screen_h/2,0x8888AA)
else
number w=560, x=(screen_w-w)/2, y=back_y+btn_h+78, row_h=46, gap=8
number i=0
loop i<count
string rk="#"+(i+1), nk=net_leaderboard_nick(i)
if i==0; roundrect(x,y,w,row_h,12,0xFF3D3215)
else if i==1; roundrect(x,y,w,row_h,12,0xFF2C3238)
else if i==2; roundrect(x,y,w,row_h,12,0xFF352620)
else; roundrect(x,y,w,row_h,12,0xFF2A2A40); end
color rank_c=0x9E9E9E
if i==0; rank_c=0xFFFFD700; else if i==1; rank_c=0xFFC0C0C0; else if i==2; rank_c=0xFFCD7F32; end
// Текст центрируем по ink-метрикам, чтобы строки не «прыгали» по высоте
// (без выносных элементов текст не уезжает вверх, см. text_ink_height).
number rth=text_ink_height(rk)*0.6, rtt=text_ink_top(rk)*0.6
text_scaled(rk,x+16,y+(row_h-rth)/2-rtt+1,rank_c,0.6)
number nth=text_ink_height(nk)*0.6, ntt=text_ink_top(nk)*0.6
text_scaled(nk,x+70,y+(row_h-nth)/2-ntt+1,0xE0E0FF,0.6)
// Кубки игрока — справа в той же строке: число (значок-кубок убран).
number cps=net_leaderboard_cups(i)
string cs=""+floor(cps+0.5)
number cnw=text_ink_width(cs)*0.6, cth=text_ink_height(cs)*0.6, ctt=text_ink_top(cs)*0.6
text_scaled(cs,x+w-20-cnw,y+(row_h-cth)/2-ctt+1,0xFFD54A,0.6)
i=i+1; y=y+row_h+gap
end
end
end
draw_back()
end
function touch_leaderboard(number x, number y, number action)
if action!=0; return; end
if back_hit(x,y)==1; start_transition(2); return; end
end
function touch_lobby(number x, number y, number action)
if action!=0; return; end
number mx=(screen_w-btn_w)/2, my=menu_top()
if x<mx-12||x>mx+btn_w+12; return; end
if y>=my-8&&y<=my+btn_h+8; start_transition(2); return; end
if y>=my+72&&y<=my+btn_h+88; start_transition(4); return; end
if y>=my+152&&y<=my+btn_h+168; start_transition(8); return; end
if y>=my+232&&y<=my+btn_h+248; login_after=0; start_transition(7); end
end
function login_sync_field()
if keyboard_visible()==0; return; end
if login_field==1; login_nick=keyboard_get_text(); else; login_pass=keyboard_get_text(); end
end
function login_focus_nick()
login_sync_field()
login_field=1
keyboard_clear()
if str_len(login_nick)>0; keyboard_type(login_nick); end
keyboard_show()
end
function login_focus_pass()
login_sync_field()
login_field=2
keyboard_clear()
if str_len(login_pass)>0; keyboard_type(login_pass); end
keyboard_show()
end
function login_open()
login_field=1; login_status=0; login_nick=""; login_pass=""
// Не открываем клавиатуру автоматически: она появляется только после тапа по полю.
keyboard_clear(); keyboard_hide()
end
function login_do()
login_sync_field()
if str_len(login_nick)==0; login_status=5; keyboard_hide(); return; end
if str_len(login_pass)==0; login_status=7; keyboard_hide(); return; end
number res=net_auth(FIREBASE,login_nick,login_pass)
if res==2
login_status=0; keyboard_hide(); keyboard_clear()
cups=net_load_cups(); candies=net_load_candies(); primes=net_load_primes(); player_class=net_load_class(); azum_owned=net_load_azum(); santa_owned=net_load_santa(); player_level=net_load_level(); levels_unlocked=net_load_levels_unlocked(); ordinary_level=net_load_ordinary_level(); ordinary_levels_unlocked=net_load_ordinary_levels_unlocked(); azum_level=net_load_azum_level(); azum_levels_unlocked=net_load_azum_levels_unlocked(); santa_level=net_load_santa_level(); santa_levels_unlocked=net_load_santa_levels_unlocked(); ordinary_prime_level=net_load_ordinary_prime_level(); azum_prime_level=net_load_azum_prime_level(); santa_prime_level=net_load_santa_prime_level()
if levels_unlocked<0; levels_unlocked=0; end
if levels_unlocked>max_level; levels_unlocked=max_level; end
if player_level<0||player_level>levels_unlocked; player_level=0; end
if azum_owned==0&&player_class==1; player_class=0; end
if santa_owned==0&&player_class==2; player_class=0; end
if ordinary_prime_level<0||ordinary_prime_level>prime_max_level; ordinary_prime_level=0; end
if azum_prime_level<0||azum_prime_level>prime_max_level; azum_prime_level=0; end
if santa_prime_level<0||santa_prime_level>prime_max_level; santa_prime_level=0; end
load_selected_level()
net_set_class(player_class)
net_set_level(player_level)
net_set_prime_level(selected_prime_level())
start_transition(login_after)
else
login_status=res
end
end
function update_login()
if keyboard_visible()==1; login_sync_field(); end
if keyboard_enter_pressed()==1
if login_field==1; login_focus_pass(); else; login_do(); end
end
end
function touch_login(number x, number y, number action)
if action!=0; return; end
number bw=460, bx=(screen_w-bw)/2+login_ox, fy=screen_h/2-100+login_oy
number py=fy+login_fh+36
number yb=py+login_fh+34
if x>=bx&&x<=bx+bw&&y>=fy&&y<=fy+login_fh; login_focus_nick(); return; end
if x>=bx&&x<=bx+bw&&y>=py&&y<=py+login_fh; login_focus_pass(); return; end
if x>=(screen_w-380)/2-12&&x<=(screen_w+380)/2+12&&y>=yb-8&&y<=yb+btn_h+8; login_do(); keyboard_hide(); return; end
// Любой тап вне поля снимает фокус и закрывает IME, но не выбирает поле заново.
login_sync_field(); keyboard_hide()
if back_hit(x,y)==1; keyboard_clear(); if login_after==5; start_transition(2); else; start_transition(0); end; end
end
function touch_menu(number x, number y, number action)
if action!=0; return; end
if game_state==7; touch_login(x,y,action); return; end
if game_state==8; touch_classes(x,y,action); return; end
if game_state==9; touch_levels(x,y,action); return; end
if game_state==10; touch_leaderboard(x,y,action); return; end
number mx=(screen_w-btn_w)/2, sy=menu_top()
if game_state==2||game_state==4
if x<mx-12||x>mx+btn_w+12; return; end
if y>=sy-8&&y<=sy+btn_h+8; start_transition(0); return; end
else
if back_hit(x,y)==1; start_transition(0); return; end
end
if x<mx-12||x>mx+btn_w+12; return; end
if game_state==2
if y>=sy+72&&y<=sy+btn_h+88; start_transition(1); return; end
if y>=sy+152&&y<=sy+btn_h+168
if net_login_status()==2; start_transition(5); else; login_after=5; start_transition(7); end
return
end
if y>=sy+232&&y<=sy+btn_h+248
net_leaderboard_fetch(FIREBASE)
start_transition(10); return
end
else if game_state==4
if y>=sy+72&&y<=sy+btn_h+88; language=0
else if y>=sy+152&&y<=sy+btn_h+168; language=1
else if y>=sy+232&&y<=sy+btn_h+248
if disco_safe==1; disco_safe=0; else; disco_safe=1; end
end
end
end
