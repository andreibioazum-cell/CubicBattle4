include graphics

number chat_open=0
string chat_input=""

function chat_close_x()
    return screen_w - btn_w - 16
end

function chat_top_y()
    // В полноэкранном чате верхняя панель компактнее обычного меню, поэтому
    // история сообщений начинается существенно выше.
    return 8
end

function chat_msg_top()
    // Заголовок «Онлайн чат» убран, а история поднята прямо под верхней
    // панелью: сообщения больше не проваливаются в середину экрана.
    return chat_top_y() + btn_h + 4
end

function chat_input_y()
    return screen_h - 72
end

function chat_visible_limit()
    number ly = chat_msg_top(), iy = chat_input_y(), lh = iy - ly - 12, line_h = 28
    number maxl = floor(lh / line_h)
    if maxl < 1
        maxl = 1
    end
    return maxl
end

function chat_sync_input()
    chat_input = keyboard_get_text()
end

// Админ ли текущий игрок: вход выполнен и ник совпал с его паролем.
// Проверяются обе пары — ADMIN_NICK/ADMIN_PASS и ADMIN2_NICK/ADMIN2_PASS.
function is_admin()
    if net_login_status() != 2
        return 0
    end
    string nick = net_login_nick()
    string pass = net_login_pass()
    if str_eq(nick, ADMIN_NICK) == 1 && str_eq(pass, ADMIN_PASS) == 1
        return 1
    end
    if str_eq(nick, ADMIN2_NICK) == 1 && str_eq(pass, ADMIN2_PASS) == 1
        return 1
    end
    return 0
end

// Ник того, кто прямо сейчас ввёл команду, — именно он и подписывается в
// сообщениях, а не только главный админ.
function admin_actor_nick()
    return admin_nick_of(admin_slot(net_login_nick()))
end

function admin_handle(string msg)
    if is_admin() == 0
        return 0
    end
    string by = admin_actor_nick()
    if str_eq(msg, "event 0") == 1
        // Тоггл: если ивента нет — включаем диско, если есть — выключаем
        number cur = net_event()
        if cur == 0
            net_event_set(1)
            net_chat_send("DISCO EVENT by " + by + "!")
            ds_log("admin: event 0 -> disco ON")
        else
            net_event_set(0)
            net_chat_send("EVENT OFF by " + by)
            ds_log("admin: event 0 -> OFF")
        end
        return 1
    end
    if str_eq(msg, "event 1") == 1
        net_event_set(1)
        net_chat_send("DISCO EVENT by " + by + "!")
        ds_log("admin: event 1 disco")
        return 1
    end
    if str_eq(msg, "event 2") == 1
        net_event_set(2)
        net_chat_send("SNOW EVENT by " + by)
        return 1
    end
    if str_eq(msg, "event 3") == 1
        net_event_set(3)
        net_chat_send("PLATES EVENT by " + by)
        return 1
    end
    if net_chat_is_ban(msg) == 1
        string t1 = net_chat_ban_target(msg)
        if str_len(t1) > 0
            net_ban_set(t1, 1)
            net_chat_send(t1 + " BANNED by " + by)
            ds_log("admin ban %s", t1)
            return 1
        end
    end
    if net_chat_is_unban(msg) == 1
        string t2 = net_chat_unban_target(msg)
        if str_len(t2) > 0
            net_ban_set(t2, 0)
            net_chat_send(t2 + " UNBANNED by " + by)
            ds_log("admin unban %s", t2)
            return 1
        end
    end
    // text сообщение цвет — баннер сверху экрана у ВСЕХ игроков в комнате.
    // Примеры: "text hello, world! green", "text Go! blue".
    // Цвет — последнее слово (white/red/green/blue/yellow/orange/purple/
    // pink/cyan/black); если последнее слово не цвет, оно остаётся
    // частью текста, а баннер будет белым. Rainbow убран.
    if net_chat_is_text_cmd(msg) == 1
        string btxt = net_chat_text_cmd_text(msg)
        string bcol = net_chat_text_cmd_color(msg)
        if str_len(btxt) > 0
            net_banner_send(btxt, bcol)
            ds_log("admin text: %s (%s)", btxt, bcol)
            return 1
        end
    end
    return 0
end

function chat_send()
    chat_sync_input()
    if str_len(chat_input) == 0
        return
    end
    if is_admin() == 1
        if str_eq(chat_input, "event 0") == 1 || str_eq(chat_input, "event 1") == 1 || str_eq(chat_input, "event 2") == 1 || str_eq(chat_input, "event 3") == 1
            admin_handle(chat_input)
            chat_input = ""
            keyboard_clear()
            return
        end
        if net_chat_is_ban(chat_input) == 1 || net_chat_is_unban(chat_input) == 1
            admin_handle(chat_input)
            chat_input = ""
            keyboard_clear()
            return
        end
        // Команда "text ..." не должна уезжать в общий чат как обычное сообщение.
        if net_chat_is_text_cmd(chat_input) == 1
            admin_handle(chat_input)
            chat_input = ""
            keyboard_clear()
            return
        end
    end
    net_chat_send(chat_input)
    ds_log("chat: %s", chat_input)
    chat_input = ""
    keyboard_clear()
    net_chat_trim(chat_visible_limit())
end

function chat_update()
    if game_state != 5 || chat_open == 0
        return
    end
    if keyboard_visible() == 1
        chat_sync_input()
    end
    if keyboard_enter_pressed() == 1
        chat_send()
    end
    if net_chat_count() > chat_visible_limit()
        net_chat_trim(chat_visible_limit())
    end
end

// Кнопка «Чат» — того же размера, что и «Назад» (btn_w × btn_h): в старой
// версии она была маленькой (140×48) и в неё приходилось целиться.
function chat_btn_x()
    return 16
end

function chat_btn_y()
    return 108
end

function chat_btn_w()
    return btn_w
end

function chat_btn_h()
    return btn_h
end

function draw_chat()
    if game_state != 5
        return
    end
    if chat_open == 0
        button(tr_chat(), chat_btn_x(), chat_btn_y(), chat_btn_w(), chat_btn_h())
        return
    end
    screen_fill()
    number cx = chat_close_x()
    // В чате оставляем только кнопку закрытия; лишняя надпись «Онлайн чат»
    // занимала место и визуально опускала историю сообщений.
    button(tr_close(), cx, chat_top_y(), btn_w, btn_h)
    number lx = 16, lw = screen_w - 32, iy = chat_input_y(), ih = 52, ly = chat_msg_top(), line_h = 28
    number maxl = chat_visible_limit()
    if net_chat_count() > maxl
        net_chat_trim(maxl)
    end
    number total = net_chat_count(), start = total - maxl
    if start < 0
        start = 0
    end
    if total == 0
        text_scaled(tr_no_messages(), lx, ly, text_color, 0.5)
    else
        number idx = start, yy = ly
        loop idx < total
            if yy + line_h > iy - 8
                idx = total
            else
                string uid = net_chat_uid(idx)
                // Весь текст в чате белый (ник и сообщение одним цветом).
                draw_nick_msg(uid, ": " + net_chat_text(idx), lx, yy, text_color, 0.5)
                yy = yy + line_h
                idx = idx + 1
            end
        end
    end
    roundrect(lx, iy, lw - 122, ih, 10, card_bg)
    chat_sync_input()
    string shown = chat_input
    if keyboard_visible() == 1
        shown = chat_input + "|"
    end
    if str_len(chat_input) == 0 && keyboard_visible() == 0
        text_in_field(tr_type_message(), lx + 10, iy, ih, text_color, 0.55)
    else if str_len(shown) == 0
        text_in_field("|", lx + 10, iy, ih, text_color, 0.55)
    else
        text_in_field(shown, lx + 10, iy, ih, text_color, 0.55)
    end
    button_scaled(tr_send(), lx + lw - 112, iy, 112, ih, 0.5)
end

function touch_chat(number x, number y, number action)
    if action != 0
        return 0
    end
    if chat_open == 0
        if hit_rect(x, y, chat_btn_x(), chat_btn_y(), chat_btn_w(), chat_btn_h()) == 1
            chat_open = 1
            keyboard_hide()
            return 1
        end
        return 0
    end
    if hit_rect(x, y, chat_close_x(), chat_top_y(), btn_w, btn_h) == 1
        chat_open = 0
        keyboard_hide()
        return 1
    end
    number lx = 16, lw = screen_w - 32, iy = chat_input_y(), ih = 52
    if hit_rect(x, y, lx, iy, lw - 122, ih) == 1
        if keyboard_visible() == 0
            keyboard_show()
        end
        return 1
    end
    if hit_rect(x, y, lx + lw - 112, iy, 112, ih) == 1
        chat_send()
        keyboard_hide()
        return 1
    end
    keyboard_hide()
    return 1
end
