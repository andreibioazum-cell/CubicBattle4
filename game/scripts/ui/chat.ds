include graphics

number chat_open=0
string chat_input=""

function chat_button(string label, number x, number y, number w, number h)
    roundrect(x, y, w, h, 20, 0x5F10A0)
    text_in_box(label, x, y, w, h, 0xFFFFFF, 0.5)
end

function chat_close_x()
    return screen_w - btn_w - 16
end

function chat_msg_top()
    return back_y + btn_h + 12
end

function chat_input_y()
    return screen_h - 72
end

function chat_visible_limit()
    number ly = chat_msg_top(), iy = chat_input_y(), lh = iy - ly - 12, line_h = 28
    number maxl = floor(lh / line_h)
    if maxl < 1
        maxl = 1
    end
    return maxl
end

function chat_sync_input()
    chat_input = keyboard_get_text()
end

// Админ ли текущий игрок: вход выполнен и ник совпал с его паролем.
// Проверяются обе пары — ADMIN_NICK/ADMIN_PASS и ADMIN2_NICK/ADMIN2_PASS.
function is_admin()
    if net_login_status() != 2
        return 0
    end
    string nick = net_login_nick()
    string pass = net_login_pass()
    if str_eq(nick, ADMIN_NICK) == 1 && str_eq(pass, ADMIN_PASS) == 1
        return 1
    end
    if str_eq(nick, ADMIN2_NICK) == 1 && str_eq(pass, ADMIN2_PASS) == 1
        return 1
    end
    return 0
end

// Ник того, кто прямо сейчас ввёл команду, — именно он и подписывается в
// сообщениях, а не только главный админ.
function admin_actor_nick()
    return admin_nick_of(admin_slot(net_login_nick()))
end

function admin_handle(string msg)
    if is_admin() == 0
        return 0
    end
    string by = admin_actor_nick()
    if str_eq(msg, "event 0") == 1
        // Тоггл: если ивента нет — включаем диско, если есть — выключаем
        number cur = net_event()
        if cur == 0
            net_event_set(1)
            net_chat_send("DISCO EVENT by " + by + "!")
            ds_log("admin: event 0 -> disco ON")
        else
            net_event_set(0)
            net_chat_send("EVENT OFF by " + by)
            ds_log("admin: event 0 -> OFF")
        end
        return 1
    end
    if str_eq(msg, "event 1") == 1
        net_event_set(1)
        net_chat_send("DISCO EVENT by " + by + "!")
        ds_log("admin: event 1 disco")
        return 1
    end
    if str_eq(msg, "event 2") == 1
        net_event_set(2)
        net_chat_send("SNOW EVENT by " + by)
        return 1
    end
    if net_chat_is_ban(msg) == 1
        string t1 = net_chat_ban_target(msg)
        if str_len(t1) > 0
            net_ban_set(t1, 1)
            net_chat_send(t1 + " BANNED by " + by)
            ds_log("admin ban %s", t1)
            return 1
        end
    end
    if net_chat_is_unban(msg) == 1
        string t2 = net_chat_unban_target(msg)
        if str_len(t2) > 0
            net_ban_set(t2, 0)
            net_chat_send(t2 + " UNBANNED by " + by)
            ds_log("admin unban %s", t2)
            return 1
        end
    end
    return 0
end

function chat_send()
    chat_sync_input()
    if str_len(chat_input) == 0
        return
    end
    if is_admin() == 1
        if str_eq(chat_input, "event 0") == 1 || str_eq(chat_input, "event 1") == 1 || str_eq(chat_input, "event 2") == 1
            admin_handle(chat_input)
            chat_input = ""
            keyboard_clear()
            return
        end
        if net_chat_is_ban(chat_input) == 1 || net_chat_is_unban(chat_input) == 1
            admin_handle(chat_input)
            chat_input = ""
            keyboard_clear()
            return
        end
    end
    net_chat_send(chat_input)
    ds_log("chat: %s", chat_input)
    chat_input = ""
    keyboard_clear()
    net_chat_trim(chat_visible_limit())
end

function chat_update()
    if game_state != 5 || chat_open == 0
        return
    end
    if keyboard_visible() == 1
        chat_sync_input()
    end
    if keyboard_enter_pressed() == 1
        chat_send()
    end
    if net_chat_count() > chat_visible_limit()
        net_chat_trim(chat_visible_limit())
    end
end

function draw_chat()
    if game_state != 5
        return
    end
    if chat_open == 0
        button(tr_chat(), 16, 150, 140, 48)
        return
    end
    rect(0, 0, screen_w, screen_h, 0xFF1E1E2F)
    number cx = chat_close_x()
    text_in_box(tr_online_chat(), 16, back_y, cx - 32, btn_h, 0xFFFFFF, 1)
    button(tr_close(), cx, back_y, btn_w, btn_h)
    number lx = 16, lw = screen_w - 32, iy = chat_input_y(), ih = 52, ly = chat_msg_top(), line_h = 28
    number maxl = chat_visible_limit()
    if net_chat_count() > maxl
        net_chat_trim(maxl)
    end
    number total = net_chat_count(), start = total - maxl
    if start < 0
        start = 0
    end
    if total == 0
        text_scaled(tr_no_messages(), lx, ly, 0x8888AA, 0.5)
    else
        number idx = start, yy = ly
        loop idx < total
            if yy + line_h > iy - 8
                idx = total
            else
                string uid = net_chat_uid(idx)
                // Цвет только у ника, текст сообщения всегда обычный.
                draw_nick_msg(uid, ": " + net_chat_text(idx), lx, yy, 0xE0E0FF, 0.5)
                yy = yy + line_h
                idx = idx + 1
            end
        end
    end
    roundrect(lx, iy, lw - 122, ih, 10, 0xFF2A2A40)
    chat_sync_input()
    string shown = chat_input
    if keyboard_visible() == 1
        shown = chat_input + "|"
    end
    if str_len(chat_input) == 0 && keyboard_visible() == 0
        text_in_field(tr_type_message(), lx + 10, iy, ih, 0x666688, 0.55)
    else if str_len(shown) == 0
        text_in_field("|", lx + 10, iy, ih, 0xFFFFFF, 0.55)
    else
        text_in_field(shown, lx + 10, iy, ih, 0xFFFFFF, 0.55)
    end
    chat_button(tr_send(), lx + lw - 112, iy, 112, ih)
end

function chat_hit(number x, number y, number bx, number by, number bw, number bh)
    if x >= bx && x <= bx + bw && y >= by && y <= by + bh
        return 1
    end
    return 0
end

function touch_chat(number x, number y, number action)
    if action != 0
        return 0
    end
    if chat_open == 0
        if chat_hit(x, y, 16, 150, 140, 48) == 1
            chat_open = 1
            keyboard_hide()
            return 1
        end
        return 0
    end
    if chat_hit(x, y, chat_close_x(), back_y, btn_w, btn_h) == 1
        chat_open = 0
        keyboard_hide()
        return 1
    end
    number lx = 16, lw = screen_w - 32, iy = chat_input_y(), ih = 52
    if chat_hit(x, y, lx, iy, lw - 122, ih) == 1
        if keyboard_visible() == 0
            keyboard_show()
        end
        return 1
    end
    if chat_hit(x, y, lx + lw - 112, iy, 112, ih) == 1
        chat_send()
        keyboard_hide()
        return 1
    end
    keyboard_hide()
    return 1
end
