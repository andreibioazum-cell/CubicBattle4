-- Cards and promo codes. A card drops in a solo match with a flat chance of
-- card_chance in 100 (5), right at the start of the battle, and waits on the
-- arena until the player walks over it. Every card carries a fresh random code
-- of 3 letters and 1 digit (net_promo_new_code): the card is the only place it is
-- ever shown, the promo screen never prints it. The code of the last card is
-- entered on ST_PROMO for the reward, one per account; the code and the flag are
-- mirrored to Firebase (native/net/promo.inc).
public number promo_focus=0
public string promo_input=""
public number promo_msg_t=0
public string promo_msg_text=""
public number promo_msg_kind=0
public number card_active=0
public number card_x=0, card_y=0, card_t=0
public number card_open=0
public number card_open_t=0
public string card_code=""
-- Rolled once per solo battle, after the fighters are placed, so the card is on
-- the arena from the very first frame and never lands on top of them.
public function card_roll()
    if rand()%100>=card_chance then
        return
    end
    card_spawn()
end
public function card_spawn()
    local number m=candy_margin, k=0
    local number cx=m+rand()%(int)(screen_w-2*m), cy=m+rand()%(int)(screen_h-2*m)
    while k<24 do
        if dist(cx,cy,player.x,player.y)<140||dist(cx,cy,enemy.x,enemy.y)<140 then
            cx=m+rand()%(int)(screen_w-2*m)
            cy=m+rand()%(int)(screen_h-2*m)
            k=k+1
        else
            k=24
        end
    end
    card_x=cx
    card_y=cy
    card_t=0
    card_active=1
    ds_log("card dropped at %g %g",cx,cy)
end
public function card_collect()
    if finished!=0 then
        return
    end
    card_active=0
    card_open=1
    card_open_t=0
    card_code=net_promo_new_code()
    ds_log("card collected")
end
public function card_close()
    card_open=0
    card_open_t=0
end
public function card_update()
    card_t=card_t+dt
    if card_open==1 then
        card_open_t=card_open_t+dt
        return
    end
    if finished!=0 then
        return
    end
    if card_active==1 then
        if dist(card_x,card_y,player.x,player.y)<player.size*0.65+26 then
            card_collect()
        end
    end
end
public function draw_card_item()
    if card_active==0 then
        return
    end
    local number bob=4*sin(card_t*3)
    local number x=card_x-22, y=card_y-30+bob
    local number a=110+95*sin(card_t*5)
    local number aa=floor(clamp(a,0,255))
    ring(card_x,card_y+bob,44,3,(((unsigned)(int)aa)<<24)|0xFFB388FF)
    roundrect(x-3,y-3,50,66,10,0xFFB388FF)
    roundrect(x,y,44,60,8,0xFFF7F3FF)
    text_in_box("?",x,y+8,44,44,0xFF5F10A0,1.1)
end
public function draw_card_open()
    if card_open==0 then
        return
    end
    rect(0,0,screen_w,screen_h,0xAA000000)
    local number w=430
    local number h=380
    local number x=center_x(w)
    local number y=screen_h/2-h/2
    roundrect(x-8,y-8,w+16,h+16,36,card_ring)
    roundrect(x,y,w,h,30,card_bg)
    ctext_scaled(tr_card_title(),y+36,0xFFB388FF,1.05)
    ctext_scaled(tr_card_sub(),y+88,text_color,0.55)
    local number sc=0.85
    if text_ink_width(card_code)*sc>w-56 then
        sc=(w-56)/text_ink_width(card_code)
    end
    ctext_scaled(card_code,y+150,0xFF4FC3F7,sc)
    if net_promo_used()==1 then
        ctext_scaled(tr_card_used1(),y+216,text_color,0.5)
        ctext_scaled(tr_card_used2(),y+240,text_color,0.5)
    else
        ctext_scaled(tr_card_hint1(),y+216,text_color,0.5)
        ctext_scaled(tr_card_hint2(),y+240,text_color,0.5)
    end
    ctext_scaled(tr_tap_to_return(),y+h-42,text_color,0.55)
end
public function promo_field_y()
    return content_top()+158
end
public function promo_btn_y()
    return promo_field_y()+56+20
end
public function promo_msg_y()
    return promo_btn_y()+btn_h+16
end
public function promo_set_msg(string text, number kind)
    promo_msg_text=text
    promo_msg_kind=kind
    promo_msg_t=4.0
end
public function promo_leave()
    promo_focus=0
    keyboard_hide()
end
public function promo_letter_ok(string ch)
    return str_index_of("ABCDEFGHIJKLMNOPQRSTUVWXYZ",ch)>=0
end
public function promo_digit_ok(string ch)
    return str_index_of("0123456789",ch)>=0
end
public function promo_code_valid(string s)
    if str_len(s)!=4 then
        return 0
    end
    local number letters=0, digits=0, i=0
    while i<4 do
        local string ch=str_sub(s,i,1)
        if promo_letter_ok(ch)==1 then
            letters=letters+1
        else if promo_digit_ok(ch)==1 then
            digits=digits+1
        else
            return 0
        end
        i=i+1
    end
    if letters==3&&digits==1 then
        return 1
    end
    return 0
end
public function promo_submit()
    if promo_focus==1 then
        promo_input=keyboard_get_text()
    end
    local string code=str_upper(str_trim(promo_input))
    if str_len(code)==0 then
        promo_set_msg(tr_promo_need_code(),0)
        return
    end
    if net_login_status()!=2 then
        promo_set_msg(tr_promo_need_login(),0)
        promo_leave()
        return
    end
    if promo_code_valid(code)==0 then
        promo_set_msg(tr_promo_bad(),0)
        return
    end
    if net_promo_used()==1 then
        promo_set_msg(tr_promo_used_msg(),0)
        return
    end
    -- Only the code of the last card counts: a well-formed code that no card
    -- gave is still wrong.
    if net_promo_check(code)==0 then
        promo_set_msg(tr_promo_bad(),0)
        return
    end
    cups=cups+promo_reward_cups
    candies=candies+promo_reward_candies
    net_promo_mark_used()
    save_progress()
    ds_log("promo redeemed: +%g cups +%g candies",promo_reward_cups,promo_reward_candies)
    promo_leave()
    promo_set_msg(tr_promo_success(),1)
end
public function update_promo()
    if promo_focus==0 then
        return
    end
    if keyboard_visible()==1 then
        promo_input=keyboard_get_text()
    end
    if keyboard_enter_pressed()==1 then
        promo_submit()
    end
end
public function draw_promo()
    screen_fill()
    draw_back()
    ctext(tr_promo_title(),title_y(),text_color)
    local number w=fit_w(560)
    local number x=center_x(w)
    local number top=content_top()+8
    panel(x,top,w,76,0)
    -- The code itself is never printed here: it is shown on the card only.
    if net_promo_used()==1 then
        centered_text(tr_promo_used_msg(),x,w,top+32,0xFFC9B6FF,0.55)
    else
        centered_text(tr_promo_need_card(),x,w,top+32,text_color,0.55)
    end
    ctext_scaled(tr_promo_how1(),top+88,text_color,0.48)
    ctext_scaled(tr_promo_how2(),top+114,text_color,0.48)
    local number fy=promo_field_y()
    roundrect(x,fy,w,56,field_radius,card_bg)
    local number caret=0
    if promo_focus==1&&keyboard_visible()==1 then
        caret=1
    end
    local string shown=promo_input
    if caret==1 then
        shown=shown+"|"
    end
    if str_len(shown)==0 then
        shown=tr_promo_enter_ph()
    end
    text_in_field(shown,x+field_text_pad,fy,56,text_color,0.6)
    button(tr_promo_submit(),x,promo_btn_y(),w,btn_h)
    promo_msg_t=tick_down(promo_msg_t)
    draw_msg(promo_msg_text,promo_msg_y(),promo_msg_t)
end
public function touch_promo(number x, number y, number action)
    if action!=0 then
        return
    end
    if back_hit(x,y)==1 then
        promo_leave()
        start_transition(ST_MODES)
        return
    end
    local number w=fit_w(560)
    local number fx=center_x(w)
    if hit_rect(x,y,fx,promo_field_y(),w,56)==1 then
        promo_focus=1
        keyboard_show()
        return
    end
    if hit_rect_pad(x,y,fx,promo_btn_y(),w,btn_h)==1 then
        promo_submit()
        return
    end
    promo_leave()
end
