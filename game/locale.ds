// ── Праймы: третья валюта ──────────────────────────────────────────────────
function tr_primes
if language==1; return "Праймы"; end; return "Primes";end
function tr_prime_exchange num pcups, num pcandies
str out=""
if language==1; out="Обменять прайм: +"+pcups+" кубков +"+pcandies+" леденцов"
else; out="Exchange prime: +"+pcups+" cups +"+pcandies+" candies"; end
return out
end
function tr_prime_need
if language==1; return "Нужен хотя бы 1 прайм"; end; return "You need at least 1 prime";end
function tr_prime_ok num pcups, num pcandies
str out=""
if language==1; out="Прайм обменян: +"+pcups+" кубков +"+pcandies+" леденцов!"
else; out="Prime exchanged: +"+pcups+" cups +"+pcandies+" candies!"; end
return out
end
function tr_prime_hint
if language==1; return "Прайм дают за каждую победу"; end; return "A prime is awarded for every win";end
