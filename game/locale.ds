// --- реплики и шутки --------------------------------------------------
// Курящие приятели зовут Ярика в курилку. Реплика выбирается случайно.
function buddy_line num i
str s="Yarik, want one?"
if language==1
if i==0; s="Ярик, будешь?"
else if i==1; s="Одну затяжку, чё ты!"
else if i==2; s="Ты чё, не мужик?"
else if i==3; s="Айда покурим за гаражи!"
else; s="Я угощаю, брат!"; end
else
if i==0; s="Yarik, want one?"
else if i==1; s="One drag, come on!"
else if i==2; s="Come on, be a man!"
else if i==3; s="Let us smoke behind the garages!"
else; s="It is on me, bro!"; end
end
return s;end
// Что кричит Ярик, когда жмёт «Держись».
function refuse_line num i
str s="Not today!"
if language==1
if i==0; s="Не сегодня!"
else if i==1; s="Я завязал!"
else if i==2; s="Мне и так хорошо"
else; s="Пас, мужики!"; end
else
if i==0; s="Not today!"
else if i==1; s="I quit!"
else if i==2; s="I feel fine already"
else; s="Pass, guys!"; end
end
return s;end
// Похвала за донесённый до урны мусор.
function praise_line num i
str s="Nice!"
if language==1
if i==0; s="Красава!"
else if i==1; s="Двор чище!"
else if i==2; s="Так держать!"
else if i==3; s="Мама бы гордилась"
else; s="Чистота!"; end
else
if i==0; s="Nice one!"
else if i==1; s="Cleaner yard!"
else if i==2; s="Keep it up!"
else if i==3; s="Mom would be proud"
else; s="Spotless!"; end
end
return s;end
// Холодильник ночью подаёт голос.
function fridge_line num i
str s="Yariiik..."
if language==1
if i==0; s="Ярииик..."
else if i==1; s="Тут холодненькое"
else if i==2; s="Одна не считается"
else; s="Я даже не заперт"; end
else
if i==0; s="Yariiik..."
else if i==1; s="Something cold in here"
else if i==2; s="One does not count"
else; s="I am not even locked"; end
end
return s;end
