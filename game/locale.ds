function tr_class_level_effect num cls, num n
// У каждого класса своя ветка: эти подписи также показываются прямо под карточкой класса.
if cls==1&&n==1; if language==1; return "Вторая жизнь: урон -10%"; end; return "Second life: damage -10%"; end
if cls==1&&n==2; if language==1; return "Скорость +3%"; end; return "Speed +3%"; end
if cls==1&&n==3; if language==1; return "Атака лечит +0.1 HP"; end; return "Attack heals +0.1 HP"; end
if cls==2&&n==1; if language==1; return "Тик яда +0.15 урона"; end; return "Poison tick +0.15 damage"; end
if cls==2&&n==2; if language==1; return "Тик яда +0.15 урона (x2)"; end; return "Poison tick +0.15 damage (x2)"; end
if cls==2&&n==3; if language==1; return "Яд стакается, снежинка наносит урон"; end; return "Poison stacks, snowflake deals damage"; end
if cls==0&&n==1; if language==1; return "Урон атаки +5%"; end; return "Attack damage +5%"; end
if cls==0&&n==2; if language==1; return "Скорость +2%"; end; return "Speed +2%"; end
if language==1; return "Атака лечит +0.05 HP"; end; return "Attack heals +0.05 HP"; end
