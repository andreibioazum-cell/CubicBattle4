// Игровая логика

num player_x = 0
num player_y = 0
num player_size = 30
num player_color = 0x00BCD4

num target_x = 0
num target_y = 0
num target_size = 20
num target_color = 0xFF5722

num target_hit = 0
num timer = 0
num game_time = 30  // 30 секунд

// Виртуальный джойстик.
// Поля joy.x, joy.y, joy.r, joy.dx, joy.dy, joy.ox, joy.oy — структура Joy из runtime.h.
num joy_active = 0       // 1, пока палец держит джойстик
num joy_knob_r = 30      // радиус ручки-кноба
num joy_hit_r = 120      // зона активации вокруг базы
num joy_speed = 5        // скорость движения игрока

fn init_game() {
    player_x = screen_w / 2
    player_y = screen_h / 2
    target_hit = 0
    timer = game_time
    init_joystick()
    spawn_target()
}

fn init_joystick() {
    joy.x = 110
    joy.y = screen_h - 120
    joy.r = 65
    joy.dx = 0
    joy.dy = 0
    joy.ox = 0
    joy.oy = 0
    joy_active = 0
}

fn update_game() {
    timer = timer - (1.0 / 60.0)  // примерно 60 FPS

    if (timer <= 0) {
        // Конец игры - возвращаемся в лобби
        game_state = 0
    }

    // Движение игрока джойстиком
    player_x = player_x + joy.dx * joy_speed
    player_y = player_y + joy.dy * joy_speed

    // Не даём игроку выйти за экран
    if (player_x < player_size) {
        player_x = player_size
    }
    if (player_x > screen_w - player_size) {
        player_x = screen_w - player_size
    }
    if (player_y < player_size) {
        player_y = player_size
    }
    if (player_y > screen_h - player_size) {
        player_y = screen_h - player_size
    }

    // Сбор цели при столкновении с игроком
    num dx = target_x - player_x
    num dy = target_y - player_y
    num dist = sqrt(dx*dx + dy*dy)
    if (dist < player_size + target_size) {
        target_hit = target_hit + 1
        score = score + 10
        spawn_target()
    }
}

fn draw_game() {
    cls(0x1a1a2e)

    // Счет и таймер
    text("Score: " + score, 20, 30, 0xFFFFFF)
    text("Time: " + floor(timer), 20, 60, 0xFFFFFF)

    // Игрок убран

    // Цель
    circle(target_x, target_y, target_size, target_color)
    circle(target_x, target_y, target_size/2, 0xFF8A65)

    // Джойстик
    draw_joystick()

    // Кнопка назад (справа сверху)
    rect(screen_w - 90, 10, 80, 40, 0xE94560)
    text("Back", screen_w - 78, 20, 0xFFFFFF)

    // Подсказка
    text("Joystick: move | Walk into targets", screen_w/2 - 140, 110, 0x666666)
}

fn draw_joystick() {
    // Прозрачная база
    circle(joy.x, joy.y, joy.r, 0x00000000)
    // Кольцевая часть полностью чёрная
    ring(joy.x, joy.y, joy.r, 8, 0x000000)

    // Стик залит чёрным
    circle(joy.x + joy.ox, joy.y + joy.oy, joy_knob_r, 0x000000)
    circle(joy.x + joy.ox, joy.y + joy.oy, joy_knob_r/2, 0x000000)
}

fn touch_game(x, y, action) {
    // Кнопка Back — только по нажатию
    if (action == 0) {
        if (x >= screen_w - 90 && x <= screen_w - 10 && y >= 10 && y <= 50) {
            game_state = 0
            return
        }
    }

    // Джойстик
    joy_touch(x, y, action)

    // Быстрый сбор цели тапом (нажатие вне зоны джойстика)
    if (action == 0 && joy_active == 0) {
        num dx = x - target_x
        num dy = y - target_y
        num dist = sqrt(dx*dx + dy*dy)
        if (dist < target_size + 20) {
            target_hit = target_hit + 1
            score = score + 10
            spawn_target()
        }
    }
}

fn joy_touch(x, y, action) {
    // Палец отпущен (UP / CANCEL) — возвращаем кноб в центр
    if (action == 1 || action == 3) {
        joy_active = 0
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
        return
    }

    // Движение без нажатия на джойстик — игнорируем
    if (action == 2 && joy_active == 0) {
        return
    }

    num dx = x - joy.x
    num dy = y - joy.y
    num dist = sqrt(dx*dx + dy*dy)

    // Нажатие вне зоны джойстика — не наш жест
    if (action == 0 && dist > joy_hit_r) {
        return
    }

    joy_active = 1

    if (dist > joy.r) {
        // Кноб упёрся в край базы
        joy.dx = dx / dist
        joy.dy = dy / dist
        joy.ox = joy.dx * joy.r
        joy.oy = joy.dy * joy.r
    } else {
        // Кноб следует за пальцем (аналоговое управление)
        joy.dx = dx / joy.r
        joy.dy = dy / joy.r
        joy.ox = dx
        joy.oy = dy
    }
}

fn spawn_target() {
    num tries = 0
    loop (tries < 20) {
        target_x = 50 + rand() % (screen_w - 100)
        target_y = 50 + rand() % (screen_h - 100)
        num dx = target_x - player_x
        num dy = target_y - player_y
        num dist = sqrt(dx*dx + dy*dy)
        if (dist > 150) {
            return
        }
        tries = tries + 1
    }
}
