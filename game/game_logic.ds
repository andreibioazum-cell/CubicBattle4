// Игровая логика

num player_x = 0
num player_y = 0
num player_size = 30
num player_color = 0xFF8844
num player_angle = 0       // куда смотрит игрок (радианы)

// Враг который преследует игрока
num enemy_x = 0
num enemy_y = 0
num enemy_size = 22
num enemy_color = 0xFF0000
num enemy_speed = 2.2
num enemy_hp = 3         // здоровье врага
num enemy_max_hp = 3
num enemy_angle = 0      // куда смотрит враг (радианы)

num timer = 0
num game_time = 30  // 30 секунд

// Виртуальный джойстик.
// Поля joy.x, joy.y, joy.r, joy.dx, joy.dy, joy.ox, joy.oy — структура Joy из runtime.h.
num joy_active = 0       // 1, пока палец держит джойстик
num joy_knob_r = 34      // радиус ручки-кноба
num joy_hit_r = 150      // зона активации вокруг базы
num joy_speed = 5        // скорость движения игрока

// Кнопка атаки (справа внизу)
num attack_x = 0
num attack_y = 0
num attack_r = 70        // радиус кнопки
num attack_active = 0    // 1, пока кнопка зажата
num attack_range = 300   // дальность удара

num back_w = 132
num back_h = 46
num back_x = 0
num back_y = 12

fn init_game() {
    player_x = screen_w / 2
    player_y = screen_h / 2
    timer = game_time
    init_joystick()
    attack_x = screen_w - 140
    attack_y = screen_h - 150
    attack_r = joy.r          // кнопка атаки того же размера, что и джойстик
    attack_active = 0
    enemy_hp = enemy_max_hp
    spawn_enemy()
}

fn init_joystick() {
    joy.x = 130
    joy.y = screen_h - 150
    joy.r = 70
    joy.dx = 0
    joy.dy = 0
    joy.ox = 0
    joy.oy = 0
    joy_active = 0
}

fn update_game() {
    timer = timer - (1.0 / 60.0)  // примерно 60 FPS

    if (timer <= 0) {
        // Конец игры - возвращаемся в лобби
        game_state = 0
        return
    }

    // Движение игрока джойстиком
    player_x = player_x + joy.dx * joy_speed
    player_y = player_y + joy.dy * joy_speed

    // Игрок поворачивается в направлении джойстика
    if (joy.dx != 0 || joy.dy != 0) {
        player_angle = atan2(joy.dy, joy.dx)
    }

    // Не даём игроку выйти за экран
    if (player_x < player_size) {
        player_x = player_size
    }
    if (player_x > screen_w - player_size) {
        player_x = screen_w - player_size
    }
    if (player_y < player_size) {
        player_y = player_size
    }
    if (player_y > screen_h - player_size) {
        player_y = screen_h - player_size
    }

    // Враг двигается за игроком
    num edx = player_x - enemy_x
    num edy = player_y - enemy_y
    num edist = sqrt(edx*edx + edy*edy)
    if (edist > 1) {
        enemy_x = enemy_x + (edx / edist) * enemy_speed
        enemy_y = enemy_y + (edy / edist) * enemy_speed
    }
    // Враг всегда повёрнут к игроку
    enemy_angle = atan2(player_y - enemy_y, player_x - enemy_x)

    // Столкновение игрока с врагом -> проигрыш
    if (edist < player_size + enemy_size) {
        game_state = 0
        return
    }

    // Начисляем очки за выживание
    score = score + 0.1
}

fn draw_game() {
    cls(0x1a1a2e)

    // Счет и таймер
    text("Score: " + floor(score), 20, 24, 0xFFFFFF)
    text("Time: " + floor(timer), 20, 48, 0x4FC3F7)

    // Игрок - текстура player.png (повёрнута в сторону джойстика) и резервный круг
    circle(player_x, player_y, 15, player_color)
    tex(player_x - 20, player_y - 20, "player.png", player_angle, 1)

    // Враг - та же текстура, что и у игрока (повёрнут к игроку, + красное кольцо-метка)
    tex(enemy_x - 20, enemy_y - 20, "player.png", enemy_angle, 1)
    ring(enemy_x, enemy_y, 26, 3, 0xFF2020)

    // Джойстик - кольцо только чёрное и стик залитый чёрным
    draw_joystick()

    // Кнопка атаки (справа внизу): красная с чёрной обводкой как у джойстика
    num atk_color = 0xE94560
    if (attack_active == 1) {
        atk_color = 0xFF6B81
    }
    circle(attack_x, attack_y, attack_r, atk_color)
    ring(attack_x, attack_y, attack_r, 6, 0x000000)
    num a_w = text_width("ATTACK") * 0.55
    text_scaled("ATTACK", attack_x - a_w / 2, attack_y - 7, 0xFFFFFF, 0.55)

    // Кнопка назад (справа сверху), текст отцентрирован по кнопке
    back_x = screen_w - back_w - 14
    rect(back_x + 2, back_y + 2, back_w, back_h, 0x0f0f1c)
    rect(back_x - 1, back_y - 1, back_w + 2, back_h + 2, 0xFF6B81)
    rect(back_x, back_y, back_w, back_h, 0xE94560)
    draw_button_label("◀ Back", back_x, back_y, back_w, back_h, 0xFFFFFF)
}

fn draw_joystick() {
    // База джойстика — только чёрное кольцо
    ring(joy.x, joy.y, joy.r, 4, 0x000000)
    // Стик — тупо залитый чёрный круг
    circle(joy.x + joy.ox, joy.y + joy.oy, joy_knob_r, 0x000000)
}

fn touch_game(x, y, action) {
    // Кнопка Back — только по нажатию
    back_x = screen_w - back_w - 14
    if (action == 0) {
        if (x >= back_x - 4 && x <= back_x + back_w + 4 && y >= back_y - 4 && y <= back_y + back_h + 4) {
            game_state = 0
            return
        }
    }

    // Кнопка атаки — по нажатию внутри круга
    if (action == 0) {
        num adx = x - attack_x
        num ady = y - attack_y
        if (sqrt(adx*adx + ady*ady) <= attack_r + 8) {
            attack_active = 1
            do_attack()
            return
        }
    }
    if (action == 1 || action == 3) {
        attack_active = 0
    }

    // Джойстик
    joy_touch(x, y, action)
}

fn do_attack() {
    // Удар: урон + отталкивание врага (если он в радиусе удара)
    num adx = enemy_x - player_x
    num ady = enemy_y - player_y
    num adist = sqrt(adx*adx + ady*ady)
    if (adist <= attack_range) {
        enemy_hp = enemy_hp - 1
        if (adist > 1) {
            enemy_x = enemy_x + (adx / adist) * 80
            enemy_y = enemy_y + (ady / adist) * 80
        }
        if (enemy_hp <= 0) {
            // Враг побеждён — очки и новый враг
            score = score + 10
            enemy_hp = enemy_max_hp
            spawn_enemy()
        }
    }
}

fn joy_touch(x, y, action) {
    // Палец отпущен (UP / CANCEL) — возвращаем кноб в центр
    if (action == 1 || action == 3) {
        joy_active = 0
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
        return
    }

    // Движение без нажатия на джойстик — игнорируем
    if (action == 2 && joy_active == 0) {
        return
    }

    num dx = x - joy.x
    num dy = y - joy.y
    num dist = sqrt(dx*dx + dy*dy)

    // Нажатие вне зоны джойстика — не наш жест
    if (action == 0 && dist > joy_hit_r) {
        return
    }

    joy_active = 1

    if (dist > joy.r) {
        // Кноб упёрся в край базы
        joy.dx = dx / dist
        joy.dy = dy / dist
        joy.ox = joy.dx * joy.r
        joy.oy = joy.dy * joy.r
    } else {
        // Кноб следует за пальцем (аналоговое управление)
        joy.dx = dx / joy.r
        joy.dy = dy / joy.r
        joy.ox = dx
        joy.oy = dy
    }
}

fn spawn_enemy() {
    // Спавним врага подальше от игрока
    num tries = 0
    loop (tries < 50) {
        enemy_x = 50 + rand() % (screen_w - 100)
        enemy_y = 50 + rand() % (screen_h - 100)
        num dx = enemy_x - player_x
        num dy = enemy_y - player_y
        num dist = sqrt(dx*dx + dy*dy)
        if (dist > 250) {
            return
        }
        tries = tries + 1
    }
    // fallback - угол экрана
    enemy_x = 50
    enemy_y = 50
}
