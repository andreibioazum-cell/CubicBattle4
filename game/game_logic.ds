// Игровая логика: игрок, враг, кнопка атаки, джойстик, таймер, очки.

object Player {
    num x = 0
    num y = 0
    num size = 30
    col color = 0xFF8844
    num angle = 0
    // Скорость сглаживается, поэтому игрок не дёргается при движении джойстика.
    num vx = 0
    num vy = 0
}

object Enemy {
    num x = 0
    num y = 0
    num size = 22
    col color = 0xFF0000
    num speed = 2.2
    int hp = 3
    int max_hp = 3
    num angle = 0
}

object AttackButton {
    num x = 0
    num y = 0
    num r = 70
    int active = 0
    num range = 300
}

Player player = new Player()
Enemy enemy = new Enemy()
AttackButton attack = new AttackButton()

int frames_left = 0
int game_frames = 1800  // 30 c при 60 FPS
int joy_active = 0
num joy_knob_r = 34
num joy_hit_r = 150
// Игрок медленнее, торможение резче — сглаживание увеличено
num joy_speed = 3.2
num movement_smoothing = 0.6
int back_w = 220
int back_h = 70
int back_x = 0
int back_y = 12
int survival_frames = 0

fn init_game() {
    player.x = screen_w / 2
    player.y = screen_h / 2
    player.vx = 0
    player.vy = 0
    frames_left = game_frames
    survival_frames = 0
    init_joystick()
    attack.x = screen_w - 140
    attack.y = screen_h - 150
    attack.r = joy.r
    attack.active = 0
    enemy.hp = enemy.max_hp
    spawn_enemy()
}

fn init_joystick() {
    joy.x = 130
    joy.y = screen_h - 150
    joy.r = 70
    joy.dx = 0
    joy.dy = 0
    joy.ox = 0
    joy.oy = 0
    joy_active = 0
}

fn update_game() {
    frames_left = frames_left - 1
    if (frames_left <= 0) {
        game_state = 0
        return
    }
    // Плавно приближаем текущую скорость к направлению джойстика.
    // При отпускании joy.dx/dy становятся нулём, поэтому игрок мягко тормозит.
    num target_vx = joy.dx * joy_speed
    num target_vy = joy.dy * joy_speed
    player.vx = player.vx + (target_vx - player.vx) * movement_smoothing
    player.vy = player.vy + (target_vy - player.vy) * movement_smoothing
    player.x = player.x + player.vx
    player.y = player.y + player.vy
    if (joy.dx != 0 || joy.dy != 0) {
        player.angle = atan2(joy.dy, joy.dx)
    }
    if (player.x < player.size) player.x = player.size
    if (player.x > screen_w - player.size) player.x = screen_w - player.size
    if (player.y < player.size) player.y = player.size
    if (player.y > screen_h - player.size) player.y = screen_h - player.size

    num edx = player.x - enemy.x
    num edy = player.y - enemy.y
    num edist = sqrt(edx*edx + edy*edy)
    if (edist > 1) {
        enemy.x = enemy.x + (edx / edist) * enemy.speed
        enemy.y = enemy.y + (edy / edist) * enemy.speed
    }
    enemy.angle = atan2(player.y - enemy.y, player.x - enemy.x)

    if (edist < player.size + enemy.size) {
        game_state = 0
        return
    }
    survival_frames = survival_frames + 1
    if (survival_frames >= 10) {
        survival_frames = 0
        score = score + 1
    }
}

fn draw_game() {
    text("Score: " + score, 20, 24, 0xFFFFFF)
    text("Time: " + ((frames_left + 59) / 60), 20, 48, 0x4FC3F7)

    circle(player.x, player.y, 15, player.color)
    tex(player.x - 20, player.y - 20, "player.png", player.angle, 1)
    tex(enemy.x - 20, enemy.y - 20, "player.png", enemy.angle, 1)
    ring(enemy.x, enemy.y, 26, 3, 0xFF2020)

    draw_joystick()

    // Кнопка атаки — визуально как джойстик: тот же радиус и та же обводка 4px
    col atk_color = 0xE94560
    circle(attack.x, attack.y, attack.r, atk_color)
    ring(attack.x, attack.y, attack.r, 4, 0x000000)
    num a_w = text_ink_width("Attack") * 0.55
    text_scaled("Attack", attack.x - a_w / 2, attack.y - 7, 0xFFFFFF, 0.55)

    // Кнопка Back — как Play: фиолетовая, тот же размер 220x70, roundrect 20
    back_x = screen_w - back_w - 14
    roundrect(back_x, back_y, back_w, back_h, 20, 0x5F10A0)
    draw_button_label("Back", back_x, back_y, back_w, back_h, 0xFFFFFF)
}

fn draw_joystick() {
    ring(joy.x, joy.y, joy.r, 4, 0x000000)
    circle(joy.x + joy.ox, joy.y + joy.oy, joy_knob_r, 0x000000)
}

fn touch_game(x, y, int action) {
    back_x = screen_w - back_w - 14
    if (action == 0) {
        if (x >= back_x - 4 && x <= back_x + back_w + 4 && y >= back_y - 4 && y <= back_y + back_h + 4) {
            start_transition(0)
            return
        }
    }
    if (action == 0) {
        num adx = x - attack.x
        num ady = y - attack.y
        if (sqrt(adx*adx + ady*ady) <= attack.r + 8) {
            attack.active = 1
            do_attack()
            return
        }
    }
    if (action == 1 || action == 3) {
        attack.active = 0
    }
    joy_touch(x, y, action)
}

fn do_attack() {
    num adx = enemy.x - player.x
    num ady = enemy.y - player.y
    num adist = sqrt(adx*adx + ady*ady)
    if (adist <= attack.range) {
        enemy.hp = enemy.hp - 1
        if (adist > 1) {
            enemy.x = enemy.x + (adx / adist) * 80
            enemy.y = enemy.y + (ady / adist) * 80
        }
        if (enemy.hp <= 0) {
            score = score + 10
            enemy.hp = enemy.max_hp
            spawn_enemy()
        }
    }
}

fn joy_touch(x, y, int action) {
    if (action == 1 || action == 3) {
        joy_active = 0
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
        return
    }
    if (action == 2 && joy_active == 0) {
        return
    }
    num dx = x - joy.x
    num dy = y - joy.y
    num dist = sqrt(dx*dx + dy*dy)
    if (action == 0 && dist > joy_hit_r) {
        return
    }
    joy_active = 1
    if (dist > joy.r) {
        joy.dx = dx / dist
        joy.dy = dy / dist
        joy.ox = joy.dx * joy.r
        joy.oy = joy.dy * joy.r
    } else {
        joy.dx = dx / joy.r
        joy.dy = dy / joy.r
        joy.ox = dx
        joy.oy = dy
    }
}

fn spawn_enemy() {
    int tries = 0
    loop (tries < 50) {
        enemy.x = 50 + rand() % (screen_w - 100)
        enemy.y = 50 + rand() % (screen_h - 100)
        num dx = enemy.x - player.x
        num dy = enemy.y - player.y
        num dist = sqrt(dx*dx + dy*dy)
        if (dist > 250) {
            return
        }
        tries = tries + 1
    }
    enemy.x = 50
    enemy.y = 50
}
