// Игровая логика

// Игровые сущности сгруппированы в объекты (struct в C), а не размазаны по
// глобальным переменным player_x, player_y, ... Для N врагов не понадобятся
// имена enemy1_x, enemy2_x, ... — просто массив объектов.

object Player {
    num x = 0
    num y = 0
    num size = 30
    col color = 0xFF8844
    num angle = 0       // куда смотрит игрок (радианы)
}

object Enemy {
    num x = 0
    num y = 0
    num size = 22
    col color = 0xFF0000
    num speed = 2.2
    int hp = 3          // здоровье — целое (урон всегда целый)
    int max_hp = 3
    num angle = 0       // куда смотрит враг (радианы)
}

object AttackButton {
    num x = 0
    num y = 0
    num r = 70          // радиус кнопки
    int active = 0      // 1, пока кнопка зажата
    num range = 300     // дальность удара
}

Player player = new Player()
Enemy enemy = new Enemy()
AttackButton attack = new AttackButton()

// Таймер считается в кадрах, а не в double: 30 секунд * 60 FPS = 1800 кадров.
// Сравнение int <= int не имеет погрешностей IEEE 754, в отличие от
// `timer = timer - 1.0/60.0; if (timer <= 0)`.
int frames_left = 0
int game_frames = 1800  // 30 секунд при ~60 FPS

// Виртуальный джойстик.
// Поля joy.x, joy.y, joy.r, joy.dx, joy.dy, joy.ox, joy.oy — структура Joy из runtime.h.
int joy_active = 0       // 1, пока палец держит джойстик
num joy_knob_r = 34      // радиус ручки-кноба
num joy_hit_r = 150      // зона активации вокруг базы
num joy_speed = 5        // скорость движения игрока

// Кнопка назад (справа сверху)
int back_w = 132
int back_h = 46
int back_x = 0
int back_y = 12

// Накопитель для очков за выживание: +1 очко каждые 10 кадров (~6 в секунду),
// чтобы score оставался целым вместо накопления дробных 0.1.
int survival_frames = 0

fn init_game() {
    player.x = screen_w / 2
    player.y = screen_h / 2
    frames_left = game_frames
    survival_frames = 0
    init_joystick()
    attack.x = screen_w - 140
    attack.y = screen_h - 150
    attack.r = joy.r          // кнопка атаки того же размера, что и джойстик
    attack.active = 0
    enemy.hp = enemy.max_hp
    spawn_enemy()
}

fn init_joystick() {
    joy.x = 130
    joy.y = screen_h - 150
    joy.r = 70
    joy.dx = 0
    joy.dy = 0
    joy.ox = 0
    joy.oy = 0
    joy_active = 0
}

fn update_game() {
    frames_left = frames_left - 1

    if (frames_left <= 0) {
        // Конец игры - возвращаемся в лобби
        game_state = 0
        return
    }

    // Движение игрока джойстиком
    player.x = player.x + joy.dx * joy_speed
    player.y = player.y + joy.dy * joy_speed

    // Игрок поворачивается в направлении джойстика
    if (joy.dx != 0 || joy.dy != 0) {
        player.angle = atan2(joy.dy, joy.dx)
    }

    // Не даём игроку выйти за экран
    if (player.x < player.size) {
        player.x = player.size
    }
    if (player.x > screen_w - player.size) {
        player.x = screen_w - player.size
    }
    if (player.y < player.size) {
        player.y = player.size
    }
    if (player.y > screen_h - player.size) {
        player.y = screen_h - player.size
    }

    // Враг двигается за игроком
    num edx = player.x - enemy.x
    num edy = player.y - enemy.y
    num edist = sqrt(edx*edx + edy*edy)
    if (edist > 1) {
        enemy.x = enemy.x + (edx / edist) * enemy.speed
        enemy.y = enemy.y + (edy / edist) * enemy.speed
    }
    // Враг всегда повёрнут к игроку
    enemy.angle = atan2(player.y - enemy.y, player.x - enemy.x)

    // Столкновение игрока с врагом -> проигрыш
    if (edist < player.size + enemy.size) {
        game_state = 0
        return
    }

    // Очки за выживание: +1 каждые 10 кадров (та же скорость, что и +0.1/кадр)
    survival_frames = survival_frames + 1
    if (survival_frames >= 10) {
        survival_frames = 0
        score = score + 1
    }
}

fn draw_game() {
    cls(0x1a1a2e)

    // Счет и таймер. score — int, время — целочисленное деление кадров на 60.
    text("Score: " + score, 20, 24, 0xFFFFFF)
    text("Time: " + ((frames_left + 59) / 60), 20, 48, 0x4FC3F7)

    // Игрок - текстура player.png (повёрнута в сторону джойстика) и резервный круг
    circle(player.x, player.y, 15, player.color)
    tex(player.x - 20, player.y - 20, "player.png", player.angle, 1)

    // Враг - та же текстура, что и у игрока (повёрнут к игроку, + красное кольцо-метка)
    tex(enemy.x - 20, enemy.y - 20, "player.png", enemy.angle, 1)
    ring(enemy.x, enemy.y, 26, 3, 0xFF2020)

    // Джойстик - кольцо только чёрное и стик залитый чёрным
    draw_joystick()

    // Кнопка атаки (справа внизу): красная с чёрной обводкой как у джойстика
    col atk_color = 0xE94560
    if (attack.active == 1) {
        atk_color = 0xFF6B81
    }
    circle(attack.x, attack.y, attack.r, atk_color)
    ring(attack.x, attack.y, attack.r, 6, 0x000000)
    num a_w = text_width("ATTACK") * 0.55
    text_scaled("ATTACK", attack.x - a_w / 2, attack.y - 7, 0xFFFFFF, 0.55)

    // Кнопка назад (справа сверху), текст отцентрирован по кнопке
    back_x = screen_w - back_w - 14
    rect(back_x + 2, back_y + 2, back_w, back_h, 0x0f0f1c)
    rect(back_x - 1, back_y - 1, back_w + 2, back_h + 2, 0xFF6B81)
    rect(back_x, back_y, back_w, back_h, 0xE94560)
    draw_button_label("◀ Back", back_x, back_y, back_w, back_h, 0xFFFFFF)
}

fn draw_joystick() {
    // База джойстика — только чёрное кольцо
    ring(joy.x, joy.y, joy.r, 4, 0x000000)
    // Стик — тупо залитый чёрный круг
    circle(joy.x + joy.ox, joy.y + joy.oy, joy_knob_r, 0x000000)
}

fn touch_game(x, y, int action) {
    // Кнопка Back — только по нажатию
    back_x = screen_w - back_w - 14
    if (action == 0) {
        if (x >= back_x - 4 && x <= back_x + back_w + 4 && y >= back_y - 4 && y <= back_y + back_h + 4) {
            game_state = 0
            return
        }
    }

    // Кнопка атаки — по нажатию внутри круга
    if (action == 0) {
        num adx = x - attack.x
        num ady = y - attack.y
        if (sqrt(adx*adx + ady*ady) <= attack.r + 8) {
            attack.active = 1
            do_attack()
            return
        }
    }
    if (action == 1 || action == 3) {
        attack.active = 0
    }

    // Джойстик
    joy_touch(x, y, action)
}

fn do_attack() {
    // Удар: урон + отталкивание врага (если он в радиусе удара)
    num adx = enemy.x - player.x
    num ady = enemy.y - player.y
    num adist = sqrt(adx*adx + ady*ady)
    if (adist <= attack.range) {
        enemy.hp = enemy.hp - 1
        if (adist > 1) {
            enemy.x = enemy.x + (adx / adist) * 80
            enemy.y = enemy.y + (ady / adist) * 80
        }
        if (enemy.hp <= 0) {
            // Враг побеждён — очки и новый враг
            score = score + 10
            enemy.hp = enemy.max_hp
            spawn_enemy()
        }
    }
}

fn joy_touch(x, y, int action) {
    // Палец отпущен (UP / CANCEL) — возвращаем кноб в центр
    if (action == 1 || action == 3) {
        joy_active = 0
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
        return
    }

    // Движение без нажатия на джойстик — игнорируем
    if (action == 2 && joy_active == 0) {
        return
    }

    num dx = x - joy.x
    num dy = y - joy.y
    num dist = sqrt(dx*dx + dy*dy)

    // Нажатие вне зоны джойстика — не наш жест
    if (action == 0 && dist > joy_hit_r) {
        return
    }

    joy_active = 1

    if (dist > joy.r) {
        // Кноб упёрся в край базы
        joy.dx = dx / dist
        joy.dy = dy / dist
        joy.ox = joy.dx * joy.r
        joy.oy = joy.dy * joy.r
    } else {
        // Кноб следует за пальцем (аналоговое управление)
        joy.dx = dx / joy.r
        joy.dy = dy / joy.r
        joy.ox = dx
        joy.oy = dy
    }
}

fn spawn_enemy() {
    // Спавним врага подальше от игрока
    int tries = 0
    loop (tries < 50) {
        enemy.x = 50 + rand() % (screen_w - 100)
        enemy.y = 50 + rand() % (screen_h - 100)
        num dx = enemy.x - player.x
        num dy = enemy.y - player.y
        num dist = sqrt(dx*dx + dy*dy)
        if (dist > 250) {
            return
        }
        tries = tries + 1
    }
    // fallback - угол экрана
    enemy.x = 50
    enemy.y = 50
}
