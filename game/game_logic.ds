// Игровая логика: мгновенное движение, прицеливание и бой с одним врагом.

object Player {
    num x = 0
    num y = 0
    num size = 30
    col color = 0xFF8844
    // Последнее направление движения — направление прицела и выстрела.
    num angle = 0
}

object Enemy {
    num x = 0
    num y = 0
    num size = 22
    col color = 0xFF0000
    num speed = 2.2
    int hp = 3
    int max_hp = 3
    num angle = 0
}

object AttackButton {
    num x = 0
    num y = 0
    num r = 70
    // Пока кнопку удерживают, показывается только прицел. Урона нет.
    int active = 0
    num range = 360
}

object Bullet {
    num x = 0
    num y = 0
    num dx = 0
    num dy = 0
    num r = 7
    num speed = 13
    num traveled = 0
    num range = 420
    int active = 0
}

Player player = new Player()
Enemy enemy = new Enemy()
AttackButton attack = new AttackButton()
Bullet bullet = new Bullet()

int joy_active = 0
num joy_knob_r = 34
num joy_hit_r = 150
// Скорость применяется сразу: при отпускании джойстика игрок останавливается мгновенно.
num joy_speed = 3.2
int back_w = 220
int back_h = 70
int back_x = 0
int back_y = 12
// 0 — бой, 1 — победа, 2 — поражение.
int game_finished = 0

fn init_game() {
    player.x = screen_w / 2
    player.y = screen_h / 2
    player.angle = 0
    game_finished = 0
    init_joystick()
    attack.x = screen_w - 140
    attack.y = screen_h - 150
    attack.r = joy.r
    attack.active = 0
    bullet.active = 0
    bullet.traveled = 0
    enemy.hp = enemy.max_hp
    spawn_enemy()
}

fn init_joystick() {
    joy.x = 130
    joy.y = screen_h - 150
    joy.r = 70
    joy.dx = 0
    joy.dy = 0
    joy.ox = 0
    joy.oy = 0
    joy_active = 0
}

fn update_game() {
    if (game_finished != 0) {
        return
    }

    // Без интерполяции скорости: координаты сразу следуют за джойстиком.
    player.x = player.x + joy.dx * joy_speed
    player.y = player.y + joy.dy * joy_speed
    if (joy.dx != 0 || joy.dy != 0) {
        player.angle = atan2(joy.dy, joy.dx)
    }
    if (player.x < player.size) player.x = player.size
    if (player.x > screen_w - player.size) player.x = screen_w - player.size
    if (player.y < player.size) player.y = player.size
    if (player.y > screen_h - player.size) player.y = screen_h - player.size

    num edx = player.x - enemy.x
    num edy = player.y - enemy.y
    num edist = sqrt(edx*edx + edy*edy)
    if (edist > 1) {
        enemy.x = enemy.x + (edx / edist) * enemy.speed
        enemy.y = enemy.y + (edy / edist) * enemy.speed
    }
    enemy.angle = atan2(player.y - enemy.y, player.x - enemy.x)

    update_bullet()
    if (game_finished != 0) {
        return
    }

    // Бой проигран только при столкновении; таймера на выживание больше нет.
    edx = player.x - enemy.x
    edy = player.y - enemy.y
    edist = sqrt(edx*edx + edy*edy)
    if (edist < player.size + enemy.size) {
        finish_game(2)
    }
}

fn update_bullet() {
    if (bullet.active == 0) {
        return
    }
    bullet.x = bullet.x + bullet.dx * bullet.speed
    bullet.y = bullet.y + bullet.dy * bullet.speed
    bullet.traveled = bullet.traveled + bullet.speed

    num dx = enemy.x - bullet.x
    num dy = enemy.y - bullet.y
    num dist = sqrt(dx*dx + dy*dy)
    if (dist <= enemy.size + bullet.r) {
        bullet.active = 0
        enemy.hp = enemy.hp - 1
        if (enemy.hp <= 0) {
            finish_game(1)
        }
        return
    }

    if (bullet.traveled >= bullet.range || bullet.x < -bullet.r || bullet.x > screen_w + bullet.r || bullet.y < -bullet.r || bullet.y > screen_h + bullet.r) {
        bullet.active = 0
    }
}

fn finish_game(int result) {
    game_finished = result
    attack.active = 0
    bullet.active = 0
    if (result == 1) {
        score = score + 10
    }
}

fn draw_game() {
    text("Defeat the enemy", 20, 24, 0xFFFFFF)
    text("Enemy HP: " + enemy.hp + "/" + enemy.max_hp, 20, 48, 0xFFCDD2)

    // Пока Attack удерживается, показываем полупрозрачную траекторию.
    if (attack.active == 1 && game_finished == 0) {
        draw_attack_aim()
    }

    circle(player.x, player.y, 15, player.color)
    tex(player.x - 20, player.y - 20, "player.png", player.angle, 1)
    tex(enemy.x - 20, enemy.y - 20, "player.png", enemy.angle, 1)
    ring(enemy.x, enemy.y, 26, 3, 0xFF2020)
    draw_enemy_health()
    draw_bullet()

    draw_joystick()

    // Кнопка не меняется при нажатии: выстрел происходит только при отпускании.
    col atk_color = 0xE94560
    circle(attack.x, attack.y, attack.r, atk_color)
    ring(attack.x, attack.y, attack.r, 4, 0x000000)
    num a_w = text_ink_width("Attack") * 0.55
    text_scaled("Attack", attack.x - a_w / 2, attack.y - 7, 0xFFFFFF, 0.55)

    // Кнопка Back — как Play: фиолетовая, тот же размер 220x70, roundrect 20.
    back_x = screen_w - back_w - 14
    roundrect(back_x, back_y, back_w, back_h, 20, 0x5F10A0)
    draw_button_label("Back", back_x, back_y, back_w, back_h, 0xFFFFFF)

    if (game_finished != 0) {
        draw_game_result()
    }
}

fn draw_attack_aim() {
    num dx = cos(player.angle)
    num dy = sin(player.angle)
    num start_x = player.x + dx * (player.size + 8)
    num start_y = player.y + dy * (player.size + 8)
    num aim_x = player.x + dx * attack.range
    num aim_y = player.y + dy * attack.range

    // Чёрная полупрозрачная линия показывает, куда вылетит пуля.
    line(start_x, start_y, aim_x, aim_y, 12, 0x66000000)
    // Перекрестие на конце траектории.
    line(aim_x - 12, aim_y, aim_x + 12, aim_y, 3, 0x99000000)
    line(aim_x, aim_y - 12, aim_x, aim_y + 12, 3, 0x99000000)
    ring(aim_x, aim_y, 14, 2, 0x99000000)
}

fn draw_enemy_health() {
    num bar_w = 44
    num bar_h = 6
    num bar_x = enemy.x - bar_w / 2
    num bar_y = enemy.y - enemy.size - 14
    rect(bar_x, bar_y, bar_w, bar_h, 0xCC000000)
    rect(bar_x, bar_y, bar_w * enemy.hp / enemy.max_hp, bar_h, 0xE94560)
}

fn draw_bullet() {
    if (bullet.active == 0) {
        return
    }
    circle(bullet.x, bullet.y, bullet.r, 0xFFF176)
    ring(bullet.x, bullet.y, bullet.r + 2, 2, 0x000000)
}

fn draw_game_result() {
    rect(0, 0, screen_w, screen_h, 0x99000000)
    num panel_w = 330
    num panel_h = 170
    num panel_x = screen_w / 2 - panel_w / 2
    num panel_y = screen_h / 2 - panel_h / 2
    roundrect(panel_x, panel_y, panel_w, panel_h, 24, 0x5F10A0)

    if (game_finished == 1) {
        draw_centered_text("Victory!", panel_y + 34, 0xFFFFFF, 1)
        draw_centered_text("Enemy defeated", panel_y + 75, 0xFFFFFF, 1)
    } else {
        draw_centered_text("Defeat", panel_y + 34, 0xFFFFFF, 1)
        draw_centered_text("The enemy caught you", panel_y + 75, 0xFFFFFF, 1)
    }
    draw_centered_text("Tap to return", panel_y + 118, 0xFFCDD2, 1)
}

fn draw_joystick() {
    ring(joy.x, joy.y, joy.r, 4, 0x000000)
    circle(joy.x + joy.ox, joy.y + joy.oy, joy_knob_r, 0x000000)
}

fn touch_game(x, y, int action) {
    if (game_finished != 0) {
        if (action == 0) {
            start_transition(0)
        }
        return
    }

    back_x = screen_w - back_w - 14
    if (action == 0) {
        if (x >= back_x - 4 && x <= back_x + back_w + 4 && y >= back_y - 4 && y <= back_y + back_h + 4) {
            start_transition(0)
            return
        }
    }

    if (action == 0) {
        num adx = x - attack.x
        num ady = y - attack.y
        if (sqrt(adx*adx + ady*ady) <= attack.r + 8) {
            // Нажатие лишь включает прицел — без урона, отбрасывания и анимации кнопки.
            attack.active = 1
            return
        }
    }

    if (action == 1 && attack.active == 1) {
        // Пуля появляется только после отпускания Attack.
        attack.active = 0
        fire_bullet()
        return
    }
    if (action == 3) {
        // Отмена касания не должна выпускать пулю.
        attack.active = 0
    }
    joy_touch(x, y, action)
}

fn fire_bullet() {
    num dx = cos(player.angle)
    num dy = sin(player.angle)
    bullet.x = player.x + dx * (player.size + bullet.r + 4)
    bullet.y = player.y + dy * (player.size + bullet.r + 4)
    bullet.dx = dx
    bullet.dy = dy
    bullet.traveled = 0
    bullet.active = 1
}

fn joy_touch(x, y, int action) {
    if (action == 1 || action == 3) {
        joy_active = 0
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
        return
    }
    if (action == 2 && joy_active == 0) {
        return
    }
    num dx = x - joy.x
    num dy = y - joy.y
    num dist = sqrt(dx*dx + dy*dy)
    if (action == 0 && dist > joy_hit_r) {
        return
    }
    joy_active = 1
    if (dist > joy.r) {
        joy.dx = dx / dist
        joy.dy = dy / dist
        joy.ox = joy.dx * joy.r
        joy.oy = joy.dy * joy.r
    } else {
        joy.dx = dx / joy.r
        joy.dy = dy / joy.r
        joy.ox = dx
        joy.oy = dy
    }
}

fn spawn_enemy() {
    int tries = 0
    loop (tries < 50) {
        enemy.x = 50 + rand() % (screen_w - 100)
        enemy.y = 50 + rand() % (screen_h - 100)
        num dx = enemy.x - player.x
        num dy = enemy.y - player.y
        num dist = sqrt(dx*dx + dy*dy)
        if (dist > 250) {
            return
        }
        tries = tries + 1
    }
    enemy.x = 50
    enemy.y = 50
}
