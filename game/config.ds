// config — все глобальные константы игры, строки через запятую
// Игрок и одиночный бот теперь одного размера; физический размер совпадает с видимым спрайтом.
// Бот использует отдельную атаку с предупреждением, коротким ударом и восстановлением:
// столкновение с ним само по себе больше не наносит урон.
num game_state=0, language=0, t_dir=0, t_target=0, t_fade=0, transition_duration=0.15, punch_time=0.2, punch_cooldown=0.3, punch_reach=104, punch_width=104, punch_damage=1, joy_speed=192, bot_speed=142, bot_strafe_speed=72, btn_w=280, btn_h=64, back_y=32, online_ready=0, max_players=4, pi=3.1415926535, console_scroll=0, cube_scale=1, player_scale=1.8, enemy_scale=1.8, aim_fade_in=0.05, aim_fade_out=0.1
num enemy_attack_distance=112, enemy_min_distance=82, enemy_punch_reach=126, enemy_punch_width=106, enemy_windup=0.42, enemy_lock_time=0.14, enemy_punch_time=0.2, enemy_recovery=0.5, enemy_attack_cooldown=0.65, enemy_damage=1, enemy_prediction=0.18
// Экран аккаунта: login_mode — 0=вход, 1=создание аккаунта;
// login_field — какое поле активно (1=ник, 2=пароль, 3=повтор пароля).
// login_status: 0=идл, 1=идёт запрос, 2=вход выполнен, 3=неверный пароль,
// 4=нет соединения, 5=недопустимый ник/пароль, 6=ник уже занят,
// 7=пароли не совпадают.
// login_after — куда перейти после успешного входа (0=лобби, 5=онлайн).
num login_field=0, login_status=0, login_after=0, login_mode=0
str GRASS="grass.png", ORDINARY_TEX="ordinary.png", PUNCH_TEX="ordinary_punch.png", FIREBASE="https://cubicbattleserver-19ae2-default-rtdb.firebaseio.com", ROOM="main", login_nick="", login_pwd="", login_pwd2="", last_kb=""
