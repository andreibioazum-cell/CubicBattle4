num chat_open=0
str chat_input=""
// Полноэкранный онлайн-чат. Пока он закрыт, игровые сообщения полностью скрыты.
// Системная клавиатура открывается только по нажатию на поле ввода.

function chat_button str label, num x, num y, num w, num h
roundrect x,y,w,h,20,0x5F10A0
text_in_box label,x,y,w,h,0xFFFFFF,0.5
end
function chat_sync_input
str raw=keyboard_get_raw()
if str_eq(raw,chat_input)==0; chat_input=keyboard_get_text(); end
end
function chat_send
chat_sync_input
if str_len(chat_input)==0; return; end
net_chat_send chat_input; ds_log "chat: %s",chat_input
chat_input=""; keyboard_clear
end
function uid_short num idx
// net_chat_uid возвращает ник, а для старых сообщений — сокращённый технический uid.
c static char ub[20]
c { const char *u = net_chat_uid(idx); int n = 0; while (u && u[n] && n < 16) { ub[n] = u[n]; n++; } ub[n] = 0; }
str s=ub
return s
end
function draw_chat
if game_state!=5; return; end
if chat_open==0
// В закрытом состоянии видна только кнопка: сообщения не просвечивают поверх игры.
button tr_chat(),16,150,140,48
return
end
rect 0,0,screen_w,screen_h,0xDD0F0F1A
num pw=screen_w-40, ph=screen_h-40, px=20, py=20
roundrect px,py,pw,ph,18,0xFF1E1E2F
ctext tr_online_chat(),py+17,0xFFFFFF
// Никаких кнопок вверх/вниз и отдельной кнопки «Клавиатура».
chat_button tr_close(),px+pw-120,py+10,104,42
num lx=px+16, lw=pw-32, iy=py+ph-72, ih=52, ly=py+66, lh=iy-ly-12, line_h=28
num maxl=floor(lh/line_h); if maxl<1; maxl=1; end
num total=net_chat_count(), start=total-maxl; if start<0; start=0; end
if total==0
text_scaled tr_no_messages(),lx,ly,0x8888AA,0.5
else
num idx=start, yy=ly
loop idx<total
if yy+line_h>iy-8; idx=total
else
str line=uid_short(idx)+": "+net_chat_text(idx)
text_scaled line,lx,yy,0xE0E0FF,0.5; yy=yy+line_h; idx=idx+1
end
end
end
roundrect lx,iy,lw-122,ih,10,0xFF2A2A40
chat_sync_input
if keyboard_enter_pressed()==1; chat_send; end
if str_len(chat_input)==0; text_in_field tr_type_message(),lx+10,iy,ih,0x666688,0.55
else; text_in_field chat_input,lx+10,iy,ih,0xFFFFFF,0.55; end
chat_button tr_send(),lx+lw-112,iy,112,ih
end
function chat_hit num x, num y, num bx, num by, num bw, num bh
if x>=bx&&x<=bx+bw&&y>=by&&y<=by+bh; return 1; end; return 0
end
function touch_chat num x, num y, num action
if action!=0; return 0; end
if chat_open==0
if chat_hit(x,y,16,150,140,48)==1; chat_open=1; keyboard_hide; return 1; end
return 0
end
num pw=screen_w-40, ph=screen_h-40, px=20, py=20, lx=px+16, lw=pw-32
if chat_hit(x,y,px+pw-120,py+10,104,42)==1; chat_open=0; keyboard_hide; return 1; end
num iy=py+ph-72, ih=52
if chat_hit(x,y,lx,iy,lw-122,ih)==1; keyboard_show; return 1; end
if chat_hit(x,y,lx+lw-112,iy,112,ih)==1; chat_send; return 1; end
return 1
end
