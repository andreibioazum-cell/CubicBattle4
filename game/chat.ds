num chat_open=0, chat_scroll=0
str chat_input=""
// chat.ds — отдельный модуль онлайн чата, не в battle.ds
// сообщения слева сверху, сама кнопка чата — чуть ниже сообщений
// и в том же стиле, что и все остальные кнопки (button из ui.ds).
// В полном чате есть своя экранная клавиатура — работает на любом
// устройстве, без системной клавиатуры.

function chat_button str label, num x, num y, num w, num h
// кнопка в стиле обычных кнопок: фиолетовый roundrect и белый текст
roundrect x,y,w,h,20,0x5F10A0
num tw=text_ink_width(label)*0.5, th=text_ink_height(label)*0.5, tt=text_ink_top(label)*0.5
text_scaled label,x+(w-tw)/2,y+(h-th)/2-tt,0xFFFFFF,0.5
end
function chat_send
// отправка текста в Firebase (Enter, кнопка «Отправить»)
if str_len(chat_input)==0; return; end; net_chat_send chat_input; ds_log "chat: %s",chat_input; chat_input=""; keyboard_clear; chat_scroll=0
end
function uid_short num idx
// первые 6 символов uid — компактная подпись вместо длинного хекса
c static char ub[8]
c { const char *u = net_chat_uid(idx); int n = 0; while (u && u[n] && n < 6) { ub[n] = u[n]; n++; } ub[n] = 0; }
str s=ub
return s
end
function draw_keypad
// экранная клавиатура чата — три ряда букв + ряд с пробелом и стиранием
c static const char *ru[3] = { "йцукенгшщзхъ", "фывапролджэ", "ячсмитьбю" };
c static const char *en[3] = { "qwertyuiop", "asdfghjkl", "zxcvbnm" };
c static char kb[40][2];
c { const char **rows = language_ru ? ru : en; double kw = floor((screen_w-138)/12.0), kh = 44, gap = 6; double kx = 36, ky = screen_h-264; int r, k, n = 0; for (r = 0; r < 3; r++) { for (k = 0; rows[r][k]; k++, n++) { double bx = kx+k*(kw+gap), by = ky+r*50; roundrect(bx,by,kw,kh,20,0x5F10A0); kb[n][0] = rows[r][k]; kb[n][1] = 0; text_scaled(kb[n], bx+(kw-text_ink_width(kb[n])*0.5)/2, by+(kh-text_ink_height(kb[n])*0.5)/2-text_ink_top(kb[n])*0.5, 0xFFFFFF, 0.5); } } roundrect(kx,ky+150,kw,kh,20,0x5F10A0); text_scaled(",", kx+(kw-text_ink_width(",")*0.5)/2, ky+156, 0xFFFFFF, 0.5); roundrect(kx+(kw+gap),ky+150,kw,kh,20,0x5F10A0); text_scaled(".", kx+(kw+gap)+(kw-text_ink_width(".")*0.5)/2, ky+156, 0xFFFFFF, 0.5); roundrect(kx+2*(kw+gap),ky+150,kw,kh,20,0x5F10A0); text_scaled("-", kx+2*(kw+gap)+(kw-text_ink_width("-")*0.5)/2, ky+156, 0xFFFFFF, 0.5); roundrect(kx+3*(kw+gap),ky+150,kw*6+gap*5,kh,20,0x5F10A0); text_scaled(language_ru ? "пробел" : "space", kx+3*(kw+gap)+((kw*6+gap*5)-text_ink_width(language_ru ? "пробел" : "space")*0.5)/2, ky+156, 0xFFFFFF, 0.5); roundrect(kx+9*(kw+gap),ky+150,kw*3+gap*2,kh,20,0x5F10A0); text_scaled("<", kx+9*(kw+gap)+((kw*3+gap*2)-text_ink_width("<")*0.5)/2, ky+156, 0xFFFFFF, 0.5); }
end
function draw_chat
if game_state!=5; return; end; if chat_open==0
// мини-режим: сообщения слева сверху, кнопка чата чуть ниже
num cc=net_chat_count(), i=cc-4, dy=56; if i<0; i=0; end
loop i<cc; str t=net_chat_text(i); if str_len(t)>0; text_scaled t,16,dy,0xE0E0FF,0.45; dy=dy+22; end; i=i+1; end
if language_ru==1; button "Чат",16,150,140,48; else; button "Chat",16,150,140,48; end; return; end
// полный экран чата
rect 0,0,screen_w,screen_h,0xDD0F0F1A; num pw=screen_w-40, ph=screen_h-40, px=20, py=20; roundrect px,py,pw,ph,18,0xFF1E1E2F; if language_ru==1; ctext "Онлайн чат",py+14,0xFFFFFF; else; ctext "Online chat",py+14,0xFFFFFF; end; num lx=px+16, lw=pw-32, lwd=lw-168, ly=py+50, lh=ph-358, line_h=26, maxl=floor(lh/line_h), total=net_chat_count(), start=total-maxl-chat_scroll; if start<0; start=0; end; if total==0; text_scaled "No messages",lx,ly,0x8888AA,0.5; else; num idx=start, yy=ly; loop idx<total; if yy+line_h>ly+lh; idx=total; else; str line=uid_short(idx)+": "+net_chat_text(idx); if text_ink_width(line)>lwd-8; line=net_chat_text(idx); end; text_scaled line,lx,yy,0xE0E0FF,0.5; yy=yy+line_h; idx=idx+1; end; end; end; roundrect px+pw-50,py+50,34,34,10,0x5F10A0; text "^",px+pw-38,py+54,0xFFFFFF; roundrect px+pw-50,py+94,34,34,10,0x5F10A0; text "v",px+pw-38,py+98,0xFFFFFF; num rx=px+pw-160, rw=144; if language_ru==1; chat_button "Закрыть",rx,py+150,rw,44; chat_button "Очистить",rx,py+200,rw,44; chat_button "Клавиатура",rx,py+250,rw,44; else; chat_button "Close",rx,py+150,rw,44; chat_button "Clear",rx,py+200,rw,44; chat_button "Keyboard",rx,py+250,rw,44; end; num iy=py+ph-300, ih=48; roundrect lx,iy,lw-116,ih,10,0xFF2A2A40; str raw=keyboard_get_raw(); if str_eq(raw,chat_input)==0; chat_input=keyboard_get_text(); end; if keyboard_enter_pressed()==1; chat_send; end; if str_len(chat_input)==0; if language_ru==1; text_scaled "Введите сообщение...",lx+10,iy+10,0x666688,0.55; else; text_scaled "Type a message...",lx+10,iy+10,0x666688,0.55; end; else; text_scaled chat_input,lx+10,iy+10,0xFFFFFF,0.55; end; if language_ru==1; chat_button "Отправить",lx+lw-110,iy,110,48; else; chat_button "Send",lx+lw-110,iy,110,48; end; draw_keypad
end
function chat_hit num x, num y, num bx, num by, num bw, num bh
// проверка попадания в кнопку
if x>=bx&&x<=bx+bw&&y>=by&&y<=by+bh; return 1; end; return 0
end
function keypad_tap num x, num y
// экранная клавиатура: ввод символа по координатам (геометрия как в draw_keypad)
num kx=36, kw=floor((screen_w-138)/12), kh=44, gap=6, ky=screen_h-264
if y<ky||y>ky+194; return 0; end
num row=floor((y-ky)/50); if row>3; row=3; end; num col=floor((x-kx)/(kw+gap))
if col<0||col>11; return 0; end
c static const char *ru[3] = { "йцукенгшщзхъ", "фывапролджэ", "ячсмитьбю" };
c static const char *en[3] = { "qwertyuiop", "asdfghjkl", "zxcvbnm" };
c { const char **rows = language_ru ? ru : en; if (row < 3) { const char *r = rows[(int)row]; int i = (int)col; if (i >= 0 && i < (int)strlen(r)) { char s[2] = { r[i], 0 }; keyboard_type(s); } } else { if (col < 3) keyboard_type(col==0 ? "," : (col==1 ? "." : "-")); else if (col <= 8) keyboard_type(" "); else keyboard_backspace(); } }
return 1
end
function touch_chat num x, num y, num action
if action!=0; return 0; end; if chat_open==0; if chat_hit(x,y,16,150,140,48)==1; chat_open=1; keyboard_show; return 1; end; return 0; end; num pw=screen_w-40, ph=screen_h-40, px=20, py=20, lx=px+16, lw=pw-32; if chat_hit(x,y,px+pw-50,py+50,34,34)==1; chat_scroll=chat_scroll+1; if chat_scroll>net_chat_count(); chat_scroll=net_chat_count(); end; return 1; end; if chat_hit(x,y,px+pw-50,py+94,34,34)==1; chat_scroll=chat_scroll-1; if chat_scroll<0; chat_scroll=0; end; return 1; end; num rx=px+pw-160, rw=144; if chat_hit(x,y,rx,py+150,rw,44)==1; chat_open=0; keyboard_hide; return 1; end; if chat_hit(x,y,rx,py+200,rw,44)==1; chat_input=""; keyboard_clear; return 1; end; if chat_hit(x,y,rx,py+250,rw,44)==1; if keyboard_visible()==1; keyboard_hide; else; keyboard_show; end; return 1; end; num iy=py+ph-300, ih=48; if chat_hit(x,y,lx,iy,lw-116,ih)==1; keyboard_show; return 1; end; if chat_hit(x,y,lx+lw-110,iy,110,48)==1; chat_send; return 1; end; keypad_tap x,y; return 1
end
