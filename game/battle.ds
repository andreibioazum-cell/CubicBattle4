// battle.ds — только система боя (без чата)
// Ближний бой: пуль больше нет — прицел и удар.
// Хитбокс удара широкий (punch_width) и недлинный (punch_reach).

function reset_battle
// сброс игрока в центр, очистка ударов и ремоутов
player.x=screen_w/2; player.y=screen_h/2; player.angle=0; player.hp=player.max_hp; player.size=25*player_scale; enemy.size=25*enemy_scale; enemy.state=0; enemy.state_time=0; enemy.cooldown=0; enemy.hit=0; enemy.dodge_cd=0; enemy.think=0; finished=0; punch.active=0; punch.hit=0; punch_left=0; punch_cd=0; aiming=0; aim_id=-1; aim_a=0
joy.x=130; joy.y=screen_h-150; joy.r=70; atk_x=screen_w-140; atk_y=screen_h-150; drop_joy
arr_clear remotes; arr_clear rbullets; num i=0; loop i<max_players*6; arr_push rbullets,0; i=i+1; end
end
function init_game
reset_battle; enemy.hp=enemy.max_hp; spawn_enemy
end
function init_online
reset_battle; chat_open=0; keyboard_hide; online_ready=0; net_connect FIREBASE,ROOM
end
function place_online
// слот -> позиция на карте
num s=net_slot(), row=floor(s/2), col=s-row*2; player.x=screen_w*(0.3+0.4*col); player.y=screen_h*(0.35+0.3*row); online_ready=1
end
function spawn_enemy
num margin=70, i=0
loop i<50
enemy.x=margin+rand()%(screen_w-140); enemy.y=margin+rand()%(screen_h-140)
if dist(enemy.x,enemy.y,player.x,player.y)>280; i=50; else; i=i+1; end
end
enemy.state=0; enemy.state_time=0; enemy.cooldown=enemy_first_delay; enemy.hit=0; enemy.dodge_cd=0; enemy.think=0
if rand()%2==0; enemy.strafe=-1; else; enemy.strafe=1; end
end
function sprite_a num a
// спрайт нарисован «лицом вверх», поэтому к игровому углу добавляем pi/2
return a+pi/2
end
function move_player
// движение джойстиком: игрок разворачивается ровно туда, куда наклонён джойстик
player.x=player.x+joy.dx*joy_speed*dt; player.y=player.y+joy.dy*joy_speed*dt
num jm=sqrt(joy.dx*joy.dx+joy.dy*joy.dy); if jm>0.15; player.angle=atan2(joy.dy,joy.dx); end
if player.x<player.size; player.x=player.size; end; if player.x>screen_w-player.size; player.x=screen_w-player.size; end; if player.y<player.size; player.y=player.size; end; if player.y>screen_h-player.size; player.y=screen_h-player.size; end
end
function in_punch_box num px, num py, num pdx, num pdy, num tx, num ty
// хитбокс удара повёрнут вместе с игроком: вперёд по (pdx,pdy) не дальше
// punch_reach (недлинный), вбок ±punch_width/2 (широкий)
num rx=tx-px, ry=ty-py, fw=rx*pdx+ry*pdy, side=ry*pdx-rx*pdy
if fw>=0&&fw<=punch_reach&&side*side<=punch_width*punch_width/4; return 1; end; return 0
end
function enemy_in_punch
// уменьшенный хитбокс врага: проверяем центр и 4 угла на попадание в хитбокс удара.
// Его положение проверяется в локальных координатах направления punch.dx/punch.dy.
num ex=enemy.x, ey=enemy.y, hs=enemy.size*0.65
num fx=cos(enemy.angle)*hs, fy=sin(enemy.angle)*hs, sx=-sin(enemy.angle)*hs, sy=cos(enemy.angle)*hs
if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex,ey)==1; return 1; end
// Проверяем повёрнутые углы, а не углы экранного квадрата.
if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex-fx-sx,ey-fy-sy)==1; return 1; end
if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex+fx-sx,ey+fy-sy)==1; return 1; end
if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex+fx+sx,ey+fy+sy)==1; return 1; end
if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex-fx+sx,ey-fy+sy)==1; return 1; end
return 0
end
function update_aim
// хитбокс показывается ТОЛЬКО во время самого удара (пока меняется текстура и
// наносится урон), при простом прицеливании его не видно
if punch_left>0&&finished==0; aim_a=1
else; aim_a=aim_a-dt/aim_fade_out; if aim_a<0; aim_a=0; end; end
if punch_cd>0; punch_cd=punch_cd-dt; if punch_cd<0; punch_cd=0; end; end
end
function follow_punch
// хитбокс удара привязан к игроку: при ходьбе во время удара он не отстаёт
if punch_left<=0; return; end
punch.x=player.x; punch.y=player.y; punch.dx=cos(player.angle); punch.dy=sin(player.angle)
end
function enemy_move num vx, num vy
// Единое перемещение ИИ с учётом границ экрана.
enemy.x=enemy.x+vx*dt; enemy.y=enemy.y+vy*dt
if enemy.x<enemy.size; enemy.x=enemy.size; end
if enemy.x>screen_w-enemy.size; enemy.x=screen_w-enemy.size; end
if enemy.y<enemy.size; enemy.y=enemy.size; end
if enemy.y>screen_h-enemy.size; enemy.y=screen_h-enemy.size; end
end
function enemy_face_prediction
// Бот целится немного вперёд по направлению движения игрока, но после замаха
// направление фиксируется: от удара можно честно увернуться.
num tx=player.x+joy.dx*joy_speed*enemy_prediction, ty=player.y+joy.dy*joy_speed*enemy_prediction
enemy.angle=atan2(ty-enemy.y,tx-enemy.x)
end
function player_in_enemy_punch
num pdx=cos(enemy.angle), pdy=sin(enemy.angle), rx=player.x-enemy.x, ry=player.y-enemy.y
// Габарит игрока в проверке ровно такой же, как габарит бота в enemy_in_punch
// (0.65 от размера) — попадания по игроку и по боту одинаково «щедрые».
num fw=rx*pdx+ry*pdy, side=ry*pdx-rx*pdy, pr=player.size*0.65, half=enemy_punch_width/2+pr
if fw>=0&&fw<=enemy_punch_reach+pr&&side*side<=half*half; return 1; end
return 0
end
function enemy_roll_cooldown
// Перезарядка удара бота каждый раз новая: случайное число в диапазоне
// enemy_cooldown_min..enemy_cooldown_max, но никогда быстрее 0.1 с.
num r=enemy_cooldown_min+(rand()%1000)/1000.0*(enemy_cooldown_max-enemy_cooldown_min)
if r<enemy_cooldown_min; r=enemy_cooldown_min; end
return r
end
function start_enemy_attack
enemy.state=1; enemy.state_time=enemy_windup; enemy.hit=0; enemy_face_prediction
end
function update_enemy
// Бот равен игроку по цифрам (урон 1, HP 10, цикл атаки 0.3 с), но играет как
// живой соперник: уклоняется от удара игрока, после своего удара отходит за
// дальность чужого удара и стрейфит, а не стоит под ударами.
if enemy.cooldown>0; enemy.cooldown=enemy.cooldown-dt; if enemy.cooldown<0; enemy.cooldown=0; end; end
if enemy.dodge_cd>0; enemy.dodge_cd=enemy.dodge_cd-dt; if enemy.dodge_cd<0; enemy.dodge_cd=0; end; end
num dx=player.x-enemy.x, dy=player.y-enemy.y, d=sqrt(dx*dx+dy*dy)
if d<1; d=1; end
// Замах: бот ещё следит за целью, затем заранее фиксирует направление удара.
if enemy.state==1
enemy.state_time=enemy.state_time-dt
if enemy.state_time>enemy_lock_time; enemy_face_prediction; end
if enemy.state_time<=0; enemy.state=2; enemy.state_time=enemy_punch_time; enemy.hit=0; end
return
end
// Короткое активное окно удара. Простое касание врага урон больше не наносит.
if enemy.state==2
enemy.state_time=enemy.state_time-dt
if enemy.hit==0&&player_in_enemy_punch()==1
enemy.hit=1; player.hp=player.hp-enemy_damage; ds_log "enemy punch! hp %g",player.hp
if player.hp<=0; player.hp=0; finish_game 2; return; end
end
if enemy.state_time<=0; enemy.state=3; enemy.state_time=enemy_recovery; enemy.cooldown=enemy_roll_cooldown(); enemy.think=enemy_think_min+(rand()%100)/100.0*(enemy_think_max-enemy_think_min); end
return
end
// После удара бот отступает, а не прилипает к игроку.
if enemy.state==3
enemy.state_time=enemy.state_time-dt; enemy.angle=atan2(dy,dx)
num rvx=-dx/d*bot_speed*0.65-dy/d*bot_strafe_speed*0.35*enemy.strafe
num rvy=-dy/d*bot_speed*0.65+dx/d*bot_strafe_speed*0.35*enemy.strafe
if d<enemy_attack_distance+28; enemy_move rvx,rvy; end
if enemy.state_time<=0; enemy.state=0; if rand()%2==0; enemy.strafe=-enemy.strafe; end; end
return
end
// Уклонение: быстрый шаг в сторону от линии удара игрока и чуть назад.
// Направление удара игрока берётся из его угла — как видит сам игрок.
if enemy.state==4
enemy.state_time=enemy.state_time-dt; enemy_face_prediction
num dpx=cos(player.angle), dpy=sin(player.angle)
num dvx=-dpy*enemy.strafe*bot_dodge_speed-dpx*bot_speed*0.6
num dvy=dpx*enemy.strafe*bot_dodge_speed-dpy*bot_speed*0.6
enemy_move dvx,dvy
if enemy.state_time<=0; enemy.state=0; enemy.dodge_cd=enemy_dodge_cooldown; end
return
end
enemy_face_prediction
// Реакция на удар игрока: если бот в зоне поражения и уклонение готово —
// уходим с линии удара в ту сторону, где бот уже стоит. Реакция не мгновенная
// (enemy_reaction): быстрый удар в упор успевает попасть до начала шага.
if punch_left>0&&punch_left<=punch_time-enemy_reaction&&enemy.dodge_cd<=0
num pxx=cos(player.angle), pyy=sin(player.angle)
num rxx=enemy.x-player.x, ryy=enemy.y-player.y
num fw2=rxx*pxx+ryy*pyy, sd2=ryy*pxx-rxx*pyy
if fw2>-30&&fw2<punch_reach+enemy.size&&sd2*sd2<=punch_width*punch_width
if sd2>=0; enemy.strafe=1; else; enemy.strafe=-1; end
enemy.state=4; enemy.state_time=enemy_dodge_time
return
end
end
// Передышка после своей атаки: бот отходит за дальность удара игрока и
// стрейфит, заходя на следующий удар сбоку — как игрок, который держит дистанцию.
if enemy.think>0
enemy.think=enemy.think-dt
num safe=punch_reach+enemy.size
num radial=clamp((d-safe)*2.2,-bot_speed,bot_speed)
num tvx=dx/d*radial-dy/d*bot_strafe_speed*enemy.strafe
num tvy=dy/d*radial+dx/d*bot_strafe_speed*enemy.strafe
enemy_move tvx,tvy
return
end
// Подойти только до дистанции удара, затем двигаться вокруг игрока и выбирать момент.
if d>enemy_attack_distance
num tx=player.x+joy.dx*joy_speed*enemy_prediction, ty=player.y+joy.dy*joy_speed*enemy_prediction
num mdx=tx-enemy.x, mdy=ty-enemy.y, md=sqrt(mdx*mdx+mdy*mdy); if md<1; md=1; end
enemy_move mdx/md*bot_speed,mdy/md*bot_speed
return
end
// Не допускаем прилипания и урона от столкновения.
if d<enemy_min_distance
enemy_move -dx/d*bot_speed,-dy/d*bot_speed
return
end
if enemy.cooldown<=0; start_enemy_attack; return; end
// Пока атака на перезарядке, бот стрейфит и удерживает удобную дистанцию.
num radial2=clamp((d-(enemy_attack_distance+enemy_min_distance)/2)*1.8,-38,38)
num vx=dx/d*radial2-dy/d*bot_strafe_speed*enemy.strafe
num vy=dy/d*radial2+dx/d*bot_strafe_speed*enemy.strafe
enemy_move vx,vy
end
function update_game
update_aim; if finished!=0; return; end; move_player
if punch_left>0; punch_left=punch_left-dt; if punch_left<0; punch_left=0; end; end
follow_punch
// урон игрока наносится только в активное окно его анимации удара
if punch_left>0&&punch.active==1&&punch.hit==0
if enemy_in_punch()==1
punch.hit=1; enemy.hp=enemy.hp-punch_damage; ds_log "hit! enemy hp %g",enemy.hp
if enemy.hp<=0; finish_game 1; return; end
end
end
update_enemy
end
function ridx num s
num i=0; loop i<arr_len(remotes)/7; if arr_get(remotes,i*7)==s; return i; end; i=i+1; end; return -1
end
function drop_remote num i
// Удаление записи вышедшего игрока: на её место переносим последнюю запись
// списка и укорачиваем массив на 7 полей.
num last=arr_len(remotes)/7-1, b=i*7, lb=last*7, k=0
if i<last; loop k<7; arr_set remotes,b+k,arr_get(remotes,lb+k); k=k+1; end; end
k=0; loop k<7; arr_pop remotes; k=k+1; end
end
function purge_left
// Игроки, которые вышли из комнаты (слот больше не онлайн), удаляются из
// списка вместе со своим ударом — иначе они висели бы «призраками» и
// занимали место, из-за которого новый игрок уже не попадал в список.
num i=0
loop i<arr_len(remotes)/7
num s=arr_get(remotes,i*7)
if net_player_online(s)==0||s==net_slot()
num rb=s*6, k=0; loop k<6; arr_set rbullets,rb+k,0; k=k+1; end
ds_log "player left: slot %g",s
drop_remote i
else; i=i+1; end
end
end
function read_remotes
// без интерполяции — просто частое чтение, прямое присваивание x,y убирает тряску и лаги
if net_slot()<0; return; end; purge_left; num i=0; loop i<arr_len(remotes)/7; arr_set remotes,i*7+5,0; i=i+1; end
num s=0; loop s<max_players; if net_player_online(s)==1&&s!=net_slot()
num x=net_player_x(s)*screen_w, y=net_player_y(s)*screen_h; i=ridx(s)
if i<0&&arr_len(remotes)/7<max_players-1; i=arr_len(remotes)/7; num v=0; loop v<7; arr_push remotes,0; v=v+1; end; num nb=i*7; arr_set remotes,nb,s; arr_set remotes,nb+1,x; arr_set remotes,nb+2,y; arr_set remotes,nb+6,net_player_bullet_shot(s); end
if i>=0; num b=i*7; arr_set remotes,b+1,x; arr_set remotes,b+2,y; arr_set remotes,b+3,net_player_angle(s); arr_set remotes,b+4,net_player_hp(s); arr_set remotes,b+5,net_player_alive(s)
num sh=net_player_bullet_shot(s); if sh!=arr_get(remotes,b+6); arr_set remotes,b+6,sh; if net_player_bullet_active(s)==1; num rb=s*6; arr_set rbullets,rb,1; arr_set rbullets,rb+1,x; arr_set rbullets,rb+2,y; arr_set rbullets,rb+3,net_player_bullet_dx(s); arr_set rbullets,rb+4,net_player_bullet_dy(s); arr_set rbullets,rb+5,0; end; end; end; end; s=s+1; end
end
function update_online
if online_ready==0&&net_slot()>=0; place_online; end; read_remotes; update_aim; if finished!=0||online_ready==0; return; end; move_player
if punch_left>0; punch_left=punch_left-dt; if punch_left<0; punch_left=0; end; end
follow_punch
if punch.active==1&&punch_left<=0; punch.active=0; net_publish_bullet punch.ox/screen_w,punch.oy/screen_h,punch.dx,punch.dy,0,punch.shot,0; end
// частая публикация позиции каждый кадр (net.c пишет каждые 50мс) — без лага
num alive=1; if player.hp<=0; alive=0; end; net_publish player.x/screen_w,player.y/screen_h,player.angle,player.hp,alive
// чужие удары: короткий таймер и широкий недлинный хитбокс от точки удара
num i=0; loop i<max_players; num rb=i*6; if arr_get(rbullets,rb)==1
num tr=arr_get(rbullets,rb+5)+dt; arr_set rbullets,rb+5,tr
if tr>=punch_time; arr_set rbullets,rb,0
else if player.hp>0&&in_punch_box(arr_get(rbullets,rb+1),arr_get(rbullets,rb+2),arr_get(rbullets,rb+3),arr_get(rbullets,rb+4),player.x,player.y)==1
arr_set rbullets,rb,0; player.hp=player.hp-punch_damage; ds_log "hit! hp %g",player.hp
if player.hp<=0; player.hp=0; net_publish player.x/screen_w,player.y/screen_h,player.angle,0,0; finish_game 2; end
end; end; i=i+1; end
end
function fire_punch
// удар: пуля не вылетает — хитбокс и удар, спрайт обычный -> ordinary_punch
// между ударами пауза punch_cooldown (0.3 c); сам урон наносится в update_game
// во время анимации удара (пока punch_left>0), а не мгновенно в момент нажатия
if punch_cd>0; return; end
punch.x=player.x; punch.y=player.y; punch.dx=cos(player.angle); punch.dy=sin(player.angle); punch.ox=punch.x; punch.oy=punch.y; punch.tr=0; punch.active=1; punch.hit=0; punch.shot=punch.shot+1; punch_left=punch_time; punch_cd=punch_cooldown
if game_state==5; net_publish_bullet punch.ox/screen_w,punch.oy/screen_h,punch.dx,punch.dy,1,punch.shot,0; end
end
function finish_game num result
finished=result; aiming=0; aim_id=-1; aim_a=0; punch.active=0; punch.hit=0; punch_left=0; drop_joy
end
function draw_field
num y=0; loop y<screen_h; num x=0; loop x<screen_w; tex x,y,GRASS,0,1; x=x+256; end; y=y+256; end; rect 0,0,screen_w,screen_h,0x33000000
// хитбокс удара: чёрный, слегка прозрачный прямоугольник, повёрнутый по направлению
// взгляда игрока (длина punch_reach, ширина punch_width). Рисуется только в момент
// удара (когда меняется текстура и наносится урон) и всегда следует за игроком.
if aim_a>0&&finished==0
num aa=floor(aim_a*aim_max_alpha)
if aa>0
num px=player.x, py=player.y, pdx=cos(player.angle), pdy=sin(player.angle)
num ax=px+pdx*punch_reach, ay=py+pdy*punch_reach
// Цвет всегда чисто чёрный, прозрачность задаётся только альфа-каналом.
line px,py,ax,ay,punch_width,aa*0x1000000
end
end
num hw=25*cube_scale*player_scale, ps=cube_scale*player_scale
if punch_left>0; tex player.x-hw,player.y-hw,PUNCH_TEX,sprite_a(player.angle),ps; else; tex player.x-hw,player.y-hw,ORDINARY_TEX,sprite_a(player.angle),ps; end
end
function draw_controls
ring joy.x,joy.y,joy.r,4,0x000000; circle joy.x+joy.ox,joy.y+joy.oy,34,0x000000
circle atk_x,atk_y,70,0xE94560; ring atk_x,atk_y,70,4,0x000000
text_in_box tr_punch(),atk_x-70,atk_y-70,140,140,0xFFFFFF,0.55
draw_back
end
function draw_result str title, str note
rect 0,0,screen_w,screen_h,0x99000000; num y=screen_h/2-85; roundrect screen_w/2-165,y,330,170,24,0x5F10A0; ctext title,y+34,0xFFFFFF; ctext note,y+75,0xFFFFFF; ctext tr_tap_to_return(),y+118,0xFFCDD2
end
function draw_game
// Прицел удара бота: такая же чёрная полупрозрачная полоса, как у игрока —
// показывает, куда попадёт удар (замах и активное окно), можно увернуться.
draw_field
if (enemy.state==1||enemy.state==2)&&finished==0
num aex=enemy.x+cos(enemy.angle)*enemy_punch_reach, aey=enemy.y+sin(enemy.angle)*enemy_punch_reach
line enemy.x,enemy.y,aex,aey,enemy_punch_width,aim_max_alpha*0x1000000
end
num ehw=25*cube_scale*enemy_scale, es=cube_scale*enemy_scale
if enemy.state==1||enemy.state==2; tex enemy.x-ehw,enemy.y-ehw,PUNCH_TEX,sprite_a(enemy.angle),es
else; tex enemy.x-ehw,enemy.y-ehw,ORDINARY_TEX,sprite_a(enemy.angle),es; end
num w=screen_w/4
hud_bar 20,20,w,28,player.hp,player.max_hp,0x7ED321,0; hud_bar screen_w-w-20,20,w,28,enemy.hp,enemy.max_hp,0xE94560,1
draw_controls
if finished==1; draw_result tr_victory(),tr_opponent_defeated(); else if finished==2; draw_result tr_defeat(),tr_opponent_won(); end
end
function draw_online
draw_field; num hw=25*cube_scale*player_scale, ps=cube_scale*player_scale; str myn=net_player_nick(net_slot()); if str_len(myn)>0; num mnw=text_ink_width(myn)*0.5; text_scaled myn,player.x-mnw/2,player.y-hw-26,0xFFFFFF,0.5; end; num i=0; loop i<arr_len(remotes)/7; num b=i*7; if arr_get(remotes,b+5)==1
num rx=arr_get(remotes,b+1), ry=arr_get(remotes,b+2), ra=arr_get(remotes,b+3), slot=arr_get(remotes,b); str rn=net_player_nick(slot)
if arr_get(rbullets,slot*6)==1
// Прицел удара соперника: та же чёрная полоса, что и у игрока.
num lx2=rx+arr_get(rbullets,slot*6+3)*punch_reach, ly2=ry+arr_get(rbullets,slot*6+4)*punch_reach
line rx,ry,lx2,ly2,punch_width,aim_max_alpha*0x1000000
tex rx-hw,ry-hw,PUNCH_TEX,sprite_a(ra),ps
else; tex rx-hw,ry-hw,ORDINARY_TEX,sprite_a(ra),ps; end
if str_len(rn)>0; num rnw=text_ink_width(rn)*0.5; text_scaled rn,rx-rnw/2,ry-hw-26,0xFFFFFF,0.5; end
end; i=i+1; end; num w=screen_w/3; hud_bar 20,20,w,28,player.hp,player.max_hp,0x7ED321,0; draw_controls; draw_chat; num st=net_status(), sy=back_y+btn_h+18; if st==4; ctext tr_no_connection(),sy,0xFF8A80; ctext tr_reconnecting(),sy+32,0xFFF176; else if st==1; ctext tr_connecting(),sy,0xFFF176; end; if finished==2; draw_result tr_defeat(),tr_you_were_defeated(); end
end
function drop_joy
joy_id=-1; joy.dx=0; joy.dy=0; joy.ox=0; joy.oy=0
end
function joy_touch num x, num y, num action, num id
if action==1; if id==joy_id; drop_joy; end; return; end; if action==0; if joy_id!=-1; return; end; if sqrt((x-joy.x)*(x-joy.x)+(y-joy.y)*(y-joy.y))>150; return; end; joy_id=id; end; if id!=joy_id; return; end; num dx=x-joy.x, dy=y-joy.y, d=sqrt(dx*dx+dy*dy); if d>joy.r; joy.dx=dx/d; joy.dy=dy/d; joy.ox=joy.dx*joy.r; joy.oy=joy.dy*joy.r; else; joy.dx=dx/joy.r; joy.dy=dy/joy.r; joy.ox=dx; joy.oy=dy; end
end
function touch_game num x, num y, num action, num id
if finished!=0; if action==0; start_transition 0; end; return; end; if action==3; aiming=0; aim_id=-1; drop_joy; return; end; if game_state==5&&touch_chat(x,y,action)==1; return; end; if back_hit(x,y)==1&&action!=2; start_transition 0; return; end; if chat_open==1; return; end; if action==0&&sqrt((x-atk_x)*(x-atk_x)+(y-atk_y)*(y-atk_y))<=96; aiming=1; aim_id=id; return; end; if action==1&&id==aim_id; aiming=0; aim_id=-1; if game_state==1||online_ready==1; fire_punch; end; return; end; joy_touch x,y,action,id
end
