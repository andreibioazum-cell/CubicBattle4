function reset_battle
player.x=screen_w/2; player.y=screen_h/2; player.angle=0; player.hp=player.max_hp; finished=0; bullet.active=0; aiming=0; aim_id=-1; joy.x=130; joy.y=screen_h-150; joy.r=70; atk_x=screen_w-140; atk_y=screen_h-150; drop_joy
arr_clear remotes; arr_clear rbullets
num i=0; loop i<max_players*8; arr_push rbullets,0; i=i+1; end
end
function init_game
reset_battle; enemy.hp=enemy.max_hp; spawn_enemy
end
function init_online
reset_battle; placed=0; online_ready=0; my_shot=0; net_connect FIREBASE, ROOM
end
function spawn_enemy
num i=0; loop i<50; enemy.x=50+rand()%(screen_w-100); enemy.y=50+rand()%(screen_h-100); if sqrt((enemy.x-player.x)*(enemy.x-player.x)+(enemy.y-player.y)*(enemy.y-player.y))>250; return; end; i=i+1; end; enemy.x=50; enemy.y=50
end
function move_player
player.x=player.x+joy.dx*joy_speed*dt; player.y=player.y+joy.dy*joy_speed*dt
if joy.dx!=0||joy.dy!=0; player.angle=atan2(joy.dy,joy.dx); end
if player.x<player.size; player.x=player.size; end; if player.x>screen_w-player.size; player.x=screen_w-player.size; end
if player.y<player.size; player.y=player.size; end; if player.y>screen_h-player.size; player.y=screen_h-player.size; end
end
function move_b
bullet.x=bullet.x+bullet.dx*bullet_speed*dt; bullet.y=bullet.y+bullet.dy*bullet_speed*dt; bullet.traveled=bullet.traveled+bullet_speed*dt
if bullet.traveled>=aim_range||bullet.x<-bullet.r||bullet.x>screen_w+bullet.r||bullet.y<-bullet.r||bullet.y>screen_h+bullet.r; bullet.active=0; end
end
function move_rb num s
num b=s*8, x=arr_get(rbullets,b+2)+arr_get(rbullets,b+4)*bullet_speed*dt, y=arr_get(rbullets,b+3)+arr_get(rbullets,b+5)*bullet_speed*dt, tr=arr_get(rbullets,b+7)+bullet_speed*dt
arr_set rbullets,b+2,x; arr_set rbullets,b+3,y; arr_set rbullets,b+7,tr
if tr>=aim_range||x<-12||x>screen_w+12||y<-12||y>screen_h+12; arr_set rbullets,b,0; end
end
function hit_r num tr
num l=aim_range-tr; if l<aim_fade; return 12*l/aim_fade; end; return 12
end
function update_game
if finished!=0; return; end; move_player
num dx=player.x-enemy.x, dy=player.y-enemy.y, d=sqrt(dx*dx+dy*dy)
if d>1; enemy.x=enemy.x+dx/d*bot_speed*dt; enemy.y=enemy.y+dy/d*bot_speed*dt; end; enemy.angle=atan2(dy,dx)
if d<player.size+enemy.size; player.hp=player.hp-1; if player.hp<=0; finish_game 2; return; end; spawn_enemy; end
if bullet.active==0; return; end; move_b; if bullet.active==0; return; end
dx=enemy.x-bullet.x; dy=enemy.y-bullet.y; d=sqrt(dx*dx+dy*dy)
if d<=enemy.size+hit_r(bullet.traveled); bullet.active=0; enemy.hp=enemy.hp-1; if enemy.hp<=0; finish_game 1; end; end
end
function ridx num s
num i=0; loop i<arr_len(remotes)/10; if arr_get(remotes,i*10)==s; return i; end; i=i+1; end; return -1
end
function read_remotes
if net_slot()<0; return; end
num s=0; loop s<max_players
if net_player_online(s)==1&&s!=net_slot()
num i=ridx(s); if i<0&&arr_len(remotes)/10<max_players-1; i=arr_len(remotes)/10; num v=0; loop v<10; arr_push remotes,0; v=v+1; end; arr_set remotes,i*10,s; end
if i>=0
num b=i*10, x=net_player_x(s), y=net_player_y(s), k=dt*12; if k>1; k=1; end
arr_set remotes,b+1,x; arr_set remotes,b+2,y; arr_set remotes,b+5,net_player_angle(s); arr_set remotes,b+7,net_player_hp(s); arr_set remotes,b+8,net_player_alive(s)
arr_set remotes,b+3,arr_get(remotes,b+3)+(x-arr_get(remotes,b+3))*k; arr_set remotes,b+4,arr_get(remotes,b+4)+(y-arr_get(remotes,b+4))*k
num sh=net_player_bullet_shot(s); if sh!=arr_get(remotes,b+9)&&net_player_bullet_active(s)==1; arr_set remotes,b+9,sh; num rb=s*8; arr_set rbullets,rb,1; arr_set rbullets,rb+1,s; arr_set rbullets,rb+2,net_player_bullet_x(s); arr_set rbullets,rb+3,net_player_bullet_y(s); arr_set rbullets,rb+4,net_player_bullet_dx(s); arr_set rbullets,rb+5,net_player_bullet_dy(s); arr_set rbullets,rb+6,sh; arr_set rbullets,rb+7,0; end
end
end
s=s+1; end
end
function update_online
if placed==0&&net_slot()>=0; player.x=screen_w/2; player.y=screen_h/2; placed=1; online_ready=1; end
num a=1; if player.hp<=0; a=0; end; net_publish player.x,player.y,player.angle,player.hp,a; net_publish_bullet bullet.x,bullet.y,bullet.dx,bullet.dy,bullet.active,my_shot; read_remotes
if finished!=0||online_ready==0; return; end; move_player; if bullet.active==1; move_b; end
num i=0; loop i<arr_len(remotes)/10; num b=i*10; if bullet.active==1&&arr_get(remotes,b+7)>0&&arr_get(remotes,b+8)==1; num odx=arr_get(remotes,b+3)-bullet.x, ody=arr_get(remotes,b+4)-bullet.y; if sqrt(odx*odx+ody*ody)<=player.size+hit_r(bullet.traveled); bullet.active=0; end; end; i=i+1; end
i=0; loop i<max_players; if arr_get(rbullets,i*8)==1; move_rb i; if arr_get(rbullets,i*8)==1&&player.hp>0; num x=arr_get(rbullets,i*8+2), y=arr_get(rbullets,i*8+3), hdx=player.x-x, hdy=player.y-y, tr=arr_get(rbullets,i*8+7); if sqrt(hdx*hdx+hdy*hdy)<=player.size+hit_r(tr); arr_set rbullets,i*8,0; player.hp=player.hp-1; if player.hp<=0; player.hp=0; net_publish player.x,player.y,player.angle,0,0; finish_game 2; end; end; end; end; i=i+1; end
end
function fire_bullet
num fdx=cos(player.angle), fdy=sin(player.angle); bullet.x=player.x+fdx*(player.size+bullet.r+4); bullet.y=player.y+fdy*(player.size+bullet.r+4); bullet.dx=fdx; bullet.dy=fdy; bullet.traveled=0; bullet.active=1; my_shot=my_shot+1
if game_state==5; net_publish_bullet bullet.x,bullet.y,fdx,fdy,1,my_shot; end
end
function finish_game num r
finished=r; aiming=0; aim_id=-1; bullet.active=0; drop_joy
end
function draw_b num x, num y, num tr
num left=aim_range-tr, a=255, sc=1; if left<aim_fade; sc=left/aim_fade; a=floor(255*sc); end; if a<1; a=1; end; num rr=12*sc; circle x,y,rr,a*0x1000000+0xFFF176; ring x,y,rr+2*sc,2*sc,a*0x1000000+0xFFB300
end
function draw_field
num y=0; loop y<screen_h; num x=0; loop x<screen_w; tex x,y,GRASS,0,1; x=x+256; end; y=y+256; end; rect 0,0,screen_w,screen_h,0x33000000
if aiming==1&&finished==0; num ax=cos(player.angle), ay=sin(player.angle); line player.x,player.y,player.x+ax*aim_range,player.y+ay*aim_range,18,0x66000000; end
circle player.x,player.y,player.size/2,0xFF8844; tex player.x-20,player.y-20,TEX,player.angle,1
end
function draw_controls
ring joy.x,joy.y,joy.r,4,0x000000; circle joy.x+joy.ox,joy.y+joy.oy,34,0x000000; if aiming==1; circle atk_x,atk_y,76,0xC73750; else; circle atk_x,atk_y,70,0xE94560; end; ring atk_x,atk_y,70,4,0x000000
if language_ru==1; text_scaled "Атака",atk_x-text_ink_width("Атака")*0.275,atk_y-7,0xFFFFFF,0.55; else; text_scaled "Attack",atk_x-text_ink_width("Attack")*0.275,atk_y-7,0xFFFFFF,0.55; end; draw_back
end
function draw_result str t, str n
rect 0,0,screen_w,screen_h,0x99000000; num py=screen_h/2-85; roundrect screen_w/2-165,py,330,170,24,0x5F10A0; ctext t,py+34,0xFFFFFF; ctext n,py+75,0xFFFFFF
if language_ru==1; ctext "Нажмите, чтобы выйти",py+118,0xFFCDD2; else; ctext "Tap to return",py+118,0xFFCDD2; end
end
function draw_game
draw_field; tex enemy.x-20,enemy.y-20,TEX,enemy.angle,1; ring enemy.x,enemy.y,26,3,0xFF2020; draw_b bullet.x,bullet.y,bullet.traveled
num hw=screen_w/4; hud_bar 20,20,hw,28,player.hp,player.max_hp,0x7ED321,0; hud_bar screen_w-hw-20,20,hw,28,enemy.hp,enemy.max_hp,0xE94560,1; draw_controls
if finished==1; if language_ru==1; draw_result "Победа!","Соперник побеждён"; else; draw_result "Victory!","Opponent defeated"; end; else if finished==2; if language_ru==1; draw_result "Поражение","Соперник победил"; else; draw_result "Defeat","The opponent won"; end; end
end
function draw_online
draw_field
num i=0; loop i<arr_len(remotes)/10; num b=i*10; if arr_get(remotes,b+8)==1; tex arr_get(remotes,b+3)-20,arr_get(remotes,b+4)-20,TEX,arr_get(remotes,b+6),1; ring arr_get(remotes,b+3),arr_get(remotes,b+4),26,3,0xFF2020; end; i=i+1; end
draw_b bullet.x,bullet.y,bullet.traveled; i=0; loop i<max_players; if arr_get(rbullets,i*8)==1; draw_b arr_get(rbullets,i*8+2),arr_get(rbullets,i*8+3),arr_get(rbullets,i*8+7); end; i=i+1; end
num hw=screen_w/3; hud_bar 20,20,hw,28,player.hp,player.max_hp,0x7ED321,0; draw_controls
num st=net_status(); if st==4; if language_ru==1; ctext "Нет соединения",76,0xFF8A80; else; ctext "No connection",76,0xFF8A80; end; else if st==1; if language_ru==1; ctext "Подключение...",76,0xFFF176; else; ctext "Connecting...",76,0xFFF176; end; end
if finished==2; if language_ru==1; draw_result "Поражение","Вы повержены"; else; draw_result "Defeat","You were defeated"; end; end
end
function drop_joy
joy_id=-1; joy.dx=0; joy.dy=0; joy.ox=0; joy.oy=0
end
function joy_touch num x, num y, num action, num id
if action==1; if id==joy_id; drop_joy; end; return; end
if action==0; if joy_id!=-1; return; end; if sqrt((x-joy.x)*(x-joy.x)+(y-joy.y)*(y-joy.y))>150; return; end; joy_id=id; end
if id!=joy_id; return; end; num dx=x-joy.x, dy=y-joy.y, d=sqrt(dx*dx+dy*dy)
if d>joy.r; joy.dx=dx/d; joy.dy=dy/d; joy.ox=joy.dx*joy.r; joy.oy=joy.dy*joy.r; else; joy.dx=dx/joy.r; joy.dy=dy/joy.r; joy.ox=dx; joy.oy=dy; end
end
function touch_game num x, num y, num action, num id
if finished!=0; if action==0; start_transition 0; end; return; end
if action==3; aiming=0; aim_id=-1; drop_joy; return; end
if x>=(screen_w-btn_w)/2-12&&x<=(screen_w+btn_w)/2+12&&y>=6&&y<=86; if action==0||action==1; start_transition 0; return; end; end
if action==0; num adx=x-atk_x, ady=y-atk_y; if sqrt(adx*adx+ady*ady)<=96; aiming=1; aim_id=id; if game_state==1||online_ready==1; fire_bullet; end; return; end; end
if action==1&&id==aim_id; aiming=0; aim_id=-1; return; end; joy_touch x,y,action,id
end
