// бой — только система боя
function reset_battle
player.x=screen_w/2; player.y=screen_h/2; player.angle=0; player.hp=player.max_hp; finished=0; bullet.active=0; aiming=0; aim_id=-1
joy.x=130; joy.y=screen_h-150; joy.r=70; atk_x=screen_w-140; atk_y=screen_h-150; drop_joy
arr_clear remotes; arr_clear rbullets; num i=0; loop i<max_players*6; arr_push rbullets,0; i=i+1; end
end
function init_game
reset_battle; enemy.hp=enemy.max_hp; spawn_enemy
end
function init_online
reset_battle; online_ready=0; my_shot=0; net_connect FIREBASE,ROOM
end
function place_online
num s=net_slot(), row=floor(s/2), col=s-row*2; player.x=screen_w*(0.3+0.4*col); player.y=screen_h*(0.35+0.3*row); online_ready=1
end
function spawn_enemy
num i=0; loop i<50; enemy.x=50+rand()%(screen_w-100); enemy.y=50+rand()%(screen_h-100); if sqrt((enemy.x-player.x)*(enemy.x-player.x)+(enemy.y-player.y)*(enemy.y-player.y))>250; return; end; i=i+1; end; enemy.x=50; enemy.y=50
end
function move_player
player.x=player.x+joy.dx*joy_speed*dt; player.y=player.y+joy.dy*joy_speed*dt
if joy.dx>0; player.angle=0; end; if joy.dx<0; player.angle=pi; end
if player.x<player.size; player.x=player.size; end; if player.x>screen_w-player.size; player.x=screen_w-player.size; end; if player.y<player.size; player.y=player.size; end; if player.y>screen_h-player.size; player.y=screen_h-player.size; end
end
function move_b
bullet.x=bullet.x+bullet.dx*bullet_speed*dt; bullet.y=bullet.y+bullet.dy*bullet_speed*dt; bullet.traveled=bullet.traveled+bullet_speed*dt
if bullet.traveled>=aim_range||bullet.x<-10||bullet.x>screen_w+10||bullet.y<-10||bullet.y>screen_h+10; bullet.active=0; end
end
function rbx num b
return arr_get(rbullets,b+1)+arr_get(rbullets,b+3)*arr_get(rbullets,b+5)
end
function rby num b
return arr_get(rbullets,b+2)+arr_get(rbullets,b+4)*arr_get(rbullets,b+5)
end
function move_rb num s
num b=s*6, tr=arr_get(rbullets,b+5)+bullet_speed*dt, x=rbx(b), y=rby(b); arr_set rbullets,b+5,tr; if tr>=aim_range||x<-10||x>screen_w+10||y<-10||y>screen_h+10; arr_set rbullets,b,0; end
end
function hit_r num tr
num left=aim_range-tr; if left<aim_fade; return 1.5*left/aim_fade; end; return 1.5
end
function update_game
if finished!=0; return; end; move_player; num dx=player.x-enemy.x, dy=player.y-enemy.y, d=sqrt(dx*dx+dy*dy)
if d>1; enemy.x=enemy.x+dx/d*bot_speed*dt; enemy.y=enemy.y+dy/d*bot_speed*dt; end; if dx>=0; enemy.angle=0; else; enemy.angle=pi; end
if d<player.size+enemy.size; player.hp=player.hp-1; if player.hp<=0; finish_game 2; return; end; spawn_enemy; end
if bullet.active==0; return; end; move_b; if bullet.active==0; return; end; dx=enemy.x-bullet.x; dy=enemy.y-bullet.y; d=sqrt(dx*dx+dy*dy)
if d<=enemy.size+hit_r(bullet.traveled); bullet.active=0; enemy.hp=enemy.hp-1; if enemy.hp<=0; finish_game 1; end; end
end
function ridx num s
num i=0; loop i<arr_len(remotes)/7; if arr_get(remotes,i*7)==s; return i; end; i=i+1; end; return -1
end
function read_remotes
if net_slot()<0; return; end; num i=0; loop i<arr_len(remotes)/7; arr_set remotes,i*7+5,0; i=i+1; end
num s=0; loop s<max_players; if net_player_online(s)==1&&s!=net_slot()
num x=net_player_x(s)*screen_w, y=net_player_y(s)*screen_h; i=ridx(s)
if i<0&&arr_len(remotes)/7<max_players-1; i=arr_len(remotes)/7; num v=0; loop v<7; arr_push remotes,0; v=v+1; end; num nb=i*7; arr_set remotes,nb,s; arr_set remotes,nb+1,x; arr_set remotes,nb+2,y; arr_set remotes,nb+6,net_player_bullet_shot(s); end
if i>=0; num b=i*7; arr_set remotes,b+1,x; arr_set remotes,b+2,y; arr_set remotes,b+3,net_player_angle(s); arr_set remotes,b+4,net_player_hp(s); arr_set remotes,b+5,net_player_alive(s)
num sh=net_player_bullet_shot(s); if sh!=arr_get(remotes,b+6); arr_set remotes,b+6,sh; if net_player_bullet_active(s)==1; num rb=s*6; arr_set rbullets,rb,1; arr_set rbullets,rb+1,net_player_bullet_x(s)*screen_w; arr_set rbullets,rb+2,net_player_bullet_y(s)*screen_h; arr_set rbullets,rb+3,net_player_bullet_dx(s); arr_set rbullets,rb+4,net_player_bullet_dy(s); arr_set rbullets,rb+5,0; end; end; end; end; s=s+1; end
end
function update_online
if online_ready==0&&net_slot()>=0; place_online; end; read_remotes; if finished!=0||online_ready==0; return; end; move_player; if bullet.active==1; move_b; end
num alive=1; if player.hp<=0; alive=0; end; net_publish player.x/screen_w,player.y/screen_h,player.angle,player.hp,alive; net_publish_bullet bullet.ox/screen_w,bullet.oy/screen_h,bullet.dx,bullet.dy,bullet.active,my_shot,bullet.traveled
num i=0; loop i<arr_len(remotes)/7; num b=i*7; if bullet.active==1&&arr_get(remotes,b+4)>0&&arr_get(remotes,b+5)==1; if sqrt((arr_get(remotes,b+1)-bullet.x)*(arr_get(remotes,b+1)-bullet.x)+(arr_get(remotes,b+2)-bullet.y)*(arr_get(remotes,b+2)-bullet.y))<=player.size+hit_r(bullet.traveled); bullet.active=0; end; end; i=i+1; end
i=0; loop i<max_players; num rb=i*6; if arr_get(rbullets,rb)==1; move_rb i; if arr_get(rbullets,rb)==1&&player.hp>0; if sqrt((player.x-rbx(rb))*(player.x-rbx(rb))+(player.y-rby(rb))*(player.y-rby(rb)))<=player.size+hit_r(arr_get(rbullets,rb+5)); arr_set rbullets,rb,0; player.hp=player.hp-1; if player.hp<=0; player.hp=0; net_publish player.x/screen_w,player.y/screen_h,player.angle,0,0; finish_game 2; end; end; end; end; i=i+1; end
end
function fire_bullet
num dx=cos(player.angle), off=54; if player.angle==0; bullet.x=player.x+off; else; bullet.x=player.x-off; end; bullet.y=player.y; bullet.ox=bullet.x; bullet.oy=bullet.y; bullet.dx=dx; bullet.dy=0; bullet.traveled=0; bullet.active=1; my_shot=my_shot+1; if game_state==5; net_publish_bullet bullet.ox/screen_w,bullet.oy/screen_h,dx,0,1,my_shot,0; end
end
function finish_game num result
finished=result; aiming=0; aim_id=-1; bullet.active=0; drop_joy
end
function draw_b num x, num y, num tr
num left=aim_range-tr, alpha=255; if left<aim_fade; alpha=floor(255*left/aim_fade); end; if alpha<1; alpha=1; end; rect x-1,y-1,3,3,alpha*0x1000000+0xFFF176
end
function draw_field
num y=0; loop y<screen_h; num x=0; loop x<screen_w; tex x,y,GRASS,0,1; x=x+256; end; y=y+256; end; rect 0,0,screen_w,screen_h,0x33000000
if aiming==1&&finished==0; line player.x,player.y,player.x+cos(player.angle)*aim_range,player.y+sin(player.angle)*aim_range,18,0x66000000; end; tex player.x-25*cube_scale,player.y-25*cube_scale,CUBE_TEX,player.angle,cube_scale
end
function draw_controls
ring joy.x,joy.y,joy.r,4,0x000000; circle joy.x+joy.ox,joy.y+joy.oy,34,0x000000; circle atk_x,atk_y,70,0xE94560; ring atk_x,atk_y,70,4,0x000000; if language_ru==1; text_scaled "Атака",atk_x-text_ink_width("Атака")*0.275,atk_y-7,0xFFFFFF,0.55; else; text_scaled "Attack",atk_x-text_ink_width("Attack")*0.275,atk_y-7,0xFFFFFF,0.55; end; draw_back
end
function draw_result str title, str note
rect 0,0,screen_w,screen_h,0x99000000; num y=screen_h/2-85; roundrect screen_w/2-165,y,330,170,24,0x5F10A0; ctext title,y+34,0xFFFFFF; ctext note,y+75,0xFFFFFF; if language_ru==1; ctext "Нажмите, чтобы выйти",y+118,0xFFCDD2; else; ctext "Tap to return",y+118,0xFFCDD2; end
end
function draw_game
draw_field; tex enemy.x-25*cube_scale,enemy.y-25*cube_scale,CUBE_TEX,enemy.angle,cube_scale; if bullet.active==1; draw_b bullet.x,bullet.y,bullet.traveled; end; num w=screen_w/4; hud_bar 20,20,w,28,player.hp,player.max_hp,0x7ED321,0; hud_bar screen_w-w-20,20,w,28,enemy.hp,enemy.max_hp,0xE94560,1; draw_controls; if finished==1; if language_ru==1; draw_result "Победа!","Соперник побеждён"; else; draw_result "Victory!","Opponent defeated"; end; else if finished==2; if language_ru==1; draw_result "Поражение","Соперник победил"; else; draw_result "Defeat","The opponent won"; end; end
end
function draw_online
draw_field; num i=0; loop i<arr_len(remotes)/7; num b=i*7; if arr_get(remotes,b+5)==1; tex arr_get(remotes,b+1)-25*cube_scale,arr_get(remotes,b+2)-25*cube_scale,CUBE_TEX,arr_get(remotes,b+3),cube_scale; end; i=i+1; end; if bullet.active==1; draw_b bullet.x,bullet.y,bullet.traveled; end; i=0; loop i<max_players; num rb=i*6; if arr_get(rbullets,rb)==1; draw_b rbx(rb),rby(rb),arr_get(rbullets,rb+5); end; i=i+1; end; num w=screen_w/3; hud_bar 20,20,w,28,player.hp,player.max_hp,0x7ED321,0; draw_controls; draw_chat; num st=net_status(), sy=back_y+btn_h+18; if st==4; if language_ru==1; ctext "Нет соединения",sy,0xFF8A80; else; ctext "No connection",sy,0xFF8A80; end; else if st==1; if language_ru==1; ctext "Подключение...",sy,0xFFF176; else; ctext "Connecting...",sy,0xFFF176; end; end; if finished==2; if language_ru==1; draw_result "Поражение","Вы повержены"; else; draw_result "Defeat","You were defeated"; end; end
end
function drop_joy
joy_id=-1; joy.dx=0; joy.dy=0; joy.ox=0; joy.oy=0
end
function joy_touch num x, num y, num action, num id
if action==1; if id==joy_id; drop_joy; end; return; end; if action==0; if joy_id!=-1; return; end; if sqrt((x-joy.x)*(x-joy.x)+(y-joy.y)*(y-joy.y))>150; return; end; joy_id=id; end; if id!=joy_id; return; end; num dx=x-joy.x, dy=y-joy.y, d=sqrt(dx*dx+dy*dy); if d>joy.r; joy.dx=dx/d; joy.dy=dy/d; joy.ox=joy.dx*joy.r; joy.oy=joy.dy*joy.r; else; joy.dx=dx/joy.r; joy.dy=dy/joy.r; joy.ox=dx; joy.oy=dy; end
end
function touch_game num x, num y, num action, num id
if finished!=0; if action==0; start_transition 0; end; return; end; if action==3; aiming=0; aim_id=-1; drop_joy; return; end; if game_state==5&&touch_chat(x,y,action)==1; return; end; if back_hit(x,y)==1&&action!=2; start_transition 0; return; end; if chat_open==1; return; end; if action==0&&sqrt((x-atk_x)*(x-atk_x)+(y-atk_y)*(y-atk_y))<=96; aiming=1; aim_id=id; if game_state==1||online_ready==1; fire_bullet; end; return; end; if action==1&&id==aim_id; aiming=0; aim_id=-1; return; end; joy_touch x,y,action,id
end
