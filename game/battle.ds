function reset_battle
player.x=screen_w/2; player.y=screen_h/2; player.angle=0; player.hp=player.max_hp; finished=0; bullet.active=0; bullet.owner=-1; aiming=0; aim_id=-1; joy.x=130; joy.y=screen_h-150; joy.r=70; atk_x=screen_w-140; atk_y=screen_h-150; drop_joy
arr_clear remotes; arr_clear remote_bullets
num bi=0; loop bi<max_players; arr_push remote_bullets, 0; arr_push remote_bullets, 0; arr_push remote_bullets, 0; arr_push remote_bullets, 0; arr_push remote_bullets, 0; arr_push remote_bullets, 0; arr_push remote_bullets, 0; arr_push remote_bullets, 0; bi=bi+1; end
end
function init_game
reset_battle; enemy.hp=enemy.max_hp; spawn_enemy; c ds_log("solo");
end
function init_online
reset_battle; placed=0; online_ready=0; my_shot=0; net_connect FIREBASE, ROOM; c ds_log("online");
end
function spawn_enemy
num i=0; loop i<50; enemy.x=50+rand()%(screen_w-100); enemy.y=50+rand()%(screen_h-100); if sqrt((enemy.x-player.x)*(enemy.x-player.x)+(enemy.y-player.y)*(enemy.y-player.y))>250; return; end; i=i+1; end; enemy.x=50; enemy.y=50
end
function move_player
player.x=player.x+joy.dx*joy_speed*dt; player.y=player.y+joy.dy*joy_speed*dt; if joy.dx!=0||joy.dy!=0; player.angle=atan2(joy.dy,joy.dx); end; if player.x<player.size; player.x=player.size; end; if player.x>screen_w-player.size; player.x=screen_w-player.size; end; if player.y<player.size; player.y=player.size; end; if player.y>screen_h-player.size; player.y=screen_h-player.size; end
end
function move_bullet
bullet.x=bullet.x+bullet.dx*bullet_speed*dt; bullet.y=bullet.y+bullet.dy*bullet_speed*dt; bullet.traveled=bullet.traveled+bullet_speed*dt; if bullet.traveled>=aim_range||bullet.x<-bullet.r||bullet.x>screen_w+bullet.r||bullet.y<-bullet.r||bullet.y>screen_h+bullet.r; bullet.active=0; end
end
function move_remote_bullet num idx
num base=idx*8; arr_set remote_bullets, base+2, arr_get(remote_bullets,base+2)+arr_get(remote_bullets,base+4)*bullet_speed*dt; arr_set remote_bullets, base+3, arr_get(remote_bullets,base+3)+arr_get(remote_bullets,base+5)*bullet_speed*dt; arr_set remote_bullets, base+7, arr_get(remote_bullets,base+7)+bullet_speed*dt
if arr_get(remote_bullets,base+7)>=aim_range||arr_get(remote_bullets,base+2)<-12||arr_get(remote_bullets,base+2)>screen_w+12||arr_get(remote_bullets,base+3)<-12||arr_get(remote_bullets,base+3)>screen_h+12; arr_set remote_bullets, base+0, 0; end
end
function bullet_hit_r num traveled
num l=aim_range-traveled; if l<aim_fade; return 12*l/aim_fade; end; return 12
end
function update_game
if finished!=0; return; end; move_player
num dx=player.x-enemy.x, dy=player.y-enemy.y, d=sqrt(dx*dx+dy*dy)
if d>1; enemy.x=enemy.x+dx/d*bot_speed*dt; enemy.y=enemy.y+dy/d*bot_speed*dt; end; enemy.angle=atan2(dy,dx)
if d<player.size+enemy.size; player.hp=player.hp-1; if player.hp<=0; finish_game 2; return; end; spawn_enemy; end
if bullet.active==0; return; end; move_bullet; if bullet.active==0; return; end
dx=enemy.x-bullet.x; dy=enemy.y-bullet.y; d=sqrt(dx*dx+dy*dy)
if d<=enemy.size+bullet_hit_r(bullet.traveled); bullet.active=0; enemy.hp=enemy.hp-1; if enemy.hp<=0; finish_game 1; end; end
end
function remote_index num slot
num i=0; loop i<arr_len(remotes)/11; if arr_get(remotes,i*11)==slot; return i; end; i=i+1; end
return -1
end
function add_remote num slot
if arr_len(remotes)/11>=max_players-1; return -1; end
num idx=arr_len(remotes)/11
arr_push remotes, slot; arr_push remotes, net_player_x(slot); arr_push remotes, net_player_y(slot); arr_push remotes, net_player_x(slot); arr_push remotes, net_player_y(slot); arr_push remotes, net_player_angle(slot); arr_push remotes, net_player_angle(slot); arr_push remotes, player.size; arr_push remotes, net_player_hp(slot); arr_push remotes, net_player_alive(slot); arr_push remotes, 0
return idx
end
function remove_remote num idx
num last=arr_len(remotes)/11-1; if idx<0||idx>last; return; end
if idx!=last; num rs=0; loop rs<11; arr_set remotes, idx*11+rs, arr_get(remotes,last*11+rs); rs=rs+1; end; end
num ps=0; loop ps<11; arr_pop remotes; ps=ps+1; end
end
function read_remotes
if net_slot()<0; return; end
num slot=0
loop slot<max_players
if net_player_online(slot)==1&&slot!=net_slot()
num idx=remote_index(slot)
if idx<0; idx=add_remote(slot); end
if idx>=0
num base=idx*11
arr_set remotes, base+1, net_player_x(slot); arr_set remotes, base+2, net_player_y(slot); arr_set remotes, base+5, net_player_angle(slot); arr_set remotes, base+8, net_player_hp(slot); arr_set remotes, base+9, net_player_alive(slot)
num k=dt*12; if k>1; k=1; end
arr_set remotes, base+3, arr_get(remotes,base+3)+(net_player_x(slot)-arr_get(remotes,base+3))*k; arr_set remotes, base+4, arr_get(remotes,base+4)+(net_player_y(slot)-arr_get(remotes,base+4))*k
num da=net_player_angle(slot)-arr_get(remotes,base+6); loop da>3.14159265; da=da-6.2831853; end; loop da<-3.14159265; da=da+6.2831853; end; arr_set remotes, base+6, arr_get(remotes,base+6)+da*k
num sh=net_player_bullet_shot(slot); if sh!=arr_get(remotes,base+10)&&net_player_bullet_active(slot)==1
arr_set remotes, base+10, sh
num b=slot*8; arr_set remote_bullets,b+0,1; arr_set remote_bullets,b+1,slot; arr_set remote_bullets,b+2,net_player_bullet_x(slot); arr_set remote_bullets,b+3,net_player_bullet_y(slot); arr_set remote_bullets,b+4,net_player_bullet_dx(slot); arr_set remote_bullets,b+5,net_player_bullet_dy(slot); arr_set remote_bullets,b+6,sh; arr_set remote_bullets,b+7,0
end
end
else if net_player_online(slot)==0
num old=remote_index(slot); if old>=0; remove_remote old; end
end
slot=slot+1
end
end
function damage_player_from_bullet num owner
if player.hp<=0; return; end
player.hp=player.hp-1; if player.hp<=0; player.hp=0; net_publish player.x, player.y, player.angle, 0, 0; finish_game 2; end
end
function update_online
num s=net_slot()
if placed==0; if s>=0; player.x=screen_w/2; player.y=screen_h/2; placed=1; online_ready=1; end; end
num a=1; if player.hp<=0; a=0; end; net_publish player.x, player.y, player.angle, player.hp, a; net_publish_bullet bullet.x, bullet.y, bullet.dx, bullet.dy, bullet.active, my_shot; read_remotes
if finished!=0||online_ready==0; return; end; move_player
if bullet.active==1; move_bullet; end
num ri=0
loop ri<arr_len(remotes)/11
num base=ri*11
if bullet.active==1&&arr_get(remotes,base+8)>0&&arr_get(remotes,base+9)==1; num rdx=arr_get(remotes,base+3)-bullet.x, rdy=arr_get(remotes,base+4)-bullet.y; if sqrt(rdx*rdx+rdy*rdy)<=player.size+bullet_hit_r(bullet.traveled); bullet.active=0; end; end
ri=ri+1
end
num bi=0
loop bi<max_players
if arr_get(remote_bullets,bi*8)==1
move_remote_bullet bi
if arr_get(remote_bullets,bi*8)==1&&player.hp>0
num bx=arr_get(remote_bullets,bi*8+2), by=arr_get(remote_bullets,bi*8+3), bdx=player.x-bx, bdy=player.y-by, traveled=arr_get(remote_bullets,bi*8+7)
if sqrt(bdx*bdx+bdy*bdy)<=player.size+bullet_hit_r(traveled); arr_set remote_bullets,bi*8,0; damage_player_from_bullet arr_get(remote_bullets,bi*8+1); end
end
end
bi=bi+1
end
end
function fire_bullet
num dx=cos(player.angle), dy=sin(player.angle); bullet.x=player.x+dx*(player.size+bullet.r+4); bullet.y=player.y+dy*(player.size+bullet.r+4); bullet.dx=dx; bullet.dy=dy; bullet.traveled=0; bullet.active=1; bullet.owner=net_slot(); my_shot=my_shot+1
if game_state==5; net_publish_bullet bullet.x, bullet.y, dx, dy, 1, my_shot; end; c ds_log("fire");
end
function finish_game num r
finished=r; aiming=0; aim_id=-1; bullet.active=0; drop_joy
end
function draw_bullet num bx, num by, num traveled
if traveled<0; return; end; num left=aim_range-traveled, a=255, sc=1; if left<aim_fade; sc=left/aim_fade; a=floor(255*sc); end; if a<1; a=1; end; num rr=12*sc; circle bx, by, rr, a*0x1000000+0xFFF176; ring bx, by, rr+2*sc, 2*sc, a*0x1000000+0xFFB300
end
function draw_field
num y=0; loop y<screen_h; num x=0; loop x<screen_w; tex x, y, GRASS, 0, 1; x=x+256; end; y=y+256; end; rect 0, 0, screen_w, screen_h, 0x33000000
if aiming==1&&finished==0; num ax=cos(player.angle), ay=sin(player.angle); line player.x, player.y, player.x+ax*aim_range, player.y+ay*aim_range, 18, 0x66000000; end; circle player.x, player.y, player.size/2, 0xFF8844; tex player.x-20, player.y-20, TEX, player.angle, 1
end
function draw_controls
ring joy.x, joy.y, joy.r, 4, 0x000000; circle joy.x+joy.ox, joy.y+joy.oy, 34, 0x000000; if aiming==1; circle atk_x, atk_y, 76, 0xC73750; else; circle atk_x, atk_y, 70, 0xE94560; end; ring atk_x, atk_y, 70, 4, 0x000000
if language_ru==1; text_scaled "Атака", atk_x-text_ink_width("Атака")*0.275, atk_y-7, 0xFFFFFF, 0.55; else; text_scaled "Attack", atk_x-text_ink_width("Attack")*0.275, atk_y-7, 0xFFFFFF, 0.55; end; draw_back
end
function draw_result str t, str n
rect 0, 0, screen_w, screen_h, 0x99000000; num py=screen_h/2-85; roundrect screen_w/2-165, py, 330, 170, 24, 0x5F10A0; ctext t, py+34, 0xFFFFFF; ctext n, py+75, 0xFFFFFF
if language_ru==1; ctext "Нажмите, чтобы выйти", py+118, 0xFFCDD2; else; ctext "Tap to return", py+118, 0xFFCDD2; end
end
function draw_game
draw_field; tex enemy.x-20, enemy.y-20, TEX, enemy.angle, 1; ring enemy.x, enemy.y, 26, 3, 0xFF2020; draw_bullet bullet.x, bullet.y, bullet.traveled
num hw=screen_w/4; hud_bar 20, 20, hw, 28, player.hp, player.max_hp, 0x7ED321, 0; hud_bar screen_w-hw-20, 20, hw, 28, enemy.hp, enemy.max_hp, 0xE94560, 1; draw_controls
if finished==1; if language_ru==1; draw_result "Победа!", "Соперник побеждён"; else; draw_result "Victory!", "Opponent defeated"; end; else if finished==2; if language_ru==1; draw_result "Поражение", "Соперник победил"; else; draw_result "Defeat", "The opponent won"; end; end
end
function draw_online
draw_field
num i=0; loop i<arr_len(remotes)/11; num base=i*11; if arr_get(remotes,base+9)==1; tex arr_get(remotes,base+3)-20, arr_get(remotes,base+4)-20, TEX, arr_get(remotes,base+6), 1; ring arr_get(remotes,base+3), arr_get(remotes,base+4), 26, 3, 0xFF2020; end; i=i+1; end
draw_bullet bullet.x, bullet.y, bullet.traveled
i=0; loop i<max_players; if arr_get(remote_bullets,i*8)==1; draw_bullet arr_get(remote_bullets,i*8+2), arr_get(remote_bullets,i*8+3), arr_get(remote_bullets,i*8+7); end; i=i+1; end
num hw=screen_w/3; hud_bar 20, 20, hw, 28, player.hp, player.max_hp, 0x7ED321, 0; draw_controls
num st=net_status(), cnt=floor(net_player_count()), joined=0; if st==4; if language_ru==1; ctext "Нет соединения", 76, 0xFF8A80; else; ctext "No connection", 76, 0xFF8A80; end; else if st==1; if language_ru==1; ctext "Подключение...", 76, 0xFFF176; else; ctext "Connecting...", 76, 0xFFF176; end; else; str label="Online: "; if language_ru==1; label="Онлайн: "; end; ctext label+ds_num_to_string(cnt), 76, 0xFFFFFF; joined=1; end
if finished==2; if language_ru==1; draw_result "Поражение", "Вы повержены"; else; draw_result "Defeat", "You were defeated"; end; end
end
function drop_joy
joy_id=-1; joy.dx=0; joy.dy=0; joy.ox=0; joy.oy=0
end
function joy_touch num x, num y, num action, num id
if action==1; if id==joy_id; drop_joy; end; return; end
if action==0; if joy_id!=-1; return; end; if sqrt((x-joy.x)*(x-joy.x)+(y-joy.y)*(y-joy.y))>150; return; end; joy_id=id; end
if id!=joy_id; return; end; num dx=x-joy.x, dy=y-joy.y, d=sqrt(dx*dx+dy*dy)
if d>joy.r; joy.dx=dx/d; joy.dy=dy/d; joy.ox=joy.dx*joy.r; joy.oy=joy.dy*joy.r; else; joy.dx=dx/joy.r; joy.dy=dy/joy.r; joy.ox=dx; joy.oy=dy; end
end
function touch_game num x, num y, num action, num id
if finished!=0; if action==0; start_transition 0; end; return; end
if action==3; aiming=0; aim_id=-1; drop_joy; return; end
if x>=(screen_w-btn_w)/2-12&&x<=(screen_w+btn_w)/2+12&&y>=6&&y<=86; if action==0||action==1; start_transition 0; return; end; end
if action==0; num adx=x-atk_x, ady=y-atk_y; if sqrt(adx*adx+ady*ady)<=96; aiming=1; aim_id=id; if game_state==1||online_ready==1; fire_bullet; end; return; end; end
if action==1&&id==aim_id; aiming=0; aim_id=-1; return; end; joy_touch x, y, action, id
end
