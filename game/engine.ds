function start_transition num t
if t_dir!=0; return; end; t_target=t; t_dir=1;end
function update_transition
if t_dir==1; t_fade=t_fade+dt/transition_duration; if t_fade>=1; t_fade=1; t_dir=2; end;else if t_dir==2; if game_state==7&&t_target!=7; keyboard_hide; end; if game_state==5&&t_target!=5; chat_open=0; keyboard_hide; net_disconnect; end; game_state=t_target; if t_target==1; init_game; else if t_target==5; init_online; else if t_target==6; console_scroll=0; else if t_target==7; login_field=0; last_kb=""; end; t_dir=-1
else if t_dir==-1; t_fade=t_fade-dt/transition_duration; if t_fade<=0; t_fade=0; t_dir=0; end; end;end
function init
ds_log "init: loading textures";png_load GRASS; png_load ORDINARY_TEX; png_load PUNCH_TEX;net_autologin FIREBASE;ds_log "init: ready";end
function update
update_transition; if game_state==1; update_game; else if game_state==5; update_online; else if game_state==7; update_login; end;end
function draw
if game_state==0; draw_lobby; else if game_state==1; draw_game; else if game_state==2; draw_modes; else if game_state==4; draw_settings; else if game_state==6; draw_console; else if game_state==7; draw_login; else; draw_online; end;if t_fade>0; rect 0,0,screen_w,screen_h,(1+floor(t_fade*254))*0x1000000; end
end
function touch num x, num y, num action, num id
if t_dir!=0; return; end; if game_state==0; touch_lobby x,y,action; else if game_state==1||game_state==5; touch_game x,y,action,id; else; touch_menu x,y,action; end;end
