function start_transition num t
if t_dir!=0; return; end; t_target=t; t_dir=1;end
function update_transition
if t_dir==1; t_fade=t_fade+dt/transition_duration; if t_fade>=1; t_fade=1; t_dir=2; end;else if t_dir==2; if game_state==7&&t_target!=7; keyboard_hide; end; if game_state==5&&t_target!=5; chat_open=0; keyboard_hide; net_disconnect; event_mode=0; event_t=0; end; game_state=t_target; if t_target==1; init_game; else if t_target==5; init_online; else if t_target==6; console_scroll=0; else if t_target==7; login_open; end; t_dir=-1
else if t_dir==-1; t_fade=t_fade-dt/transition_duration; if t_fade<=0; t_fade=0; t_dir=0; end; end;end
function init
ds_log "init: loading textures";png_load GRASS; png_load ORDINARY_TEX; png_load PUNCH_TEX; png_load AZUM_TEX; png_load AZUM_PUNCH_TEX; png_load SANTA_TEX; png_load SANTA_PUNCH_TEX; png_load CANDY_TEX; png_load SNOWFLAKE_TEX;net_autologin FIREBASE
// Звуки из game/sounds: музыки может не быть — тогда просто тишина.
music_ok=snd_load(LOBBY_MUSIC)
if music_ok==1; music_level=1; snd_volume LOBBY_MUSIC,0.7; snd_loop LOBBY_MUSIC; ds_log "init: lobby music on"; else; ds_log "init: no lobby music (game/sounds/lobbymusic.wav)"; end
cups=net_load_cups(); candies=net_load_candies(); player_class=net_load_class(); azum_owned=net_load_azum(); santa_owned=net_load_santa(); player_level=net_load_level(); levels_unlocked=net_load_levels_unlocked(); ordinary_level=net_load_ordinary_level(); ordinary_levels_unlocked=net_load_ordinary_levels_unlocked(); azum_level=net_load_azum_level(); azum_levels_unlocked=net_load_azum_levels_unlocked(); santa_level=net_load_santa_level(); santa_levels_unlocked=net_load_santa_levels_unlocked()
if levels_unlocked<0; levels_unlocked=0; end
if levels_unlocked>max_level; levels_unlocked=max_level; end
if player_level<0||player_level>levels_unlocked; player_level=0; end
if azum_owned==0&&player_class==1; player_class=0; end
if santa_owned==0&&player_class==2; player_class=0; end
load_selected_level
net_set_class player_class
net_set_level player_level
ds_log "init: ready";end
function update_music
// В бой музыка не обрывается мгновенно: за секунду плавно затихает и только
// потом останавливается. При возвращении в меню она так же мягко появляется.
if music_ok==0; return; end
if game_state==1||game_state==5
music_level=music_level-dt/music_fade_out_time
if music_level<0; music_level=0; end
snd_volume LOBBY_MUSIC,0.7*music_level
if music_level<=0&&snd_playing(LOBBY_MUSIC)==1; snd_stop LOBBY_MUSIC; end
else
if snd_playing(LOBBY_MUSIC)==0; music_level=0; snd_loop LOBBY_MUSIC; end
music_level=music_level+dt/music_fade_in_time
if music_level>1; music_level=1; end
snd_volume LOBBY_MUSIC,0.7*music_level
end
end
function update
update_transition; update_music; if game_state==1; update_game; else if game_state==5; update_online; else if game_state==7; update_login; end;end
function draw
if game_state==0; draw_lobby; else if game_state==1; draw_game; else if game_state==2; draw_modes; else if game_state==4; draw_settings; else if game_state==7; draw_login; else if game_state==8; draw_classes; else if game_state==9; draw_levels; else if game_state==10; draw_leaderboard; else; draw_online; end;if t_fade>0; rect 0,0,screen_w,screen_h,(1+floor(t_fade*254))*0x1000000; end
end
function touch num x, num y, num action, num id
if t_dir!=0; return; end; if game_state==0; touch_lobby x,y,action; else if game_state==1||game_state==5; touch_game x,y,action,id; else; touch_menu x,y,action; end;end
