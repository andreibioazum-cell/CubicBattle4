function start_transition num t
if t_dir!=0; return; end; t_target=t; t_dir=1
end
function update_transition
if t_dir==1; t_fade=t_fade+dt/0.25; if t_fade>=1; t_fade=1; t_dir=2; end; else if t_dir==2; if game_state==5&&t_target!=5; net_disconnect; end; game_state=t_target; if t_target==1; init_game; else if t_target==5; init_online; end; t_dir=-1; else if t_dir==-1; t_fade=t_fade-dt/0.25; if t_fade<=0; t_fade=0; t_dir=0; end; end
end
function init
png_load GRASS; png_load TEX; c printf("C works\n"); c ds_log("init");
end
function update
update_transition; if game_state==1; update_game; else if game_state==5; update_online; end
end
function draw
if game_state==0; draw_lobby; else if game_state==1; draw_game; else if game_state==2; draw_modes; else if game_state==4; draw_settings; else; draw_online; end; if t_fade>0; rect 0, 0, screen_w, screen_h, floor(t_fade*255)*0x1000000; end
end
function touch num x, num y, num action, num id
if t_dir!=0; return; end; if game_state==0; touch_lobby x, y, action; else if game_state==1||game_state==5; touch_game x, y, action, id; else; touch_menu x, y, action; end
end
