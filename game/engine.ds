// engine.ds — переходы между экранами и точки входа движка.
// Экраны: 0 — лобби, 1 — двор, 2 — привычки, 3 — как играть, 4 — настройки.
function start_transition num t
if t_dir!=0; return; end
t_target=t; t_dir=1
end
function update_transition
if t_dir==1
t_fade=t_fade+dt/transition_duration
if t_fade>=1; t_fade=1; t_dir=2; end
else if t_dir==2
game_state=t_target
if t_target==1; init_game; end
if t_target==2; shop_msg=0; end
t_dir=-1
else if t_dir==-1
t_fade=t_fade-dt/transition_duration
if t_fade<=0; t_fade=0; t_dir=0; end
end
end
function init
ds_log "init: loading textures"
png_load YARD; png_load YARIK; png_load YARIK_HOLD
png_load TRASH; png_load BIN; png_load SHEET
png_load FLOOR; png_load FRIDGE; png_load BED; png_load FOOD
png_load YARIK_W1; png_load YARIK_W2; png_load BUDDY; png_load BUDDY_W; png_load CAT
load_progress
ds_log "init: willpower %g, best day %g",willpower,best_day
end
function update
update_transition
if game_state==1; update_game; end
end
function draw
if splash_on==1; draw_disclaimer; return; end
if game_state==1; draw_game
else if game_state==2; draw_habits
else if game_state==3; draw_howto
else if game_state==4; draw_settings
else; draw_lobby; end
if t_fade>0; rect 0,0,screen_w,screen_h,(1+floor(t_fade*254))*0x1000000; end
end
function touch num x, num y, num action, num id
if splash_on==1
if action==0; splash_on=0; end
return
end
if t_dir!=0; return; end
if game_state==0; touch_lobby x,y,action
else if game_state==1; touch_game x,y,action,id
else; touch_menu x,y,action; end
end
