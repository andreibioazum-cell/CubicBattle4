// entities — игровые объекты
// Punch — событие удара: точка, направление и счётчик выстрела для сети
object Player
num x=0, y=0, size=30, angle=0, hp=10, max_hp=10
end
object Enemy
// state: 0 = сближение/стрейф, 1 = замах, 2 = удар, 3 = отход, 4 = уклонение
// Цифры бота равны игроку: hp 10, урон 1, цикл атаки 0.3 с. Бот не «толще»
// и не «сильнее» игрока — он играет как живой: держит дистанцию и уклоняется.
// dodge_cd — перезарядка уклонения, think — пауза-передышка между заходами.
// px/py/pvx/pvy/seen — «зрение» бота: последняя увиденная позиция игрока и
// оценка его скорости (по ней бот упреждает удар и перехватывает движение).
// flank — таймер смены стороны обхода.
// mvx/mvy — фактическая скорость бота в ЭТОМ кадре (по ней спрайт
// разворачивается в сторону движения); svx/svy — сглаженная скорость обхода,
// живёт между кадрами, чтобы бой не дёргался при смене направления.
// freeze — сколько секунд враг ещё заморожен, freeze_slow — насколько медленно
// он в это время ходит (доля от обычной скорости; чем меньше, тем медленнее).
// poison — сколько секунд враг ещё отравлен. poison_tick — обратный отсчёт
// до отдельного тика урона; между тиками HP не меняется.
// santa_poison_dps сохранён как имя совместимости, но теперь это урон ОДНОГО
// тика, а не урон каждого кадра.
// poison_damage — накопленный урон за тик от стека яда (3 уровень Санты: суммируется при повторных ударах).
num x=0, y=0, size=25, hp=10, max_hp=10, angle=0, state=0, state_time=0, cooldown=0, hit=0, strafe=1, dodge_cd=0, think=0, px=0, py=0, pvx=0, pvy=0, seen=0, flank=0, mvx=0, mvy=0, svx=0, svy=0, freeze=0, freeze_slow=1, poison=0, poison_tick=0, poison_damage=0
end
object Punch
// shot — растущий номер удара; active/hit нужны для текущего окна урона.
num x=0, y=0, dx=0, dy=0, active=0, shot=0, hit=0
end
object Gift
// Суператака Деда Мороза: снежинка летит по направлению взгляда и взрывается.
// active — в полёте, t — сколько уже летит (для ограничения дальности),
// shot — растущий номер броска для онлайна (как punch.shot у удара).
num x=0, y=0, dx=0, dy=0, active=0, t=0, shot=0
end
Player player=new Player()
Enemy enemy=new Enemy()
Punch punch=new Punch()
Gift gift=new Gift()
// punch_cd — кулдаун между ударами, aim_a — прозрачность серого хитбокса (0..1)
// aim_tx/aim_ty — точка упреждения бота (куда он целится с учётом скорости игрока)
num aim_tx=0, aim_ty=0
num finished=0, atk_x=0, atk_y=0, atk2_x=0, atk2_y=0, joy_id=-1, aim_id=-1, super_id=-1, punch_left=0, punch_cd=0, aim_a=0
num super_cd=0, boom_t=0, boom_x=0, boom_y=0
// freeze_a — видимая прозрачность круга заморозки (0..1), плавно растёт/гаснет.
num freeze_a=0
// player_freeze — сколько секунд сам игрок заморожен снежинкой соперника в
// онлайне, player_freeze_slow — доля скорости, pfreeze_a — прозрачность круга.
num player_freeze=0, player_freeze_slow=1, pfreeze_a=0
// player_poison — сколько секунд игрок отравлен посохом чужого Деда Мороза в
// онлайне; player_poison_tick — время до следующего дискретного тика.
// player_poison_damage запоминает силу тика атакующего класса.
num player_poison=0, player_poison_tick=0, player_poison_damage=0, ppoison_a=0
// poison_a — видимая прозрачность голубого круга отравления вокруг врага.
num poison_a=0
arr remotes=arr_new(), remote_punches=arr_new()
// remote_snow — чужие снежинки в онлайне: на каждого игрока snow_fields полей
// [счётчик броска, active, t, x, y, boom_t, boom_x, boom_y].
arr remote_snow=arr_new()
// Леденцы-пикапы на карте: по паре координат (x,y) на каждый из candy_count.
arr candy_x=arr_new(), candy_y=arr_new()
// Пыль от ходьбы игрока: пул на dust_max частиц, по dust_fields чисел каждая.
// Поля: x, y, vx, vy, life (оставшееся время жизни в секундах).
arr dust=arr_new()
