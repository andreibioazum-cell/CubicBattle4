// entities.ds — объекты и состояние текущего забега.
object Yarik
// bag — сколько мусора Ярик несёт прямо сейчас, hold — таймер позы «Держись».
num x=0, y=0, angle=0, bag=0, hold=0
end
Yarik yarik=new Yarik()

// Мусор во дворе: на каждый предмет пара координат и флаг «ещё лежит».
arr trash_x=arr_new(), trash_y=arr_new(), trash_on=arr_new()
// Бутылки-соблазны во дворе: координаты и остаточный толчок от «Держись».
arr bot_x=arr_new(), bot_y=arr_new(), bot_dx=arr_new(), bot_dy=arr_new()
// Ночная еда на полу.
arr food_x=arr_new(), food_y=arr_new(), food_on=arr_new()

// Урна — куда Ярик относит мусор днём.
num bin_x=0, bin_y=0
// Холодильник и кровать — ночные полюса комнаты.
num fridge_x=0, fridge_y=0, bed_x=0, bed_y=0
// phase: 0 — день во дворе, 1 — ночь в квартире.
num phase=0, night_t=0, eaten=0, pull_off=0
// День забега, сколько мусора донесено, сколько надо донести.
num day=1, cleaned=0, goal=4
// Тяга 0..max_craving и перезарядка кнопки «Держись».
num craving=0, hold_cd=0
// over: 0 — играем, 1 — срыв по тяге, 2 — день закрыт, 3 — ночь пережита,
// 4 — срыв от обжорства, 5 — открыл холодильник и выпил.
num over=0, last_reward=0
// Управление: id пальца на джойстике и на кнопке.
num joy_id=-1, act_id=-1, act_x=0, act_y=0
// Всплывающая подсказка в магазине привычек.
num shop_msg=0
