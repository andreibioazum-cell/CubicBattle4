// Точка входа: состояние сцен, переход между лобби и игрой, фон игры.
// lobby.ds — фон лобби, ui.ds — интерфейс, logic.ds — правила боя,
// cubes.ds — куб игрока и его текстура.

int game_state = 0  // 0 — лобби, 1 — игра

// Переход: fade считается по времени (dt — секунды кадра), поэтому длительность
// не зависит от FPS и экран плавно затемняется, а не мигает.
int transition_dir = 0     // 0 — нет перехода, 1 — затемнение, -1 — осветление
int transition_target = 0
num transition_fade = 0
num transition_time = 0.25

str GRASS = "grass.png"

#include "cubes.ds"
#include "ui.ds"
#include "logic.ds"
#include "lobby.ds"

fn init() {
    png_load(GRASS)
    png_load(PLAYER_TEX)
    init_lobby_background()
}

fn update() {
    update_transition()
    if (game_state == 0) {
        update_lobby_ui()
    } else {
        update_game_logic()
    }
}

fn start_transition(int target) {
    if (transition_dir != 0) {
        return
    }
    transition_target = target
    transition_dir = 1
}

fn update_transition() {
    if (transition_dir == 1) {
        transition_fade = transition_fade + dt / transition_time
        if (transition_fade >= 1) {
            transition_fade = 1
            game_state = transition_target
            if (transition_target == 1) {
                init_game_logic()
                init_game_ui()
            }
            transition_dir = -1
        }
    } else if (transition_dir == -1) {
        transition_fade = transition_fade - dt / transition_time
        if (transition_fade <= 0) {
            transition_fade = 0
            transition_dir = 0
        }
    }
}

fn draw() {
    if (game_state == 0) {
        draw_lobby_background()
        draw_lobby_ui()
    } else {
        draw_game_background()
        draw_game_ui_underlay()
        draw_game_entities()
        draw_game_ui()
    }
    // Чёрная заливка поверх во время перехода; alpha = fade * 255.
    // Меняем только старший (альфа) байт: умножение всего 0xFF000000 на
    // дробный fade портит RGB-каналы (красочное мигание вместо затемнения),
    // поэтому alpha сначала округляем в целое, а потом сдвигаем в старший байт.
    if (transition_fade > 0) {
        rect(0, 0, screen_w, screen_h, floor(transition_fade * 255) * 0x1000000)
    }
}

// Фон игры: повторяем 256px-текстуру травы без масштабирования.
fn draw_game_background() {
    num grass_size = 256
    num y = 0
    loop (y < screen_h) {
        num x = 0
        loop (x < screen_w) {
            tex(x, y, GRASS, 0, 1)
            x = x + grass_size
        }
        y = y + grass_size
    }
    // Подложка, чтобы игровой HUD оставался читаемым.
    rect(0, 0, screen_w, screen_h, 0x33000000)
}

fn touch(x, y, int action) {
    if (transition_dir != 0) {
        return
    }
    if (game_state == 0) {
        touch_lobby_ui(x, y, action)
    } else {
        touch_game_ui(x, y, action)
    }
}
