// Точка входа. game_state: 0 - лобби, 1 - игра.
// Плавный переход между сценами: затемнение → смена сцены → осветление.

int game_state = 0
int score = 0
int transition_state = 0  // 0 - нет, 1 - затемнение, 2 - осветление
int transition_target = 0
int transition_level = 0
int transition_len = 5

#include "lobby.ds"
#include "game_logic.ds"
#include "ui.ds"

str GRASS = "grass.png"
str PLAYER_TEX = "player.png"
str FONT_FILE = "fonts/ChillRoundGothic_Heavy.ttf"

fn init() {
    png_load(GRASS)
    png_load(PLAYER_TEX)
    cls(0x2C2C2C)
    score = 0
    game_state = 0
    init_stars()
}

fn update() {
    update_transition()
    update_stars()
    if (game_state == 0) {
        update_lobby()
    } else {
        update_game()
    }
}

fn update_transition() {
    if (transition_state == 0) {
        return
    }
    if (transition_state == 1) {
        transition_level = transition_level + 1
        if (transition_level >= transition_len) {
            transition_level = transition_len
            game_state = transition_target
            if (transition_target == 1) {
                init_game()
            }
            transition_state = 2
        }
    } else {
        transition_level = transition_level - 1
        if (transition_level <= 0) {
            transition_level = 0
            transition_state = 0
        }
    }
}

fn start_transition(int target) {
    transition_target = target
    transition_level = 0
    transition_state = 1
}

fn draw() {
    if (game_state == 0) {
        draw_lobby_bg()
        draw_lobby()
    } else {
        draw_game_bg()
        draw_game()
    }
    // Чёрная заливка поверх во время перехода
    if (transition_state != 0 && transition_level > 0) {
        rect(0, 0, screen_w, screen_h, transition_level * 0x33000000)
    }
}

// Фон лобби: тёмная подложка + звёзды. Без травы — она только в игре.
fn draw_lobby_bg() {
    rect(0, 0, screen_w, screen_h, 0x1a1a2e)
    draw_stars()
}

// Фон игры: текстура травы во весь экран.
fn draw_game_bg() {
    num grass_size = 256
    num scale = screen_w / grass_size
    if (screen_h > screen_w) {
        scale = screen_h / grass_size
    }
    num gw = grass_size * scale
    num gh = grass_size * scale
    tex((screen_w - gw) / 2, (screen_h - gh) / 2, GRASS, 0, scale)
    // Лёгкая подложка, чтобы белый текст и HUD читались.
    rect(0, 0, screen_w, screen_h, 0x33000000)
}

fn touch(x, y, int action) {
    set_touch(x, y)
    if (transition_state != 0) {
        return
    }
    if (game_state == 0) {
        touch_lobby(x, y, action)
    } else {
        touch_game(x, y, action)
    }
}
