// Gig1.0 — Cubic Battle 4
// Единый скрипт: лобби со звёздами, бой с врагом, джойстик и пули.
// Части: лобби, интерфейс, логика боя, куб игрока.

num game_state = 0          // 0 — лобби, 1 — игра

// Переход: fade считается по времени (dt — секунды кадра), поэтому его
// длительность не зависит от FPS.
num transition_dir = 0      // 0 — нет перехода, 1 — затемнение, -1 — осветление
num transition_target = 0
num transition_fade = 0
num transition_time = 0.25

str GRASS = "grass.png"

// --- Куб игрока ---

str PLAYER_TEX = "player.png"

object Player
    num x = 0
    num y = 0
    num size = 30
    col color = 0xFF8844
    num angle = 0
end

Player player = new Player()

function draw_player_cube
    circle player.x, player.y, player.size / 2, player.color
    tex player.x - player.size, player.y - player.size, PLAYER_TEX, player.angle, 1
end

function move_player num dx, num dy
    player.x = player.x + dx
    player.y = player.y + dy
end

// --- Лобби: тёмная подложка и летящие звёзды ---

function init_lobby_background
    init_stars 90, 0xFFFFFF
end

function draw_lobby_background
    rect 0, 0, screen_w, screen_h, 0x1a1a2e
    update_stars
    draw_stars
end

// --- Интерфейс: кнопки, HUD, джойстик и прицел ---

object Button
    num x = 0
    num y = 0
    num w = 220
    num h = 70
    col color = 0x5F10A0
    num pressed = 0
end

object AttackButton
    num x = 0
    num y = 0
    num r = 70
    num active = 0
    num range = 360
end

Button play_btn = new Button()
AttackButton attack = new AttackButton()

num joy_active = 0
num joy_knob_r = 34
num joy_hit_r = 150
num back_x = 0

function draw_button_label str label, num x, num y, num w, num h, col color
    text label, x + (w - text_ink_width(label)) / 2, y + (h - text_ink_height(label)) / 2, color
end

function draw_centered_text str label, num y, col color
    text label, screen_w / 2 - text_ink_width(label) / 2, y, color
end

function update_lobby_ui
    play_btn.x = (screen_w - play_btn.w) / 2
    play_btn.y = (screen_h - play_btn.h) / 2 + 40
end

function draw_lobby_ui
    str title = "Cubic Battle 4"
    text title, screen_w / 2 - text_ink_width(title) / 2, play_btn.y - text_ink_height(title) - 20, 0xFFFFFF
    roundrect play_btn.x, play_btn.y, play_btn.w, play_btn.h, 20, play_btn.color
    draw_button_label "Play", play_btn.x, play_btn.y, play_btn.w, play_btn.h, 0xFFFFFF
end

// Нажатие на Play засчитывается при отпускании пальца внутри кнопки.
function touch_lobby_ui num x, num y, num action
    if x >= play_btn.x && x <= play_btn.x + play_btn.w && y >= play_btn.y && y <= play_btn.y + play_btn.h
        if action == 0
            play_btn.pressed = 1
        else if action == 1 || action == 3
            if play_btn.pressed == 1
                play_btn.pressed = 0
                start_transition 1
            end
        end
        return
    end
    play_btn.pressed = 0
end

function init_joystick_ui
    joy.x = 130
    joy.y = screen_h - 150
    joy.r = 70
    joy.dx = 0
    joy.dy = 0
    joy.ox = 0
    joy.oy = 0
    joy_active = 0
end

function init_game_ui
    init_joystick_ui
    attack.x = screen_w - 140
    attack.y = screen_h - 150
    attack.r = joy.r
    attack.active = 0
end

// Рисуется до игровых объектов, чтобы прицел не закрывал игрока и врага.
function draw_game_ui_underlay
    if attack.active == 1 && game_finished == 0
        draw_attack_aim_ui
    end
end

function draw_game_ui
    text "Defeat the enemy", 20, 24, 0xFFFFFF
    text "Enemy HP: " + enemy.hp + "/" + enemy.max_hp, 20, 48, 0xFFCDD2
    draw_enemy_health_ui
    draw_joystick_ui
    draw_attack_button_ui
    draw_back_button_ui
    if game_finished != 0
        draw_game_result_ui
    end
end

function draw_attack_aim_ui
    num dx = cos(player.angle)
    num dy = sin(player.angle)
    num start_x = player.x + dx * (player.size + 8)
    num start_y = player.y + dy * (player.size + 8)
    num aim_x = player.x + dx * attack.range
    num aim_y = player.y + dy * attack.range
    // Полупрозрачная линия показывает, куда вылетит пуля.
    line start_x, start_y, aim_x, aim_y, 12, 0x66000000
    line aim_x - 12, aim_y, aim_x + 12, aim_y, 3, 0x99000000
    line aim_x, aim_y - 12, aim_x, aim_y + 12, 3, 0x99000000
    ring aim_x, aim_y, 14, 2, 0x99000000
end

function draw_enemy_health_ui
    num bar_w = 44
    num bar_x = enemy.x - bar_w / 2
    num bar_y = enemy.y - enemy.size - 14
    rect bar_x, bar_y, bar_w, 6, 0xCC000000
    rect bar_x, bar_y, bar_w * enemy.hp / enemy.max_hp, 6, 0xE94560
end

function draw_joystick_ui
    ring joy.x, joy.y, joy.r, 4, 0x000000
    circle joy.x + joy.ox, joy.y + joy.oy, joy_knob_r, 0x000000
end

function draw_attack_button_ui
    circle attack.x, attack.y, attack.r, 0xE94560
    ring attack.x, attack.y, attack.r, 4, 0x000000
    num a_w = text_ink_width("Attack") * 0.55
    text_scaled "Attack", attack.x - a_w / 2, attack.y - 7, 0xFFFFFF, 0.55
end

function draw_back_button_ui
    back_x = screen_w - 234
    roundrect back_x, 12, 220, 70, 20, 0x5F10A0
    draw_button_label "Back", back_x, 12, 220, 70, 0xFFFFFF
end

function draw_game_result_ui
    rect 0, 0, screen_w, screen_h, 0x99000000
    num panel_x = screen_w / 2 - 165
    num panel_y = screen_h / 2 - 85
    roundrect panel_x, panel_y, 330, 170, 24, 0x5F10A0
    if game_finished == 1
        draw_centered_text "Victory!", panel_y + 34, 0xFFFFFF
        draw_centered_text "Enemy defeated", panel_y + 75, 0xFFFFFF
    else
        draw_centered_text "Defeat", panel_y + 34, 0xFFFFFF
        draw_centered_text "The enemy caught you", panel_y + 75, 0xFFFFFF
    end
    draw_centered_text "Tap to return", panel_y + 118, 0xFFCDD2
end

function touch_game_ui num x, num y, num action
    if game_finished != 0
        if action == 0
            start_transition 0
        end
        return
    end
    back_x = screen_w - 234
    if action == 0
        if x >= back_x - 4 && x <= back_x + 224 && y >= 8 && y <= 86
            start_transition 0
            return
        end
        num adx = x - attack.x
        num ady = y - attack.y
        if sqrt(adx * adx + ady * ady) <= attack.r + 8
            // Нажатие лишь включает прицел — выстрел при отпускании.
            attack.active = 1
            return
        end
    end
    if action == 1 && attack.active == 1
        attack.active = 0
        fire_bullet
        return
    end
    if action == 3
        // Отмена касания не должна выпускать пулю.
        attack.active = 0
    end
    joy_touch_ui x, y, action
end

function joy_touch_ui num x, num y, num action
    if action == 1 || action == 3
        joy_active = 0
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
        return
    end
    if action == 2 && joy_active == 0
        return
    end
    num dx = x - joy.x
    num dy = y - joy.y
    num dist = sqrt(dx * dx + dy * dy)
    if action == 0 && dist > joy_hit_r
        return
    end
    joy_active = 1
    if dist > joy.r
        joy.dx = dx / dist
        joy.dy = dy / dist
        joy.ox = joy.dx * joy.r
        joy.oy = joy.dy * joy.r
    else
        joy.dx = dx / joy.r
        joy.dy = dy / joy.r
        joy.ox = dx
        joy.oy = dy
    end
end

// --- Логика боя: враг, пули, столкновения и условия победы ---

object Enemy
    num x = 0
    num y = 0
    num size = 22
    col color = 0xFF0000
    num speed = 2.2
    num hp = 3
    num max_hp = 3
    num angle = 0
end

object Bullet
    num x = 0
    num y = 0
    num dx = 0
    num dy = 0
    num r = 7
    num speed = 13
    num traveled = 0
    num range = 420
    num active = 0
end

Enemy enemy = new Enemy()
Bullet bullet = new Bullet()

// Скорость применяется сразу: при отпускании джойстика игрок останавливается мгновенно.
num joy_speed = 3.2
// 0 — бой, 1 — победа, 2 — поражение.
num game_finished = 0

function init_game_logic
    player.x = screen_w / 2
    player.y = screen_h / 2
    player.angle = 0
    game_finished = 0
    bullet.active = 0
    bullet.traveled = 0
    enemy.hp = enemy.max_hp
    spawn_enemy
end

function update_game_logic
    if game_finished != 0
        return
    end
    // Координаты сразу следуют за джойстиком.
    move_player joy.dx * joy_speed, joy.dy * joy_speed
    if joy.dx != 0 || joy.dy != 0
        player.angle = atan2(joy.dy, joy.dx)
    end
    if player.x < player.size
        player.x = player.size
    end
    if player.x > screen_w - player.size
        player.x = screen_w - player.size
    end
    if player.y < player.size
        player.y = player.size
    end
    if player.y > screen_h - player.size
        player.y = screen_h - player.size
    end

    num edx = player.x - enemy.x
    num edy = player.y - enemy.y
    num edist = sqrt(edx * edx + edy * edy)
    if edist > 1
        enemy.x = enemy.x + (edx / edist) * enemy.speed
        enemy.y = enemy.y + (edy / edist) * enemy.speed
    end
    enemy.angle = atan2(player.y - enemy.y, player.x - enemy.x)

    update_bullet
    if game_finished != 0
        return
    end
    edx = player.x - enemy.x
    edy = player.y - enemy.y
    edist = sqrt(edx * edx + edy * edy)
    if edist < player.size + enemy.size
        finish_game 2
    end
end

function update_bullet
    if bullet.active == 0
        return
    end
    bullet.x = bullet.x + bullet.dx * bullet.speed
    bullet.y = bullet.y + bullet.dy * bullet.speed
    bullet.traveled = bullet.traveled + bullet.speed

    num dx = enemy.x - bullet.x
    num dy = enemy.y - bullet.y
    num dist = sqrt(dx * dx + dy * dy)
    if dist <= enemy.size + bullet.r
        bullet.active = 0
        enemy.hp = enemy.hp - 1
        if enemy.hp <= 0
            finish_game 1
        end
        return
    end
    if bullet.traveled >= bullet.range || bullet.x < -bullet.r || bullet.x > screen_w + bullet.r || bullet.y < -bullet.r || bullet.y > screen_h + bullet.r
        bullet.active = 0
    end
end

function fire_bullet
    num dx = cos(player.angle)
    num dy = sin(player.angle)
    bullet.x = player.x + dx * (player.size + bullet.r + 4)
    bullet.y = player.y + dy * (player.size + bullet.r + 4)
    bullet.dx = dx
    bullet.dy = dy
    bullet.traveled = 0
    bullet.active = 1
end

function finish_game num result
    game_finished = result
    attack.active = 0
    bullet.active = 0
end

function spawn_enemy
    num tries = 0
    loop tries < 50
        enemy.x = 50 + rand() % (screen_w - 100)
        enemy.y = 50 + rand() % (screen_h - 100)
        num dx = enemy.x - player.x
        num dy = enemy.y - player.y
        num dist = sqrt(dx * dx + dy * dy)
        if dist > 250
            return
        end
        tries = tries + 1
    end
    enemy.x = 50
    enemy.y = 50
end

// Отрисовка игровых объектов, которые не являются интерфейсом.
function draw_game_entities
    draw_player_cube
    tex enemy.x - 20, enemy.y - 20, PLAYER_TEX, enemy.angle, 1
    ring enemy.x, enemy.y, 26, 3, 0xFF2020
    if bullet.active == 1
        circle bullet.x, bullet.y, bullet.r, 0xFFF176
        ring bullet.x, bullet.y, bullet.r + 2, 2, 0x000000
    end
end

// --- Точка входа и переходы между сценами ---

function init
    png_load GRASS
    png_load PLAYER_TEX
    init_lobby_background
end

function update
    update_transition
    if game_state == 0
        update_lobby_ui
    else
        update_game_logic
    end
end

function start_transition num target
    if transition_dir != 0
        return
    end
    transition_target = target
    transition_dir = 1
end

function update_transition
    if transition_dir == 1
        transition_fade = transition_fade + dt / transition_time
        if transition_fade >= 1
            transition_fade = 1
            game_state = transition_target
            if transition_target == 1
                init_game_logic
                init_game_ui
            end
            transition_dir = -1
        end
    else if transition_dir == -1
        transition_fade = transition_fade - dt / transition_time
        if transition_fade <= 0
            transition_fade = 0
            transition_dir = 0
        end
    end
end

function draw
    if game_state == 0
        draw_lobby_background
        draw_lobby_ui
    else
        draw_game_background
        draw_game_ui_underlay
        draw_game_entities
        draw_game_ui
    end
    // Чёрная заливка поверх во время перехода; alpha = fade * 255.
    // Сначала округляем alpha в целое, потом сдвигаем в старший байт —
    // умножение всего 0xFF000000 на дробный fade портит RGB-каналы.
    if transition_fade > 0
        rect 0, 0, screen_w, screen_h, floor(transition_fade * 255) * 0x1000000
    end
end

// Фон игры: повторяем 256px-текстуру травы без масштабирования.
function draw_game_background
    num grass_size = 256
    num y = 0
    loop y < screen_h
        num x = 0
        loop x < screen_w
            tex x, y, GRASS, 0, 1
            x = x + grass_size
        end
        y = y + grass_size
    end
    // Подложка, чтобы игровой HUD оставался читаемым.
    rect 0, 0, screen_w, screen_h, 0x33000000
end

function touch num x, num y, num action
    if transition_dir != 0
        return
    end
    if game_state == 0
        touch_lobby_ui x, y, action
    else
        touch_game_ui x, y, action
    end
end
