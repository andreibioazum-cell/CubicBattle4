// Gig1.0 — Cubic Battle 4
// Лобби со звёздами + бой: джойстик, прицел, пули, мультитач.

num game_state = 0      // 0 — лобби, 1 — бой, 2 — режимы, 3 — комнаты, 4 — настройки, 5 — поиск
num game_mode = 0       // 0 — соло, 1 — онлайн-комната
num language_ru = 0     // 0 — English, 1 — Русский
num selected_room = 0
num match_time = 0
num t_dir = 0           // переход: 1 — затемнение, -1 — осветление, 0 — нет
num t_target = 0
num t_fade = 0

str GRASS = "grass.png"
str TEX = "player.png"

num aim_range = 240     // длина прицела = дальность полёта пули
num aim_fade = 90       // пуля плавно гаснет на последних 90 пикселях

// --- Сущности ---

object Player
    num x = 0
    num y = 0
    num size = 30
    num angle = 0
    num hp = 10
    num max_hp = 10
end

object Enemy
    num x = 0
    num y = 0
    num size = 22
    num speed = 2.2
    num hp = 3
    num max_hp = 3
    num angle = 0
end

object Bullet
    num x = 0
    num y = 0
    num dx = 0
    num dy = 0
    num r = 12
    num speed = 13
    num traveled = 0
    num active = 0
end

Player player = new Player()
Enemy enemy = new Enemy()
Bullet bullet = new Bullet()

num finished = 0        // 0 — бой, 1 — победа, 2 — поражение
num joy_speed = 3.2
num aiming = 0
num atk_x = 0
num atk_y = 0
num joy_id = -1         // палец на джойстике (-1 — свободен)
num aim_id = -1         // палец на кнопке атаки

// --- Помощники отрисовки ---

function ctext str s, num y, col color
    text s, (screen_w - text_ink_width(s)) / 2, y, color
end

function button str label, num x, num y, num w, num h
    roundrect x, y, w, h, 20, 0x5F10A0
    text label, x + (w - text_ink_width(label)) / 2, y + (h - text_ink_height(label)) / 2, 0xFFFFFF
end

function hud_bar num bx, num by, num w, num h, num cur, num max, col color, num from_right
    // Светлая рамка и тёмный фон хорошо читаются на траве без подписей.
    roundrect bx, by, w, h, h / 2, 0xDDFFFFFF
    roundrect bx + 3, by + 3, w - 6, h - 6, (h - 6) / 2, 0xDD171923
    num fill_w = (w - 8) * cur / max
    if fill_w > 0
        if from_right == 1
            roundrect bx + w - 4 - fill_w, by + 4, fill_w, h - 8, (h - 8) / 2, color
        else
            roundrect bx + 4, by + 4, fill_w, h - 8, (h - 8) / 2, color
        end
    end
end

// --- Лобби и меню ---

function draw_back
    if language_ru == 1
        button "Назад", (screen_w - 120) / 2, 12, 120, 48
    else
        button "Back", (screen_w - 120) / 2, 12, 120, 48
    end
end

function draw_lobby
    rect 0, 0, screen_w, screen_h, 0x1a1a2e
    update_stars
    draw_stars
    // Название одинаковое в обеих локализациях, как и в английской версии.
    ctext "Cubic Battle 4", screen_h / 2 - 142, 0xFFFFFF
    if language_ru == 1
        button "Играть", (screen_w - 240) / 2, screen_h / 2 - 8, 240, 70
        button "Настройки", (screen_w - 240) / 2, screen_h / 2 + 78, 240, 58
    else
        button "Play", (screen_w - 240) / 2, screen_h / 2 - 8, 240, 70
        button "Settings", (screen_w - 240) / 2, screen_h / 2 + 78, 240, 58
    end
end

function draw_modes
    rect 0, 0, screen_w, screen_h, 0x1a1a2e
    update_stars
    draw_stars
    if language_ru == 1
        ctext "Выберите режим", screen_h / 2 - 138, 0xFFFFFF
        // Именно «Соло», а не прежнее неоднозначное название одиночного режима.
        button "Соло", (screen_w - 260) / 2, screen_h / 2 - 55, 260, 70
        button "Онлайн", (screen_w - 260) / 2, screen_h / 2 + 35, 260, 70
    else
        ctext "Choose mode", screen_h / 2 - 138, 0xFFFFFF
        button "Solo", (screen_w - 260) / 2, screen_h / 2 - 55, 260, 70
        button "Online", (screen_w - 260) / 2, screen_h / 2 + 35, 260, 70
    end
    draw_back
end

function draw_rooms
    rect 0, 0, screen_w, screen_h, 0x1a1a2e
    update_stars
    draw_stars
    if language_ru == 1
        ctext "Онлайн-комнаты", 92, 0xFFFFFF
        ctext "Выберите комнату", 130, 0xC9C9D6
        button "Комната 1", (screen_w - 280) / 2, 180, 280, 58
        button "Комната 2", (screen_w - 280) / 2, 252, 280, 58
        button "Комната 3", (screen_w - 280) / 2, 324, 280, 58
    else
        ctext "Online rooms", 92, 0xFFFFFF
        ctext "Choose a room", 130, 0xC9C9D6
        button "Room 1", (screen_w - 280) / 2, 180, 280, 58
        button "Room 2", (screen_w - 280) / 2, 252, 280, 58
        button "Room 3", (screen_w - 280) / 2, 324, 280, 58
    end
    draw_back
end

function draw_matchmaking
    rect 0, 0, screen_w, screen_h, 0x1a1a2e
    update_stars
    draw_stars
    if language_ru == 1
        ctext "Комната " + selected_room, screen_h / 2 - 82, 0xFFFFFF
        ctext "Ищем соперника...", screen_h / 2 - 36, 0xFFFFFF
        ctext "Поиск отменится автоматически", screen_h / 2 + 2, 0xC9C9D6
        button "Отмена", (screen_w - 200) / 2, screen_h / 2 + 58, 200, 58
    else
        ctext "Room " + selected_room, screen_h / 2 - 82, 0xFFFFFF
        ctext "Finding an opponent...", screen_h / 2 - 36, 0xFFFFFF
        ctext "Matchmaking starts automatically", screen_h / 2 + 2, 0xC9C9D6
        button "Cancel", (screen_w - 200) / 2, screen_h / 2 + 58, 200, 58
    end
end

function draw_settings
    rect 0, 0, screen_w, screen_h, 0x1a1a2e
    update_stars
    draw_stars
    if language_ru == 1
        ctext "Настройки", 92, 0xFFFFFF
        ctext "Язык", 148, 0xC9C9D6
    else
        ctext "Settings", 92, 0xFFFFFF
        ctext "Language", 148, 0xC9C9D6
    end
    // Активный язык отмечен белой рамкой; зелёный цвет здесь не используется.
    roundrect (screen_w - 280) / 2, 182, 280, 58, 18, 0x5F10A0
    roundrect (screen_w - 280) / 2, 254, 280, 58, 18, 0x5F10A0
    if language_ru == 0
        ring screen_w / 2, 211, 154, 3, 0xFFFFFF
    else
        ring screen_w / 2, 283, 154, 3, 0xFFFFFF
    end
    ctext "English", 197, 0xFFFFFF
    ctext "Русский", 269, 0xFFFFFF
    draw_back
end

function touch_lobby num x, num y, num action
    if action != 0
        return
    end
    if y >= screen_h / 2 - 24 && y <= screen_h / 2 + 78
        start_transition 2
    else if y >= screen_h / 2 + 62 && y <= screen_h / 2 + 152
        start_transition 4
    end
end

function touch_menu num x, num y, num action
    if action != 0
        return
    end
    if y <= 72
        start_transition 0
        return
    end
    if game_state == 2
        if y >= screen_h / 2 - 75 && y <= screen_h / 2 + 20
            game_mode = 0
            start_transition 1
        else if y >= screen_h / 2 + 15 && y <= screen_h / 2 + 125
            start_transition 3
        end
    else if game_state == 3
        if y >= 168 && y <= 396
            selected_room = floor((y - 180) / 72) + 1
            game_mode = 1
            match_time = 0
            start_transition 5
        end
    else if game_state == 4
        if y >= 172 && y <= 246
            language_ru = 0
        else if y >= 246 && y <= 320
            language_ru = 1
        end
    else if game_state == 5
        if y >= screen_h / 2 + 40 && y <= screen_h / 2 + 132
            start_transition 3
        end
    end
end

// --- Логика боя ---

function init_game
    player.x = screen_w / 2
    player.y = screen_h / 2
    player.angle = 0
    player.hp = player.max_hp
    enemy.hp = enemy.max_hp
    finished = 0
    bullet.active = 0
    aiming = 0
    aim_id = -1
    joy.x = 130
    joy.y = screen_h - 150
    joy.r = 70
    atk_x = screen_w - 140
    atk_y = screen_h - 150
    drop_joy
    spawn_enemy
end

function spawn_enemy
    num tries = 0
    loop tries < 50
        enemy.x = 50 + rand() % (screen_w - 100)
        enemy.y = 50 + rand() % (screen_h - 100)
        num dx = enemy.x - player.x
        num dy = enemy.y - player.y
        if sqrt(dx * dx + dy * dy) > 250
            return
        end
        tries = tries + 1
    end
    enemy.x = 50
    enemy.y = 50
end

function update_game
    if finished != 0
        return
    end
    player.x = player.x + joy.dx * joy_speed
    player.y = player.y + joy.dy * joy_speed
    if joy.dx != 0 || joy.dy != 0
        player.angle = atan2(joy.dy, joy.dx)
    end
    if player.x < player.size
        player.x = player.size
    end
    if player.x > screen_w - player.size
        player.x = screen_w - player.size
    end
    if player.y < player.size
        player.y = player.size
    end
    if player.y > screen_h - player.size
        player.y = screen_h - player.size
    end

    // враг догоняет игрока; касание -1 жизнь, враг перерождается
    num dx = player.x - enemy.x
    num dy = player.y - enemy.y
    num dist = sqrt(dx * dx + dy * dy)
    if dist > 1
        enemy.x = enemy.x + dx / dist * enemy.speed
        enemy.y = enemy.y + dy / dist * enemy.speed
    end
    enemy.angle = atan2(dy, dx)
    if dist < player.size + enemy.size
        player.hp = player.hp - 1
        if player.hp <= 0
            finish_game 2
            return
        end
        spawn_enemy
    end

    // пуля
    if bullet.active == 0
        return
    end
    bullet.x = bullet.x + bullet.dx * bullet.speed
    bullet.y = bullet.y + bullet.dy * bullet.speed
    bullet.traveled = bullet.traveled + bullet.speed
    if bullet.traveled >= aim_range || bullet.x < -bullet.r || bullet.x > screen_w + bullet.r || bullet.y < -bullet.r || bullet.y > screen_h + bullet.r
        bullet.active = 0
        return
    end
    dx = enemy.x - bullet.x
    dy = enemy.y - bullet.y
    dist = sqrt(dx * dx + dy * dy)
    num hit_r = bullet.r
    num bullet_left = aim_range - bullet.traveled
    if bullet_left < aim_fade
        hit_r = bullet.r * bullet_left / aim_fade
    end
    if dist <= enemy.size + hit_r
        bullet.active = 0
        enemy.hp = enemy.hp - 1
        // Единственная победная цель — полностью победить врага, таймера нет.
        if enemy.hp <= 0
            finish_game 1
        end
        return
    end
end

function fire_bullet
    num dx = cos(player.angle)
    num dy = sin(player.angle)
    bullet.x = player.x + dx * (player.size + bullet.r + 4)
    bullet.y = player.y + dy * (player.size + bullet.r + 4)
    bullet.dx = dx
    bullet.dy = dy
    bullet.traveled = 0
    bullet.active = 1
end

function finish_game num result
    finished = result
    aiming = 0
    aim_id = -1
    bullet.active = 0
    drop_joy
end

function draw_game
    // фон — повторяющаяся текстура травы
    num y = 0
    loop y < screen_h
        num x = 0
        loop x < screen_w
            tex x, y, GRASS, 0, 1
            x = x + 256
        end
        y = y + 256
    end
    rect 0, 0, screen_w, screen_h, 0x33000000

    // Прицел заканчивается чистой полосой — без крестика или метки на конце.
    if aiming == 1 && finished == 0
        num ax = cos(player.angle)
        num ay = sin(player.angle)
        num tip_x = player.x + ax * aim_range
        num tip_y = player.y + ay * aim_range
        line player.x, player.y, tip_x, tip_y, 18, 0x66000000
    end

    // бойцы
    circle player.x, player.y, player.size / 2, 0xFF8844
    tex player.x - 20, player.y - 20, TEX, player.angle, 1
    tex enemy.x - 20, enemy.y - 20, TEX, enemy.angle, 1
    ring enemy.x, enemy.y, 26, 3, 0xFF2020

    // В начале пуля крупная. На последних пикселях пути она одновременно
    // гаснет и плавно уменьшается, поэтому не обрывается резко.
    if bullet.active == 1
        num left = aim_range - bullet.traveled
        num a = 255
        num bullet_scale = 1
        if left < aim_fade
            bullet_scale = left / aim_fade
            a = floor(255 * bullet_scale)
        end
        if a < 1
            a = 1
        end
        num draw_r = bullet.r * bullet_scale
        circle bullet.x, bullet.y, draw_r, a * 0x1000000 + 0xFFF176
        ring bullet.x, bullet.y, draw_r + 2 * bullet_scale, 2 * bullet_scale, a * 0x1000000 + 0xFFB300
    end

    // HUD без текстовых счётчиков: здоровье игрока слева, врага справа.
    num hud_w = screen_w / 4
    hud_bar 20, 20, hud_w, 28, player.hp, player.max_hp, 0x7ED321, 0
    hud_bar screen_w - hud_w - 20, 20, hud_w, 28, enemy.hp, enemy.max_hp, 0xE94560, 1

    // интерфейс
    ring joy.x, joy.y, joy.r, 4, 0x000000
    circle joy.x + joy.ox, joy.y + joy.oy, 34, 0x000000
    if aiming == 1
        circle atk_x, atk_y, 76, 0xC73750
    else
        circle atk_x, atk_y, 70, 0xE94560
    end
    ring atk_x, atk_y, 70, 4, 0x000000
    if language_ru == 1
        text_scaled "Атака", atk_x - text_ink_width("Атака") * 0.275, atk_y - 7, 0xFFFFFF, 0.55
    else
        text_scaled "Attack", atk_x - text_ink_width("Attack") * 0.275, atk_y - 7, 0xFFFFFF, 0.55
    end
    draw_back

    if finished != 0
        rect 0, 0, screen_w, screen_h, 0x99000000
        num panel_y = screen_h / 2 - 85
        roundrect screen_w / 2 - 165, panel_y, 330, 170, 24, 0x5F10A0
        if language_ru == 1
            if finished == 1
                ctext "Победа!", panel_y + 34, 0xFFFFFF
                ctext "Соперник побеждён", panel_y + 75, 0xFFFFFF
            else
                ctext "Поражение", panel_y + 34, 0xFFFFFF
                ctext "Соперник победил", panel_y + 75, 0xFFFFFF
            end
            ctext "Нажмите, чтобы выйти", panel_y + 118, 0xFFCDD2
        else
            if finished == 1
                ctext "Victory!", panel_y + 34, 0xFFFFFF
                ctext "Opponent defeated", panel_y + 75, 0xFFFFFF
            else
                ctext "Defeat", panel_y + 34, 0xFFFFFF
                ctext "The opponent won", panel_y + 75, 0xFFFFFF
            end
            ctext "Tap to return", panel_y + 118, 0xFFCDD2
        end
    end
end

// --- Касания (мультитач: id — номер пальца) ---

function drop_joy
    joy_id = -1
    joy.dx = 0
    joy.dy = 0
    joy.ox = 0
    joy.oy = 0
end

function joy_touch num x, num y, num action, num id
    if action == 1
        if id == joy_id
            drop_joy
        end
        return
    end
    if action == 0
        if joy_id != -1
            return
        end
        num hx = x - joy.x
        num hy = y - joy.y
        if sqrt(hx * hx + hy * hy) > 150
            return
        end
        joy_id = id
    end
    if id != joy_id
        return
    end
    num dx = x - joy.x
    num dy = y - joy.y
    num dist = sqrt(dx * dx + dy * dy)
    if dist > joy.r
        joy.dx = dx / dist
        joy.dy = dy / dist
        joy.ox = joy.dx * joy.r
        joy.oy = joy.dy * joy.r
    else
        joy.dx = dx / joy.r
        joy.dy = dy / joy.r
        joy.ox = dx
        joy.oy = dy
    end
end

function touch_game num x, num y, num action, num id
    if finished != 0
        if action == 0
            start_transition 0
        end
        return
    end
    if action == 3
        // системная отмена жеста: сбрасываем пальцы, пуля не вылетает
        aiming = 0
        aim_id = -1
        drop_joy
        return
    end
    // Кнопка Back с увеличенной невидимой зоной срабатывает сразу на down.
    // Up оставлен запасным вариантом на случай прерванного начала жеста.
    if x >= (screen_w - 156) / 2 && x <= (screen_w + 156) / 2 && y >= 0 && y <= 72
        if action == 0 || action == 1
            start_transition 0
            return
        end
    end
    if action == 0
        num adx = x - atk_x
        num ady = y - atk_y
        // Выстрел происходит при нажатии, а не после отпускания: быстрый тап
        // больше не ощущается пропущенным. Зона нажатия чуть шире кнопки.
        if sqrt(adx * adx + ady * ady) <= 96
            aiming = 1
            aim_id = id
            fire_bullet
            return
        end
    end
    if action == 1 && id == aim_id
        aiming = 0
        aim_id = -1
        return
    end
    joy_touch x, y, action, id
end

// --- Переходы и хуки движка ---

function start_transition num target
    if t_dir != 0
        return
    end
    t_target = target
    t_dir = 1
end

function update_transition
    if t_dir == 1
        t_fade = t_fade + dt / 0.25
        if t_fade >= 1
            // Сначала показываем полностью чёрный кадр. Экран меняется только
            // на следующем кадре, поэтому в конце перехода нет белого мигания.
            t_fade = 1
            t_dir = 2
        end
    else if t_dir == 2
        game_state = t_target
        if t_target == 1
            init_game
        end
        t_dir = -1
    else if t_dir == -1
        t_fade = t_fade - dt / 0.25
        if t_fade <= 0
            t_fade = 0
            t_dir = 0
        end
    end
end

function init
    png_load GRASS
    png_load TEX
    init_stars 90, 0xFFFFFF
end

function update
    update_transition
    if game_state == 5 && t_dir == 0
        match_time = match_time + dt
        // Комната не оставляет игрока в бесконечном «ждём соперника».
        // После короткого поиска запускается матч в выбранной комнате.
        if match_time >= 1.2
            start_transition 1
        end
    end
    if game_state == 1
        update_game
    end
end

function draw
    if game_state == 0
        draw_lobby
    else if game_state == 1
        draw_game
    else if game_state == 2
        draw_modes
    else if game_state == 3
        draw_rooms
    else if game_state == 4
        draw_settings
    else
        draw_matchmaking
    end
    // затемнение поверх во время перехода
    if t_fade > 0
        rect 0, 0, screen_w, screen_h, floor(t_fade * 255) * 0x1000000
    end
end

function touch num x, num y, num action, num id
    if t_dir != 0
        return
    end
    if game_state == 0
        touch_lobby x, y, action
    else if game_state == 1
        touch_game x, y, action, id
    else
        touch_menu x, y, action
    end
end
