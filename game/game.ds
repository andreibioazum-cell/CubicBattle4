// Gig1.0 — Cubic Battle 4
// Лобби со звёздами + бой: джойстик, прицел, пули, мультитач.

num game_state = 0      // 0 — лобби, 1 — игра
num t_dir = 0           // переход: 1 — затемнение, -1 — осветление, 0 — нет
num t_target = 0
num t_fade = 0

str GRASS = "grass.png"
str TEX = "player.png"

num aim_range = 240     // длина прицела = дальность полёта пули
num aim_fade = 90       // пуля плавно гаснет на последних 90 пикселях

// --- Сущности ---

object Player
    num x = 0
    num y = 0
    num size = 30
    num angle = 0
    num hp = 5
    num max_hp = 5
end

object Enemy
    num x = 0
    num y = 0
    num size = 22
    num speed = 2.2
    num hp = 3
    num max_hp = 3
    num angle = 0
end

object Bullet
    num x = 0
    num y = 0
    num dx = 0
    num dy = 0
    num r = 7
    num speed = 13
    num traveled = 0
    num active = 0
end

Player player = new Player()
Enemy enemy = new Enemy()
Bullet bullet = new Bullet()

num finished = 0        // 0 — бой, 1 — победа, 2 — поражение
num joy_speed = 3.2
num aiming = 0
num atk_x = 0
num atk_y = 0
num play_pressed = 0
num joy_id = -1         // палец на джойстике (-1 — свободен)
num aim_id = -1         // палец на кнопке атаки

// --- Помощники отрисовки ---

function ctext str s, num y, col color
    text s, (screen_w - text_ink_width(s)) / 2, y, color
end

function button str label, num x, num y, num w, num h
    roundrect x, y, w, h, 20, 0x5F10A0
    text label, x + (w - text_ink_width(label)) / 2, y + (h - text_ink_height(label)) / 2, 0xFFFFFF
end

function bar num bx, num by, num cur, num max, col color
    rect bx, by, 44, 6, 0xCC000000
    rect bx, by, 44 * cur / max, 6, color
end

// --- Лобби ---

function draw_lobby
    rect 0, 0, screen_w, screen_h, 0x1a1a2e
    update_stars
    draw_stars
    ctext "Cubic Battle 4", screen_h / 2 - 100, 0xFFFFFF
    button "Play", (screen_w - 220) / 2, screen_h / 2 + 20, 220, 70
end

function touch_lobby num x, num y, num action
    if x >= (screen_w - 220) / 2 && x <= (screen_w + 220) / 2 && y >= screen_h / 2 + 20 && y <= screen_h / 2 + 90
        if action == 0
            play_pressed = 1
        else if (action == 1 || action == 3) && play_pressed == 1
            play_pressed = 0
            start_transition 1
        end
        return
    end
    play_pressed = 0
end

// --- Логика боя ---

function init_game
    player.x = screen_w / 2
    player.y = screen_h / 2
    player.angle = 0
    player.hp = player.max_hp
    enemy.hp = enemy.max_hp
    finished = 0
    bullet.active = 0
    aiming = 0
    aim_id = -1
    joy.x = 130
    joy.y = screen_h - 150
    joy.r = 70
    atk_x = screen_w - 140
    atk_y = screen_h - 150
    drop_joy
    spawn_enemy
end

function spawn_enemy
    num tries = 0
    loop tries < 50
        enemy.x = 50 + rand() % (screen_w - 100)
        enemy.y = 50 + rand() % (screen_h - 100)
        num dx = enemy.x - player.x
        num dy = enemy.y - player.y
        if sqrt(dx * dx + dy * dy) > 250
            return
        end
        tries = tries + 1
    end
    enemy.x = 50
    enemy.y = 50
end

function update_game
    if finished != 0
        return
    end
    player.x = player.x + joy.dx * joy_speed
    player.y = player.y + joy.dy * joy_speed
    if joy.dx != 0 || joy.dy != 0
        player.angle = atan2(joy.dy, joy.dx)
    end
    if player.x < player.size
        player.x = player.size
    end
    if player.x > screen_w - player.size
        player.x = screen_w - player.size
    end
    if player.y < player.size
        player.y = player.size
    end
    if player.y > screen_h - player.size
        player.y = screen_h - player.size
    end

    // враг догоняет игрока; касание -1 жизнь, враг перерождается
    num dx = player.x - enemy.x
    num dy = player.y - enemy.y
    num dist = sqrt(dx * dx + dy * dy)
    if dist > 1
        enemy.x = enemy.x + dx / dist * enemy.speed
        enemy.y = enemy.y + dy / dist * enemy.speed
    end
    enemy.angle = atan2(dy, dx)
    if dist < player.size + enemy.size
        player.hp = player.hp - 1
        if player.hp <= 0
            finish_game 2
            return
        end
        spawn_enemy
    end

    // пуля
    if bullet.active == 0
        return
    end
    bullet.x = bullet.x + bullet.dx * bullet.speed
    bullet.y = bullet.y + bullet.dy * bullet.speed
    bullet.traveled = bullet.traveled + bullet.speed
    dx = enemy.x - bullet.x
    dy = enemy.y - bullet.y
    dist = sqrt(dx * dx + dy * dy)
    if dist <= enemy.size + bullet.r
        bullet.active = 0
        enemy.hp = enemy.hp - 1
        if enemy.hp <= 0
            finish_game 1
        end
        return
    end
    if bullet.traveled >= aim_range || bullet.x < -bullet.r || bullet.x > screen_w + bullet.r || bullet.y < -bullet.r || bullet.y > screen_h + bullet.r
        bullet.active = 0
    end
end

function fire_bullet
    num dx = cos(player.angle)
    num dy = sin(player.angle)
    bullet.x = player.x + dx * (player.size + bullet.r + 4)
    bullet.y = player.y + dy * (player.size + bullet.r + 4)
    bullet.dx = dx
    bullet.dy = dy
    bullet.traveled = 0
    bullet.active = 1
end

function finish_game num result
    finished = result
    aiming = 0
    aim_id = -1
    bullet.active = 0
    drop_joy
end

function draw_game
    // фон — повторяющаяся текстура травы
    num y = 0
    loop y < screen_h
        num x = 0
        loop x < screen_w
            tex x, y, GRASS, 0, 1
            x = x + 256
        end
        y = y + 256
    end
    rect 0, 0, screen_w, screen_h, 0x33000000

    // прицел: широкая короткая полоса прямо из игрока, без круга в конце
    if aiming == 1 && finished == 0
        num ax = cos(player.angle)
        num ay = sin(player.angle)
        num tip_x = player.x + ax * aim_range
        num tip_y = player.y + ay * aim_range
        line player.x, player.y, tip_x, tip_y, 18, 0x66000000
        line tip_x - 10, tip_y, tip_x + 10, tip_y, 3, 0x99000000
        line tip_x, tip_y - 10, tip_x, tip_y + 10, 3, 0x99000000
    end

    // бойцы
    circle player.x, player.y, player.size / 2, 0xFF8844
    tex player.x - 20, player.y - 20, TEX, player.angle, 1
    tex enemy.x - 20, enemy.y - 20, TEX, enemy.angle, 1
    ring enemy.x, enemy.y, 26, 3, 0xFF2020

    // пуля плавно гаснет в конце прицела, а не исчезает резко
    if bullet.active == 1
        num left = aim_range - bullet.traveled
        num a = 255
        if left < aim_fade
            a = floor(255 * left / aim_fade)
        end
        if a < 1
            a = 1
        end
        circle bullet.x, bullet.y, bullet.r, a * 0x1000000 + 0xFFF176
        ring bullet.x, bullet.y, bullet.r + 2, 2, a * 0x1000000
    end

    // здоровье над бойцами
    bar enemy.x - 22, enemy.y - enemy.size - 14, enemy.hp, enemy.max_hp, 0xE94560
    bar player.x - 22, player.y - player.size - 16, player.hp, player.max_hp, 0x7ED321

    // интерфейс
    text "You: " + player.hp + "/" + player.max_hp, 20, 24, 0xFFFFFF
    text "Enemy: " + enemy.hp + "/" + enemy.max_hp, 20, 48, 0xFFCDD2
    ring joy.x, joy.y, joy.r, 4, 0x000000
    circle joy.x + joy.ox, joy.y + joy.oy, 34, 0x000000
    circle atk_x, atk_y, 70, 0xE94560
    ring atk_x, atk_y, 70, 4, 0x000000
    text_scaled "Attack", atk_x - text_ink_width("Attack") * 0.275, atk_y - 7, 0xFFFFFF, 0.55
    button "Back", (screen_w - 220) / 2, 12, 220, 70

    if finished != 0
        rect 0, 0, screen_w, screen_h, 0x99000000
        num panel_y = screen_h / 2 - 85
        roundrect screen_w / 2 - 165, panel_y, 330, 170, 24, 0x5F10A0
        if finished == 1
            ctext "Victory!", panel_y + 34, 0xFFFFFF
            ctext "Enemy defeated", panel_y + 75, 0xFFFFFF
        else
            ctext "Defeat", panel_y + 34, 0xFFFFFF
            ctext "The enemy caught you", panel_y + 75, 0xFFFFFF
        end
        ctext "Tap to return", panel_y + 118, 0xFFCDD2
    end
end

// --- Касания (мультитач: id — номер пальца) ---

function drop_joy
    joy_id = -1
    joy.dx = 0
    joy.dy = 0
    joy.ox = 0
    joy.oy = 0
end

function joy_touch num x, num y, num action, num id
    if action == 1
        if id == joy_id
            drop_joy
        end
        return
    end
    if action == 0
        if joy_id != -1
            return
        end
        num hx = x - joy.x
        num hy = y - joy.y
        if sqrt(hx * hx + hy * hy) > 150
            return
        end
        joy_id = id
    end
    if id != joy_id
        return
    end
    num dx = x - joy.x
    num dy = y - joy.y
    num dist = sqrt(dx * dx + dy * dy)
    if dist > joy.r
        joy.dx = dx / dist
        joy.dy = dy / dist
        joy.ox = joy.dx * joy.r
        joy.oy = joy.dy * joy.r
    else
        joy.dx = dx / joy.r
        joy.dy = dy / joy.r
        joy.ox = dx
        joy.oy = dy
    end
end

function touch_game num x, num y, num action, num id
    if finished != 0
        if action == 0
            start_transition 0
        end
        return
    end
    if action == 3
        // системная отмена жеста: сбрасываем пальцы, пуля не вылетает
        aiming = 0
        aim_id = -1
        drop_joy
        return
    end
    if action == 0
        if x >= (screen_w - 220) / 2 && x <= (screen_w + 220) / 2 && y >= 12 && y <= 82
            start_transition 0
            return
        end
        num adx = x - atk_x
        num ady = y - atk_y
        if aim_id == -1 && sqrt(adx * adx + ady * ady) <= 78
            aiming = 1
            aim_id = id
            return
        end
    end
    if action == 1 && id == aim_id
        aiming = 0
        aim_id = -1
        fire_bullet
        return
    end
    joy_touch x, y, action, id
end

// --- Переходы и хуки движка ---

function start_transition num target
    if t_dir != 0
        return
    end
    t_target = target
    t_dir = 1
end

function update_transition
    if t_dir == 1
        t_fade = t_fade + dt / 0.25
        if t_fade >= 1
            t_fade = 1
            game_state = t_target
            if t_target == 1
                init_game
            end
            t_dir = -1
        end
    else if t_dir == -1
        t_fade = t_fade - dt / 0.25
        if t_fade <= 0
            t_fade = 0
            t_dir = 0
        end
    end
end

function init
    png_load GRASS
    png_load TEX
    init_stars 90, 0xFFFFFF
end

function update
    update_transition
    if game_state == 1
        update_game
    end
end

function draw
    if game_state == 0
        draw_lobby
    else
        draw_game
    end
    // затемнение поверх во время перехода
    if t_fade > 0
        rect 0, 0, screen_w, screen_h, floor(t_fade * 255) * 0x1000000
    end
end

function touch num x, num y, num action, num id
    if t_dir != 0
        return
    end
    if game_state == 0
        touch_lobby x, y, action
    else
        touch_game x, y, action, id
    end
end
