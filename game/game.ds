// ============================================
// JOYSTICK DEMO - DimScript
// ============================================

// ЦВЕТА
num COLOR_BG = 0xFFCCCCCC;
num COLOR_PLAYER = 0xFFEE7722;
num COLOR_JOY = 0xFF000000;

// ИГРОК
num player_x = 0;
num player_y = 0;
num player_speed = 5;
num player_size = 40;

// ДЖОЙСТИК
num joy_x = 150;
num joy_y = 0;
num joy_dx = 0;
num joy_dy = 0;
num joy_ox = 0;
num joy_oy = 0;
num joy_r = 80;

// ============================================
// ИНИЦИАЛИЗАЦИЯ
// ============================================
fn init() {
    player_x = screen_w / 2;
    player_y = screen_h / 2;
    joy_x = 150;
    joy_y = screen_h - 150;
    joy_r = 80;
}

// ============================================
// ОБНОВЛЕНИЕ
// ============================================
fn update() {
    player_x = player_x + joy_dx * player_speed;
    player_y = player_y + joy_dy * player_speed;
    
    // Границы экрана
    if (player_x < player_size / 2) {
        player_x = player_size / 2;
    }
    if (player_x > screen_w - player_size / 2) {
        player_x = screen_w - player_size / 2;
    }
    if (player_y < player_size / 2) {
        player_y = player_size / 2;
    }
    if (player_y > screen_h - player_size / 2) {
        player_y = screen_h - player_size / 2;
    }
}

// ============================================
// ОТРИСОВКА
// ============================================
fn draw() {
    // Очистка экрана
    cls(COLOR_BG);
    
    // Рисуем игрока
    rect(
        player_x - player_size / 2,
        player_y - player_size / 2,
        player_size,
        player_size,
        COLOR_PLAYER
    );
    
    // Рисуем джойстик (кольцо)
    ring(joy_x, joy_y, joy_r, 4, COLOR_JOY);
    
    // Рисуем джойстик (ручка)
    circle(joy_x + joy_ox, joy_y + joy_oy, 35, COLOR_JOY);
}

// ============================================
// ОБРАБОТКА КАСАНИЙ
// ============================================
fn touch(x, y, action) {
    // Отпускание (action == 1) или отмена (action == 3)
    if (action == 1 || action == 3) {
        joy_dx = 0;
        joy_dy = 0;
        joy_ox = 0;
        joy_oy = 0;
        return;
    }
    
    // Расчёт расстояния до центра джойстика
    num dx = x - joy_x;
    num dy = y - joy_y;
    num distance = sqrt(dx * dx + dy * dy);
    
    // Если вне зоны джойстика
    if (distance > joy_r + 30 || distance < 15) {
        joy_dx = 0;
        joy_dy = 0;
        joy_ox = 0;
        joy_oy = 0;
        return;
    }
    
    // Нормализация
    num knob_distance = distance;
    if (knob_distance > joy_r) {
        knob_distance = joy_r;
    }
    
    joy_dx = dx / distance;
    joy_dy = dy / distance;
    joy_ox = joy_dx * knob_distance;
    joy_oy = joy_dy * knob_distance;
}
