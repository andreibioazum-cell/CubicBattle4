// Главный файл - инициализация и управление состоянием

// Глобальное состояние игры
num game_state = 0  // 0 - лобби, 1 - игра
num score = 0

// Подключаем модули игры. Пути указаны относительно этого файла.
#include "lobby.ds"
#include "game_logic.ds"
#include "ui.ds"

fn init() {
    // Инициализация
    cls(0x2C2C2C)
    score = 0
    game_state = 0
}

fn update() {
    if (game_state == 0) {
        update_lobby()
    } else {
        update_game()
    }
}

fn draw() {
    if (game_state == 0) {
        draw_lobby()
    } else {
        draw_game()
    }
}

fn touch(x, y, action) {
    set_touch(x, y)
    if (game_state == 0) {
        if (action == 0) {  // нажатие
            touch_lobby(x, y)
        }
    } else {
        // В игре передаём все события: 0 - нажатие, 1 - отпускание,
        // 2 - движение пальца (нужно джойстику), 3 - отмена
        touch_game(x, y, action)
    }
}
