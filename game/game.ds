// Точка входа и фоны сцен.
// game.ds отвечает за состояние сцен, переходы и фон игры;
// lobby.ds — фон лобби, ui.ds — интерфейс, logic.ds — правила боя,
// cubes.ds — куб игрока и его текстура.

int game_state = 0  // 0 — лобби, 1 — игра
int score = 0
int transition_state = 0  // 0 — нет, 1 — затемнение, 2 — осветление
int transition_target = 0
int transition_level = 0
int transition_len = 30

str GRASS = "grass.png"

#include "cubes.ds"
#include "ui.ds"
#include "logic.ds"
#include "lobby.ds"

fn init() {
    png_load(GRASS)
    png_load(PLAYER_TEX)
    cls(0x2C2C2C)
    score = 0
    game_state = 0
    init_lobby_background()
}

fn update() {
    update_transition()
    update_lobby_background()
    if (game_state == 0) {
        update_lobby_ui()
    } else {
        update_game_logic()
    }
}

fn init_game_scene() {
    init_game_logic()
    init_game_ui()
}

fn update_transition() {
    if (transition_state == 0) {
        return
    }
    if (transition_state == 1) {
        transition_level = transition_level + 1
        if (transition_level >= transition_len) {
            transition_level = transition_len
            game_state = transition_target
            if (transition_target == 1) {
                init_game_scene()
            }
            transition_state = 2
        }
    } else {
        transition_level = transition_level - 1
        if (transition_level <= 0) {
            transition_level = 0
            transition_state = 0
        }
    }
}

fn start_transition(int target) {
    transition_target = target
    transition_level = 0
    transition_state = 1
}

fn draw() {
    if (game_state == 0) {
        draw_lobby_background()
        draw_lobby_ui()
    } else {
        draw_game_background()
        draw_game_ui_underlay()
        draw_game_entities()
        draw_game_ui()
    }
    // Чёрная заливка поверх во время перехода.
    if (transition_state != 0 && transition_level > 0) {
        rect(0, 0, screen_w, screen_h, transition_level * 0x33000000)
    }
}

// Фон игры: повторяем 256px-текстуру травы без масштабирования.
fn draw_game_background() {
    num grass_size = 256
    num y = 0
    loop (y < screen_h) {
        num x = 0
        loop (x < screen_w) {
            tex(x, y, GRASS, 0, 1)
            x = x + grass_size
        }
        y = y + grass_size
    }
    // Подложка, чтобы игровой HUD оставался читаемым.
    rect(0, 0, screen_w, screen_h, 0x33000000)
}

fn touch(x, y, int action) {
    set_touch(x, y)
    if (transition_state != 0) {
        return
    }
    if (game_state == 0) {
        touch_lobby_ui(x, y, action)
    } else {
        touch_game_ui(x, y, action)
    }
}
