// ============================================
// JOYSTICK DEMO - LuaMC Syntax
// ============================================

// ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ
COLOR_BG = 0xFFCCCCCC;
COLOR_PLAYER = 0xFFEE7722;
COLOR_JOY = 0xFF000000;

// Игрок
player = {
    x = 0,
    y = 0,
    speed = 5,
    size = 40
};

// Джойстик
joy = {
    x = 150,
    y = 0,
    dx = 0,
    dy = 0,
    ox = 0,
    oy = 0,
    r = 80
};

// ============================================
// ИНИЦИАЛИЗАЦИЯ
// ============================================
fn init() {
    player.x = screen_w / 2;
    player.y = screen_h / 2;
    joy.x = 150;
    joy.y = screen_h - 150;
    joy.r = 80;
}

// ============================================
// ОБНОВЛЕНИЕ
// ============================================
fn update() {
    player.x = player.x + joy.dx * player.speed;
    player.y = player.y + joy.dy * player.speed;
    
    // Границы экрана
    if (player.x < player.size / 2) {
        player.x = player.size / 2;
    }
    if (player.x > screen_w - player.size / 2) {
        player.x = screen_w - player.size / 2;
    }
    if (player.y < player.size / 2) {
        player.y = player.size / 2;
    }
    if (player.y > screen_h - player.size / 2) {
        player.y = screen_h - player.size / 2;
    }
}

// ============================================
// ОТРИСОВКА
// ============================================
fn draw() {
    // Очистка экрана
    cls(COLOR_BG);
    
    // Рисуем игрока
    rect(
        player.x - player.size / 2,
        player.y - player.size / 2,
        player.size,
        player.size,
        COLOR_PLAYER
    );
    
    // Рисуем джойстик (кольцо)
    ring(joy.x, joy.y, joy.r, 4, COLOR_JOY);
    
    // Рисуем джойстик (ручка)
    circle(joy.x + joy.ox, joy.y + joy.oy, 35, COLOR_JOY);
}

// ============================================
// ОБРАБОТКА КАСАНИЙ
// ============================================
fn touch(x, y, action) {
    // Отпускание (action == 1) или отмена (action == 3)
    if (action == 1 || action == 3) {
        joy.dx = 0;
        joy.dy = 0;
        joy.ox = 0;
        joy.oy = 0;
        return;
    }
    
    // Расчёт расстояния до центра джойстика
    num dx = x - joy.x;
    num dy = y - joy.y;
    num distance = sqrt(dx * dx + dy * dy);
    
    // Если вне зоны джойстика
    if (distance > joy.r + 30 || distance < 15) {
        joy.dx = 0;
        joy.dy = 0;
        joy.ox = 0;
        joy.oy = 0;
        return;
    }
    
    // Нормализация
    num knob_distance = distance;
    if (knob_distance > joy.r) {
        knob_distance = joy.r;
    }
    
    joy.dx = dx / distance;
    joy.dy = dy / distance;
    joy.ox = joy.dx * knob_distance;
    joy.oy = joy.dy * knob_distance;
}

// ============================================
// ДОПОЛНИТЕЛЬНО: ОБРАБОТКА НАЗАД
// ============================================
fn onBack() {
    // Выход из игры
    // Screen.Exit();
}
