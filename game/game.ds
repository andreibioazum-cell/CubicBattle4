num COLOR_BG = 0xFF333366
num COLOR_PLAYER = 0xFFFF8844
num COLOR_JOY = 0xFFFFFFFF

num player_x = 200
num player_y = 400
num player_speed = 4
num player_size = 40

num joy_x = 150
num joy_y = 700
num joy_r = 80
num joy_dx = 0
num joy_dy = 0
num joy_ox = 0
num joy_oy = 0

num touch_x = 0
num touch_y = 0
num touch_action = 0

fn init() {
    player_x = screen_w / 2
    player_y = screen_h / 2
    joy_x = 150
    joy_y = screen_h - 150
    joy_r = 80
}

fn update() {
    player_x = player_x + joy_dx * player_speed
    player_y = player_y + joy_dy * player_speed
    
    if (player_x < player_size / 2) {
        player_x = player_size / 2
    }
    if (player_x > screen_w - player_size / 2) {
        player_x = screen_w - player_size / 2
    }
    if (player_y < player_size / 2) {
        player_y = player_size / 2
    }
    if (player_y > screen_h - player_size / 2) {
        player_y = screen_h - player_size / 2
    }
}

fn draw() {
    cls(COLOR_BG)
    rect(player_x - 20, player_y - 20, 40, 40, COLOR_PLAYER)
    ring(joy_x, joy_y, joy_r, 4, COLOR_JOY)
    circle(joy_x + joy_ox, joy_y + joy_oy, 35, COLOR_JOY)
}

fn touch(x, y, action) {
    touch_x = x
    touch_y = y
    touch_action = action
}

fn update_touch() {
    if (touch_action == 1 || touch_action == 3) {
        joy_dx = 0
        joy_dy = 0
        joy_ox = 0
        joy_oy = 0
        return
    }
    
    num dx = touch_x - joy_x
    num dy = touch_y - joy_y
    num distance = sqrt(dx * dx + dy * dy)
    
    // Мёртвая зона
    if (distance < 15) {
        joy_dx = 0
        joy_dy = 0
        joy_ox = 0
        joy_oy = 0
        return
    }
    
    // Направление (всегда нормализовано)
    num norm_dx = dx / distance
    num norm_dy = dy / distance
    
    // Ограничиваем расстояние радиусом кольца
    num limited_distance = distance
    if (limited_distance > joy_r) {
        limited_distance = joy_r
    }
    
    // Стик всегда на краю или внутри кольца
    joy_dx = norm_dx
    joy_dy = norm_dy
    joy_ox = norm_dx * limited_distance
    joy_oy = norm_dy * limited_distance
}
