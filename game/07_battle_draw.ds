// Отрисовка арены и результатов боя.
function draw_game
    // фон — повторяющаяся текстура травы
    num y = 0
    loop y < screen_h
        num x = 0
        loop x < screen_w
            tex x, y, GRASS, 0, 1
            x = x + 256
        end
        y = y + 256
    end
    rect 0, 0, screen_w, screen_h, 0x33000000

    // Прицел заканчивается чистой полосой — без крестика или метки на конце.
    if aiming == 1 && finished == 0
        num ax = cos(player.angle)
        num ay = sin(player.angle)
        num tip_x = player.x + ax * aim_range
        num tip_y = player.y + ay * aim_range
        line player.x, player.y, tip_x, tip_y, 18, 0x66000000
    end

    // бойцы
    circle player.x, player.y, player.size / 2, 0xFF8844
    tex player.x - 20, player.y - 20, TEX, player.angle, 1
    tex enemy.x - 20, enemy.y - 20, TEX, enemy.angle, 1
    ring enemy.x, enemy.y, 26, 3, 0xFF2020

    // В начале пуля крупная. На последних пикселях пути она одновременно
    // гаснет и плавно уменьшается, поэтому не обрывается резко.
    if bullet.active == 1
        num left = aim_range - bullet.traveled
        num a = 255
        num bullet_scale = 1
        if left < aim_fade
            bullet_scale = left / aim_fade
            a = floor(255 * bullet_scale)
        end
        if a < 1
            a = 1
        end
        num draw_r = bullet.r * bullet_scale
        circle bullet.x, bullet.y, draw_r, a * 0x1000000 + 0xFFF176
        ring bullet.x, bullet.y, draw_r + 2 * bullet_scale, 2 * bullet_scale, a * 0x1000000 + 0xFFB300
    end

    // HUD без текстовых счётчиков: здоровье игрока слева, врага справа.
    num hud_w = screen_w / 4
    hud_bar 20, 20, hud_w, 28, player.hp, player.max_hp, 0x7ED321, 0
    hud_bar screen_w - hud_w - 20, 20, hud_w, 28, enemy.hp, enemy.max_hp, 0xE94560, 1

    // интерфейс
    ring joy.x, joy.y, joy.r, 4, 0x000000
    circle joy.x + joy.ox, joy.y + joy.oy, 34, 0x000000
    if aiming == 1
        circle atk_x, atk_y, 76, 0xC73750
    else
        circle atk_x, atk_y, 70, 0xE94560
    end
    ring atk_x, atk_y, 70, 4, 0x000000
    if language_ru == 1
        text_scaled "Атака", atk_x - text_ink_width("Атака") * 0.275, atk_y - 7, 0xFFFFFF, 0.55
    else
        text_scaled "Attack", atk_x - text_ink_width("Attack") * 0.275, atk_y - 7, 0xFFFFFF, 0.55
    end
    draw_back

    if finished != 0
        rect 0, 0, screen_w, screen_h, 0x99000000
        num panel_y = screen_h / 2 - 85
        roundrect screen_w / 2 - 165, panel_y, 330, 170, 24, 0x5F10A0
        if language_ru == 1
            if finished == 1
                ctext "Победа!", panel_y + 34, 0xFFFFFF
                ctext "Соперник побеждён", panel_y + 75, 0xFFFFFF
            else
                ctext "Поражение", panel_y + 34, 0xFFFFFF
                ctext "Соперник победил", panel_y + 75, 0xFFFFFF
            end
            ctext "Нажмите, чтобы выйти", panel_y + 118, 0xFFCDD2
        else
            if finished == 1
                ctext "Victory!", panel_y + 34, 0xFFFFFF
                ctext "Opponent defeated", panel_y + 75, 0xFFFFFF
            else
                ctext "Defeat", panel_y + 34, 0xFFFFFF
                ctext "The opponent won", panel_y + 75, 0xFFFFFF
            end
            ctext "Tap to return", panel_y + 118, 0xFFCDD2
        end
    end
end
