// Лобби - главное меню

// Кнопка сгруппирована в объект (struct в C), а не в 8 отдельных глобальных
// переменных btn_x, btn_y, btn_w, ... — так проще масштабировать интерфейс.
object Button {
    num x = 0
    num y = 0
    num w = 220
    num h = 70
    col color = 0x5F10A0       // цвета — это битовая маска, а не число с плавающей точкой
    col pressed_color = 0x470C78  // темнее, пока кнопка зажата
    col text_color = 0xFFFFFF
    int pressed = 0            // 1, пока палец держит кнопку
    num press_scale = 1.08     // во сколько раз кнопка увеличивается при нажатии
}

object Star {
    num x = 0
    num y = 0
    num vx = 0
    num vy = 0
    num r = 1.4
}

Button play_btn = new Button()

Star s0 = new Star()
Star s1 = new Star()
Star s2 = new Star()
Star s3 = new Star()
Star s4 = new Star()
Star s5 = new Star()
Star s6 = new Star()
Star s7 = new Star()
Star s8 = new Star()
Star s9 = new Star()
Star s10 = new Star()
Star s11 = new Star()
Star s12 = new Star()
Star s13 = new Star()
Star s14 = new Star()
Star s15 = new Star()
Star s16 = new Star()
Star s17 = new Star()
Star s18 = new Star()
Star s19 = new Star()
Star s20 = new Star()
Star s21 = new Star()
Star s22 = new Star()
Star s23 = new Star()
Star s24 = new Star()
Star s25 = new Star()
Star s26 = new Star()
Star s27 = new Star()
Star s28 = new Star()
Star s29 = new Star()
Star s30 = new Star()
Star s31 = new Star()
Star s32 = new Star()
Star s33 = new Star()
Star s34 = new Star()
Star s35 = new Star()
Star s36 = new Star()
Star s37 = new Star()
Star s38 = new Star()
Star s39 = new Star()
Star s40 = new Star()
Star s41 = new Star()

int lobby_w = 0
int lobby_h = 0
int stars_started = 0

fn reset_star(Star star, int seed, num start_offset) {
    // Звёзды появляются сверху/слева и летят по диагонали вправо-вниз.
    // start_offset растягивает их цепочку по экрану, чтобы было видно сразу.
    star.x = -120 - ((seed * 71) % 220) + start_offset * 0.65
    star.y = -120 - ((seed * 97) % 260) + start_offset * 0.95
    star.vx = 1.0 + ((seed * 17) % 19) * 0.09
    star.vy = 1.7 + ((seed * 29) % 23) * 0.11
    star.r = 1.0 + ((seed * 31) % 19) * 0.09
}

fn init_stars() {
    num travel = screen_w
    if (screen_h > travel) {
        travel = screen_h
    }
    num step = (travel + 300) / 42
    reset_star(s0, 1, step * 0)
    reset_star(s1, 2, step * 1)
    reset_star(s2, 3, step * 2)
    reset_star(s3, 4, step * 3)
    reset_star(s4, 5, step * 4)
    reset_star(s5, 6, step * 5)
    reset_star(s6, 7, step * 6)
    reset_star(s7, 8, step * 7)
    reset_star(s8, 9, step * 8)
    reset_star(s9, 10, step * 9)
    reset_star(s10, 11, step * 10)
    reset_star(s11, 12, step * 11)
    reset_star(s12, 13, step * 12)
    reset_star(s13, 14, step * 13)
    reset_star(s14, 15, step * 14)
    reset_star(s15, 16, step * 15)
    reset_star(s16, 17, step * 16)
    reset_star(s17, 18, step * 17)
    reset_star(s18, 19, step * 18)
    reset_star(s19, 20, step * 19)
    reset_star(s20, 21, step * 20)
    reset_star(s21, 22, step * 21)
    reset_star(s22, 23, step * 22)
    reset_star(s23, 24, step * 23)
    reset_star(s24, 25, step * 24)
    reset_star(s25, 26, step * 25)
    reset_star(s26, 27, step * 26)
    reset_star(s27, 28, step * 27)
    reset_star(s28, 29, step * 28)
    reset_star(s29, 30, step * 29)
    reset_star(s30, 31, step * 30)
    reset_star(s31, 32, step * 31)
    reset_star(s32, 33, step * 32)
    reset_star(s33, 34, step * 33)
    reset_star(s34, 35, step * 34)
    reset_star(s35, 36, step * 35)
    reset_star(s36, 37, step * 36)
    reset_star(s37, 38, step * 37)
    reset_star(s38, 39, step * 38)
    reset_star(s39, 40, step * 39)
    reset_star(s40, 41, step * 40)
    reset_star(s41, 42, step * 41)
    stars_started = 1
}

fn update_star(Star star) {
    star.x = star.x + star.vx
    star.y = star.y + star.vy
    if (star.x > screen_w + 40 || star.y > screen_h + 40) {
        reset_star(star, rand() % 900 + 1, 0)
        // Возвращаем звезду за верхний/левый край экрана.
        if ((rand() % 2) == 0) {
            star.x = -30 - (rand() % 120)
            star.y = rand() % (screen_h / 2)
        } else {
            star.x = rand() % (screen_w / 2)
            star.y = -30 - (rand() % 120)
        }
    }
}

fn update_stars() {
    update_star(s0)
    update_star(s1)
    update_star(s2)
    update_star(s3)
    update_star(s4)
    update_star(s5)
    update_star(s6)
    update_star(s7)
