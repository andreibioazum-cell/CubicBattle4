fn draw_lobby_background() {
    // Текстура травы масштабируется на весь экран.
    num grass_size = 256
    num scale = screen_w / grass_size
    if (screen_h > screen_w) {
        scale = screen_h / grass_size
    }
    num grass_w = grass_size * scale
    num grass_h = grass_size * scale
    num grass_x = (screen_w - grass_w) / 2
    num grass_y = (screen_h - grass_h) / 2
    tex(grass_x, grass_y, "grass.png", 0, scale)

    // Затемняем фон, чтобы белые звёзды и заголовок читались лучше.
    rect(0, 0, screen_w, screen_h, 0xB4000000)
}

fn update_lobby() {
    // Центрируем кнопку.
    play_btn.w = 220
    play_btn.h = 70
    play_btn.x = (screen_w / 2) - (play_btn.w / 2)
    play_btn.y = (screen_h / 2) - (play_btn.h / 2) + 40

    if (stars_started == 0 || lobby_w != screen_w || lobby_h != screen_h) {
        lobby_w = screen_w
        lobby_h = screen_h
        init_stars()
    }
    update_stars()
}

fn draw_lobby() {
    draw_lobby_background()
    draw_stars()

    // Заголовок стоит ровно над кнопкой Play (центрируется по реальным
    // границам текста, поэтому больше не уезжает вверх).
    str title = "Кубик Батл"
    num title_h = text_ink_height(title)
    num title_gap = 20
    num title_y = play_btn.y - title_h - title_gap
    text(title, screen_w / 2 - text_ink_width(title) / 2, title_y, 0xFFFFFF)

    // Кнопка Play: без тени, рамки и hover-эффекта. При нажатии кнопка
    // увеличивается (press_scale) и темнеет (pressed_color), при отпускании
    // возвращается к обычному размеру и цвету.
    num scale = 1
    if (play_btn.pressed == 1) {
        scale = play_btn.press_scale
    }
    num bw = play_btn.w * scale
    num bh = play_btn.h * scale
    num bx = play_btn.x + (play_btn.w - bw) / 2
    num by = play_btn.y + (play_btn.h - bh) / 2
    col color = play_btn.color
    if (play_btn.pressed == 1) {
        color = play_btn.pressed_color
    }

    // Одна аккуратная заливка скруглённым прямоугольником
    roundrect(bx, by, bw, bh, 20 * scale, color)
    draw_button_label("Play", bx, by, bw, bh, play_btn.text_color)
}

fn touch_lobby(x, y, int action) {
    // Нажатие на кнопку: увеличиваем и затемняем. Отпускание внутри кнопки:
    // возвращаем размер/цвет и запускаем плавный переход в игру.
    if (x >= play_btn.x && x <= play_btn.x + play_btn.w && y >= play_btn.y && y <= play_btn.y + play_btn.h) {
        if (action == 0) {
            play_btn.pressed = 1
            return
        }
        if (action == 1 || action == 3) {
            if (play_btn.pressed == 1) {
                play_btn.pressed = 0
                score = 0
                start_transition(1)
            }
            return
        }
        return  // движение пальца внутри кнопки — кнопка остаётся нажатой
    }
    // Палец ушёл с кнопки: если был зажат или отпущен/отменён — сбрасываем
    if (action == 2 || action == 1 || action == 3) {
        play_btn.pressed = 0
    }
}

// Глобальные переменные для touch
int touch_x = 0
int touch_y = 0

fn set_touch(x, y) {
    touch_x = x
    touch_y = y
}
