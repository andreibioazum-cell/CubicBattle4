// Лобби: кнопка Play + летающие звёзды поверх фона-травы.
// Звёзды агрессивно летят из верхнего левого угла в правый нижний.

object Button {
    num x = 0
    num y = 0
    num w = 220
    num h = 70
    col color = 0x5F10A0
    col pressed_color = 0x470C78
    col text_color = 0xFFFFFF
    int pressed = 0
    num press_scale = 1.08
}

Button play_btn = new Button()

int lobby_w = 0
int lobby_h = 0
int stars_started = 0

// Кнопка не анимируется сама по себе: увеличение — только пока её удерживают.
num play_scale = 1

int touch_x = 0
int touch_y = 0

fn set_touch(x, y) {
    touch_x = x
    touch_y = y
}

fn init_stars() {
    // Много крупных звёзд (90), агрессивный полёт из верхнего-левого угла.
    ds_init_stars(90, 0xFFFFFF)
    stars_started = 1
}

fn update_stars() {
    if (stars_started == 0 || lobby_w != screen_w || lobby_h != screen_h) {
        lobby_w = screen_w
        lobby_h = screen_h
        ds_init_stars(90, 0xFFFFFF)
        stars_started = 1
    }
    ds_update_stars()
}

fn draw_stars() {
    ds_draw_stars()
}

fn update_lobby() {
    play_btn.w = 220
    play_btn.h = 70
    play_btn.x = (screen_w / 2) - (play_btn.w / 2)
    play_btn.y = (screen_h / 2) - (play_btn.h / 2) + 40
    // В покое размер постоянный. При нажатии Play сразу становится больше;
    // цвет для нажатия задаётся в draw_lobby.
    if (play_btn.pressed == 1) {
        play_scale = play_btn.press_scale
    } else {
        play_scale = 1
    }
}

fn draw_lobby() {
    str title = "Cubic Battle 4"
    num title_h = text_ink_height(title)
    num title_gap = 20
    num title_y = play_btn.y - title_h - title_gap
    text(title, screen_w / 2 - text_ink_width(title) / 2, title_y, 0xFFFFFF)

    num scale = play_scale
    num bw = play_btn.w * scale
    num bh = play_btn.h * scale
    num bx = play_btn.x + (play_btn.w - bw) / 2
    num by = play_btn.y + (play_btn.h - bh) / 2
    col color = play_btn.color
    if (play_btn.pressed == 1) {
        color = play_btn.pressed_color
    }
    roundrect(bx, by, bw, bh, 20 * scale, color)
    draw_button_label("Play", bx, by, bw, bh, play_btn.text_color)
}

fn touch_lobby(x, y, int action) {
    if (x >= play_btn.x && x <= play_btn.x + play_btn.w && y >= play_btn.y && y <= play_btn.y + play_btn.h) {
        if (action == 0) {
            play_btn.pressed = 1
            return
        }
        if (action == 1 || action == 3) {
            if (play_btn.pressed == 1) {
                play_btn.pressed = 0
                score = 0
                start_transition(1)
            }
            return
        }
        return
    }
    if (action == 2 || action == 1 || action == 3) {
        play_btn.pressed = 0
    }
}
