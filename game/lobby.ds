// Лобби - главное меню

num btn_x = 0
num btn_y = 0
num btn_w = 220
num btn_h = 70
num btn_color = 0x5F10A0
num btn_hover_color = 0x7A22C9
num btn_text_color = 0xFFFFFF

num title_y = 0

fn update_lobby() {
    // Центрируем кнопку
    btn_w = 220
    btn_h = 70
    btn_x = (screen_w / 2) - (btn_w / 2)
    btn_y = (screen_h / 2) - (btn_h / 2) + 40
    title_y = btn_y - 110
}

fn draw_lobby() {
    cls(0x1a1a2e)
    
    // Заголовок игры
    text("🎮 GAME DS", screen_w / 2 - 45, title_y, 0xE94560)
    
    // Кнопка "Play"
    num hover = 0
    if (touch_x >= btn_x && touch_x <= btn_x + btn_w && touch_y >= btn_y && touch_y <= btn_y + btn_h) {
        hover = 1
    }
    num color = btn_color
    if (hover == 1) {
        color = btn_hover_color
    }
    
    // Стильная кнопка с тенью, рамкой и заливкой (скруглённая, фиолетовая)
    roundrect(btn_x + 3, btn_y + 4, btn_w, btn_h, 20, 0x0f0f1c)
    roundrect(btn_x - 2, btn_y - 2, btn_w + 4, btn_h + 4, 22, 0x9C27B0)
    roundrect(btn_x, btn_y, btn_w, btn_h, 20, color)
    
    // Текст на кнопке, отцентрирован по кнопке
    draw_button_label("PLAY", btn_x, btn_y, btn_w, btn_h, btn_text_color)
}

fn touch_lobby(x, y) {
    if (x >= btn_x && x <= btn_x + btn_w && y >= btn_y && y <= btn_y + btn_h) {
        game_state = 1
        score = 0
        init_game()
    }
}

// Глобальные переменные для touch
num touch_x = 0
num touch_y = 0

fn set_touch(x, y) {
    touch_x = x
    touch_y = y
}
