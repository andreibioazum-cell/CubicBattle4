// Фон лобби: тёмная подложка и летающие звёзды.
// Кнопки и текст лобби находятся в ui.ds.

int lobby_w = 0
int lobby_h = 0
int stars_started = 0

fn init_lobby_background() {
    // Много крупных звёзд, летящих из верхнего левого угла.
    ds_init_stars(90, 0xFFFFFF)
    stars_started = 1
}

fn update_lobby_background() {
    if (stars_started == 0 || lobby_w != screen_w || lobby_h != screen_h) {
        lobby_w = screen_w
        lobby_h = screen_h
        ds_init_stars(90, 0xFFFFFF)
        stars_started = 1
    }
    ds_update_stars()
}

fn draw_lobby_background() {
    rect(0, 0, screen_w, screen_h, 0x1a1a2e)
    ds_draw_stars()
}
