    update_star(s13)
    update_star(s14)
    update_star(s15)
    update_star(s16)
    update_star(s17)
    update_star(s18)
    update_star(s19)
    update_star(s20)
    update_star(s21)
    update_star(s22)
    update_star(s23)
    update_star(s24)
    update_star(s25)
    update_star(s26)
    update_star(s27)
    update_star(s28)
    update_star(s29)
    update_star(s30)
    update_star(s31)
    update_star(s32)
