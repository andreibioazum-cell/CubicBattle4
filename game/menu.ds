// menu.ds — лобби, привычки, «как играть» и настройки.

function save_progress
// Прогресс лежит в progress.dat: движок хранит семь чисел, у нас это сила
// воли, рекорд дней и пять бесконечных ступеней прокачки.
net_save_progress willpower,best_day,up_speed,up_bag,up_hold,up_night,up_food
end
function load_progress
willpower=net_load_cups(); best_day=net_load_candies()
up_speed=net_load_class(); up_bag=net_load_azum(); up_hold=net_load_santa()
up_night=net_load_level(); up_food=net_load_levels_unlocked()
if willpower<0; willpower=0; end
if best_day<0; best_day=0; end
if up_speed<0; up_speed=0; end
if up_bag<0; up_bag=0; end
if up_hold<0; up_hold=0; end
if up_night<0; up_night=0; end
if up_food<0; up_food=0; end
end
function up_cost num base, num lvl
// Каждая следующая ступень дороже предыдущей в cost_growth раз. Потолка нет:
// качать можно сколько угодно, просто всё дороже.
num c=base, i=0
loop i<lvl
c=floor(c*cost_growth)
i=i+1
end
return c
end
function buy_speed
num cost=up_cost(cost_speed,up_speed)
if willpower<cost; shop_msg=2.5; return; end
willpower=willpower-cost; up_speed=up_speed+1; shop_msg=0; save_progress
end
function buy_bag
num cost=up_cost(cost_bag,up_bag)
if willpower<cost; shop_msg=2.5; return; end
willpower=willpower-cost; up_bag=up_bag+1; shop_msg=0; save_progress
end
function buy_hold
num cost=up_cost(cost_hold,up_hold)
if willpower<cost; shop_msg=2.5; return; end
willpower=willpower-cost; up_hold=up_hold+1; shop_msg=0; save_progress
end
function buy_night
num cost=up_cost(cost_night,up_night)
if willpower<cost; shop_msg=2.5; return; end
willpower=willpower-cost; up_night=up_night+1; shop_msg=0; save_progress
end
function buy_food
num cost=up_cost(cost_food,up_food)
if willpower<cost; shop_msg=2.5; return; end
willpower=willpower-cost; up_food=up_food+1; shop_msg=0; save_progress
end
function draw_purse num y
str w_s=tr_will()+": "+willpower, r_s=tr_record()+": "+best_day
num ww=text_ink_width(w_s)*0.55, rw=text_ink_width(r_s)*0.55, gap=34
num x=(screen_w-ww-rw-gap)/2
text_scaled w_s,x,y,0xFFD54A,0.55
text_scaled r_s,x+ww+gap,y,0xB0F0B0,0.55
end
function draw_bg
// Фон меню - тёмный лист в линейку: тема игры про тетрадку, где Ярик
// отмечает прожитые дни.
rect 0,0,screen_w,screen_h,0x14161F
num ly=38
loop ly<screen_h
line 0,ly,screen_w,ly,1,0x191D2A
ly=ly+38
end
line 112,0,112,screen_h,2,0x2B1F2E
end
function draw_disclaimer
draw_bg
num y=screen_h/2-186
tex screen_w/2-32,y,SHEET,0,1
y=y+96
ctext tr_disc_title(),y,0xFFFFFF
y=y+68
ctext_scaled tr_disc1(),y,0xE6E6F0,0.6; y=y+44
ctext_scaled tr_disc2(),y,0xE6E6F0,0.6; y=y+44
ctext_scaled tr_disc3(),y,0x9FE0A0,0.6; y=y+70
ctext_scaled tr_disc_tap(),y,0x8890A8,0.55
end
function draw_lobby
draw_bg
num mx=(screen_w-btn_w)/2, my=menu_top()
ctext tr_title(),my-118,0xFFFFFF
ctext_scaled tr_subtitle(),my-70,0x9FE0A0,0.7
button tr_play(),mx,my,btn_w,btn_h
button tr_habits(),mx,my+80,btn_w,btn_h
button tr_howto(),mx,my+160,btn_w,btn_h
button tr_settings(),mx,my+240,btn_w,btn_h
draw_purse my+240+btn_h+22
end
function touch_lobby num x, num y, num action
if action!=0; return; end
if menu_hit(x,y,0)==1; click_sound; start_transition 1; return; end
if menu_hit(x,y,1)==1; click_sound; start_transition 2; return; end
if menu_hit(x,y,2)==1; click_sound; start_transition 3; return; end
if menu_hit(x,y,3)==1; click_sound; start_transition 4; end
end
// Пять карточек привычек в ряд.
function card_w
return 232
end
function card_h
return 300
end
function card_gap
return 18
end
function card_x num i
num total=card_w()*5+card_gap()*4
return (screen_w-total)/2+i*(card_w()+card_gap())
end
function card_y
return back_y+btn_h+40
end
function draw_card num i, str title, str desc, num lvl, num cost, col accent, str icon, num icon_scale
num x=card_x(i), y=card_y(), w=card_w(), h=card_h()
roundrect x,y,w,h,20,0xFF23252F
roundrect x,y,w,8,4,accent
circle x+w/2,y+80,44,accent
num half=44*icon_scale
tex x+w/2-half,y+80-half,icon,0,icon_scale
text_in_box title,x,y+130,w,34,0xFFFFFF,0.75
str lv_s=tr_step()+lvl
text_in_box lv_s,x,y+166,w,28,0xB9F6CA,0.55
text_in_box desc,x,y+198,w,44,0xC0C4D4,0.45
button_scaled tr_buy_for(cost),x+20,y+h-66,w-40,48,0.55
end
function draw_habits
draw_bg
draw_card 0,tr_shoes(),tr_shoes_desc(),up_speed,up_cost(cost_speed,up_speed),0xFF4CAF50,YARIK,0.85
draw_card 1,tr_bigbag(),tr_bigbag_desc(),up_bag,up_cost(cost_bag,up_bag),0xFF42A5F5,TRASH,1.0
draw_card 2,tr_calm(),tr_calm_desc(),up_hold,up_cost(cost_hold,up_hold),0xFFAB47BC,SHEET,1.0
draw_card 3,tr_night_up(),tr_night_up_desc(),up_night,up_cost(cost_night,up_night),0xFF5C6BC0,FRIDGE,0.8
draw_card 4,tr_appetite(),tr_appetite_desc(),up_food,up_cost(cost_food,up_food),0xFFFF7043,FOOD,1.0
ctext_scaled tr_endless(),card_y()+card_h()+26,0x8890A8,0.5
draw_purse card_y()+card_h()+58
if shop_msg>0; shop_msg=shop_msg-dt; ctext_scaled tr_need_will(),card_y()+card_h()+94,0xFF8A80,0.6; end
draw_back
end
function card_btn_hit num i, num x, num y
num cx=card_x(i)+20, cy=card_y()+card_h()-66
if x>=cx&&x<=cx+card_w()-40&&y>=cy&&y<=cy+48; return 1; end
return 0
end
function touch_habits num x, num y, num action
if action!=0; return; end
if back_hit(x,y)==1; click_sound; start_transition 0; return; end
if card_btn_hit(0,x,y)==1; click_sound; buy_speed; return; end
if card_btn_hit(1,x,y)==1; click_sound; buy_bag; return; end
if card_btn_hit(2,x,y)==1; click_sound; buy_hold; return; end
if card_btn_hit(3,x,y)==1; click_sound; buy_night; return; end
if card_btn_hit(4,x,y)==1; click_sound; buy_food; end
end
function draw_howto
draw_bg
num y=back_y+btn_h+30
ctext tr_story(),y,0xFFFFFF
y=y+46
ctext_scaled tr_s1(),y,0xC9CBD8,0.52; y=y+34
ctext_scaled tr_s2(),y,0xC9CBD8,0.52; y=y+34
ctext_scaled tr_s3(),y,0xC9CBD8,0.52; y=y+34
ctext_scaled tr_s4(),y,0xC9CBD8,0.52; y=y+34
ctext_scaled tr_s5(),y,0x8890A8,0.52; y=y+52
ctext tr_rules(),y,0xFFFFFF
y=y+46
ctext_scaled tr_h2(),y,0xE6E6F0,0.55; y=y+36
ctext_scaled tr_h3(),y,0xE6E6F0,0.55; y=y+36
ctext_scaled tr_h4(),y,0xE6E6F0,0.55; y=y+36
ctext_scaled tr_h1(),y,0xFFB3A7,0.55; y=y+36
ctext_scaled tr_h5(),y,0xE6E6F0,0.55; y=y+36
ctext_scaled tr_h6(),y,0x9FC6FF,0.55; y=y+36
ctext_scaled tr_h7(),y,0x9FC6FF,0.55; y=y+36
ctext_scaled tr_h8(),y,0xFFB3A7,0.55; y=y+36
ctext_scaled tr_h9(),y,0xFFD54A,0.55
draw_back
end
function draw_settings
draw_bg
num mx=(screen_w-btn_w)/2, my=menu_top()
ctext tr_lang(),my-70,0xFFFFFF
if language==1; button "Русский",mx,my,btn_w,btn_h; else; button_grey "Русский",mx,my,btn_w,btn_h,1; end
if language==0; button "English",mx,my+80,btn_w,btn_h; else; button_grey "English",mx,my+80,btn_w,btn_h,1; end
draw_back
end
function touch_settings num x, num y, num action
if action!=0; return; end
if back_hit(x,y)==1; click_sound; start_transition 0; return; end
if menu_hit(x,y,0)==1; click_sound; language=1; return; end
if menu_hit(x,y,1)==1; click_sound; language=0; end
end
function touch_menu num x, num y, num action
if game_state==2; touch_habits x,y,action; return; end
if game_state==4; touch_settings x,y,action; return; end
if action!=0; return; end
if back_hit(x,y)==1; click_sound; start_transition 0; end
end
