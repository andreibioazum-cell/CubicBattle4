// menu.ds — лобби, привычки, «как играть» и настройки.

function save_progress
// Прогресс лежит в progress.dat. Движок хранит семь чисел, у нас они значат:
// сила воли, рекорд дней, (не используется), большой мешок, дыхание,
// ступень кроссовок (дважды: текущая и максимальная — они всегда равны).
net_save_progress willpower,best_day,0,bag_owned,calm_owned,shoes_level,shoes_level
end
function load_progress
willpower=net_load_cups(); best_day=net_load_candies()
bag_owned=net_load_azum(); calm_owned=net_load_santa(); shoes_level=net_load_levels_unlocked()
if willpower<0; willpower=0; end
if best_day<0; best_day=0; end
if shoes_level<0; shoes_level=0; end
if shoes_level>shoes_max; shoes_level=shoes_max; end
end
function shoes_cost
return shoes_base_cost+shoes_level*shoes_step
end
function buy_shoes
if shoes_level>=shoes_max; return; end
if willpower<shoes_cost(); shop_msg=2.5; return; end
willpower=willpower-shoes_cost(); shoes_level=shoes_level+1; shop_msg=0; save_progress
end
function buy_bag
if bag_owned==1; return; end
if willpower<bag_cost; shop_msg=2.5; return; end
willpower=willpower-bag_cost; bag_owned=1; shop_msg=0; save_progress
end
function buy_calm
if calm_owned==1; return; end
if willpower<calm_cost; shop_msg=2.5; return; end
willpower=willpower-calm_cost; calm_owned=1; shop_msg=0; save_progress
end
function draw_purse num y
str w_s=tr_will()+": "+willpower, r_s=tr_record()+": "+best_day
num ww=text_ink_width(w_s)*0.55, rw=text_ink_width(r_s)*0.55, gap=34
num x=(screen_w-ww-rw-gap)/2
text_scaled w_s,x,y,0xFFD54A,0.55
text_scaled r_s,x+ww+gap,y,0xB0F0B0,0.55
end
function draw_bg
rect 0,0,screen_w,screen_h,0x14161F
end
function draw_lobby
draw_bg
num mx=(screen_w-btn_w)/2, my=menu_top()
ctext tr_title(),my-118,0xFFFFFF
ctext_scaled tr_subtitle(),my-70,0x9FE0A0,0.7
button tr_play(),mx,my,btn_w,btn_h
button tr_habits(),mx,my+80,btn_w,btn_h
button tr_howto(),mx,my+160,btn_w,btn_h
button tr_settings(),mx,my+240,btn_w,btn_h
draw_purse my+240+btn_h+22
end
function touch_lobby num x, num y, num action
if action!=0; return; end
if menu_hit(x,y,0)==1; start_transition 1; return; end
if menu_hit(x,y,1)==1; start_transition 2; return; end
if menu_hit(x,y,2)==1; start_transition 3; return; end
if menu_hit(x,y,3)==1; start_transition 4; end
end
function card_w
return 300
end
function card_h
return 296
end
function card_x num i
num total=card_w()*3+2*26
return (screen_w-total)/2+i*(card_w()+26)
end
function card_y
return back_y+btn_h+46
end
function draw_card num i, str title, str desc, str state, num owned, col accent, str icon, num icon_scale
num x=card_x(i), y=card_y(), w=card_w(), h=card_h()
roundrect x,y,w,h,22,0xFF23252F
roundrect x,y,w,8,4,accent
circle x+w/2,y+86,48,accent
num half=48*icon_scale
tex x+w/2-half,y+86-half,icon,0,icon_scale
text_in_box title,x,y+140,w,40,0xFFFFFF,0.85
text_in_box desc,x,y+184,w,32,0xC0C4D4,0.55
if owned==1; button_grey state,x+26,y+h-70,w-52,50,0.6
else; button_scaled state,x+26,y+h-70,w-52,50,0.6; end
end
function shoes_state
str s=tr_buy_for(shoes_cost())
if shoes_level>=shoes_max; s=tr_maxed(); end
return s
end
function shoes_title
str s=tr_shoes()+" "+shoes_level+"/"+shoes_max
return s
end
function draw_habits
draw_bg
num done=0
if shoes_level>=shoes_max; done=1; end
draw_card 0,shoes_title(),tr_shoes_desc(),shoes_state(),done,0xFF4CAF50,YARIK,0.85
str bag_state=tr_buy_for(bag_cost)
if bag_owned==1; bag_state=tr_owned(); end
draw_card 1,tr_bigbag(),tr_bigbag_desc(),bag_state,bag_owned,0xFF42A5F5,TRASH,1.1
str calm_state=tr_buy_for(calm_cost)
if calm_owned==1; calm_state=tr_owned(); end
draw_card 2,tr_calm(),tr_calm_desc(),calm_state,calm_owned,0xFFAB47BC,SHEET,1.1
draw_purse card_y()+card_h()+26
if shop_msg>0; shop_msg=shop_msg-dt; ctext_scaled tr_need_will(),card_y()+card_h()+64,0xFF8A80,0.6; end
draw_back
end
function card_btn_hit num i, num x, num y
num cx=card_x(i)+26, cy=card_y()+card_h()-70
if x>=cx&&x<=cx+card_w()-52&&y>=cy&&y<=cy+50; return 1; end
return 0
end
function touch_habits num x, num y, num action
if action!=0; return; end
if back_hit(x,y)==1; start_transition 0; return; end
if card_btn_hit(0,x,y)==1; buy_shoes; return; end
if card_btn_hit(1,x,y)==1; buy_bag; return; end
if card_btn_hit(2,x,y)==1; buy_calm; end
end
function draw_howto
draw_bg
num y=back_y+btn_h+50
ctext tr_howto(),y,0xFFFFFF
y=y+62
ctext_scaled tr_h1(),y,0xE6E6F0,0.62; y=y+46
ctext_scaled tr_h2(),y,0xE6E6F0,0.62; y=y+46
ctext_scaled tr_h3(),y,0xE6E6F0,0.62; y=y+46
ctext_scaled tr_h4(),y,0xE6E6F0,0.62; y=y+46
ctext_scaled tr_h5(),y,0xE6E6F0,0.62; y=y+46
ctext_scaled tr_h6(),y,0xFFB3A7,0.62; y=y+46
ctext_scaled tr_h7(),y,0xFFD54A,0.62
draw_back
end
function draw_settings
draw_bg
num mx=(screen_w-btn_w)/2, my=menu_top()
ctext tr_lang(),my-70,0xFFFFFF
if language==1; button "Русский",mx,my,btn_w,btn_h; else; button_grey "Русский",mx,my,btn_w,btn_h,1; end
if language==0; button "English",mx,my+80,btn_w,btn_h; else; button_grey "English",mx,my+80,btn_w,btn_h,1; end
draw_back
end
function touch_settings num x, num y, num action
if action!=0; return; end
if back_hit(x,y)==1; start_transition 0; return; end
if menu_hit(x,y,0)==1; language=1; return; end
if menu_hit(x,y,1)==1; language=0; end
end
function touch_menu num x, num y, num action
if game_state==2; touch_habits x,y,action; return; end
if game_state==4; touch_settings x,y,action; return; end
if action!=0; return; end
if back_hit(x,y)==1; start_transition 0; end
end
