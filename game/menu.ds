function class_name
if player_class==1; return tr_class_azum(); end
return tr_class_ordinary()
end
function save_progress
net_save_progress cups,player_class,azum_owned
net_set_class player_class
end
function draw_cups
str cup_s=tr_cups()+": "+cups
num cw=text_ink_width(cup_s)*0.5
text_scaled cup_s,screen_w-cw-20,18,0xFFD54A,0.5
end
function draw_lobby
rect 0,0,screen_w,screen_h,0x1a1a2e; ctext "Cubic Battle 4",screen_h/2-150,0xFFFFFF
// Основное меню: классы идут сразу под настройками и имеют тот же размер.
num mx=(screen_w-btn_w)/2, my=screen_h/2-80
button tr_play(),mx,my,btn_w,btn_h;button tr_settings(),mx,my+80,btn_w,btn_h;button tr_classes(),mx,my+160,btn_w,btn_h;button tr_account(),mx,my+240,btn_w,btn_h
if net_login_status()==2;str ln=net_login_nick();if str_len(ln)>0;str greet="Привет, \""+ln+"\"";num lw=text_ink_width(greet)*0.5;text_scaled greet,(screen_w-lw)/2,18,0xFFFFFF,0.5;end;end
draw_cups
end
function draw_class_card num x, num y, num w, num h, num cls, str title, str desc, str texname
num sel=0, locked=0
if player_class==cls; sel=1; end
if cls==1&&azum_owned==0; locked=1; sel=0; end
if sel==1; roundrect x-5,y-5,w+10,h+10,26,0xFF5A5A78; end
roundrect x,y,w,h,22,0xFF2A2A40
num ts=2.2, spr=50*ts
tex x+(w-spr)/2,y+28,texname,0,ts
num tw=text_ink_width(title)
text title,x+(w-tw)/2,y+150,0xFFFFFF
num dw=text_ink_width(desc)*0.5
text_scaled desc,x+(w-dw)/2,y+198,0xC8C8E0,0.5
if sel==1; button_scaled tr_class_selected(),x+24,y+h-72,w-48,48,0.55
else if locked==1; button_scaled tr_class_buy(),x+24,y+h-72,w-48,48,0.55
else; button_scaled tr_class_pick(),x+24,y+h-72,w-48,48,0.55; end
end
function draw_classes
rect 0,0,screen_w,screen_h,0x1a1a2e
num cw=300, ch=300, gap=40
num x1=(screen_w-cw*2-gap)/2, x2=x1+cw+gap, y=back_y+btn_h+16
draw_class_card x1,y,cw,ch,0,tr_class_ordinary(),tr_class_ordinary_desc(),ORDINARY_TEX
draw_class_card x2,y,cw,ch,1,tr_class_azum(),tr_class_azum_desc(),AZUM_TEX
// Кнопка «Уровни» — под карточкой Азума.
button_scaled tr_levels(),x2,y+ch+gap,cw,btn_h,0.9
draw_cups
if class_msg_t>0; class_msg_t=class_msg_t-dt; ctext tr_class_need_cups(),y+ch+gap+btn_h+18,0xFF8A80; end
draw_back
end
function pick_class num cls
if cls==1
if azum_owned==0
if cups>=azum_cost; cups=cups-azum_cost; azum_owned=1; player_class=1; save_progress; ds_log "bought azum, cups %g",cups
else; class_msg_t=2.5; end
return
end
player_class=1; save_progress; return
end
player_class=0; save_progress
end
function touch_classes num x, num y, num action
if action!=0; return; end
if back_hit(x,y)==1; start_transition 0; return; end
num cw=300, ch=300, gap=40
num x1=(screen_w-cw*2-gap)/2, x2=x1+cw+gap, cy=back_y+btn_h+16
if y>=cy&&y<=cy+ch
if x>=x1&&x<=x1+cw; pick_class 0; return; end
if x>=x2&&x<=x2+cw; pick_class 1; return; end
end
// Кнопка «Уровни» под карточкой Азума.
if y>=cy+ch+gap&&y<=cy+ch+gap+btn_h
if x>=x2&&x<=x2+cw; start_transition 9; return; end
end
end
function draw_levels
rect 0,0,screen_w,screen_h,0x1a1a2e
ctext tr_levels(),back_y+btn_h+8,0xFFFFFF
num n=1, row_h=78, y=back_y+btn_h+52, w=520, x=(screen_w-w)/2
loop n<=max_level
num sel=0; if player_level==n; sel=1; end
if sel==1; roundrect x-4,y-4,w+8,row_h+8,24,0xFF5A5A78; end
roundrect x,y,w,row_h,20,0xFF2A2A40
str title=tr_level()+" "+n
str desc=tr_level_absorb()+" "+(n*10)+"%"
num tw=text_ink_width(title)*0.7
text_scaled title,x+(w-tw)/2,y+12,0xFFFFFF,0.7
num dw=text_ink_width(desc)*0.5
text_scaled desc,x+(w-dw)/2,y+42,0xC8C8E0,0.5
n=n+1; y=y+row_h+10
end
draw_cups
draw_back
end
function touch_levels num x, num y, num action
if action!=0; return; end
if back_hit(x,y)==1; start_transition 8; return; end
num n=1, row_h=78, ry=back_y+btn_h+52, w=520, rx=(screen_w-w)/2
loop n<=max_level
if x>=rx&&x<=rx+w&&y>=ry&&y<=ry+row_h; player_level=n; return; end
n=n+1; ry=ry+row_h+10
end
end
function draw_modes
rect 0,0,screen_w,screen_h,0x1a1a2e
button tr_solo(),(screen_w-btn_w)/2,screen_h/2-40,btn_w,btn_h
button tr_online(),(screen_w-btn_w)/2,screen_h/2+40,btn_w,btn_h
// Третья кнопка в выборе режима: защита для эпилептиков (выключает мигание).
// Текст поменьше обычного, чтобы целиком помещался в кнопку размером с «Онлайн».
str lbl=tr_disco_epilepsy()+" ("+tr_mode_off()+")"
if disco_safe==1; lbl=tr_disco_epilepsy()+" ("+tr_mode_on()+")"; end
button_scaled lbl,(screen_w-btn_w)/2,screen_h/2+120,btn_w,btn_h,0.7
draw_back;end
function draw_login
// Экран входа в онлайн: спрашиваем ТОЛЬКО ник — без пароля и регистрации.
// Ник сохраняется и при следующем запуске сразу пускает игрока в онлайн.
rect 0,0,screen_w,screen_h,0x1a1a2e
text tr_login_title(),24+login_ox,26,0xFFFFFF
num bw=screen_w-120, bx=(screen_w-bw)/2+login_ox, fy=screen_h/2-60+login_oy
text tr_nick(),bx+login_lab_ox,fy-login_lab,0xFFFFFF
if login_field==1; roundrect bx,fy,bw,login_fh,14,0xFF4B2E83; else; roundrect bx,fy,bw,login_fh,14,0xFF2A2A40; end
if str_len(login_nick)==0; if keyboard_visible()==1; text_in_field "|",bx+16,fy,login_fh,0xFFFFFF,0.6; else; text_in_field tr_nick_ph(),bx+16,fy,login_fh,0x666688,0.6; end; else; if keyboard_visible()==1; text_in_field login_nick+"|",bx+16,fy,login_fh,0xFFFFFF,0.6; else; text_in_field login_nick,bx+16,fy,login_fh,0xFFFFFF,0.6; end; end
num yb=fy+login_fh+40
button tr_play(),(screen_w-btn_w)/2,yb,btn_w,btn_h
num sy=yb+btn_h+34
if login_status==5; ctext tr_bad_nick(),sy,0xFF8A80; end
draw_back;end
function draw_settings
rect 0,0,screen_w,screen_h,0x1a1a2e;num x=(screen_w-btn_w)/2, y=screen_h/2-110;button "English",x,y,btn_w,btn_h;button "Русский",x,y+80,btn_w,btn_h;button "日本語",x,y+160,btn_w,btn_h;draw_back;end
function touch_lobby num x, num y, num action
if action!=0; return; end
num mx=(screen_w-btn_w)/2, my=screen_h/2-80
if x<mx-12||x>mx+btn_w+12; return; end
if y>=my-8&&y<=my+btn_h+8; start_transition 2; return; end
if y>=my+72&&y<=my+btn_h+88; start_transition 4; return; end
if y>=my+152&&y<=my+btn_h+168; start_transition 8; return; end
if y>=my+232&&y<=my+btn_h+248; login_after=0; start_transition 7; end
end
function login_focus
// Поле одно и всегда в фокусе. Если IME реально закрыта (например, юзер
// смахнул её жестом) — просто показываем снова. Набранное НЕ стираем:
// keyboard_show сам передаёт текущий буфер в системный редактор, поэтому
// повторное открытие клавиатуры не теряет уже набранные символы.
login_field=1
if keyboard_visible()==1; return; end
keyboard_show
end
function login_open
// Экран ника: очищаем чужой текст (чат) и сразу даём писать, без лишнего тапа.
login_field=1; login_status=0; login_nick=""
keyboard_clear; keyboard_show
end
function login_do
// Никакой сети для входа не нужно: ник проверяется и сохраняется на месте.
if net_set_nick(login_nick)==1; login_status=0; keyboard_hide; keyboard_clear; start_transition login_after
else; login_status=5; end
end
function update_login
// Каждый кадр забираем текст с клавиатуры, как в чате. Сравнение last_kb/raw
// оставляло поле пустым: указатель на строку уже не совпадал с буфером IME,
// хотя латинские буквы в системной клавиатуре уже были.
if login_field!=1; login_focus; end
login_nick=keyboard_get_text()
if keyboard_enter_pressed()==1; login_do; end
end
function touch_login num x, num y, num action
if action!=0; return; end
if back_hit(x,y)==1; keyboard_hide; keyboard_clear; if login_after==5; start_transition 2; else; start_transition 0; end; return; end
num bw=screen_w-120, bx=(screen_w-bw)/2+login_ox, fy=screen_h/2-60+login_oy
num yb=fy+login_fh+40
if x>=(screen_w-btn_w)/2-12&&x<=(screen_w-btn_w)/2+btn_w+12&&y>=yb-8&&y<=yb+btn_h+8; login_do; return; end
// Тап в поле или мимо кнопок снова открывает клавиатуру, чтобы можно было писать.
login_focus
end
function touch_menu num x, num y, num action
if action!=0; return; end
if game_state==7; touch_login x,y,action; return; end
if game_state==8; touch_classes x,y,action; return; end
if game_state==9; touch_levels x,y,action; return; end
if back_hit(x,y)==1; start_transition 0; return; end
num mx=(screen_w-btn_w)/2
if x<mx-12||x>mx+btn_w+12; return; end
if game_state==2
if y>=screen_h/2-48&&y<=screen_h/2+32; start_transition 1; return; end
if y>=screen_h/2+32&&y<=screen_h/2+112
if net_login_status()==2; start_transition 5; else; login_after=5; start_transition 7; end
return
end
if y>=screen_h/2+112&&y<=screen_h/2+192
if disco_safe==1; disco_safe=0; else; disco_safe=1; end
return
end
else if game_state==4
num sy=screen_h/2-110
if y>=sy-8&&y<sy+72; language=0
else if y>=sy+72&&y<sy+152; language=1
else if y>=sy+152&&y<sy+232; language=2
end
end
end
