num settings_focus=0, account_last_status=0, account_notice=0
str account_nick_input="", account_password_input=""

function draw_lobby
rect 0,0,screen_w,screen_h,0x1a1a2e; ctext "Cubic Battle 4",screen_h/2-110,0xFFFFFF
if language_ru==1; button "Играть",(screen_w-btn_w)/2,screen_h/2-20,btn_w,btn_h; button "Настройки",(screen_w-btn_w)/2,screen_h/2+60,btn_w,btn_h
else; button "Play",(screen_w-btn_w)/2,screen_h/2-20,btn_w,btn_h; button "Settings",(screen_w-btn_w)/2,screen_h/2+60,btn_w,btn_h; end
end
function draw_modes
rect 0,0,screen_w,screen_h,0x1a1a2e
if language_ru==1; button "Соло",(screen_w-btn_w)/2,screen_h/2-40,btn_w,btn_h; button "Онлайн",(screen_w-btn_w)/2,screen_h/2+40,btn_w,btn_h
else; button "Solo",(screen_w-btn_w)/2,screen_h/2-40,btn_w,btn_h; button "Online",(screen_w-btn_w)/2,screen_h/2+40,btn_w,btn_h; end; draw_back
end
function settings_x
return (screen_w-420)/2
end
function masked_password
str hidden=""; num i=0
loop i<str_len(account_password_input)&&i<16; hidden=hidden+"*"; i=i+1; end
return hidden
end
function settings_focus_nick
settings_focus=1; keyboard_clear; keyboard_type account_nick_input; keyboard_show
end
function settings_focus_password
settings_focus=2; keyboard_clear; keyboard_type account_password_input; keyboard_show
end
function settings_submit
if net_account_status()==1; return; end
settings_focus=0; account_notice=0; keyboard_hide; net_account_login account_nick_input,account_password_input; account_last_status=1
end
function settings_read_keyboard
if settings_focus==0; return; end
str raw=keyboard_get_raw()
if settings_focus==1
if str_eq(raw,account_nick_input)==0; account_nick_input=keyboard_get_text(); end
else
if str_eq(raw,account_password_input)==0; account_password_input=keyboard_get_text(); end
end
if keyboard_enter_pressed()==1; if settings_focus==1; settings_focus_password; else; settings_submit; end; end
end
function draw_account_field str label, str value, num y, num active
num fx=settings_x(), color=0xFF272742
if active==1; color=0xFF493080; end
text_scaled label,fx,y-24,0xFFB8B8D8,0.48; roundrect fx,y,420,54,12,color; text_scaled value,fx+14,y+11,0xFFFFFFFF,0.55
end
function draw_account_status num y
num st=net_account_status()
if st==2&&account_last_status==1; account_nick_input=net_account_nickname(); account_password_input=""; settings_focus=0; keyboard_clear; keyboard_hide; end
account_last_status=st
if st==2
if language_ru==1; ctext "Аккаунт подтверждён: "+net_account_nickname(),y,0xFF7ED321; else; ctext "Account confirmed: "+net_account_nickname(),y,0xFF7ED321; end
else if st==1
if language_ru==1; ctext "Проверяем ник и пароль...",y,0xFFFFF176; else; ctext "Checking nickname and password...",y,0xFFFFF176; end
else if st==3
if language_ru==1; ctext "Неверный пароль. Выберите другой ник.",y,0xFFFF8A80; else; ctext "Wrong password. Choose another nickname.",y,0xFFFF8A80; end
else if st==4
if language_ru==1; ctext "Ник: 3–16 букв/цифр. Пароль: от 6 символов.",y,0xFFFF8A80; else; ctext "Nickname: 3–16 letters/digits. Password: 6+.",y,0xFFFF8A80; end
else if st==5
if language_ru==1; ctext "Ошибка Firebase. Проверьте сеть и Rules.",y,0xFFFF8A80; else; ctext "Firebase error. Check network and Rules.",y,0xFFFF8A80; end
else if account_notice==1
if language_ru==1; ctext "Для онлайна сначала создайте аккаунт.",y,0xFFFFF176; else; ctext "Create an account before playing online.",y,0xFFFFF176; end
else
if language_ru==1; ctext "Один ник — один пароль. Пароль нельзя обойти.",y,0xFFB8B8D8; else; ctext "One nickname, one password. Login is required.",y,0xFFB8B8D8; end
end
end
function draw_settings
settings_read_keyboard; rect 0,0,screen_w,screen_h,0x1a1a2e; draw_back
num top=145, nick_active=0, password_active=0
if settings_focus==1; nick_active=1; else if settings_focus==2; password_active=1; end
if language_ru==1; ctext "Уникальный аккаунт",top-34,0xFFFFFFFF; draw_account_field "Ник",account_nick_input,top,nick_active; draw_account_field "Пароль (минимум 6 символов)",masked_password(),top+78,password_active; button "Войти / создать",(screen_w-btn_w)/2,top+148,btn_w,btn_h
else; ctext "Unique account",top-34,0xFFFFFFFF; draw_account_field "Nickname",account_nick_input,top,nick_active; draw_account_field "Password (6 characters minimum)",masked_password(),top+78,password_active; button "Log in / create",(screen_w-btn_w)/2,top+148,btn_w,btn_h; end
draw_account_status top+222
num bw=(screen_w-64)/3, by=screen_h-btn_h-20
button "English",16,by,bw,btn_h; button "Русский",24+bw,by,bw,btn_h; if language_ru==1; button "Консоль",32+bw*2,by,bw,btn_h; else; button "Console",32+bw*2,by,bw,btn_h; end
end
function draw_console
// фон идеально чёрный, текст: зелёный = лог, красный = ошибка
rect 0,0,screen_w,screen_h,0xFF000000
if language_ru==1; ctext "Консоль",48,0xFF00FF00; else; ctext "Console",48,0xFF00FF00; end
num total=console_count(), lh=30, max=floor((screen_h-230)/lh)
if max<3; max=3; end; if max>22; max=22; end
num cy=100, i=0, li=0, col=0
loop i<max
if console_scroll+i<total
li=total-1-(console_scroll+i); col=0xFF00FF00
if console_type(li)==1; col=0xFFFF0000; end
text_scaled console_line(li),18,cy,col,0.75
end
cy=cy+lh; i=i+1
end
num bw=(screen_w-76)/3, by=screen_h-78
if language_ru==1; button "Вверх",16,by,bw,btn_h; button "Вниз",screen_w/2-bw/2,by,bw,btn_h; button "Очистить",screen_w-bw-16,by,bw,btn_h
else; button "Up",16,by,bw,btn_h; button "Down",screen_w/2-bw/2,by,bw,btn_h; button "Clear",screen_w-bw-16,by,bw,btn_h; end
draw_back
end
function touch_lobby num x, num y, num action
if action!=0; return; end; num cx=(screen_w-btn_w)/2; if x<cx-12||x>cx+btn_w+12; return; end
if y>=screen_h/2-28&&y<=screen_h/2+52; start_transition 2; return; end; if y>=screen_h/2+52&&y<=screen_h/2+132; start_transition 4; end
end
function touch_settings num x, num y
if back_hit(x,y)==1; settings_focus=0; keyboard_hide; start_transition 0; return; end
num top=145, fx=settings_x()
if x>=fx&&x<=fx+420&&y>=top&&y<=top+54; settings_focus_nick; return; end
if x>=fx&&x<=fx+420&&y>=top+78&&y<=top+132; settings_focus_password; return; end
num mx=(screen_w-btn_w)/2
if x>=mx-12&&x<=mx+btn_w+12&&y>=top+140&&y<=top+220; settings_submit; return; end
num bw=(screen_w-64)/3, by=screen_h-btn_h-20
if y>=by-8&&y<=by+btn_h+8
settings_focus=0; keyboard_hide
if x>=16&&x<=16+bw; language_ru=0; else if x>=24+bw&&x<=24+bw*2; language_ru=1; else if x>=32+bw*2&&x<=32+bw*3; start_transition 6; end; end
end
function touch_menu num x, num y, num action
if action!=0; return; end
if game_state==4; touch_settings x,y; return; end
if back_hit(x,y)==1; if game_state==6; start_transition 4; else; start_transition 0; end; return; end
if game_state==6
num bw=(screen_w-76)/3, by=screen_h-78, m=console_count()-1
if x>=16&&x<=16+bw&&y>=by&&y<=by+btn_h; if m>=0; if console_scroll+10<m; console_scroll=console_scroll+10; else; console_scroll=m; end; end; return; end
if x>=screen_w/2-bw/2&&x<=screen_w/2+bw/2&&y>=by&&y<=by+btn_h; console_scroll=console_scroll-10; if console_scroll<0; console_scroll=0; end; return; end
if x>=screen_w-bw-16&&x<=screen_w-16&&y>=by&&y<=by+btn_h; console_clear; console_scroll=0; end
return
end
num mx=(screen_w-btn_w)/2; if x<mx-12||x>mx+btn_w+12; return; end
if game_state==2
if y>=screen_h/2-48&&y<=screen_h/2+32; start_transition 1; return; end
if y>=screen_h/2+32&&y<=screen_h/2+112; if net_account_status()==2; start_transition 5; else; account_notice=1; account_nick_input=net_account_nickname(); start_transition 4; end; end
end
end
