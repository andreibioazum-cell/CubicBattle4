function draw_back
if language_ru==1
button "Назад", (screen_w-btn_w)/2, 14, btn_w, btn_h
else
button "Back", (screen_w-btn_w)/2, 14, btn_w, btn_h
end
end
function ctext str s, num y, col color
text s, (screen_w-text_ink_width(s))/2, y, color
end
function button str label, num x, num y, num w, num h
roundrect x, y, w, h, 20, 0x5F10A0
text label, x+(w-text_ink_width(label))/2, y+(h-text_ink_height(label))/2-text_ink_top(label), 0xFFFFFF
end
function choice str label, num bx, num by, num w, num h, num on
if on==1
roundrect bx, by, w, h, 20, 0x7ED321; roundrect bx+4, by+4, w-8, h-8, 16, 0x2E7D32
else
roundrect bx, by, w, h, 20, 0x5F10A0
end
text label, bx+(w-text_ink_width(label))/2, by+(h-text_ink_height(label))/2-text_ink_top(label), 0xFFFFFF
end
function hud_bar num bx, num by, num w, num h, num cur, num max, col color, num from_right
roundrect bx, by, w, h, h/2, 0xDD171923
num shown=cur; if shown<0; shown=0; end
num fill_w=(w-8)*shown/max
if fill_w>0
if from_right==1
roundrect bx+w-4-fill_w, by+4, fill_w, h-8, (h-8)/2, color
else
roundrect bx+4, by+4, fill_w, h-8, (h-8)/2, color
end
end
end
