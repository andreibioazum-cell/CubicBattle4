// ui.ds — кнопки, полосы и текстовые помощники.
function ctext str s, num y, col color
text s,(screen_w-text_ink_width(s))/2,y,color
end
function ctext_scaled str s, num y, col color, num scale
text_scaled s,(screen_w-text_ink_width(s)*scale)/2,y,color,scale
end
function text_in_box str label, num x, num y, num w, num h, col color, num scale
// Центруем реальные видимые границы глифов, а не базовую линию шрифта.
num tw=text_ink_width(label)*scale, th=text_ink_height(label)*scale, tt=text_ink_top(label)*scale
text_scaled label,x+(w-tw)/2,y+(h-th)/2-tt+1.5,color,scale
end
// Наведение мыши: на телефоне mouse_in всегда 0, поэтому эффекта нет.
function hovered num x, num y, num w, num h
if mouse_in<1; return 0; end
if mouse_x<x||mouse_x>x+w; return 0; end
if mouse_y<y||mouse_y>y+h; return 0; end
return 1
end
// Щелчок кнопки. Зовётся из обработчиков нажатий, а не из отрисовки.
function click_sound
sound_play SND_CLICK,sfx_volume
end
function button str label, num x, num y, num w, num h
col c=btn_color
if hovered(x,y,w,h)==1; c=btn_hover; end
roundrect x,y,w,h,20,c; text_in_box label,x,y,w,h,0xFFFFFF,1
end
function button_scaled str label, num x, num y, num w, num h, num scale
col c=btn_color
if hovered(x,y,w,h)==1; c=btn_hover; end
roundrect x,y,w,h,20,c; text_in_box label,x,y,w,h,0xFFFFFF,scale
end
function button_grey str label, num x, num y, num w, num h, num scale
col c=btn_grey
if hovered(x,y,w,h)==1; c=btn_grey_hover; end
roundrect x,y,w,h,20,c; text_in_box label,x,y,w,h,0xC8C8D8,scale
end
function bar num bx, num by, num w, num h, num cur, num max, col color
roundrect bx,by,w,h,h/2,0xDD171923
num shown=clamp(cur,0,max), fill_w=(w-8)*shown/max
if fill_w>2; roundrect bx+4,by+4,fill_w,h-8,(h-8)/2,color; end
end
function draw_back
button tr_back(),(screen_w-btn_w)/2,back_y,btn_w,btn_h
end
function back_hit num x, num y
num bx=(screen_w-btn_w)/2
if x>=bx-12&&x<=bx+btn_w+12&&y>=back_y-8&&y<=back_y+btn_h+8; return 1; end
return 0
end
function menu_top
return screen_h/2-140
end
function menu_hit num x, num y, num row
// Кнопки лобби идут одна под другой с шагом 80 пикселей.
num mx=(screen_w-btn_w)/2, my=menu_top()+row*80
if x<mx-12||x>mx+btn_w+12; return 0; end
if y>=my-8&&y<=my+btn_h+8; return 1; end
return 0
end
