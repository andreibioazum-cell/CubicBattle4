// Весь пользовательский интерфейс: лобби, HUD, джойстик и прицел.

object Button {
    num x = 0
    num y = 0
    num w = 220
    num h = 70
    col color = 0x5F10A0
    int pressed = 0
}

object AttackButton {
    num x = 0
    num y = 0
    num r = 70
    // Пока кнопку удерживают, UI показывает прицел. Выстрел — при отпускании.
    int active = 0
    num range = 360
}

Button play_btn = new Button()
AttackButton attack = new AttackButton()

int joy_active = 0
num joy_knob_r = 34
num joy_hit_r = 150
int back_x = 0

fn draw_button_label(str label, x, y, w, h, col color) {
    text(label, x + (w - text_ink_width(label)) / 2, y + (h - text_ink_height(label)) / 2, color)
}

fn draw_centered_text(str label, y, col color) {
    text(label, screen_w / 2 - text_ink_width(label) / 2, y, color)
}

// --- Лобби ---

fn update_lobby_ui() {
    play_btn.x = (screen_w - play_btn.w) / 2
    play_btn.y = (screen_h - play_btn.h) / 2 + 40
}

fn draw_lobby_ui() {
    str title = "Cubic Battle 4"
    text(title, screen_w / 2 - text_ink_width(title) / 2, play_btn.y - text_ink_height(title) - 20, 0xFFFFFF)
    roundrect(play_btn.x, play_btn.y, play_btn.w, play_btn.h, 20, play_btn.color)
    draw_button_label("Play", play_btn.x, play_btn.y, play_btn.w, play_btn.h, 0xFFFFFF)
}

// Нажатие на Play засчитывается при отпускании пальца внутри кнопки.
fn touch_lobby_ui(x, y, int action) {
    if (x >= play_btn.x && x <= play_btn.x + play_btn.w && y >= play_btn.y && y <= play_btn.y + play_btn.h) {
        if (action == 0) {
            play_btn.pressed = 1
        } else if (action == 1 || action == 3) {
            if (play_btn.pressed == 1) {
                play_btn.pressed = 0
                start_transition(1)
            }
        }
        return
    }
    play_btn.pressed = 0
}

// --- Игровой интерфейс ---

fn init_game_ui() {
    init_joystick_ui()
    attack.x = screen_w - 140
    attack.y = screen_h - 150
    attack.r = joy.r
    attack.active = 0
}

fn init_joystick_ui() {
    joy.x = 130
    joy.y = screen_h - 150
    joy.r = 70
    joy.dx = 0
    joy.dy = 0
    joy.ox = 0
    joy.oy = 0
    joy_active = 0
}

// Рисуется до игровых объектов, чтобы прицел не закрывал игрока и врага.
fn draw_game_ui_underlay() {
    if (attack.active == 1 && game_finished == 0) {
        draw_attack_aim_ui()
    }
}

fn draw_game_ui() {
    text("Defeat the enemy", 20, 24, 0xFFFFFF)
    text("Enemy HP: " + enemy.hp + "/" + enemy.max_hp, 20, 48, 0xFFCDD2)
    draw_enemy_health_ui()
    draw_joystick_ui()
    draw_attack_button_ui()
    draw_back_button_ui()

    if (game_finished != 0) {
        draw_game_result_ui()
    }
}

fn draw_attack_aim_ui() {
    num dx = cos(player.angle)
    num dy = sin(player.angle)
    num start_x = player.x + dx * (player.size + 8)
    num start_y = player.y + dy * (player.size + 8)
    num aim_x = player.x + dx * attack.range
    num aim_y = player.y + dy * attack.range

    // Полупрозрачная линия показывает, куда вылетит пуля.
    line(start_x, start_y, aim_x, aim_y, 12, 0x66000000)
    line(aim_x - 12, aim_y, aim_x + 12, aim_y, 3, 0x99000000)
    line(aim_x, aim_y - 12, aim_x, aim_y + 12, 3, 0x99000000)
    ring(aim_x, aim_y, 14, 2, 0x99000000)
}

fn draw_enemy_health_ui() {
    num bar_w = 44
    num bar_x = enemy.x - bar_w / 2
    num bar_y = enemy.y - enemy.size - 14
    rect(bar_x, bar_y, bar_w, 6, 0xCC000000)
    rect(bar_x, bar_y, bar_w * enemy.hp / enemy.max_hp, 6, 0xE94560)
}

fn draw_joystick_ui() {
    ring(joy.x, joy.y, joy.r, 4, 0x000000)
    circle(joy.x + joy.ox, joy.y + joy.oy, joy_knob_r, 0x000000)
}

fn draw_attack_button_ui() {
    circle(attack.x, attack.y, attack.r, 0xE94560)
    ring(attack.x, attack.y, attack.r, 4, 0x000000)
    num a_w = text_ink_width("Attack") * 0.55
    text_scaled("Attack", attack.x - a_w / 2, attack.y - 7, 0xFFFFFF, 0.55)
}

fn draw_back_button_ui() {
    back_x = screen_w - 234
    roundrect(back_x, 12, 220, 70, 20, 0x5F10A0)
    draw_button_label("Back", back_x, 12, 220, 70, 0xFFFFFF)
}

fn draw_game_result_ui() {
    rect(0, 0, screen_w, screen_h, 0x99000000)
    num panel_x = screen_w / 2 - 165
    num panel_y = screen_h / 2 - 85
    roundrect(panel_x, panel_y, 330, 170, 24, 0x5F10A0)

    if (game_finished == 1) {
        draw_centered_text("Victory!", panel_y + 34, 0xFFFFFF)
        draw_centered_text("Enemy defeated", panel_y + 75, 0xFFFFFF)
    } else {
        draw_centered_text("Defeat", panel_y + 34, 0xFFFFFF)
        draw_centered_text("The enemy caught you", panel_y + 75, 0xFFFFFF)
    }
    draw_centered_text("Tap to return", panel_y + 118, 0xFFCDD2)
}

fn touch_game_ui(x, y, int action) {
    if (game_finished != 0) {
        if (action == 0) {
            start_transition(0)
        }
        return
    }

    back_x = screen_w - 234
    if (action == 0) {
        if (x >= back_x - 4 && x <= back_x + 224 && y >= 8 && y <= 86) {
            start_transition(0)
            return
        }
        num adx = x - attack.x
        num ady = y - attack.y
        if (sqrt(adx*adx + ady*ady) <= attack.r + 8) {
            // Нажатие лишь включает прицел — выстрел при отпускании.
            attack.active = 1
            return
        }
    }
    if (action == 1 && attack.active == 1) {
        attack.active = 0
        fire_bullet()
        return
    }
    if (action == 3) {
        // Отмена касания не должна выпускать пулю.
        attack.active = 0
    }
    joy_touch_ui(x, y, action)
}

fn joy_touch_ui(x, y, int action) {
    if (action == 1 || action == 3) {
        joy_active = 0
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
        return
    }
    if (action == 2 && joy_active == 0) {
        return
    }
    num dx = x - joy.x
    num dy = y - joy.y
    num dist = sqrt(dx*dx + dy*dy)
    if (action == 0 && dist > joy_hit_r) {
        return
    }
    joy_active = 1
    if (dist > joy.r) {
        joy.dx = dx / dist
        joy.dy = dy / dist
        joy.ox = joy.dx * joy.r
        joy.oy = joy.dy * joy.r
    } else {
        joy.dx = dx / joy.r
        joy.dy = dy / joy.r
        joy.ox = dx
        joy.oy = dy
    }
}
