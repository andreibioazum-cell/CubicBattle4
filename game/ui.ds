// UI-утилиты: центрирование текста по реальным ink-метрикам.

fn draw_button_label(str label, x, y, w, h, col color) {
    text(label, x + (w - text_ink_width(label)) / 2, y + (h - text_ink_height(label)) / 2, color)
}

fn draw_button(x, y, w, h, str label, col color, col text_color) {
    rect(x + 2, y + 3, w, h, 0x0f0f1c)
    rect(x - 2, y - 2, w + 4, h + 4, 0x334455)
    rect(x, y, w, h, color)
    draw_button_label(label, x, y, w, h, text_color)
}

fn draw_panel(x, y, w, h, col color, col border_color) {
    if (border_color != 0) {
        rect(x - 2, y - 2, w + 4, h + 4, border_color)
    }
    rect(x, y, w, h, color)
}

fn draw_centered_text(str label, y, col color, size) {
    text(label, screen_w / 2 - text_ink_width(label) / 2, y, color)
}
