// Игровые сущности и их состояние.
// --- Сущности ---

object Player
    num x = 0
    num y = 0
    num size = 30
    num angle = 0
    num hp = 10
    num max_hp = 10
end

object Enemy
    num x = 0
    num y = 0
    num size = 22
    num speed = 2.2
    num hp = 3
    num max_hp = 3
    num angle = 0
end

object Bullet
    num x = 0
    num y = 0
    num dx = 0
    num dy = 0
    num r = 12
    num speed = 13
    num traveled = 0
    num active = 0
end

Player player = new Player()
Enemy enemy = new Enemy()
Bullet bullet = new Bullet()

num finished = 0        // 0 — бой, 1 — победа, 2 — поражение
num joy_speed = 3.2
num aiming = 0
num atk_x = 0
num atk_y = 0
num joy_id = -1         // палец на джойстике (-1 — свободен)
num aim_id = -1         // палец на кнопке атаки
