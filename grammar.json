{
  "scopeName": "source.dimscript",
  "name": "DimScript",
  "fileTypes": ["ds"],
  "patterns": [
    {
      "name": "meta.preprocessor.include.dimscript",
      "match": "^\\s*(#\\s*include)\\s*([\\\"<])([^\\\">]+)([\\\">])",
      "captures": {
        "1": {"name": "keyword.control.directive.include.dimscript"},
        "2": {"name": "punctuation.definition.string.begin.dimscript"},
        "3": {"name": "string.quoted.other.include.dimscript"},
        "4": {"name": "punctuation.definition.string.end.dimscript"}
      }
    },
    {
      "name": "comment.line.double-slash.dimscript",
      "match": "//.*$"
    },
    {
      "name": "storage.type.dimscript",
      "match": "\\b(num|int|bool|str|col|size|byte\\*)\\b"
    },
    {
      "name": "keyword.control.dimscript",
      "match": "\\b(fn|if|else|while|loop|return|new|delete|Main)\\b"
    },
    {
      "name": "constant.language.dimscript",
      "match": "\\b(true|false|NULL)\\b"
    },
    {
      "name": "support.function.builtin.dimscript",
      "match": "\\b(cls|rect|circle|ring|tex|png_load|text|text_scaled|text_width|text_height|print|printn|prints|sqrt|sin|cos|atan2|ds_len|ds_ulen|ds_substr|ds_concat|ds_find|ds_contains|ds_starts_with|ds_ends_with|ds_upper|ds_lower|ds_trim|ds_replace)\\b"
    },
    {
      "name": "string.quoted.double.dimscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.dimscript",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.dimscript",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?)\\b"
    },
    {
      "name": "entity.name.function.dimscript",
      "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": {"name": "entity.name.function.dimscript"}
      }
    },
    {
      "name": "variable.other.dimscript",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  ]
}
