cat > game.ds << 'EOF'
-- game.ds - пример игры на DimScript

COLOR_BG = 0xFFCCCCCC
COLOR_PLAYER = 0xFFEE7722

player = {x=0, y=0, speed=5}

function init()
    player.x = screen_w / 2
    player.y = screen_h / 2
end

function update()
    player.x = player.x + joy.dx * player.speed
    player.y = player.y + joy.dy * player.speed
end

function draw()
    cls(COLOR_BG)
    rect(player.x, player.y, 40, 40, COLOR_PLAYER)
end
EOF
