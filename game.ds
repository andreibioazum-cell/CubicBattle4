-- Example DimScript game

COLOR_BG = 0xFFCCCCCC
COLOR_PLAYER = 0xFFEE7722
COLOR_JOY = 0xFF000000

player = {x = 0, y = 0, speed = 5, size = 40}

function init()
    player.x = screen_w / 2
    player.y = screen_h / 2
    joy.x = 150
    joy.y = screen_h - 150
    joy.r = 80
end

function update()
    player.x = player.x + joy.dx * player.speed
    player.y = player.y + joy.dy * player.speed
end

function draw()
    cls(COLOR_BG)
    rect(player.x - player.size / 2, player.y - player.size / 2, player.size, player.size, COLOR_PLAYER)
    ring(joy.x, joy.y, joy.r, 4, COLOR_JOY)
    circle(joy.x + joy.ox, joy.y + joy.oy, 35, COLOR_JOY)
end

function touch(x, y, action)
    if action == 1 or action == 3 then
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
    else
        local dx = x - joy.x
        local dy = y - joy.y
        local distance = sqrt(dx * dx + dy * dy)
        if distance < 15 then
            joy.dx = 0
            joy.dy = 0
            joy.ox = 0
            joy.oy = 0
        else
            joy.dx = dx / distance
            joy.dy = dy / distance
            joy.ox = joy.dx * distance
            joy.oy = joy.dy * distance
        end
    end
end
