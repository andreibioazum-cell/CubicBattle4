-- game.ds - Игра на Lua-синтаксисе с компиляцией в машинный код

-- Константы
COLOR_BG = 0xFFCCCCCC
COLOR_PLAYER = 0xFFEE7722
COLOR_JOY = 0xFF000000
COLOR_TEXT = 0xFFFFFFFF

-- Глобальные переменные
player = {x=0, y=0, angle=0, speed=5, size=40}
fps_counter = 0
fps_time = 0

-- Инициализация
function init()
    player.x = screen_w / 2
    player.y = screen_h / 2
    joy.x = 150
    joy.y = screen_h - 150
    joy.r = 80
end

-- Обновление
function update()
    -- Движение
    player.x = player.x + joy.dx * player.speed
    player.y = player.y + joy.dy * player.speed
    
    -- Поворот
    if joy.dx ~= 0 or joy.dy ~= 0 then
        player.angle = atan2(joy.dx, -joy.dy)
    end
    
    -- Границы
    maxX = screen_w - player.size
    maxY = screen_h - player.size
    if player.x < player.size then player.x = player.size end
    if player.x > maxX then player.x = maxX end
    if player.y < player.size then player.y = player.size end
    if player.y > maxY then player.y = maxY end
    
    -- FPS
    fps_counter = fps_counter + 1
    if os.clock() - fps_time >= 1 then
        fps = fps_counter
        fps_counter = 0
        fps_time = os.clock()
    end
end

-- Отрисовка
function draw()
    cls(COLOR_BG)
    
    -- Игрок (квадрат)
    rect(player.x - player.size/2, player.y - player.size/2, player.size, player.size, COLOR_PLAYER)
    
    -- Джойстик
    ring(joy.x, joy.y, joy.r, 4, COLOR_JOY)
    circle(joy.x + joy.ox, joy.y + joy.oy, 35, COLOR_JOY)
    
    -- FPS
    text("FPS: " .. tostring(fps), 10, 10, COLOR_TEXT)
end

-- Обработка касания
function touch(x, y, action)
    dx = x - joy.x
    dy = y - joy.y
    dist = sqrt(dx*dx + dy*dy)
    
    if action == 1 then -- UP
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
        return
    end
    
    if dist > joy.r + 30 then return end
    if dist < 15 then
        joy.dx = 0
        joy.dy = 0
        joy.ox = 0
        joy.oy = 0
        return
    end
    
    clamped = dist
    if dist > joy.r then clamped = joy.r end
    
    joy.dx = dx / dist
    joy.dy = dy / dist
    joy.ox = joy.dx * clamped
    joy.oy = joy.dy * clamped
end
